context demo

---
`is` tests a value against a pattern and narrows it. Inside the `if`, `n` is an
`Int` — the `Ok` payload — without an explicit unwrap.
---
fn useValue(r: Result[Int, String]) -> Int {
  if r is Ok(n) {
    n
  } else {
    0
  }
}

---
Run calls `service playground`: one `Ok` and one `Err`, so you see both branches.
---
service playground {
  on call() -> Effect[List[Int]] {
    [useValue(Ok(7)), useValue(Err("missing"))]
  }
}
