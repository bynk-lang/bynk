context demo

type Id = Int

fn classify(n: Int) -> String {
  if n < 10 {
    "small"
  } else if n < 100 {
    "medium"
  } else {
    "large"
  }
}

---
Run calls `service playground`, so the playground has something to show:
`classify` applied to three sizes of number.
---
service playground {
  on call() -> Effect[List[String]] {
    [classify(7), classify(42), classify(1000)]
  }
}
