context demo

---
Who we are greeting — non-empty, at most 40 characters.

A refined type: every `Subject` that exists has already passed this check,
so `greeting` never needs to validate its input.
---
type Subject = String where NonEmpty && MaxLength(40)

fn greeting(subject: Subject) -> String {
  "Hello, \(subject)!"
}

---
Run calls `service playground`. `Subject.of` checks each raw string, and only the
one that passes reaches `greeting`.
---
service playground {
  on call() -> Effect[List[String]] by Caller {
    ["World", ""].map((raw) => match Subject.of(raw) {
      Ok(subject) => greeting(subject)
      Err(e) => "\(e.field): \(e.message)"
    })
  }
}
