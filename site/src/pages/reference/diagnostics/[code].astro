---
// One page per diagnostic code (web presence track, slice 4, #3876). Every
// tool links a code as `https://bynk-lang.org/d/<code>`, which `_redirects`
// sends here. The page is built from `src/generated/diagnostics/<code>.json` (the
// compiler's registry, rendered per code by `bynk_syntax::diagnostics::render_json_per_code`
// and kept current by the `diagnostics_registry` docs-consistency test) and lists
// the Book pages that explain the code from `src/data/diagnostic-links.json`.
import { getCollection, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Badge, Code } from "@astrojs/starlight/components";
import diagnosticLinks from "../../../data/diagnostic-links.json";

export async function getStaticPaths() {
  // One file per code (#4286), so two changes that add different codes never touch the same
  // file. Inside the function: Astro hoists `getStaticPaths`, so only imports are in scope.
  const diagnostics = Object.values(
    import.meta.glob("../../../generated/diagnostics/*.json", { eager: true, import: "default" }),
  ).sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));
  // The title and headings of every Book page a code links to, read once.
  const wanted = new Set(
    Object.values(diagnosticLinks)
      .flat()
      .map((l) => l.split("#")[0].replace(/^\/|\/$/g, "")),
  );
  const pages = new Map();
  for (const entry of await getCollection("docs", (e) => wanted.has(e.id))) {
    const { headings } = await render(entry);
    pages.set(entry.id, { title: entry.data.title, headings });
  }
  const describe = (link) => {
    const [path, anchor] = link.split("#");
    const page = pages.get(path.replace(/^\/|\/$/g, ""));
    const heading = anchor && page?.headings.find((h) => h.slug === anchor);
    return {
      href: link,
      page: page?.title ?? path,
      section: heading ? heading.text : undefined,
    };
  };
  return diagnostics.map((d) => ({
    params: { code: d.code },
    props: { d, links: (diagnosticLinks[d.code] ?? []).map(describe) },
  }));
}

const { d, links } = Astro.props;

/** Inline Markdown as the registry writes it: `code` spans and *emphasis*. */
function inline(text) {
  const escape = (s) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return text
    .split("`")
    .map((part, i) =>
      i % 2 === 1
        ? `<code>${escape(part)}</code>`
        : escape(part).replace(/(^|[^\w*])\*([^*\s][^*]*?)\*(?![\w*])/g, "$1<em>$2</em>"),
    )
    .join("");
}

const severity = {
  error: { text: "Error", variant: "danger" },
  warning: { text: "Warning", variant: "caution" },
  hint: { text: "Hint", variant: "note" },
}[d.severity];
const paragraphs = d.blurb ? d.blurb.split(/\n\n+/) : [];
---

<StarlightPage
  frontmatter={{
    title: d.code,
    description: d.summary.replace(/`/g, ""),
    tableOfContents: false,
    editUrl: false,
  }}
>
  <p>
    <Badge text={severity.text} variant={severity.variant} />
    {" "}<span set:html={inline(d.summary)} />
  </p>

  {
    d.blurb ? (
      <>
        {paragraphs.map((p) => (
          <p set:html={inline(p)} />
        ))}
        <h2 id="example">Example</h2>
        <Code code={d.example} lang="bynk" />
      </>
    ) : (
      <p>
        No explanation is written for this code yet. The summary above is the
        compiler's own description of it.
      </p>
    )
  }

  {
    links.length > 0 && (
      <>
        <h2 id="in-the-book">In the Book</h2>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href}>
                {l.page}
                {l.section && <> › {l.section}</>}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2 id="see-also">See also</h2>
  <ul>
    {
      d.constructs.length > 0 && (
        <li>
          {d.constructs.length === 1 ? "The grammar rule it governs: " : "The grammar rules it governs: "}
          {d.constructs.map((c, i) => (
            <>
              {i > 0 && ", "}
              <a href={`/reference/grammar/#rule-${c}`}>
                <code>{c}</code>
              </a>
            </>
          ))}
          .
        </li>
      )
    }
    <li>
      Every code in its category, <a href={`/reference/diagnostics/#${d.categoryAnchor}`}>{d.category}</a>,
      on the <a href="/reference/diagnostics/">diagnostic index</a>.
    </li>
    <li>
      <code>bynk explain {d.code}</code> shows the same from the installed
      toolchain, without a network.
    </li>
  </ul>
</StarlightPage>
