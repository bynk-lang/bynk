---
// "From the blog" (web presence slice 8): the newest three posts, read at
// build time from the blog's /blog/posts.json (see src/lib/blog-posts.mjs).
// When the list can't be read, the section shows only its link to the blog.
import { latestPosts } from "../../lib/blog-posts.mjs";

const posts = await latestPosts(3);
const date = (iso: string) =>
  new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(
    new Date(iso),
  );
---

<section class="home-section not-content" aria-labelledby="from-the-blog">
  <div class="head">
    <h2 id="from-the-blog">From the blog</h2>
    <a href="/blog/">All posts and series</a>
  </div>
  {
    posts.length > 0 && (
      <div class="posts">
        {posts.map((p) => (
          <a class="post" href={p.url}>
            {(p.series || p.level) && (
              <span class="eyebrow">{[p.series, p.level].filter(Boolean).join(" · ")}</span>
            )}
            <span class="title">{p.title}</span>
            {p.summary && <span class="summary">{p.summary}</span>}
            <span class="meta">
              {[date(p.date), p.bynkVersion && `Bynk ${p.bynkVersion.replace(/^v/, "")}`].filter(Boolean).join(" · ")}
            </span>
          </a>
        ))}
      </div>
    )
  }
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--bynk-surface-panel);
    border: 1px solid var(--bynk-line);
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--bynk-ink);
  }
  .post:hover {
    border-color: var(--bynk-line-strong);
  }
  .post:hover .title {
    color: var(--bynk-accent);
  }
  .title {
    font-size: var(--sl-text-lg);
    font-weight: 650;
    line-height: 1.3;
  }
  .summary {
    color: var(--bynk-ink-muted);
    font-size: var(--sl-text-sm);
  }
  .meta {
    margin-top: auto;
    color: var(--bynk-ink-muted);
    font-size: var(--sl-text-xs);
  }
</style>
