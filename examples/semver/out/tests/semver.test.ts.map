suite semver
// Everything here is pure, so it is tested directly: no context, no platform.

case "parse reads the three components and the tag" {
	expect parse("1.2.3") is Ok(_)
	expect literal("1.2.3").major == 1
	expect literal("1.2.3").minor == 2
	expect literal("1.2.3").patch == 3
	expect literal("1.2.3-beta.1").pre == "beta.1"
}

case "parse tolerates a leading v and drops build metadata" {
	expect render(literal("v1.2.3+build.5")) == "1.2.3"
	expect render(literal("1.2.3-rc.1+build.5")) == "1.2.3-rc.1"
}

case "parse rejects what is not a version" {
	expect parse("") is Err(_)
	expect parse("1.2") is Err(_)
	expect parse("1.2.3.4") is Err(_)
	expect parse("1.2.x") is Err(_)
	expect parse("01.2.3") is Err(_)
	expect parse("-1.2.3") is Err(_)
	expect parse("1.2.3-") is Err(_)
}

case "versions order by major, minor, then patch" {
	expect compare(literal("1.2.3"), literal("1.2.3")) == 0
	expect compare(literal("2.0.0"), literal("1.9.9")) == 1
	expect compare(literal("1.3.0"), literal("1.2.9")) == 1
	expect compare(literal("1.2.4"), literal("1.2.3")) == 1
	expect compare(literal("1.2.3"), literal("1.2.4")) == -1
	expect compare(literal("1.10.0"), literal("1.9.0")) == 1
}

case "a pre-release is lower than its release" {
	expect compare(literal("1.0.0-rc.1"), literal("1.0.0")) == -1
	expect compare(literal("1.0.0"), literal("1.0.0-rc.1")) == 1
}

case "pre-release identifiers follow the semver precedence example" {
	// 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta < 1.0.0-beta
	//   < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0-rc.1 < 1.0.0
	expect compare(literal("1.0.0-alpha"), literal("1.0.0-alpha.1")) == -1
	expect compare(literal("1.0.0-alpha.1"), literal("1.0.0-alpha.beta")) == -1
	expect compare(literal("1.0.0-alpha.beta"), literal("1.0.0-beta")) == -1
	expect compare(literal("1.0.0-beta"), literal("1.0.0-beta.2")) == -1
	expect compare(literal("1.0.0-beta.2"), literal("1.0.0-beta.11")) == -1
	expect compare(literal("1.0.0-beta.11"), literal("1.0.0-rc.1")) == -1
}

case "caret ranges stop at the next breaking change" {
	expect satisfies(literal("1.2.3"), "^1.2.3") is Ok(true)
	expect satisfies(literal("1.9.0"), "^1.2.3") is Ok(true)
	expect satisfies(literal("1.2.2"), "^1.2.3") is Ok(false)
	expect satisfies(literal("2.0.0"), "^1.2.3") is Ok(false)
	expect satisfies(literal("0.2.9"), "^0.2.3") is Ok(true)
	expect satisfies(literal("0.3.0"), "^0.2.3") is Ok(false)
	expect satisfies(literal("0.0.3"), "^0.0.3") is Ok(true)
	expect satisfies(literal("0.0.4"), "^0.0.3") is Ok(false)
}

case "tilde ranges allow patch changes only" {
	expect satisfies(literal("1.2.9"), "~1.2.3") is Ok(true)
	expect satisfies(literal("1.3.0"), "~1.2.3") is Ok(false)
}

case "comparators combine with a space, and ranges with ||" {
	expect satisfies(literal("1.5.0"), ">=1.2.3 <2.0.0") is Ok(true)
	expect satisfies(literal("2.0.0"), ">=1.2.3 <2.0.0") is Ok(false)
	expect satisfies(literal("1.2.3"), ">1.2.3") is Ok(false)
	expect satisfies(literal("1.2.3"), "<=1.2.3") is Ok(true)
	expect satisfies(literal("3.1.0"), "^1.0.0 || ^3.0.0") is Ok(true)
	expect satisfies(literal("2.1.0"), "^1.0.0 || ^3.0.0") is Ok(false)
}

case "a bare version is an exact match, and * matches anything" {
	expect satisfies(literal("1.2.3"), "1.2.3") is Ok(true)
	expect satisfies(literal("1.2.4"), "1.2.3") is Ok(false)
	expect satisfies(literal("1.2.4"), "=1.2.4") is Ok(true)
	expect satisfies(literal("9.9.9"), "*") is Ok(true)
}

case "pre-releases are opt-in" {
	expect satisfies(literal("1.3.0-beta.1"), "^1.2.0") is Ok(false)
	expect satisfies(literal("1.3.0-beta.1"), ">=1.3.0-alpha.1") is Ok(true)
	expect satisfies(literal("1.4.0-beta.1"), ">=1.3.0-alpha.1") is Ok(false)
}

case "a malformed range is an error, whatever the version" {
	expect satisfies(literal("1.0.0"), "^banana") is Err(_)
	expect satisfies(literal("1.0.0-beta"), "^banana") is Err(_)
	expect satisfies(literal("1.0.0"), "") is Err(_)
	expect satisfies(literal("1.0.0"), "^1.0.0 ||") is Err(_)
}

case "maxSatisfying picks the highest match" {
	let all = ["1.0.0", "1.2.0", "1.10.0", "2.0.0", "2.1.0-beta.1", "oops"]
	expect maxSatisfying(all, "^1.0.0") is Ok(Some("1.10.0"))
	expect maxSatisfying(all, "*") is Ok(Some("2.0.0"))
	expect maxSatisfying(all, "^3.0.0") is Ok(None)
	expect maxSatisfying(all, "^banana") is Err(_)
}
