context sessions

uses tokens
consumes bynk { Clock, Cookie, Random }

type LoginRequest = {
	user: UserId,
}

---
The cookies a request carries. `sid` is the session token, read from the
`__Host-sid` cookie: a hyphen cannot be part of a field name, so `@name` gives the
field the wire name the browser sends. The router decodes and validates it before the
handler runs, so a malformed token never reaches the cache. A missing cookie is `None`.
---
type SessionCookies = {
	@name("__Host-sid") sid: Option[Token],
}

---
A shard of live sessions (a Cloudflare Durable Object). State is a `Cache` — a
`Map` whose entries expire on their own. `@ttl(30.minutes)` sets the lifetime:
each `put` (re)starts the 30-minute clock, an entry past its TTL reads as `None`,
and expired entries are reaped at the next commit.

Eviction consults the clock, so every cache op *except* `remove` declares
`given Clock` — the time dependency is visible in the signature.
---
agent Sessions {
	key shard: String

	store live: Cache[Token, UserId] @ttl(30.minutes)

	// start or refresh a session; stamps a fresh 30-minute expiry
	on call login(token: Token, user: UserId) -> Effect[()] given Clock {
		do live.put(token, user)
	}

	// resolve a token to its user, or None if unknown or expired
	on call whoami(token: Token) -> Effect[Option[UserId]] given Clock {
		live.get(token)
	}

	// end a session now; `remove` is idempotent and needs no clock
	on call logout(token: Token) -> Effect[()] {
		do live.remove(token)
	}

	// how many sessions are currently live (expired entries are not counted)
	on call active() -> Effect[Int] given Clock {
		live.size()
	}
}

service api from http {
	// Log in: mint an unguessable token, store the session under it, and hand it
	// to the browser in a `__Host-` cookie (`Secure`, `HttpOnly` and `SameSite=Lax`
	// by default, bound to this origin by the prefix: the compiler checks `secure`,
	// `path: "/"` and no `domain`).
	on POST("/sessions") (
		body: LoginRequest
	) -> Effect[HttpResult[String]] by Visitor given Random {
		let raw <- Random.bytes(16)
		let text = raw.toBase64Url()
		match Token.of(text) {
			Ok(token) => {
				do Sessions("default").login(token, body.user)
				Created("ok").withCookie(Cookie {
					...SessionCookies.sid.cookie(token),
					maxAge: Some(30.minutes),
				})
			},
			Err(_) => ServerError("could not mint a session token"),
		}
	}

	// Who am I? The session cookie names the live session; the typed `cookies`
	// record has already checked it is a `Token` (a malformed one is a `400`).
	on GET("/me") (cookies: SessionCookies) -> Effect[HttpResult[UserId]] by Visitor {
		match cookies.sid {
			None => Unauthorized,
			Some(token) => {
				let who <- Sessions("default").whoami(token)
				match who {
					Some(user) => Ok(user),
					None => Unauthorized,
				}
			},
		}
	}

	// Log out: end the session and clear the cookie. This handler reads the raw
	// `RequestCookies` view, not the typed record: a typed `cookies` record rejects a
	// malformed `__Host-sid` with a `400` before the handler runs, and logout must still
	// clear such a cookie, whatever it holds.
	on POST("/logout") (cookies: RequestCookies) -> Effect[HttpResult[String]] by Visitor {
		match cookies.get("__Host-sid") {
			None => NoContent,
			Some(raw) => match Token.of(raw) {
				Ok(token) => {
					do Sessions("default").logout(token)
					NoContent.withCookie(SessionCookies.sid.expire())
				},
				Err(_) => NoContent.withCookie(SessionCookies.sid.expire()),
			},
		}
	}

	on GET("/sessions") () -> Effect[HttpResult[Int]] by Visitor {
		let n <- Sessions("default").active()
		Ok(n)
	}
}
