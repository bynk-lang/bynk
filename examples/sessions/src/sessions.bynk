context sessions

uses tokens
consumes bynk { Clock, Cookie, Random }

type LoginRequest = {
	user: UserId,
}

---
The cookies a request carries. `sid` is the session token: the router
decodes and validates it before the handler runs, so a malformed token never
reaches the cache. A missing cookie is `None`.
---
type SessionCookies = {
	sid: Option[Token],
}

---
A shard of live sessions (a Cloudflare Durable Object). State is a `Cache` — a
`Map` whose entries expire on their own. `@ttl(30.minutes)` sets the lifetime:
each `put` (re)starts the 30-minute clock, an entry past its TTL reads as `None`,
and expired entries are reaped at the next commit.

Eviction consults the clock, so every cache op *except* `remove` declares
`given Clock` — the time dependency is visible in the signature.
---
agent Sessions {
	key shard: String

	store live: Cache[Token, UserId] @ttl(30.minutes)

	// start or refresh a session; stamps a fresh 30-minute expiry
	on call login(token: Token, user: UserId) -> Effect[()] given Clock {
		do live.put(token, user)
	}

	// resolve a token to its user, or None if unknown or expired
	on call whoami(token: Token) -> Effect[Option[UserId]] given Clock {
		live.get(token)
	}

	// end a session now; `remove` is idempotent and needs no clock
	on call logout(token: Token) -> Effect[()] {
		do live.remove(token)
	}

	// how many sessions are currently live (expired entries are not counted)
	on call active() -> Effect[Int] given Clock {
		live.size()
	}
}

service api from http {
	// Log in: mint an unguessable token, store the session under it, and hand it
	// to the browser in a cookie (`Secure`, `HttpOnly` and `SameSite=Lax` by
	// default). A `__Host-` prefix would bind it to this origin, but a hyphenated
	// name cannot be a record field yet, so the typed reader cannot name it.
	on POST("/sessions") (
		body: LoginRequest
	) -> Effect[HttpResult[String]] by Visitor given Random {
		let raw <- Random.bytes(16)
		let text = raw.toBase64Url()
		match Token.of(text) {
			Ok(token) => {
				do Sessions("default").login(token, body.user)
				Created("ok").withCookie(Cookie {
					name: "sid",
					value: text,
					maxAge: Some(30.minutes),
				})
			},
			Err(_) => ServerError("could not mint a session token"),
		}
	}

	// Who am I? The session cookie is read as a typed `cookies` record.
	on GET("/me") (cookies: SessionCookies) -> Effect[HttpResult[UserId]] by Visitor {
		match cookies.sid {
			None => Unauthorized,
			Some(token) => {
				let who <- Sessions("default").whoami(token)
				match who {
					Some(user) => Ok(user),
					None => Unauthorized,
				}
			},
		}
	}

	// Log out: end the session and clear the cookie.
	on POST("/logout") (cookies: SessionCookies) -> Effect[HttpResult[String]] by Visitor {
		match cookies.sid {
			None => NoContent,
			Some(token) => {
				do Sessions("default").logout(token)
				NoContent.clearCookie(Cookie { name: "sid", value: "" })
			},
		}
	}

	on GET("/sessions") () -> Effect[HttpResult[Int]] by Visitor {
		let n <- Sessions("default").active()
		Ok(n)
	}
}
