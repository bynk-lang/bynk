#!/bin/sh
# Pre-push: run the CI gates that stop short of the test suite (fmt, clippy and
# strict rustdoc), so a formatting, lint or broken-doc-link slip is caught in
# seconds rather than costing a full CI round trip.
#
# Enable it (opt-in, per clone — git never picks this directory up on its own):
#
#     git config core.hooksPath .githooks
#
# Why only the fast gates: the PR gate's critical path is the
# `Test suite (windows-latest)` leg at ~7 minutes, and fmt, clippy and the strict
# rustdoc build are the cheap lint-class gates that fail most often. Catching
# them here removes the most common reason a PR needs a second run. The
# test suite is deliberately NOT run on every push — it is minutes of local
# wall clock, and a hook slow enough to be worth bypassing gets bypassed. Run
# it yourself before opening a PR:
#
#     cargo xtask ci
#
# What "fast" actually costs. `cargo clippy --workspace --all-targets` skips
# codegen and linking, NOT compilation: it still builds the whole dependency
# graph and every dev-dependency as metadata. `cargo doc --no-deps --workspace`
# (run with `-D warnings`, as CI's API docs job does) rebuilds only the workspace
# crates' docs. Measured on this workspace (one run each, so indicative):
#
#     warm cache                                    ~6s
#     all workspace sources touched                 ~70s  (clippy ~18s + rustdoc ~50s)
#     fresh clone (nothing built yet)               minutes
#
# "Touched" invalidates the workspace crates only; a lockfile or toolchain bump
# also rebuilds the dependency graph for clippy, so it costs more than the middle
# row. Rustdoc is the larger share of the invalidated case.
#
# So this is a few seconds in the steady state and a real wait the first time,
# or after anything that invalidates the workspace — a lockfile or toolchain
# bump, a `[profile]` edit, a rebase across one. That is the case to reach for
# --no-verify on, rather than turning the hook off.
#
# Scope, so this does not read as stricter than it is: the gates lint the
# WORKING TREE, not the commits being pushed. The refs on stdin are read only
# to spot a branch deletion. Pushing an older branch, or pushing with dirty or
# stashed local edits, checks something other than what lands on the remote.
# It front-runs CI; it is not a proof about the push.
#
# To push past this hook once (a WIP branch, a docs-only fixup):
#
#     git push --no-verify

set -e

# Nothing to check on a branch deletion (`git push origin :branch`), which sends
# an all-zero local SHA and no worktree change to lint.
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
	*[!0]*) has_commits=1 ;;
	esac
done
[ -n "${has_commits:-}" ] || exit 0

echo "pre-push: running the fast CI gates (cargo xtask ci --fast)"
echo "pre-push: skip with --no-verify; full suite is \`cargo xtask ci\`"
exec cargo xtask ci --fast
