suite registry.store {
	// Accounts (R3): the agents' decisions, the device flow with GitHub stubbed,
	// and the account API. The real flow runs against a fake GitHub in
	// scripts/check-accounts.sh.

	case "a name is claimed first come, once" {
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let bob = GitHubUser {
			id: 2,
			login: "bob",
		}
		let first <- Organisation("acme").claim(ann, false)
		expect first is ClaimedNow
		let second <- Organisation("acme").claim(bob, false)
		expect second is Taken
		let again <- Organisation("acme").claim(ann, false)
		expect again is AlreadyYours
	}

	case "only the owner manages members, and the owner stays" {
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let bob = GitHubUser {
			id: 2,
			login: "bob",
		}
		let cy = GitHubUser {
			id: 3,
			login: "cy",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let added <- Organisation("acme").addMember(Person(ann), bob)
		expect added is Done
		let byMember <- Organisation("acme").addMember(Person(bob), cy)
		expect byMember is NotOwner
		let byStranger <- Organisation("acme").setBlocked(Person(cy), true)
		expect byStranger is NotOwner
		let owner <- Organisation("acme").removeMember(Person(ann), 1)
		expect owner is OwnerStays
		let removed <- Organisation("acme").removeMember(Person(ann), 2)
		expect removed is Done
		let seen <- Organisation("acme").view(Person(bob))
		expect seen is None
	}

	case "an operator acts as any organisation's owner" {
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let blocked <- Organisation("acme").setBlocked(Operator, true)
		expect blocked is Done
		let status <- Organisation("acme").status()
		expect status.blocked
	}

	case "a member revokes their own tokens; the owner revokes any" {
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let bob = GitHubUser {
			id: 2,
			login: "bob",
		}
		let cy = GitHubUser {
			id: 3,
			login: "cy",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let _ <- Organisation("acme").addMember(Person(ann), bob)
		let _ <- Organisation("acme").addMember(Person(ann), cy)
		let _ <- Organisation("acme").issue(Person(bob), TokenInfo {
			id: "t1",
			can: ["publish"],
			expiresAt: 10,
			note: "",
			mintedBy: 2,
		})
		let byOther <- Organisation("acme").mayRevoke(Person(cy), "t1")
		expect byOther is NotOwner
		let byMinter <- Organisation("acme").mayRevoke(Person(bob), "t1")
		expect byMinter is Done
		let byOwner <- Organisation("acme").mayRevoke(Person(ann), "t1")
		expect byOwner is Done
		let missing <- Organisation("acme").mayRevoke(Person(ann), "t2")
		expect missing is NoSuchToken
	}

	case "a publish token is checked by organisation, capability, expiry and revocation" {
		let _ <- PublishToken("d1").set(Grant {
			org: "acme",
			can: ["publish"],
			expiresAt: 1000,
			revoked: false,
		})
		let ok <- PublishToken("d1").check("acme", "publish", 500)
		expect ok is Allowed
		let yank <- PublishToken("d1").check("acme", "yank", 500)
		expect yank is CantDo
		let other <- PublishToken("d1").check("globex", "publish", 500)
		expect other is OtherOrg
		let late <- PublishToken("d1").check("acme", "publish", 1000)
		expect late is Lapsed
		let _ <- PublishToken("d1").revoke()
		let revoked <- PublishToken("d1").check("acme", "publish", 500)
		expect revoked is Revoked
		let never <- PublishToken("d2").check("acme", "publish", 500)
		expect never is NotIssued
	}

	case "a session lasts until it lapses or ends" {
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Session("s1").start(ann, 1000)
		let now <- Session("s1").who(500)
		expect now == Some(ann)
		let later <- Session("s1").who(1000)
		expect later == None
		let _ <- Session("s1").end()
		let ended <- Session("s1").who(500)
		expect ended == None
	}

	case "signing in starts GitHub's device flow" {
		stub Secrets.get("GITHUB_CLIENT_ID") returns Some("cid")
		stub Secrets.get(_) returns None
		stub Fetch.send(_) returns Ok(Response { status: 200, headers: Map.empty(), body: "{\"device_code\":\"dc1\",\"user_code\":\"ABCD-1234\",\"verification_uri\":\"https://github.com/login/device\",\"interval\":5,\"expires_in\":900}" })
		let r <- account.POST("/account/login") by Visitor
		expect r is Ok(s) && s.poll == "dc1" && s.userCode == "ABCD-1234" && s.interval == 5
	}

	case "a poll before approval is 400 authorization_pending; a faster one is 429" {
		stub Secrets.get("GITHUB_CLIENT_ID") returns Some("cid")
		stub Secrets.get(_) returns None
		stub Fetch.send(_) returns each [Ok(Response { status: 400, headers: Map.empty(), body: "{\"error\":\"authorization_pending\"}" }), Ok(Response { status: 400, headers: Map.empty(), body: "{\"error\":\"slow_down\",\"interval\":10}" }), Ok(Response { status: 400, headers: Map.empty(), body: "{\"error\":\"expired_token\"}" })]
		let pending <- account.POST("/account/login/poll", PollRequest { poll: "dc1" }) by Visitor
		expect pending is RawError(400, body, _)
			&& body == problem(
				"authorization_pending",
				"approve the code at GitHub, then poll again"
			)
		let slow <- account.POST("/account/login/poll", PollRequest { poll: "dc1" }) by Visitor
		expect slow is RawError(429, _, _)
		let expired <- account.POST("/account/login/poll", PollRequest { poll: "dc1" }) by Visitor
		expect expired is RawError(410, _, _)
	}

	case "an approved poll signs the GitHub user in, and the session claims a name" {
		stub Secrets.get("GITHUB_CLIENT_ID") returns Some("cid")
		stub Secrets.get(_) returns None
		stub Fetch.send(_) returns each [Ok(Response { status: 200, headers: Map.empty(), body: "{\"access_token\":\"gho_x\",\"token_type\":\"bearer\"}" }), Ok(Response { status: 200, headers: Map.empty(), body: "{\"id\":42,\"login\":\"ann\",\"name\":\"Ann\"}" })]
		let r <- account.POST("/account/login/poll", PollRequest { poll: "dc1" }) by Visitor
		match r {
			Ok(session) => {
				expect session.login == "ann" && session.token.startsWith("bynka_")
				let bearer = RequestHeaders.of(["Authorization: Bearer ".concat(session.token)])
				let claimed <- account.POST(
					"/account/orgs/:org",
					"acme",
					ClaimRequest {
						block: false,
						owner: None,
					},
					bearer
				) by Visitor
				expect claimed is Created(c) && c.owner == "ann"
				let reserved <- account.POST(
					"/account/orgs/:org",
					"npm",
					ClaimRequest {
						block: false,
						owner: None,
					},
					bearer
				) by Visitor
				expect reserved is RawError(403, _, _)
			},
			_ => expect false,
		}
	}

	case "the account API needs a session" {
		let r <- account.GET("/account/orgs/:org", "acme", RequestHeaders.empty()) by Visitor
		expect r is RawError(401, _, _)
	}

	case "a minted token publishes, and a revoked one is 401" {
		stub Admit.admit(_, _, _) returns Err(Refusal { code: "invalid_package", message: "probe" })
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let minted <- Accounts.mint(Person(ann), "acme", ["publish"], 30, "ci")
		match minted {
			Ok(m) => {
				let bearer = RequestHeaders.of(["Authorization: Bearer ".concat(m.token)])
				// Admission refuses the probe: the token got past authorisation.
				let used <- api.PUT(
					"/api/:org/:package/:version",
					"acme",
					"money",
					"1.0.0",
					Bytes.fromUtf8("probe"),
					bearer
				) by Visitor
				expect used is RawError(400, _, _)
				let elsewhere <- api.PUT(
					"/api/:org/:package/:version",
					"globex",
					"money",
					"1.0.0",
					Bytes.fromUtf8("probe"),
					bearer
				) by Visitor
				expect elsewhere is RawError(403, _, _)
				let _ <- Accounts.revoke(Person(ann), "acme", m.info.id)
				let after <- api.PUT(
					"/api/:org/:package/:version",
					"acme",
					"money",
					"1.0.0",
					Bytes.fromUtf8("probe"),
					bearer
				) by Visitor
				expect after is RawError(401, body, _)
					&& body == problem("unauthorised", "the token has expired or been revoked")
			},
			Err(_) => expect false,
		}
	}

	case "a blocked organisation refuses every publish" {
		stub Admit.admit(_, _, _) returns Err(Refusal { code: "invalid_package", message: "probe" })
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Organisation("held").claim(ann, true)
		let minted <- Accounts.mint(Person(ann), "held", ["publish"], 30, "")
		match minted {
			Ok(m) => {
				let r <- api.PUT(
					"/api/:org/:package/:version",
					"held",
					"money",
					"1.0.0",
					Bytes.fromUtf8("probe"),
					RequestHeaders.of(["Authorization: Bearer ".concat(m.token)])
				) by Visitor
				expect r is RawError(403, body, _)
					&& body == problem(
						"blocked",
						"`held` is blocked: its name is held, and nothing is published to it"
					)
			},
			Err(_) => expect false,
		}
	}

	case "a token can't be minted for an organisation by a non-member" {
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let bob = GitHubUser {
			id: 2,
			login: "bob",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let minted <- Accounts.mint(Person(bob), "acme", ["publish"], 30, "")
		expect minted is Err(NotMember)
	}
}
