suite registry.store {
	// Trusted publishing (R4): registration with GitHub stubbed, and the
	// exchange through the real handler with the token's claims passed in-process.
	// The real OIDC seam runs against a fake issuer in scripts/check-trusted.sh.

	case "a job_workflow_ref names a workflow in its repository" {
		expect workflowPath(
			"acme/money",
			"acme/money/.github/workflows/release.yml@refs/tags/v1"
		) == Some(".github/workflows/release.yml")
		expect workflowPath(
			"acme/money",
			"acme/other/.github/workflows/release.yml@refs/tags/v1"
		) == None
		expect workflowPath("", "/.github/workflows/release.yml@x") == None
	}

	case "a workflow path is a yml under .github/workflows" {
		expect isWorkflowPath(".github/workflows/release.yml")
		expect isWorkflowPath(".github/workflows/ci.yaml")
		expect !isWorkflowPath(".github/workflows/../secrets.yml")
		expect !isWorkflowPath("release.yml")
		expect !isWorkflowPath(".github/workflows/release.sh")
		expect !isWorkflowPath(".github/workflows/sub/release.yml")
	}

	case "a GitHub name is checked before it goes into a URL" {
		expect isGitHubName("acme")
		expect isGitHubName("money.js")
		expect !isGitHubName("")
		expect !isGitHubName(".")
		expect !isGitHubName("..")
		expect !isGitHubName("a/../b")
		expect !isGitHubName("a/b?x")
	}

	case "only the owner registers, by the repository's id" {
		stub Fetch.send(_) returns Ok(Response { status: 200, headers: Map.empty(), body: "{\"id\":4242,\"full_name\":\"acme/money\"}" })
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let bob = GitHubUser {
			id: 2,
			login: "bob",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let _ <- Organisation("acme").addMember(Person(ann), bob)
		let request = TrustedRequest {
			repository: "acme/money",
			workflow: ".github/workflows/release.yml",
			environment: Some("release"),
			can: ["publish"],
		}
		let byMember <- TrustedPublishing.register(Person(bob), "acme", request)
		expect byMember is NotAllowed(NotOwner)
		let byOwner <- TrustedPublishing.register(Person(ann), "acme", request)
		expect byOwner is Registered(p) && p.repositoryId == "4242"
		let indexed <- TrustedRepository("4242").list()
		expect indexed.length() == 1
	}

	case "a matching token exchanges for a short-lived publish token" {
		stub Fetch.send(_) returns Ok(Response { status: 200, headers: Map.empty(), body: "{\"id\":4242,\"full_name\":\"acme/money\"}" })
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let _ <- TrustedPublishing.register(Person(ann), "acme", TrustedRequest {
			repository: "acme/money",
			workflow: ".github/workflows/release.yml",
			environment: Some("release"),
			can: ["publish"],
		})
		let ok <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release", "ref: refs/tags/v1", "jti: j1"]))
		expect ok is Created(m)
			&& m.token.startsWith("bynk_")
			&& m.info.note == "trusted: acme/money@refs/tags/v1"
		let replayed <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release", "ref: refs/tags/v1", "jti: j1"]))
		expect replayed is RawError(403, _, _)
		let noJti <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release", "ref: refs/tags/v1"]))
		expect noJti is RawError(403, _, _)
		let another <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release", "ref: refs/tags/v1", "jti: j2"]))
		expect another is Created(_)
		let otherWorkflow <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/ci.yml@refs/heads/main", "environment: release"]))
		expect otherWorkflow is RawError(403, _, _)
		let otherRepository <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 9999", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release"]))
		expect otherRepository is RawError(403, _, _)
		let noEnvironment <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:ref:refs/heads/main", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/heads/main"]))
		expect noEnvironment is RawError(403, _, _)
		let otherOrg <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "globex" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release"]))
		expect otherOrg is RawError(403, _, _)
	}

	case "a removed publisher, or a blocked organisation, exchanges nothing" {
		stub Fetch.send(_) returns Ok(Response { status: 200, headers: Map.empty(), body: "{\"id\":4242,\"full_name\":\"acme/money\"}" })
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let registered <- TrustedPublishing.register(Person(ann), "acme", TrustedRequest {
			repository: "acme/money",
			workflow: ".github/workflows/release.yml",
			environment: None,
			can: ["publish"],
		})
		match registered {
			Registered(p) => {
				let _ <- Organisation("acme").setBlocked(Person(ann), true)
				let blocked <- trusted.POST(
					"/account/trusted/exchange",
					ExchangeRequest { org: "acme" }
				) by Workload("repo:acme/money:ref:refs/heads/main", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/heads/main"]))
				expect blocked is RawError(403, body, _)
					&& body == problem(
						"blocked",
						"`acme` is blocked: its name is held, and nothing is published to it"
					)
				let _ <- Organisation("acme").setBlocked(Person(ann), false)
				let bob = GitHubUser {
					id: 2,
					login: "bob",
				}
				let _ <- Organisation("acme").addMember(Person(ann), bob)
				let byMember <- TrustedPublishing.remove(Person(bob), "acme", p.id)
				expect byMember is NotOwner
				let missing <- TrustedPublishing.remove(Person(ann), "acme", "nope")
				expect missing is NoSuchToken
				let removed <- TrustedPublishing.remove(Person(ann), "acme", p.id)
				expect removed is Done
				let after <- trusted.POST(
					"/account/trusted/exchange",
					ExchangeRequest { org: "acme" }
				) by Workload("repo:acme/money:ref:refs/heads/main", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/heads/main"]))
				expect after is RawError(403, _, _)
			},
			_ => expect false,
		}
	}

	case "a publisher bound to the job's environment wins over one that takes any" {
		stub Fetch.send(_) returns Ok(Response { status: 200, headers: Map.empty(), body: "{\"id\":4242,\"full_name\":\"acme/money\"}" })
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let _ <- TrustedPublishing.register(Person(ann), "acme", TrustedRequest {
			repository: "acme/money",
			workflow: ".github/workflows/release.yml",
			environment: None,
			can: ["publish"],
		})
		let specific <- TrustedPublishing.register(Person(ann), "acme", TrustedRequest {
			repository: "acme/money",
			workflow: ".github/workflows/release.yml",
			environment: Some("release"),
			can: ["publish", "yank"],
		})
		let first <- trusted.POST(
			"/account/trusted/exchange",
			ExchangeRequest { org: "acme" }
		) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release", "jti: a"]))
		expect first is Created(m) && m.info.can == ["publish", "yank"]
		match specific {
			Registered(p) => {
				let _ <- TrustedPublishing.remove(Person(ann), "acme", p.id)
				let second <- trusted.POST(
					"/account/trusted/exchange",
					ExchangeRequest { org: "acme" }
				) by Workload("repo:acme/money:environment:release", TokenClaims.of(["repository: acme/money", "repository_id: 4242", "job_workflow_ref: acme/money/.github/workflows/release.yml@refs/tags/v1", "environment: release", "jti: b"]))
				expect second is Created(m) && m.info.can == ["publish"]
			},
			_ => expect false,
		}
	}

	case "lapsed tokens are dropped as new ones are listed" {
		let ann = GitHubUser {
			id: 1,
			login: "ann",
		}
		let _ <- Organisation("acme").claim(ann, false)
		let _ <- Organisation("acme").issue(
			Person(ann),
			TokenInfo {
				id: "old",
				can: ["publish"],
				expiresAt: 100,
				note: "",
				mintedBy: 1,
			},
			50
		)
		let _ <- Organisation("acme").issue(
			Person(ann),
			TokenInfo {
				id: "edge",
				can: ["publish"],
				expiresAt: 200,
				note: "",
				mintedBy: 1,
			},
			50
		)
		let _ <- Organisation("acme").issue(
			Person(ann),
			TokenInfo {
				id: "new",
				can: ["publish"],
				expiresAt: 10000,
				note: "",
				mintedBy: 1,
			},
			200
		)
		let seen <- Organisation("acme").view(Person(ann))
		expect seen is Some(v) && v.tokens.map((t) => t.id) == ["new"]
	}
}
