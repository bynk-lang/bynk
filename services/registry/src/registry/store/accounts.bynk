// Accounts and organisations (first-party registry R3, #2363): people sign in
// with GitHub through the OAuth device flow, claim organisations, add members,
// block names, and mint expiring publish tokens. Everything lives in
// `registry.store`, beside the publish API that reads the tokens.
context registry.store

uses registry.paths
consumes bynk { Secrets, Random, Clock, Fetch }
consumes bynk.crypto { Crypto }

---
A GitHub user, by GitHub's numeric id (stable) and login (for display: a
login can be renamed and reused, an id can't).
---
type GitHubUser = {
	id: Int,
	login: String,
}

---
Who is acting on the account API: a signed-in person, or an operator token
with the `operate` capability, which may act as any organisation's owner.
---
type Principal = | Person(user: GitHubUser)
| Operator

---
A publish token as its organisation lists it. `id` is the token's sha256 (hex):
never the token itself, which is shown once and not kept.
---
type TokenInfo = {
	id: String,
	can: List[String],
	expiresAt: Int,
	note: String,
	mintedBy: Int,
}

---
What a publish token may do, as the publish path checks it: one organisation,
some of `publish`/`yank`, until `expiresAt` (epoch milliseconds), unless revoked.
---
type Grant = {
	org: String,
	can: List[String],
	expiresAt: Int,
	revoked: Bool,
}

---
A publish token checked at publish time.
---
type TokenCheck = enum { Allowed, NotIssued, Lapsed, Revoked, OtherOrg, CantDo }

---
What a claim did.
---
type Claimed = | ClaimedNow
| AlreadyYours(blocked: Bool)
| Taken

---
What a change to an organisation did, or why it was refused.
---
type Changed = enum { Done, NoSuchOrg, NotOwner, NotMember, NoSuchMember, NoSuchToken, OwnerStays }

---
An organisation as its members see it.
---
type OrgView = {
	name: String,
	owner: GitHubUser,
	members: List[GitHubUser],
	blocked: Bool,
	tokens: List[TokenInfo],
	trusted: List[TrustedPublisher],
}

---
An organisation, as the export (R5.2) keeps it.
---
type OrgExport = {
	name: String,
	owner: Option[GitHubUser],
	members: List[GitHubUser],
	blocked: Bool,
	trusted: List[TrustedPublisher],
}

---
What restoring an organisation did: restored it, found it already restored
to that very state, or found the name claimed otherwise.
---
type Restored = enum { RestoredNow, AlreadyRestored, OtherwiseClaimed }

---
Whether an organisation exists and is blocked: what a publish needs to know.
---
type OrgStatus = {
	claimed: Bool,
	blocked: Bool,
	listed: Bool,
}

---
One organisation (track D4): its owner, its members, whether its name is
blocked, and the publish tokens issued for it. Claims are first-come because
this agent decides them one at a time.
---
agent Organisation {
	key name: String

	store owner: Cell[Option[GitHubUser]] = None
	store members: Cell[List[GitHubUser]] = []
	store blocked: Cell[Bool] = false
	store tokens: Cell[List[TokenInfo]] = []
	store trusted: Cell[List[TrustedPublisher]] = []

	---
	Claim the name for `who`, who becomes its owner and first member; `block`
	reserves the name without publishing (claim-blocking).
	---
	on call claim(who: GitHubUser, block: Bool) -> Effect[Claimed] {
		match owner {
			Some(o) => if o.id == who.id { AlreadyYours(blocked) } else { Taken },
			None => {
				owner := Some(who)
				members := [who]
				blocked := block
				ClaimedNow
			},
		}
	}

	---
	The organisation's state, for the export (R5.2): its owner, members, block
	and trusted publishers. Token digests stay out: tokens are short-lived.
	---
	on call snapshot() -> Effect[OrgExport] {
		let o = owner
		let ms = members
		let b = blocked
		let ts = trusted
		OrgExport {
			name: self.name,
			owner: o,
			members: ms,
			blocked: b,
			trusted: ts,
		}
	}

	---
	Restore the organisation from its export (R5a.2): its owner, members, block
	and trusted publishers. Only an unclaimed name is restored, so a restore
	never overwrites; a repeat of the very state is `AlreadyRestored`, so an
	interrupted restore can be finished.
	---
	on call restore(state: OrgExport) -> Effect[Restored] {
		let current = owner
		match current {
			Some(o) => if Some(o) == state.owner
				&& members == state.members
				&& blocked == state.blocked
				&& trusted == state.trusted {
				AlreadyRestored
			} else {
				OtherwiseClaimed
			},
			None => {
				owner := state.owner
				members := state.members
				blocked := state.blocked
				trusted := state.trusted
				RestoredNow
			},
		}
	}

	on call setBlocked(who: Principal, block: Bool) -> Effect[Changed] {
		match ownerCheck(owner, who) {
			Done => {
				blocked := block
				Done
			},
			refused => refused,
		}
	}

	on call addMember(who: Principal, member: GitHubUser) -> Effect[Changed] {
		match ownerCheck(owner, who) {
			Done => {
				let _ <- members.update((ms: List[GitHubUser]) => ms
					.filter((m) => m.id != member.id)
					.append(member))
				Done
			},
			refused => refused,
		}
	}

	on call removeMember(who: Principal, id: Int) -> Effect[Changed] {
		let current = owner
		let present = members
		match ownerCheck(current, who) {
			Done => if current.map((o) => o.id == id).getOrElse(false) {
				OwnerStays
			} else {
				if !present.any((m) => m.id == id) {
					NoSuchMember
				} else {
					let _ <- members.update((ms: List[GitHubUser]) => ms.filter((m) => m.id != id))
					// Their tokens go with them: a token works only while it is
					// listed here, so unlisting them revokes them all at once.
					let _ <- tokens.update((ts: List[TokenInfo]) => ts.filter(
						(t) => t.mintedBy != id
					))
					Done
				}
			},
			refused => refused,
		}
	}

	---
	Record a token a member minted. Its grant is written after this, so a
	failure between the two leaves a listed token that authorises nothing.
	---
	on call issue(who: Principal, info: TokenInfo, now: Int) -> Effect[Changed] {
		match memberCheck(owner, members, who) {
			Done => {
				// #2381 (R4): lapsed tokens are dropped as new ones are listed, so
				// short-lived trusted-publishing tokens don't accumulate.
				let _ <- tokens.update((ts: List[TokenInfo]) => ts
					.filter((t) => t.expiresAt > now)
					.append(info))
				Done
			},
			refused => refused,
		}
	}

	---
	Whether `who` may revoke the token `id`: an owner may revoke any, a member
	the ones they minted. Checked before the grant is revoked.
	---
	on call mayRevoke(who: Principal, id: String) -> Effect[Changed] {
		let current = owner
		let listed = tokens
		match memberCheck(current, members, who) {
			Done => match listed.filter((t) => t.id == id).first() {
				None => NoSuchToken,
				Some(t) => match who {
					Operator => Done,
					Person(u) => if t.mintedBy == u.id
						|| current.map((o) => o.id == u.id).getOrElse(false) {
						Done
					} else {
						NotOwner
					},
				},
			},
			refused => refused,
		}
	}

	---
	Drop a revoked token from the list, after its grant was revoked.
	---
	on call forget(id: String) -> Effect[()] {
		let _ <- tokens.update((ts: List[TokenInfo]) => ts.filter((t) => t.id != id))
		Effect.pure(())
	}

	---
	Register a trusted publisher (R4): owner only. It is listed here before it
	is indexed by repository, so a half-done registration mints nothing.
	---
	on call addTrusted(who: Principal, publisher: TrustedPublisher) -> Effect[Changed] {
		match ownerCheck(owner, who) {
			Done => {
				let _ <- trusted.update((ps: List[TrustedPublisher]) => ps.append(publisher))
				Done
			},
			refused => refused,
		}
	}

	---
	The trusted publisher `id`, for its owner to remove: un-indexed by
	repository first, then dropped here with `forgetTrusted`.
	---
	on call findTrusted(who: Principal, id: String) -> Effect[Result[TrustedPublisher, Changed]] {
		let listed = trusted
		match ownerCheck(owner, who) {
			Done => match listed.filter((p) => p.id == id).first() {
				Some(p) => Ok(p),
				None => Err(NoSuchToken),
			},
			refused => Err(refused),
		}
	}

	on call forgetTrusted(id: String) -> Effect[()] {
		let _ <- trusted.update((ps: List[TrustedPublisher]) => ps.filter((p) => p.id != id))
		Effect.pure(())
	}

	---
	The ids of the trusted publishers still listed: an exchange mints only
	through a listed one.
	---
	on call listedTrusted() -> Effect[List[String]] {
		let listed = trusted
		listed.map((p) => p.id)
	}

	on call view(who: Principal) -> Effect[Option[OrgView]] {
		match memberCheck(owner, members, who) {
			Done => match owner {
				None => None,
				Some(o) => Some(OrgView {
					name: self.name,
					owner: o,
					members: members,
					blocked: blocked,
					tokens: tokens,
					trusted: trusted,
				}),
			},
			_ => None,
		}
	}

	---
	What a publish with the token `token` (its digest; `None` for an operator
	token, which this organisation doesn't list) needs to know: whether the
	name is blocked, and whether the token is still listed. A token works only
	while listed, so removing its minter, or revoking it, ends it.
	---
	on call status(token: Option[String]) -> Effect[OrgStatus] {
		let current = owner
		let listed = tokens
		OrgStatus {
			claimed: current.isSome(),
			blocked: blocked,
			listed: token.map((id) => listed.any((t) => t.id == id)).getOrElse(true),
		}
	}
}

---
Whether `who` owns the organisation (an operator acts as owner).
---
fn ownerCheck(owner: Option[GitHubUser], who: Principal) -> Changed {
	match owner {
		None => NoSuchOrg,
		Some(o) => match who {
			Operator => Done,
			Person(u) => if u.id == o.id { Done } else { NotOwner },
		},
	}
}

---
Whether `who` is a member (an operator acts as owner, so as a member too).
---
fn memberCheck(owner: Option[GitHubUser], members: List[GitHubUser], who: Principal) -> Changed {
	match owner {
		None => NoSuchOrg,
		Some(_) => match who {
			Operator => Done,
			Person(u) => if members.any((m) => m.id == u.id) { Done } else { NotMember },
		},
	}
}

---
One publish token, keyed by the sha256 (hex) of the token: the one lookup a
publish makes to authorise it.
---
agent PublishToken {
	key digest: String

	store grant: Cell[Option[Grant]] = None

	on call set(g: Grant) -> Effect[()] {
		grant := Some(g)
		Effect.pure(())
	}

	---
	Revoke the token. Revoked before its organisation forgets it, so a failure
	in between leaves a dead token still listed, never a live one unlisted.
	---
	on call revoke() -> Effect[()] {
		let _ <- grant.update((current: Option[Grant]) => current.map((g: Grant) => Grant {
			org: g.org,
			can: g.can,
			expiresAt: g.expiresAt,
			revoked: true,
		}))
		Effect.pure(())
	}

	on call check(org: String, can: String, now: Int) -> Effect[TokenCheck] {
		match grant {
			None => NotIssued,
			Some(g) => if g.revoked {
				Revoked
			} else {
				if now >= g.expiresAt {
					Lapsed
				} else {
					if g.org != org {
						OtherOrg
					} else {
						if !g.can.any((c) => c == can) { CantDo } else { Allowed }
					}
				}
			},
		}
	}
}

---
A signed-in session, keyed by the sha256 (hex) of its account token.
---
agent Session {
	key digest: String

	store user: Cell[Option[GitHubUser]] = None
	store expiresAt: Cell[Int] = 0

	on call start(u: GitHubUser, until: Int) -> Effect[()] {
		user := Some(u)
		expiresAt := until
		Effect.pure(())
	}

	on call who(now: Int) -> Effect[Option[GitHubUser]] {
		if now < expiresAt { user } else { None }
	}

	on call end() -> Effect[()] {
		user := None
		expiresAt := 0
		Effect.pure(())
	}
}

---
Who an account request comes from: the session its account token
(`bynka_…`) names, or an operator token with `operate`.
---
capability Accounts {
	fn principal(token: Option[String]) -> Effect[Option[Principal]]
	---
	Mint a session for `user`: the account token, shown once.
	---
	fn signIn(user: GitHubUser) -> Effect[SignedIn]
	fn signOut(token: Option[String]) -> Effect[()]
	---
	Mint a publish token for `org`, as `who`, lasting `millis` milliseconds:
	the token (shown once) and how it is listed, or why it was refused.
	---
	fn mint(
		who: Principal,
		org: String,
		can: List[String],
		millis: Int,
		note: String
	) -> Effect[Result[Minted, Changed]]
	fn revoke(who: Principal, org: String, id: String) -> Effect[Changed]
}

---
A new session: the account token, shown once, and when it lapses.
---
type SignedIn = {
	token: String,
	login: String,
	expiresAt: Int,
}

---
A new publish token: the token, shown once, and how it is listed.
---
type Minted = {
	token: String,
	info: TokenInfo,
}

---
A day, in milliseconds.
---
fn dayMillis() -> Int {
	24 * 60 * 60 * 1000
}

---
A session lasts 30 days.
---
fn sessionMillis() -> Int {
	30 * 24 * 60 * 60 * 1000
}

provides Accounts = AgentAccounts given Secrets, Random, Clock, Crypto {
	fn principal(token: Option[String]) -> Effect[Option[Principal]] {
		match token {
			None => Effect.pure(None),
			Some(t) => {
				let digest <- Crypto.digest(Sha256, Bytes.fromUtf8(t))
				let hex = digest.toHex()
				if t.startsWith("bynka_") {
					let now <- Clock.now()
					let found <- Session(hex).who(now.toEpochMillis())
					Effect.pure(found.map((u) => Person(u)))
				} else {
					let table <- Secrets.get("REGISTRY_TOKENS")
					let entries: List[OperatorToken] = match table {
						Some(text) => match Json.decode[List[OperatorToken]](text) {
							Ok(es) => es,
							Err(_) => [],
						},
						None => [],
					}
					let operate = entries.any((e) => e.sha256 == hex
						&& e.can.any((c) => c == "operate"))
					Effect.pure(if operate { Some(Operator) } else { None })
				}
			},
		}
	}

	fn signIn(user: GitHubUser) -> Effect[SignedIn] {
		let raw <- Random.bytes(32)
		let token = "bynka_".concat(raw.toHex())
		let digest <- Crypto.digest(Sha256, Bytes.fromUtf8(token))
		let now <- Clock.now()
		let until = now.toEpochMillis() + sessionMillis()
		let _ <- Session(digest.toHex()).start(user, until)
		Effect.pure(SignedIn { token: token, login: user.login, expiresAt: until })
	}

	fn signOut(token: Option[String]) -> Effect[()] {
		match token {
			None => Effect.pure(()),
			Some(t) => {
				let digest <- Crypto.digest(Sha256, Bytes.fromUtf8(t))
				Session(digest.toHex()).end()
			},
		}
	}

	fn mint(
		who: Principal,
		org: String,
		can: List[String],
		millis: Int,
		note: String
	) -> Effect[Result[Minted, Changed]] {
		let raw <- Random.bytes(32)
		let token = "bynk_".concat(raw.toHex())
		let digest <- Crypto.digest(Sha256, Bytes.fromUtf8(token))
		let id = digest.toHex()
		let now <- Clock.now()
		let until = now.toEpochMillis() + millis
		let minter = match who {
			Person(u) => u.id,
			Operator => 0,
		}
		let info = TokenInfo {
			id: id,
			can: can,
			expiresAt: until,
			note: note,
			mintedBy: minter,
		}
		let recorded <- Organisation(org).issue(who, info, now.toEpochMillis())
		match recorded {
			Done => {
				let _ <- PublishToken(id).set(Grant {
					org: org,
					can: can,
					expiresAt: until,
					revoked: false,
				})
				Effect.pure(Ok(Minted { token: token, info: info }))
			},
			refused => Effect.pure(Err(refused)),
		}
	}

	fn revoke(who: Principal, org: String, id: String) -> Effect[Changed] {
		let may <- Organisation(org).mayRevoke(who, id)
		match may {
			Done => {
				let _ <- PublishToken(id).revoke()
				let _ <- Organisation(org).forget(id)
				Effect.pure(Done)
			},
			refused => Effect.pure(refused),
		}
	}
}

---
An operator token's entry in `REGISTRY_TOKENS`, as the account API reads it:
only the digest and the capabilities matter here.
---
type OperatorToken = {
	sha256: String,
	can: List[String],
}

---
A device authorisation GitHub started: the code a person enters at
`verificationUri`, how often to poll (seconds), how long it lasts (seconds),
and the opaque `poll` value (GitHub's `device_code`) the client polls with.
---
type DeviceStart = {
	poll: String,
	userCode: String,
	verificationUri: String,
	interval: Int,
	expiresIn: Int,
}

---
One poll of a device authorisation.
---
type PollOutcome = | SignedInAs(user: GitHubUser)
| Pending
| SlowDown(interval: Int)
| Expired
| Denied
| GitHubFailed(why: String)

---
GitHub's answers, as much of them as the registry reads.
---
type DeviceCodeAnswer = {
	device_code: String,
	user_code: String,
	verification_uri: String,
	interval: Int,
	expires_in: Int,
}

type TokenAnswer = {
	access_token: Option[String],
	error: Option[String],
	interval: Option[Int],
}

type UserAnswer = {
	id: Int,
	login: String,
}

---
GitHub's OAuth device flow and user lookups (track §5, R3 decision A). The
registry's OAuth app is public: its `GITHUB_CLIENT_ID` is the only setting it
needs, and no client secret exists. `GITHUB_BASE` and `GITHUB_API_BASE`
default to github.com and api.github.com, and point at a fake in tests.
---
capability GitHub {
	fn start() -> Effect[Result[DeviceStart, String]]
	---
	One request to GitHub's token endpoint. On success the access token is
	used once, to ask who it belongs to, and never kept.
	---
	fn poll(deviceCode: String) -> Effect[PollOutcome]
	fn lookup(login: String) -> Effect[Option[GitHubUser]]
	---
	A repository by `owner/name`: GitHub's numeric id (as a string, as Actions
	tokens carry it) and its canonical name. `None` when there's none.
	---
	fn repository(fullName: String) -> Effect[Option[RepositoryInfo]]
}

---
A GitHub repository: its stable numeric id, as a string, and its name.
---
type RepositoryInfo = {
	id: String,
	fullName: String,
}

type RepositoryAnswer = {
	id: Int,
	full_name: String,
}

provides GitHub = DeviceFlow given Secrets, Fetch {
	fn start() -> Effect[Result[DeviceStart, String]] {
		let clientId <- Secrets.get("GITHUB_CLIENT_ID")
		let base <- Secrets.get("GITHUB_BASE")
		match clientId {
			None => Effect.pure(Err("GITHUB_CLIENT_ID isn't set")),
			Some(id) => {
				let sent <- Fetch.send(Request {
					method: Post,
					url: base.getOrElse("https://github.com").concat("/login/device/code"),
					contentType: Some("application/x-www-form-urlencoded"),
					authorization: None,
					headers: githubHeaders("application/json"),
					body: Some("client_id=".concat(id)),
				})
				match sent {
					Err(_) => Effect.pure(Err("GitHub couldn't be reached")),
					Ok(r) => if r.status != 200 {
						Effect.pure(Err("GitHub refused to start a sign-in (\(r.status))"))
					} else {
						match Json.decode[DeviceCodeAnswer](r.body) {
							Err(_) => Effect.pure(Err("GitHub's answer couldn't be read")),
							Ok(a) => Effect.pure(Ok(DeviceStart {
								poll: a.device_code,
								userCode: a.user_code,
								verificationUri: a.verification_uri,
								interval: a.interval,
								expiresIn: a.expires_in,
							})),
						}
					},
				}
			},
		}
	}

	fn poll(deviceCode: String) -> Effect[PollOutcome] {
		let clientId <- Secrets.get("GITHUB_CLIENT_ID")
		let base <- Secrets.get("GITHUB_BASE")
		let api <- Secrets.get("GITHUB_API_BASE")
		match clientId {
			None => Effect.pure(GitHubFailed("GITHUB_CLIENT_ID isn't set")),
			Some(id) => if !isFormSafe(deviceCode) {
				Effect.pure(Expired)
			} else {
				let sent <- Fetch.send(Request {
					method: Post,
					url: base.getOrElse("https://github.com").concat("/login/oauth/access_token"),
					contentType: Some("application/x-www-form-urlencoded"),
					authorization: None,
					headers: githubHeaders("application/json"),
					body: Some("client_id="
						.concat(id)
						.concat("&device_code=")
						.concat(deviceCode)
						.concat(
							"&grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code"
						)),
				})
				match sent {
					Err(_) => Effect.pure(GitHubFailed("GitHub couldn't be reached")),
					Ok(r) => match Json.decode[TokenAnswer](r.body) {
						Err(_) => Effect.pure(GitHubFailed("GitHub's answer couldn't be read")),
						Ok(a) => match a.access_token {
							Some(token) => {
								let who <- Fetch.send(Request {
									method: Get,
									url: api.getOrElse("https://api.github.com").concat("/user"),
									contentType: None,
									authorization: Some("Bearer ".concat(token)),
									headers: githubHeaders("application/vnd.github+json"),
									body: None,
								})
								Effect.pure(match who {
									Err(_) => GitHubFailed("GitHub couldn't be reached"),
									Ok(u) => if u.status != 200 {
										GitHubFailed(
											"GitHub wouldn't say who signed in (\(u.status))"
										)
									} else {
										match Json.decode[UserAnswer](u.body) {
											Ok(user) => SignedInAs(GitHubUser {
												id: user.id,
												login: user.login,
											}),
											Err(_) => GitHubFailed(
												"GitHub's answer couldn't be read"
											),
										}
									},
								})
							},
							None => Effect.pure(match a.error.getOrElse("") {
								"authorization_pending" => Pending,
								"slow_down" => SlowDown(a.interval.getOrElse(10)),
								"expired_token" => Expired,
								"access_denied" => Denied,
								other => GitHubFailed("GitHub refused the sign-in (\(other))"),
							}),
						},
					},
				}
			},
		}
	}

	fn lookup(login: String) -> Effect[Option[GitHubUser]] {
		let api <- Secrets.get("GITHUB_API_BASE")
		let token <- Secrets.get("GITHUB_API_TOKEN")
		if !isGitHubLogin(login) {
			Effect.pure(None)
		} else {
			let sent <- Fetch.send(Request {
				method: Get,
				url: api.getOrElse("https://api.github.com").concat("/users/").concat(login),
				contentType: None,
				authorization: token.map((t) => "Bearer ".concat(t)),
				headers: githubHeaders("application/vnd.github+json"),
				body: None,
			})
			Effect.pure(match sent {
				Ok(r) => if r.status != 200 {
					None
				} else {
					match Json.decode[UserAnswer](r.body) {
						Ok(user) => Some(GitHubUser { id: user.id, login: user.login }),
						Err(_) => None,
					}
				},
				Err(_) => None,
			})
		}
	}

	fn repository(fullName: String) -> Effect[Option[RepositoryInfo]] {
		let api <- Secrets.get("GITHUB_API_BASE")
		let token <- Secrets.get("GITHUB_API_TOKEN")
		let parts = fullName.split("/")
		if parts.length() != 2 || !parts.all((p) => isGitHubName(p)) {
			Effect.pure(None)
		} else {
			let sent <- Fetch.send(Request {
				method: Get,
				url: api.getOrElse("https://api.github.com").concat("/repos/").concat(fullName),
				contentType: None,
				authorization: token.map((t) => "Bearer ".concat(t)),
				headers: githubHeaders("application/vnd.github+json"),
				body: None,
			})
			Effect.pure(match sent {
				Ok(r) => if r.status != 200 {
					None
				} else {
					match Json.decode[RepositoryAnswer](r.body) {
						Ok(repo) => Some(RepositoryInfo {
							id: repo.id.toString(),
							fullName: repo.full_name,
						}),
						Err(_) => None,
					}
				},
				Err(_) => None,
			})
		}
	}
}

---
The headers every GitHub request carries: what it accepts, and the
`User-Agent` GitHub's API requires.
---
fn githubHeaders(accept: String) -> Map[String, String] {
	let none: Map[String, String] = Map.empty()
	none.insert("accept", accept).insert("user-agent", "bynk-registry")
}

---
A GitHub login: letters, digits and single hyphens, at most 39 characters.
Checked before it goes into a URL.
---
fn isGitHubLogin(s: String) -> Bool {
	s != ""
		&& s.length() <= 39
		&& s
			.chars()
			.all((c) => "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-".contains(
				c
			))
}

---
A GitHub owner or repository name: letters, digits, `-`, `_` and `.`, at most
100 characters, and not `.` or `..`. Checked before it goes into a URL.
---
fn isGitHubName(s: String) -> Bool {
	s != ""
		&& s != "."
		&& s != ".."
		&& s.length() <= 100
		&& s
			.chars()
			.all(
				(c) => "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.".contains(
					c
				)
			)
}

---
A value safe to put in a form body unescaped: GitHub's device codes are
hexadecimal, and anything else is refused rather than escaped.
---
fn isFormSafe(s: String) -> Bool {
	s != ""
		&& s.length() <= 100
		&& s
			.chars()
			.all((c) => "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_".contains(
				c
			))
}

---
A poll of a sign-in: the `poll` value `POST /account/login` returned.
---
type PollRequest = {
	poll: String,
}

---
A claim: `block` reserves the name without publishing. An operator claims for
someone else by naming their GitHub `owner` login.
---
type ClaimRequest = {
	block: Bool,
	owner: Option[String],
}

type BlockRequest = {
	blocked: Bool,
}

---
A publish token to mint: what it may do (`publish`, `yank`), for how many days
(1 to 365), and a note to recognise it by.
---
type TokenRequest = {
	can: List[String],
	days: Int,
	note: String,
}

---
An organisation after a claim.
---
type ClaimAnswer = {
	org: String,
	owner: String,
	blocked: Bool,
}

---
An acknowledgement, `{"ok": true}`.
---
type Acknowledged = {
	ok: Bool,
}

---
The account API (R3, #2363): signing in with GitHub, organisations, members
and publish tokens. Every answer is JSON; every refusal is the protocol's
`{"error", "message"}`. A request names its session with an account token
(`Authorization: Bearer bynka_…`), or an operator token with `operate`.
---
service account from http {
	---
	Start signing in: open `verificationUri`, enter `userCode`, then poll.
	---
	on POST("/account/login") (
		headers: RequestHeaders
	) -> Effect[HttpResult[DeviceStart]] by v: Visitor given Limits, GitHub {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[DeviceStart]()
		} else {
			let started <- GitHub.start()
			match started {
				Ok(s) => Ok(s),
				Err(why) => RawError(BadGateway, problem("github", why), "application/json"),
			}
		}
	}

	---
	One poll (RFC 8628's shape): `400 authorization_pending` until the person
	approves, `429 slow_down` to poll less often, `410 expired_token`, `403
	access_denied`; then the account token.
	---
	on POST("/account/login/poll") (
		body: PollRequest,
		headers: RequestHeaders
	) -> Effect[HttpResult[SignedIn]] by v: Visitor given Limits, GitHub, Accounts {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[SignedIn]()
		} else {
			let polled <- GitHub.poll(body.poll)
			match polled {
				SignedInAs(user) => {
					let session <- Accounts.signIn(user)
					Ok(session)
				},
				Pending => RawError(
					BadRequest,
					problem("authorization_pending", "approve the code at GitHub, then poll again"),
					"application/json"
				),
				SlowDown(n) => RawError(
					TooManyRequests,
					problem("slow_down", "poll at most every \(n) seconds"),
					"application/json"
				),
				Expired => RawError(
					Gone,
					problem("expired_token", "the code expired; start signing in again"),
					"application/json"
				),
				Denied => RawError(
					Forbidden,
					problem("access_denied", "the sign-in was declined at GitHub"),
					"application/json"
				),
				GitHubFailed(why) => RawError(
					BadGateway,
					problem("github", why),
					"application/json"
				),
			}
		}
	}

	on DELETE("/account/session") (
		headers: RequestHeaders
	) -> Effect[HttpResult[()]] by v: Visitor given Limits, Accounts {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[()]()
		} else {
			let _ <- Accounts.signOut(headers.bearer())
			NoContent
		}
	}

	---
	Claim an organisation, first come: the claimant becomes its owner. A
	reserved name is refused unless an operator claims it for someone.
	---
	on POST("/account/orgs/:org") (
		org: String,
		body: ClaimRequest,
		headers: RequestHeaders
	) -> Effect[HttpResult[ClaimAnswer]] by v: Visitor given Limits, Accounts, Claimants {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[ClaimAnswer]()
		} else {
			let who <- Accounts.principal(headers.bearer())
			match who {
				None => signInFirst[ClaimAnswer](),
				Some(p) => if !isOrg(org) {
					noSuchOrg[ClaimAnswer](org)
				} else {
					let claimant <- Claimants.claimantOf(p, body.owner)
					match claimant {
						None => RawError(
							BadRequest,
							problem(
								"bad_request",
								"an operator claims for someone: name their GitHub `owner`"
							),
							"application/json"
						),
						Some(user) => if isReserved(org) && p != Operator {
							RawError(
								Forbidden,
								problem(
									"reserved",
									"`\(org)` is reserved; ask the registry's operators"
								),
								"application/json"
							)
						} else {
							let claimed <- Organisation(org).claim(user, body.block)
							// The export finds organisations through the directory (R5.2);
							// a refused claim adds nothing.
							match claimed {
								ClaimedNow => {
									let _ <- Directory(organisations()).add(org)
									Created(ClaimAnswer {
										org: org,
										owner: user.login,
										blocked: body.block,
									})
								},
								AlreadyYours(held) => {
									let _ <- Directory(organisations()).add(org)
									Ok(ClaimAnswer { org: org, owner: user.login, blocked: held })
								},
								Taken => RawError(
									Conflict,
									problem("taken", "`\(org)` is already claimed"),
									"application/json"
								),
							}
						},
					}
				},
			}
		}
	}

	on GET("/account/orgs/:org") (
		org: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[OrgView]] by v: Visitor given Limits, Accounts {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[OrgView]()
		} else {
			let who <- Accounts.principal(headers.bearer())
			match who {
				None => signInFirst[OrgView](),
				Some(p) => {
					let seen <- Organisation(org).view(p)
					match seen {
						Some(view) => Ok(view),
						None => noSuchOrg[OrgView](org),
					}
				},
			}
		}
	}

	on PUT("/account/orgs/:org/blocked") (
		org: String,
		body: BlockRequest,
		headers: RequestHeaders
	) -> Effect[HttpResult[Acknowledged]] by v: Visitor given Limits, Accounts {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[Acknowledged]()
		} else {
			let who <- Accounts.principal(headers.bearer())
			match who {
				None => signInFirst[Acknowledged](),
				Some(p) => {
					let changed <- Organisation(org).setBlocked(p, body.blocked)
					changedAnswer(changed, org)
				},
			}
		}
	}

	---
	Add a member by GitHub login; they are stored by GitHub's numeric id.
	---
	on PUT("/account/orgs/:org/members/:login") (
		org: String,
		login: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[Acknowledged]] by v: Visitor given Limits, Accounts, GitHub {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[Acknowledged]()
		} else {
			let who <- Accounts.principal(headers.bearer())
			match who {
				None => signInFirst[Acknowledged](),
				Some(p) => {
					let found <- GitHub.lookup(login)
					match found {
						None => RawError(
							NotFound,
							problem("not_found", "GitHub has no user `\(login)`"),
							"application/json"
						),
						Some(member) => {
							let changed <- Organisation(org).addMember(p, member)
							changedAnswer(changed, org)
						},
					}
				},
			}
		}
	}

	on DELETE("/account/orgs/:org/members/:id") (
		org: String,
		id: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[Acknowledged]] by v: Visitor given Limits, Accounts {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[Acknowledged]()
		} else {
			let who <- Accounts.principal(headers.bearer())
			match who {
				None => signInFirst[Acknowledged](),
				Some(p) => match Int.parse(id) {
					None => RawError(
						NotFound,
						problem("not_found", "a member is named by their GitHub id"),
						"application/json"
					),
					Some(n) => {
						let changed <- Organisation(org).removeMember(p, n)
						changedAnswer(changed, org)
					},
				},
			}
		}
	}

	---
	Mint a publish token for the organisation: shown once, in the answer.
	---
	on POST("/account/orgs/:org/tokens") (
		org: String,
		body: TokenRequest,
		headers: RequestHeaders
	) -> Effect[HttpResult[Minted]] by v: Visitor given Limits, Accounts {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[Minted]()
		} else {
			let who <- Accounts.principal(headers.bearer())
			match who {
				None => signInFirst[Minted](),
				Some(p) => if body.can == []
					|| !body.can.all((c) => c == "publish" || c == "yank") {
					RawError(
						BadRequest,
						problem("bad_request", "`can` is some of `publish` and `yank`"),
						"application/json"
					)
				} else {
					if body.days < 1 || body.days > 365 {
						RawError(
							BadRequest,
							problem("bad_request", "a token lasts 1 to 365 days"),
							"application/json"
						)
					} else {
						let minted <- Accounts.mint(
							p,
							org,
							body.can.distinct(),
							body.days * dayMillis(),
							body.note
						)
						match minted {
							Ok(m) => Created(m),
							Err(c) => refusedChange[Minted](c, org),
						}
					}
				},
			}
		}
	}

	on DELETE("/account/orgs/:org/tokens/:id") (
		org: String,
		id: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[Acknowledged]] by v: Visitor given Limits, Accounts {
		let allowed <- Limits.account(headers.clientIp())
		if !allowed {
			rateLimited[Acknowledged]()
		} else {
			let who <- Accounts.principal(headers.bearer())
			match who {
				None => signInFirst[Acknowledged](),
				Some(p) => {
					let changed <- Accounts.revoke(p, org, id)
					changedAnswer(changed, org)
				},
			}
		}
	}

	// The router's own refusals, in the protocol's shape.
	on rejected(why: BoundaryRejection) -> Effect[HttpResult[()]] {
		match why {
			MethodNotAllowed => RawError(
				MethodNotAllowed,
				problem("method_not_allowed", "this endpoint doesn't take that method"),
				"application/json"
			),
			PayloadTooLarge(_) => RawError(
				PayloadTooLarge,
				problem("too_large", "the request body is too large"),
				"application/json"
			),
			Unauthorized => RawError(
				Unauthorized,
				problem("unauthorised", "sign in first"),
				"application/json"
			),
			_ => RawError(
				BadRequest,
				problem("bad_request", "the request couldn't be read"),
				"application/json"
			),
		}
	}
}

---
Who an organisation is claimed for: the signed-in person, or, for an
operator, the GitHub user it names.
---
capability Claimants {
	fn claimantOf(who: Principal, owner: Option[String]) -> Effect[Option[GitHubUser]]
}

provides Claimants = GitHubClaimants given GitHub {
	fn claimantOf(who: Principal, owner: Option[String]) -> Effect[Option[GitHubUser]] {
		match who {
			Person(u) => Effect.pure(Some(u)),
			Operator => match owner {
				None => Effect.pure(None),
				Some(login) => GitHub.lookup(login),
			},
		}
	}
}

fn signInFirst[T]() -> HttpResult[T] {
	RawError(
		Unauthorized,
		problem("unauthorised", "sign in first: POST /account/login"),
		"application/json"
	)
}

fn noSuchOrg[T](org: String) -> HttpResult[T] {
	RawError(
		NotFound,
		problem("not_found", "no organisation `\(org)` you can see"),
		"application/json"
	)
}

---
A refused change, with the status its reason has. A non-member is told the
organisation isn't there, so membership isn't revealed.
---
fn refusedChange[T](c: Changed, org: String) -> HttpResult[T] {
	match c {
		NotOwner => RawError(
			Forbidden,
			problem("forbidden", "only the owner of `\(org)` can do that"),
			"application/json"
		),
		NoSuchMember => RawError(
			NotFound,
			problem("not_found", "`\(org)` has no such member"),
			"application/json"
		),
		NoSuchToken => RawError(
			NotFound,
			problem("not_found", "`\(org)` has no such token"),
			"application/json"
		),
		OwnerStays => RawError(
			Conflict,
			problem("owner_stays", "the owner can't be removed from `\(org)`"),
			"application/json"
		),
		_ => noSuchOrg[T](org),
	}
}

fn changedAnswer(c: Changed, org: String) -> HttpResult[Acknowledged] {
	match c {
		Done => Ok(Acknowledged { ok: true }),
		_ => refusedChange[Acknowledged](c, org),
	}
}
