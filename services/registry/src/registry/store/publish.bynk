// The publish API (first-party registry R2, #2336): `PUT /api/<org>/<package>/
// <version>` with an archive body, and `POST …/yank|unyank`, as the protocol's
// "Publish API" specifies and the reference server (`bynk registry serve`)
// answers. Every write to the bucket happens in this context (R1's ownership
// rule); one `PackageIndex` agent per package is the only writer of its lines.
context registry.store

uses registry.paths
consumes bynk { Secrets }
consumes bynk.crypto { Crypto }
consumes registry.admission { Admit }

---
One package's index: its lines, in publish order. The single writer (track
D2): appends to one package are serialised here, so two publishes of one
version can't both land. A package seeded before the agent existed is adopted
from its index file on the first call.
---
agent PackageIndex {
	key name: String

	store lines: Cell[List[Line]] = []
	store adopted: Cell[Bool] = false

	---
	Append `line`, unless its version is already here: the same tree is a
	retry (D10) and answers the existing line; another tree is refused. The
	index file is rewritten here, inside the call, so writes land in the order
	the appends were decided.
	---
	on call append(line: Line) -> Effect[Appended] given IndexFiles {
		let known <- IndexFiles.known(self.name, adopted, lines)
		match known {
			Err(why) => Unreadable(why),
			Ok(current) => {
				adopted := true
				match current.filter((l) => l.version == line.version).first() {
					Some(old) => {
						lines := current
						if old.withdrawn.isSome() {
							// A takedown is final: not even a retry of the very tree
							// restores it.
							Withdrawn
						} else {
							if old.checksum == line.checksum {
								// Rewriting repairs a projection a failed write left behind.
								let _ <- IndexFiles.write(self.name, current)
								Retry(old)
							} else {
								Exists
							}
						}
					},
					None => {
						let next = current.append(line)
						lines := next
						let _ <- IndexFiles.write(self.name, next)
						Fresh(line)
					},
				}
			},
		}
	}

	---
	The package's lines, for the export (R5.2): what this agent holds, or its
	index file when it has never been called.
	---
	on call snapshot() -> Effect[Result[List[Line], String]] given IndexFiles {
		IndexFiles.known(self.name, adopted, lines)
	}

	---
	What appending `version` with `checksum` would do, without doing it: the
	publish route asks before it stores the archive (R5.1), so an upload the
	index refuses never reaches the bucket. `append` stays the authority.
	---
	on call outlook(version: String, checksum: String) -> Effect[Outlook] given IndexFiles {
		let known <- IndexFiles.known(self.name, adopted, lines)
		match known {
			Err(why) => OutlookUnreadable(why),
			Ok(current) => match current.filter((l) => l.version == version).first() {
				None => Appendable,
				Some(old) => if old.withdrawn.isSome() {
					WasWithdrawn
				} else {
					if old.checksum == checksum { Appendable } else { OtherTree }
				},
			},
		}
	}

	---
	Whether `version` is here with `checksum`: a retry of a publish (D10).
	---
	on call holds(version: String, checksum: String) -> Effect[Bool] {
		let current = lines
		current.any((l) => l.version == version && l.checksum == checksum)
	}

	---
	Set `version`'s `yanked` flag, and rewrite the index file. Nothing is
	re-signed: a line's signature doesn't cover `yanked`.
	---
	on call setYanked(version: String, yanked: Bool) -> Effect[YankResult] given IndexFiles {
		let known <- IndexFiles.known(self.name, adopted, lines)
		match known {
			Err(why) => IndexUnreadable(why),
			Ok(current) => {
				adopted := true
				lines := current
				if !yanked && current.any((l) => l.version == version && l.withdrawn.isSome()) {
					// Un-yanking would advertise a version whose archive is gone.
					WithdrawnFinal
				} else {
					if current.any((l) => l.version == version) {
						let next = current.map((l) => if l.version == version {
							withYanked(l, yanked)
						} else {
							l
						})
						lines := next
						let _ <- IndexFiles.write(self.name, next)
						Changed
					} else {
						NoSuchVersion
					}
				}
			},
		}
	}

	---
	The takedown (R5a.2, #2397): set `version`'s `yanked` and its `withdrawn`
	`reason`, and rewrite the index file. Nothing is re-signed: a line's
	signature covers neither. A version already withdrawn keeps its first
	reason. `shared` says another live version here names the same tree, so its
	archive must stay.
	---
	on call withdraw(version: String, reason: String) -> Effect[Withdrawal] given IndexFiles {
		let known <- IndexFiles.known(self.name, adopted, lines)
		match known {
			Err(why) => WithdrawUnreadable(why),
			Ok(current) => {
				adopted := true
				lines := current
				match current.filter((l) => l.version == version).first() {
					None => NotHere,
					Some(old) => {
						let shared = current.any((l) => l.version != version
							&& l.checksum == old.checksum
							&& !l.withdrawn.isSome())
						if old.withdrawn.isSome() {
							AlreadyWithdrawn(old, shared)
						} else {
							let down = withdrawnLine(old, reason)
							let next = current.map((l) => if l.version == version {
								down
							} else {
								l
							})
							lines := next
							let _ <- IndexFiles.write(self.name, next)
							WithdrawnNow(down, shared)
						}
					},
				}
			},
		}
	}
}

---
What withdrawing a version did to the index: withdrew it now, found it
already withdrawn (each with whether another live version shares its tree),
found no such version, or couldn't read the index.
---
type Withdrawal = | WithdrawnNow(line: Line, shared: Bool)
| AlreadyWithdrawn(line: Line, shared: Bool)
| NotHere
| WithdrawUnreadable(why: String)

---
What appending a line did.
---
type Appended = | Fresh(line: Line)
| Retry(line: Line)
| Exists
| Withdrawn
| Unreadable(why: String)

---
What appending a version would do: go ahead (a new version, or a retry of
the same tree), refuse another tree, or refuse a withdrawn version.
---
type Outlook = | Appendable
| OtherTree
| WasWithdrawn
| OutlookUnreadable(why: String)

---
`409 version_exists`: another tree under a published version.
---
fn versionExists(name: String, version: String) -> HttpResult[Line] {
	RawError(
		Conflict,
		problem(
			"version_exists",
			"`\(name)` \(version) is already in the registry with a different tree — its index is append-only; bump `version`"
		),
		"application/json"
	)
}

---
`410 withdrawn`: a withdrawn version, which never comes back.
---
fn withdrawnVersion(name: String, version: String) -> HttpResult[Line] {
	RawError(
		Gone,
		problem(
			"withdrawn",
			"`\(name)` \(version) was withdrawn from the registry and can't be published again; bump `version`"
		),
		"application/json"
	)
}

---
What yanking or unyanking a version did.
---
type YankResult = | Changed
| NoSuchVersion
| WithdrawnFinal
| IndexUnreadable(why: String)

---
Why a request's token can't do what it asks.
---
type Denied = | NoToken
| UnknownToken
| WrongOrganisation(org: String)
| CannotDo(can: String)
| BadTable(why: String)
| Dead
| Blocked(org: String)

---
One operator-issued publish token (track decision D): the sha256 of the
token, the organisations it may act for, and what it may do (`publish`,
`yank`). The table is the `REGISTRY_TOKENS` secret, a JSON list of these.
---
type TokenEntry = {
	sha256: String,
	organisations: List[String],
	can: List[String],
}

---
Who may publish or yank: an operator token from the `REGISTRY_TOKENS` table,
or a publish token an organisation member minted (R3), and never into a
blocked organisation.
---
capability Tokens {
	fn check(token: Option[String], org: String, can: String) -> Effect[Option[Denied]]
}

---
An account-minted publish token's verdict (R3): unknown, lapsed, revoked,
another organisation or capability, or allowed (`None`).
---
capability PublishTokens {
	fn decide(
		digest: String,
		org: String,
		can: String,
		table: Result[List[TokenEntry], String]
	) -> Effect[Option[Denied]]
}

provides PublishTokens = AgentPublishTokens given Clock {
	fn decide(
		digest: String,
		org: String,
		can: String,
		table: Result[List[TokenEntry], String]
	) -> Effect[Option[Denied]] {
		let now <- Clock.now()
		let checked <- PublishToken(digest).check(org, can, now.toEpochMillis())
		Effect.pure(match checked {
			Allowed => None,
			Lapsed => Some(Dead),
			Revoked => Some(Dead),
			OtherOrg => Some(WrongOrganisation(org)),
			CantDo => Some(CannotDo(can)),
			NotIssued => match table {
				Err(why) => Some(BadTable(why)),
				Ok(_) => Some(UnknownToken),
			},
		})
	}
}

provides Tokens = SecretTokens given Secrets, Crypto, PublishTokens {
	fn check(token: Option[String], org: String, can: String) -> Effect[Option[Denied]] {
		match token {
			None => Effect.pure(Some(NoToken)),
			Some(t) => {
				let table <- Secrets.get("REGISTRY_TOKENS")
				// No table is no operator tokens; a table that can't be read is the
				// operator's misconfiguration, not the publisher's mistake.
				let parsed: Result[List[TokenEntry], String] = match table {
					Some(text) => match Json.decode[List[TokenEntry]](text) {
						Ok(es) => Ok(es),
						Err(_) => Err("REGISTRY_TOKENS isn't a JSON list of tokens"),
					},
					None => Ok([]),
				}
				let digest <- Crypto.digest(Sha256, Bytes.fromUtf8(t))
				let hex = digest.toHex()
				let entries: List[TokenEntry] = match parsed {
					Ok(es) => es,
					Err(_) => [],
				}
				// The table holds digests, never tokens, so this compares a
				// digest of the presented token: equal digests mean equal tokens.
				// A table that can't be read is the operator's misconfiguration,
				// not the publisher's mistake.
				// The token is authenticated first, so an unknown one is `401`
				// whatever the organisation; only then does a block apply.
				let decided: Option[Denied] = match entries.filter((e) => e.sha256 == hex).first() {
					Some(entry) => if !entry.organisations.any((o) => o == org) {
						Some(WrongOrganisation(org))
					} else {
						if !entry.can.any((c) => c == can) { Some(CannotDo(can)) } else { None }
					},
					None => Some(UnknownToken),
				}
				let operator = !decided.isSome()
				let accountDecision <- if operator || decided != Some(UnknownToken) {
					Effect.pure(decided)
				} else {
					PublishTokens.decide(hex, org, can, parsed)
				}
				match accountDecision {
					Some(d) => Effect.pure(Some(d)),
					None => {
						let status <- Organisation(org).status(if operator {
							None
						} else {
							Some(hex)
						})
						Effect.pure(if status.blocked {
							Some(Blocked(org))
						} else {
							if status.listed { None } else { Some(Dead) }
						})
					},
				}
			},
		}
	}
}

---
Signs index lines with the online delegate (track D5, decision E). The key
is the `REGISTRY_SIGNING_KEY` secret (PKCS#8, base64) and its public half
`REGISTRY_SIGNING_PUBLIC` (`ed25519:<base64>`). Before each signature the key
is checked against the bucket's `config.json`: a delegation from the newest
chain key names it, verified, no revocation names it, and a signature made
with it verifies. A key that fails is never used, so the service can't publish
lines no client accepts.
---
capability Signing {
	fn sign(line: Line) -> Effect[Result[Line, String]]
}

---
The signing step itself: check the delegate `key` against what `config.json`
says about it (`s`), then sign `line` with it (the PKCS#8 `pkcs8`) and verify
the signature.
---
capability Delegate {
	fn signChecked(
		pkcs8: String,
		key: String,
		s: Signer,
		line: Line
	) -> Effect[Result[Line, String]]
}

provides Delegate = CheckedDelegate given Crypto, Admit {
	fn signChecked(
		pkcs8: String,
		key: String,
		s: Signer,
		line: Line
	) -> Effect[Result[Line, String]] {
		let refused = Err("the signing key \(key) isn't a valid, unrevoked delegate in config.json")
		match keyBytes(s.chainKey) {
			None => Effect.pure(refused),
			Some(chain) => match s.delegationSig.andThen((t) => Bytes.fromBase64(t)) {
				None => Effect.pure(refused),
				Some(delegation) => {
					let chainKey <- Crypto.importVerifyKey(Ed25519, chain)
					match chainKey {
						Err(_) => Effect.pure(refused),
						Ok(vk) => {
							let vouched <- Crypto.verify(vk, s.delegationPayload, delegation)
							if !vouched || !s.delegated || s.revoked {
								Effect.pure(refused)
							} else {
								match Bytes.fromBase64(pkcs8) {
									None => Effect.pure(Err("REGISTRY_SIGNING_KEY isn't base64")),
									Some(der) => {
										let imported <- Crypto.importSigningKey(
											Ed25519,
											pkcs8v1(der)
										)
										match imported {
											Err(_) => Effect.pure(Err("REGISTRY_SIGNING_KEY isn't an Ed25519 PKCS#8 key")),
											Ok(signing) => {
												let payload <- Admit.payload(line, s.id)
												let sig <- Crypto.sign(signing, payload)
												match keyBytes(key) {
													None => Effect.pure(refused),
													Some(own) => {
														let ownKey <- Crypto.importVerifyKey(
															Ed25519,
															own
														)
														match ownKey {
															Err(_) => Effect.pure(refused),
															Ok(check) => {
																let good <- Crypto.verify(
																	check,
																	payload,
																	sig
																)
																if good {
																	Effect.pure(Ok(withSig(
																		line,
																		sig.toBase64()
																	)))
																} else {
																	Effect.pure(Err("REGISTRY_SIGNING_KEY isn't the private half of REGISTRY_SIGNING_PUBLIC"))
																}
															},
														}
													},
												}
											},
										}
									},
								}
							}
						},
					}
				},
			},
		}
	}
}

provides Signing = DelegateSigner given Secrets, Admit, Store, Delegate {
	fn sign(line: Line) -> Effect[Result[Line, String]] {
		let secret <- Secrets.get("REGISTRY_SIGNING_KEY")
		let public <- Secrets.get("REGISTRY_SIGNING_PUBLIC")
		let configBytes <- Store.get(configKey())
		let config = configBytes.andThen((b) => b.decodeUtf8())
		match secret {
			None => Effect.pure(Err("the signing key (REGISTRY_SIGNING_KEY) isn't set")),
			Some(pkcs8) => match public {
				None => Effect.pure(Err("the signing key's public half (REGISTRY_SIGNING_PUBLIC) isn't set")),
				Some(key) => match config {
					None => Effect.pure(Err("the bucket has no readable config.json")),
					Some(text) => {
						let info <- Admit.signer(text, key)
						match info {
							Err(r) => Effect.pure(Err("config.json couldn't be read: \(r.message)")),
							Ok(s) => Delegate.signChecked(pkcs8, key, s, line),
						}
					},
				},
			},
		}
	}
}

---
The raw bytes of an `ed25519:<base64>` key, `None` for anything else.
---
fn keyBytes(key: String) -> Option[Bytes] {
	if key.startsWith("ed25519:") { Bytes.fromBase64(key.slice(8, key.length())) } else { None }
}

---
An Ed25519 PKCS#8 document as version 1. `bynk registry` writes version 2
(ring's form, which carries the public key too), and Web Crypto takes only
version 1; both hold the same 32-byte seed at the same offset. Any other
document is passed through for the import to judge.
---
fn pkcs8v1(der: Bytes) -> Bytes {
	// After the outer SEQUENCE header: version 1 (`v2`), the Ed25519 OID, and
	// the seed's OCTET STRING header.
	let v2 = Bytes.fromHex("020101300506032b657004220420").getOrElse(Bytes.empty())
	let v1 = Bytes.fromHex("302e020100300506032b657004220420").getOrElse(Bytes.empty())
	if der.length() > 48 && der.slice(2, 16) == v2 { v1.concat(der.slice(16, 48)) } else { der }
}

---
`line` with its `yanked` flag set.
---
fn withYanked(l: Line, yanked: Bool) -> Line {
	Line {
		name: l.name,
		version: l.version,
		checksum: l.checksum,
		deps: l.deps,
		npm: l.npm,
		toolchain: l.toolchain,
		yanked: yanked,
		withdrawn: l.withdrawn,
		sig: l.sig,
	}
}

---
`line` withdrawn for `reason`: yanked too, as the protocol requires.
---
fn withdrawnLine(l: Line, reason: String) -> Line {
	Line {
		name: l.name,
		version: l.version,
		checksum: l.checksum,
		deps: l.deps,
		npm: l.npm,
		toolchain: l.toolchain,
		yanked: true,
		withdrawn: Some(reason),
		sig: l.sig,
	}
}

---
`line` with its signature.
---
fn withSig(l: Line, sig: String) -> Line {
	Line {
		name: l.name,
		version: l.version,
		checksum: l.checksum,
		deps: l.deps,
		npm: l.npm,
		toolchain: l.toolchain,
		yanked: l.yanked,
		withdrawn: l.withdrawn,
		sig: sig,
	}
}

---
The publish API. Every refusal is the protocol's JSON `{"error", "message"}`,
with the status the reference server answers it with, including the router's
own (`on rejected`).
---
service api from http {
	// The protocol's upload cap, 64 MiB, as the reference server's.
	limits {
		maxBody: 67108864,
	}

	@raw(contentType: "application/vnd.bynk.tree-v1")
	on PUT("/api/:org/:package/:version") (
		org: String,
		package: String,
		version: String,
		body: Bytes,
		headers: RequestHeaders
	) -> Effect[HttpResult[Line]] by v: Visitor given Limits, Tokens, Admit, Store, Signing, Quota {
		let allowed <- Limits.write(headers.clientIp(), headers.bearer())
		if !allowed {
			rateLimited[Line]()
		} else {
			let denied <- Tokens.check(headers.bearer(), org, "publish")
			match denied {
				Some(d) => denial[Line](d),
				None => {
					let name = "\(org)/\(package)"
					let admitted <- Admit.admit(body, name, version)
					match admitted {
						Err(r) => refusal[Line](r),
						Ok(a) => match archiveName(a.checksum) {
							None => problemAt500[Line](
								"the module gave a checksum this service can't name: \(a.checksum)"
							),
							Some(key) => {
								let size = a.archive.length()
								let verdict <- Quota.admits(org, name, version, a.checksum, size)
								match verdict {
									Over(used, quota) => RawError(
										PayloadTooLarge,
										problem(
											"quota_exceeded",
											"`\(org)` has used \(used) of its \(quota) bytes, and this upload is \(size) more"
										),
										"application/json"
									),
									QuotaUnreadable(why) => problemAt500[Line](why),
									Within => {
										// Settle what the index will do before storing anything: an
										// upload the index refuses never reaches the bucket, so
										// nothing is stored outside the quota's count.
										let outlook <- PackageIndex(name).outlook(
											version,
											a.checksum
										)
										match outlook {
											OtherTree => versionExists(name, version),
											WasWithdrawn => withdrawnVersion(name, version),
											OutlookUnreadable(why) => problemAt500[Line](why),
											Appendable => {
												let signed <- Signing.sign(unsigned(a))
												match signed {
													Err(why) => problemAt500[Line](why),
													Ok(line) => {
														// Content-addressed: an archive already there is this one.
														let _ <- Store.putWith(
															key,
															a.archive,
															R2Put {
																contentType: Some("application/vnd.bynk.tree-v1"),
																metadata: Map.empty(),
																onlyIf: Absent,
															}
														)
														let appended <- PackageIndex(name).append(
															line
														)
														match appended {
															Exists => versionExists(name, version),
															Fresh(l) => {
																let _ <- Quota.count(org, size)
																Created(l)
															},
															Retry(l) => Ok(l),
															Withdrawn => {
																// A takedown landed after `outlook`, and this
																// upload may have put its archive back. No other
																// line shares the tree (the tree's manifest names
																// this version), so it goes again (R5a.2).
																let _ <- Store.delete(key)
																withdrawnVersion(name, version)
															},
															Unreadable(why) => problemAt500[Line](
																why
															),
														}
													},
												}
											},
										}
									},
								}
							},
						},
					}
				},
			}
		}
	}

	on POST("/api/:org/:package/:version/yank") (
		org: String,
		package: String,
		version: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[Yanked]] by v: Visitor given Limits, Tokens {
		let allowed <- Limits.write(headers.clientIp(), headers.bearer())
		if !allowed {
			rateLimited[Yanked]()
		} else {
			let denied <- Tokens.check(headers.bearer(), org, "yank")
			match denied {
				Some(d) => denial[Yanked](d),
				None => {
					let changed <- PackageIndex("\(org)/\(package)").setYanked(version, true)
					match changed {
						NoSuchVersion => missingVersion(org, package, version),
						WithdrawnFinal => RawError(
							Conflict,
							problem(
								"withdrawn",
								"`\(org)/\(package)` \(version) was withdrawn, so it can't be un-yanked; a withdrawal is final"
							),
							"application/json"
						),
						IndexUnreadable(why) => problemAt500[Yanked](why),
						Changed => Ok(Yanked { ok: true }),
					}
				},
			}
		}
	}

	on POST("/api/:org/:package/:version/unyank") (
		org: String,
		package: String,
		version: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[Yanked]] by v: Visitor given Limits, Tokens {
		let allowed <- Limits.write(headers.clientIp(), headers.bearer())
		if !allowed {
			rateLimited[Yanked]()
		} else {
			let denied <- Tokens.check(headers.bearer(), org, "yank")
			match denied {
				Some(d) => denial[Yanked](d),
				None => {
					let changed <- PackageIndex("\(org)/\(package)").setYanked(version, false)
					match changed {
						NoSuchVersion => missingVersion(org, package, version),
						WithdrawnFinal => RawError(
							Conflict,
							problem(
								"withdrawn",
								"`\(org)/\(package)` \(version) was withdrawn, so it can't be un-yanked; a withdrawal is final"
							),
							"application/json"
						),
						IndexUnreadable(why) => problemAt500[Yanked](why),
						Changed => Ok(Yanked { ok: true }),
					}
				},
			}
		}
	}

	// The router's own refusals, in the protocol's shape.
	on rejected(why: BoundaryRejection) -> Effect[HttpResult[()]] {
		match why {
			PayloadTooLarge(_) => RawError(
				PayloadTooLarge,
				problem("too_large", "an upload is limited to 67108864 bytes"),
				"application/json"
			),
			UnsupportedMediaType(_) => RawError(
				UnsupportedMediaType,
				problem(
					"unsupported_media_type",
					"an upload is an `application/vnd.bynk.tree-v1` archive"
				),
				"application/json"
			),
			MethodNotAllowed => RawError(
				MethodNotAllowed,
				problem("method_not_allowed", "this API endpoint doesn't take that method"),
				"application/json"
			),
			Unauthorized => RawError(
				Unauthorized,
				problem("unauthorised", "this registry needs a publish token"),
				"application/json"
			),
			_ => RawError(
				BadRequest,
				problem("bad_request", "the request couldn't be read"),
				"application/json"
			),
		}
	}
}

---
The body of a yank's answer, `{"ok": true}`.
---
type Yanked = {
	ok: Bool,
}

---
The protocol's refusal body.
---
type Problem = {
	error: String,
	message: String,
}

---
A package's index file, read and written whole. The file is a projection of
the package's `PackageIndex` agent, rewritten after each change (D10: a failed
write is repaired by the next).
---
capability IndexFiles {
	---
	A `PackageIndex`'s lines: its own once it has adopted them, else the
	bucket's index file.
	---
	fn known(name: String, adopted: Bool, lines: List[Line]) -> Effect[Result[List[Line], String]]
	fn write(name: String, lines: List[Line]) -> Effect[()]
}

provides IndexFiles = BucketIndexFiles given Store {
	fn known(name: String, adopted: Bool, lines: List[Line]) -> Effect[Result[List[Line], String]] {
		if adopted {
			Effect.pure(Ok(lines))
		} else {
			match packageKey(name) {
				None => Effect.pure(Ok([])),
				Some(key) => {
					let found <- Store.get(key)
					match found {
						None => Effect.pure(Ok([])),
						Some(b) => match b.decodeUtf8() {
							None => Effect.pure(Err("the index file of `\(name)` isn't UTF-8")),
							Some(text) => Effect.pure(parseIndex(name, text)),
						},
					}
				},
			}
		}
	}

	fn write(name: String, lines: List[Line]) -> Effect[()] {
		match packageKey(name) {
			None => Effect.pure(()),
			Some(key) => {
				let _ <- Store.put(key, Bytes.fromUtf8(renderIndex(lines)))
				Effect.pure(())
			},
		}
	}
}

---
A refusal body, `{"error": code, "message": message}`.
---
fn problem(code: String, message: String) -> Bytes {
	Bytes.fromUtf8(Json.encode(Problem { error: code, message: message }))
}

---
A `500` for a fault of this service's own (its configuration, or a module
answer it can't use), so a publisher sees why.
---
fn problemAt500[T](message: String) -> HttpResult[T] {
	RawError(ServerError, problem("internal", message), "application/json")
}

---
A token refusal, as the reference server answers it: `401` for no token or an
unknown one, `403` for one that can't act here.
---
fn denial[T](d: Denied) -> HttpResult[T] {
	match d {
		NoToken => RawError(
			Unauthorized,
			problem("unauthorised", "this registry needs a publish token"),
			"application/json"
		),
		UnknownToken => RawError(
			Unauthorized,
			problem("unauthorised", "the token isn't known to this registry"),
			"application/json"
		),
		WrongOrganisation(org) => RawError(
			Forbidden,
			problem("forbidden", "the token can't act for the organisation `\(org)`"),
			"application/json"
		),
		BadTable(why) => RawError(ServerError, problem("internal", why), "application/json"),
		Dead => RawError(
			Unauthorized,
			problem("unauthorised", "the token has expired or been revoked"),
			"application/json"
		),
		Blocked(org) => RawError(
			Forbidden,
			problem(
				"blocked",
				"`\(org)` is blocked: its name is held, and nothing is published to it"
			),
			"application/json"
		),
		CannotDo(can) => RawError(
			Forbidden,
			problem("forbidden", "the token can't `\(can)`"),
			"application/json"
		),
	}
}

---
An admission refusal, with the status the reference server gives its code.
---
fn refusal[T](r: Refusal) -> HttpResult[T] {
	match r.code {
		"invalid_package" => RawError(BadRequest, problem(r.code, r.message), "application/json"),
		"version_exists" => RawError(Conflict, problem(r.code, r.message), "application/json"),
		"not_found" => RawError(NotFound, problem(r.code, r.message), "application/json"),
		"too_large" => RawError(PayloadTooLarge, problem(r.code, r.message), "application/json"),
		_ => RawError(ServerError, problem(r.code, r.message), "application/json"),
	}
}

---
A yank of a version the index doesn't have.
---
fn missingVersion(org: String, package: String, version: String) -> HttpResult[Yanked] {
	RawError(
		NotFound,
		problem("not_found", "`\(org)/\(package)` has no version \(version)"),
		"application/json"
	)
}

---
The archive key of a `sha256-<base64>` checksum.
---
fn archiveName(checksum: String) -> Option[String] {
	if checksum.startsWith("sha256-") {
		Bytes.fromBase64(checksum.slice(7, checksum.length())).andThen((d) => archiveKey(d.toHex()))
	} else {
		None
	}
}

---
The line an admitted upload becomes, before it is signed. Like the reference
server's, it names no minimum toolchain.
---
fn unsigned(a: Admitted) -> Line {
	Line {
		name: a.name,
		version: a.version,
		checksum: a.checksum,
		deps: a.deps,
		npm: a.npm,
		toolchain: None,
		yanked: false,
		withdrawn: None,
		sig: "",
	}
}

---
An index file's lines. A line that doesn't parse is an error, never dropped:
the file is adopted as the package's lines, and a dropped line would free its
version for another tree.
---
fn parseIndex(name: String, text: String) -> Result[List[Line], String] {
	let none: List[Line] = []
	text.split("\n").fold(Ok(none), (acc, l) => match acc {
		Err(e) => Err(e),
		Ok(lines) => if l.trim() == "" {
			Ok(lines)
		} else {
			match Json.decode[Line](l) {
				Ok(line) => Ok(lines.append(line)),
				Err(_) => Err("the index file of `\(name)` has a line that isn't an index line"),
			}
		},
	})
}

---
The bucket key of a package's index file, from its `org/package` name.
---
fn packageKey(name: String) -> Option[String] {
	match name.indexOf("/") {
		None => None,
		Some(i) => indexKey(name.slice(0, i), name.slice(i + 1, name.length())),
	}
}

---
Lines as an index file: one JSON object per line.
---
fn renderIndex(lines: List[Line]) -> String {
	lines.fold("", (text, l) => text.concat(renderLine(l)).concat("\n"))
}

---
One index line as the protocol writes it (`registry-protocol.md`, "Index
files"): `toolchain` is `null` or a string, and `withdrawn` a string, present
only when set. The codec's own JSON tags an `Option` (`{"kind": "Some", …}`),
which a client reads as absent, so a withdrawal would go unseen (R5a.2).
---
fn renderLine(l: Line) -> String {
	let toolchain = match l.toolchain {
		Some(t) => Json.encode(t),
		None => "null",
	}
	let withdrawn = match l.withdrawn {
		Some(reason) => ",\"withdrawn\":".concat(Json.encode(reason)),
		None => "",
	}
	"{\"name\":"
		.concat(Json.encode(l.name))
		.concat(",\"version\":")
		.concat(Json.encode(l.version))
		.concat(",\"checksum\":")
		.concat(Json.encode(l.checksum))
		.concat(",\"deps\":")
		.concat(Json.encode(l.deps))
		.concat(",\"npm\":")
		.concat(Json.encode(l.npm))
		.concat(",\"toolchain\":")
		.concat(toolchain)
		.concat(",\"yanked\":")
		.concat(if l.yanked { "true" } else { "false" })
		.concat(withdrawn)
		.concat(",\"sig\":")
		.concat(Json.encode(l.sig))
		.concat("}")
}
