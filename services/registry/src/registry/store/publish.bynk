// The publish API (first-party registry R2, #2336): `PUT /api/<org>/<package>/
// <version>` with an archive body, and `POST …/yank|unyank`, as the protocol's
// "Publish API" specifies and the reference server (`bynk registry serve`)
// answers. Every write to the bucket happens in this context (R1's ownership
// rule); one `PackageIndex` agent per package is the only writer of its lines.
context registry.store

uses registry.paths
consumes bynk { Secrets }
consumes bynk.crypto { Crypto }
consumes registry.admission { Admit }

---
One package's index: its lines, in publish order. The single writer (track
D2): appends to one package are serialised here, so two publishes of one
version can't both land. A package seeded before the agent existed is adopted
from its index file on the first call.
---
agent PackageIndex {
	key name: String

	store lines: Cell[List[Line]] = []
	store adopted: Cell[Bool] = false

	---
	Append `line`, unless its version is already here: the same tree is a
	retry (D10) and answers the existing line; another tree is refused.
	`seed` is the bucket's index file, adopted when this agent is new.
	---
	on call append(line: Line, seed: List[Line]) -> Effect[Appended] {
		let current = if adopted { lines } else { seed }
		adopted := true
		match current.filter((l) => l.version == line.version).first() {
			Some(old) => {
				lines := current
				if old.checksum == line.checksum { Retry(old, current) } else { Exists }
			},
			None => {
				let next = current.append(line)
				lines := next
				Fresh(line, next)
			},
		}
	}

	---
	Set `version`'s `yanked` flag. Nothing is re-signed: a line's signature
	doesn't cover `yanked`. `None` when the version isn't here.
	---
	on call setYanked(version: String, yanked: Bool, seed: List[Line]) -> Effect[Option[List[Line]]] {
		let current = if adopted { lines } else { seed }
		adopted := true
		lines := current
		if current.any((l) => l.version == version) {
			let next = current.map((l) => if l.version == version { withYanked(l, yanked) } else { l })
			lines := next
			Some(next)
		} else {
			None
		}
	}
}

---
What appending a line did.
---
type Appended = | Fresh(line: Line, lines: List[Line]) | Retry(line: Line, lines: List[Line]) | Exists

---
Why a request's token can't do what it asks.
---
type Denied = | NoToken | UnknownToken | WrongOrganisation(org: String) | CannotDo(can: String)

---
One operator-issued publish token (track decision D): the sha256 of the
token, the organisations it may act for, and what it may do (`publish`,
`yank`). The table is the `REGISTRY_TOKENS` secret, a JSON list of these.
---
type TokenEntry = { sha256: String, organisations: List[String], can: List[String] }

---
The operator-issued token table, until accounts (R3) replace it.
---
capability Tokens {
	fn check(token: Option[String], org: String, can: String) -> Effect[Option[Denied]]
}

provides Tokens = SecretTokens given Secrets, Crypto {
	fn check(token: Option[String], org: String, can: String) -> Effect[Option[Denied]] {
		match token {
			None => Effect.pure(Some(NoToken)),
			Some(t) => {
				let table <- Secrets.get("REGISTRY_TOKENS")
				let entries: List[TokenEntry] = match table {
					Some(text) => match Json.decode[List[TokenEntry]](text) {
						Ok(es) => es,
						Err(_) => [],
					},
					None => [],
				}
				let digest <- Crypto.digest(Sha256, Bytes.fromUtf8(t))
				let hex = digest.toHex()
				// The table holds digests, never tokens, so this compares a
				// digest of the presented token: equal digests mean equal tokens.
				match entries.filter((e) => e.sha256 == hex).first() {
					None => Effect.pure(Some(UnknownToken)),
					Some(entry) => if !entry.organisations.any((o) => o == org) {
						Effect.pure(Some(WrongOrganisation(org)))
					} else if !entry.can.any((c) => c == can) {
						Effect.pure(Some(CannotDo(can)))
					} else {
						Effect.pure(None)
					},
				}
			},
		}
	}
}

---
Signs index lines with the online delegate (track D5, decision E). The key
is the `REGISTRY_SIGNING_KEY` secret (PKCS#8, base64) and its public half
`REGISTRY_SIGNING_PUBLIC` (`ed25519:<base64>`). Before each signature the key
is checked against the bucket's `config.json`: a delegation from the newest
chain key names it, verified, no revocation names it, and a signature made
with it verifies. A key that fails is never used, so the service can't publish
lines no client accepts.
---
capability Signing {
	fn sign(line: Line) -> Effect[Result[Line, String]]
}

---
The signing step itself: check the delegate `key` against what `config.json`
says about it (`s`), then sign `line` with it (the PKCS#8 `pkcs8`) and verify
the signature.
---
capability Delegate {
	fn signChecked(pkcs8: String, key: String, s: Signer, line: Line) -> Effect[Result[Line, String]]
}

provides Delegate = CheckedDelegate given Crypto, Admit {
	fn signChecked(pkcs8: String, key: String, s: Signer, line: Line) -> Effect[Result[Line, String]] {
		let refused = Err("the signing key \(key) isn't a valid, unrevoked delegate in config.json")
		match keyBytes(s.chainKey) {
			None => Effect.pure(refused),
			Some(chain) => match s.delegationSig.andThen((t) => Bytes.fromBase64(t)) {
				None => Effect.pure(refused),
				Some(delegation) => {
					let chainKey <- Crypto.importVerifyKey(Ed25519, chain)
					match chainKey {
						Err(_) => Effect.pure(refused),
						Ok(vk) => {
							let vouched <- Crypto.verify(vk, s.delegationPayload, delegation)
							if !vouched || !s.delegated || s.revoked {
								Effect.pure(refused)
							} else {
								match Bytes.fromBase64(pkcs8) {
									None => Effect.pure(Err("REGISTRY_SIGNING_KEY isn't base64")),
									Some(der) => {
										let imported <- Crypto.importSigningKey(Ed25519, pkcs8v1(der))
										match imported {
											Err(_) => Effect.pure(Err("REGISTRY_SIGNING_KEY isn't an Ed25519 PKCS#8 key")),
											Ok(signing) => {
												let payload <- Admit.payload(line, s.id)
												let sig <- Crypto.sign(signing, payload)
												match keyBytes(key) {
													None => Effect.pure(refused),
													Some(own) => {
														let ownKey <- Crypto.importVerifyKey(Ed25519, own)
														match ownKey {
															Err(_) => Effect.pure(refused),
															Ok(check) => {
																let good <- Crypto.verify(check, payload, sig)
																if good {
																	Effect.pure(Ok(withSig(line, sig.toBase64())))
																} else {
																	Effect.pure(Err("REGISTRY_SIGNING_KEY isn't the private half of REGISTRY_SIGNING_PUBLIC"))
																}
															},
														}
													},
												}
											},
										}
									},
								}
							}
						},
					}
				},
			},
		}
	}
}

provides Signing = DelegateSigner given Secrets, Admit, Store, Delegate {
	fn sign(line: Line) -> Effect[Result[Line, String]] {
		let secret <- Secrets.get("REGISTRY_SIGNING_KEY")
		let public <- Secrets.get("REGISTRY_SIGNING_PUBLIC")
		let configBytes <- Store.get(configKey())
		let config = configBytes.andThen((b) => b.decodeUtf8())
		match secret {
			None => Effect.pure(Err("the signing key (REGISTRY_SIGNING_KEY) isn't set")),
			Some(pkcs8) => match public {
				None => Effect.pure(Err("the signing key's public half (REGISTRY_SIGNING_PUBLIC) isn't set")),
				Some(key) => match config {
					None => Effect.pure(Err("the bucket has no readable config.json")),
					Some(text) => {
						let info <- Admit.signer(text, key)
						match info {
							Err(r) => Effect.pure(Err("config.json couldn't be read: \(r.message)")),
							Ok(s) => Delegate.signChecked(pkcs8, key, s, line),
						}
					},
				},
			},
		}
	}
}

---
The raw bytes of an `ed25519:<base64>` key, `None` for anything else.
---
fn keyBytes(key: String) -> Option[Bytes] {
	if key.startsWith("ed25519:") { Bytes.fromBase64(key.slice(8, key.length())) } else { None }
}

---
An Ed25519 PKCS#8 document as version 1. `bynk registry` writes version 2
(ring's form, which carries the public key too), and Web Crypto takes only
version 1; both hold the same 32-byte seed at the same offset. Any other
document is passed through for the import to judge.
---
fn pkcs8v1(der: Bytes) -> Bytes {
	// After the outer SEQUENCE header: version 1 (`v2`), the Ed25519 OID, and
	// the seed's OCTET STRING header.
	let v2 = Bytes.fromHex("020101300506032b657004220420").getOrElse(Bytes.empty())
	let v1 = Bytes.fromHex("302e020100300506032b657004220420").getOrElse(Bytes.empty())
	if der.length() > 48 && der.slice(2, 16) == v2 { v1.concat(der.slice(16, 48)) } else { der }
}

---
`line` with its `yanked` flag set.
---
fn withYanked(l: Line, yanked: Bool) -> Line {
	Line {
		name: l.name,
		version: l.version,
		checksum: l.checksum,
		deps: l.deps,
		npm: l.npm,
		toolchain: l.toolchain,
		yanked: yanked,
		sig: l.sig,
	}
}

---
`line` with its signature.
---
fn withSig(l: Line, sig: String) -> Line {
	Line {
		name: l.name,
		version: l.version,
		checksum: l.checksum,
		deps: l.deps,
		npm: l.npm,
		toolchain: l.toolchain,
		yanked: l.yanked,
		sig: sig,
	}
}

---
The publish API. Every refusal is the protocol's JSON `{"error", "message"}`,
with the status the reference server answers it with, including the router's
own (`on rejected`).
---
service api from http {
	// The protocol's upload cap, 64 MiB, as the reference server's.
	limits { maxBody: 67108864 }

	@raw(contentType: "application/vnd.bynk.tree-v1")
	on PUT("/api/:org/:package/:version") (
		org: String,
		package: String,
		version: String,
		body: Bytes,
		headers: RequestHeaders
	) -> Effect[HttpResult[Line]] by v: Visitor given Tokens, Admit, Store, Signing, IndexFiles {
		let denied <- Tokens.check(headers.bearer(), org, "publish")
		match denied {
			Some(d) => denial[Line](d),
			None => {
				let name = "\(org)/\(package)"
				let admitted <- Admit.admit(body, name, version)
				match admitted {
					Err(r) => refusal[Line](r),
					Ok(a) => match archiveName(a.checksum) {
						None => problemAt500[Line]("the module gave a checksum this service can't name: \(a.checksum)"),
						Some(key) => {
							// Content-addressed: an archive already there is this one.
							let _ <- Store.putWith(key, a.archive, R2Put {
								contentType: Some("application/vnd.bynk.tree-v1"),
								metadata: Map.empty(),
								onlyIf: Absent,
							})
							let signed <- Signing.sign(unsigned(a))
							match signed {
								Err(why) => problemAt500[Line](why),
								Ok(line) => {
									let seed <- IndexFiles.read(org, package)
									let appended <- PackageIndex(name).append(line, seed)
									match appended {
										Exists => RawError(
											Conflict,
											problem("version_exists", "`\(name)` \(version) is already in the registry with a different tree — its index is append-only; bump `version`"),
											"application/json"
										),
										Fresh(l, lines) => {
											let _ <- IndexFiles.write(org, package, lines)
											Created(l)
										},
										Retry(l, lines) => {
											let _ <- IndexFiles.write(org, package, lines)
											Ok(l)
										},
									}
								},
							}
						},
					},
				}
			},
		}
	}

	on POST("/api/:org/:package/:version/yank") (
		org: String,
		package: String,
		version: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[Yanked]] by v: Visitor given Tokens, IndexFiles {
		let denied <- Tokens.check(headers.bearer(), org, "yank")
		match denied {
			Some(d) => denial[Yanked](d),
			None => {
				let seed <- IndexFiles.read(org, package)
				let changed <- PackageIndex("\(org)/\(package)").setYanked(version, true, seed)
				match changed {
					None => missingVersion(org, package, version),
					Some(lines) => {
						let _ <- IndexFiles.write(org, package, lines)
						Ok(Yanked { ok: true })
					},
				}
			},
		}
	}

	on POST("/api/:org/:package/:version/unyank") (
		org: String,
		package: String,
		version: String,
		headers: RequestHeaders
	) -> Effect[HttpResult[Yanked]] by v: Visitor given Tokens, IndexFiles {
		let denied <- Tokens.check(headers.bearer(), org, "yank")
		match denied {
			Some(d) => denial[Yanked](d),
			None => {
				let seed <- IndexFiles.read(org, package)
				let changed <- PackageIndex("\(org)/\(package)").setYanked(version, false, seed)
				match changed {
					None => missingVersion(org, package, version),
					Some(lines) => {
						let _ <- IndexFiles.write(org, package, lines)
						Ok(Yanked { ok: true })
					},
				}
			},
		}
	}

	// The router's own refusals, in the protocol's shape.
	on rejected(why: BoundaryRejection) -> Effect[HttpResult[()]] {
		match why {
			PayloadTooLarge(_) => RawError(
				PayloadTooLarge,
				problem("too_large", "an upload is limited to 67108864 bytes"),
				"application/json"
			),
			UnsupportedMediaType(_) => RawError(
				UnsupportedMediaType,
				problem("unsupported_media_type", "an upload is an `application/vnd.bynk.tree-v1` archive"),
				"application/json"
			),
			MethodNotAllowed => RawError(
				MethodNotAllowed,
				problem("method_not_allowed", "this API endpoint doesn't take that method"),
				"application/json"
			),
			Unauthorized => RawError(Unauthorized, problem("unauthorised", "this registry needs a publish token"), "application/json"),
			_ => RawError(BadRequest, problem("bad_request", "the request couldn't be read"), "application/json"),
		}
	}
}

---
The body of a yank's answer, `{"ok": true}`.
---
type Yanked = { ok: Bool }

---
The protocol's refusal body.
---
type Problem = { error: String, message: String }

---
A package's index file, read and written whole. The file is a projection of
the package's `PackageIndex` agent, rewritten after each change (D10: a failed
write is repaired by the next).
---
capability IndexFiles {
	fn read(org: String, package: String) -> Effect[List[Line]]
	fn write(org: String, package: String, lines: List[Line]) -> Effect[()]
}

provides IndexFiles = BucketIndexFiles given Store {
	fn read(org: String, package: String) -> Effect[List[Line]] {
		match indexKey(org, package) {
			None => Effect.pure([]),
			Some(key) => {
				let found <- Store.get(key)
				Effect.pure(parseIndex(found.andThen((b) => b.decodeUtf8()).getOrElse("")))
			},
		}
	}

	fn write(org: String, package: String, lines: List[Line]) -> Effect[()] {
		match indexKey(org, package) {
			None => Effect.pure(()),
			Some(key) => {
				let _ <- Store.put(key, Bytes.fromUtf8(renderIndex(lines)))
				Effect.pure(())
			},
		}
	}
}

---
A refusal body, `{"error": code, "message": message}`.
---
fn problem(code: String, message: String) -> Bytes {
	Bytes.fromUtf8(Json.encode(Problem { error: code, message: message }))
}

---
A `500` for a fault of this service's own (its configuration, or a module
answer it can't use), so a publisher sees why.
---
fn problemAt500[T](message: String) -> HttpResult[T] {
	RawError(ServerError, problem("internal", message), "application/json")
}

---
A token refusal, as the reference server answers it: `401` for no token or an
unknown one, `403` for one that can't act here.
---
fn denial[T](d: Denied) -> HttpResult[T] {
	match d {
		NoToken => RawError(Unauthorized, problem("unauthorised", "this registry needs a publish token"), "application/json"),
		UnknownToken => RawError(Unauthorized, problem("unauthorised", "the token isn't known to this registry"), "application/json"),
		WrongOrganisation(org) => RawError(
			Forbidden,
			problem("forbidden", "the token can't act for the organisation `\(org)`"),
			"application/json"
		),
		CannotDo(can) => RawError(Forbidden, problem("forbidden", "the token can't `\(can)`"), "application/json"),
	}
}

---
An admission refusal, with the status the reference server gives its code.
---
fn refusal[T](r: Refusal) -> HttpResult[T] {
	match r.code {
		"invalid_package" => RawError(BadRequest, problem(r.code, r.message), "application/json"),
		"version_exists" => RawError(Conflict, problem(r.code, r.message), "application/json"),
		"not_found" => RawError(NotFound, problem(r.code, r.message), "application/json"),
		"too_large" => RawError(PayloadTooLarge, problem(r.code, r.message), "application/json"),
		_ => RawError(ServerError, problem(r.code, r.message), "application/json"),
	}
}

---
A yank of a version the index doesn't have.
---
fn missingVersion(org: String, package: String, version: String) -> HttpResult[Yanked] {
	RawError(
		NotFound,
		problem("not_found", "`\(org)/\(package)` has no version \(version)"),
		"application/json"
	)
}

---
The archive key of a `sha256-<base64>` checksum.
---
fn archiveName(checksum: String) -> Option[String] {
	if checksum.startsWith("sha256-") {
		Bytes.fromBase64(checksum.slice(7, checksum.length())).andThen((d) => archiveKey(d.toHex()))
	} else {
		None
	}
}

---
The line an admitted upload becomes, before it is signed. Like the reference
server's, it names no minimum toolchain.
---
fn unsigned(a: Admitted) -> Line {
	Line {
		name: a.name,
		version: a.version,
		checksum: a.checksum,
		deps: a.deps,
		npm: a.npm,
		toolchain: None,
		yanked: false,
		sig: "",
	}
}

---
An index file's lines. A line that doesn't parse is dropped: the file is a
projection, and the agent holds the lines.
---
fn parseIndex(text: String) -> List[Line] {
	let none: List[Line] = []
	text.split("\n").fold(none, (lines, l) => match Json.decode[Line](l) {
		Ok(line) => lines.append(line),
		Err(_) => lines,
	})
}

---
Lines as an index file: one JSON object per line.
---
fn renderIndex(lines: List[Line]) -> String {
	lines.fold("", (text, l) => text.concat(Json.encode(l)).concat("\n"))
}
