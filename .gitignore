# Rust build artifacts
target/
**/*.rs.bk

# Insta pending snapshots
**/*.pending-snap
**/snapshots/*.snap.new

# mdBook build output
docs/book/

# `bynk test` build output written into a fixture dir (never tracked; the
# fixtures are driven from temp dirs, so a committed out/ is stale cruft)
bynk-tests/tests/fixtures/**/out/
bynk-tests/tests/fixtures/**/out-js/

# Likewise for the examples: `bynk test` and `bynk compile` write here
examples/**/out/
examples/**/out-js/
examples/**/bynk.schema.lock
.github/codeql/bynk-emitted/canaries/**/bynk.schema.lock

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# The Dev Container feature's CI-only release cache
# (scripts/ci/devcontainer-feature-prefetch.sh); never committed or published.
features/src/bynk/ci-release-cache/
