adapter bynk.cloudflare {
	consumes bynk { Fetch }
	exports capability {
		Kv,
		Service,
		R2,
		RateLimit,
		Queue,
		Analytics,
		EdgeCache,
		D1,
		Version,
		Ai,
		StoredSecret,
		Email,
		Postgres,
		MySql,
		Vectorize,
		Container,
		AiSearch,
	}
	exports transparent {
		KvExpiration,
		KvPut,
		KvGet,
		KvEntry,
		KvKey,
		KvList,
		KvListing,
		R2Object,
		R2Put,
		R2Condition,
		R2Listing,
		R2Body,
		R2Upload,
		R2UploadOptions,
		R2Part,
		QueueSend,
		DataPoint,
		SqlValue,
		SqlStatement,
		SqlRun,
		SqlError,
		SqlReadError,
		WorkerVersion,
		AiError,
		ChatRole,
		ChatMessage,
		GenerateRequest,
		TokenUsage,
		Generation,
		EmailAttachment,
		EmailMessage,
		EmailError,
		InboundAttachment,
		InboundEmail,
		EmailReply,
		EmailVerdict,
		DmarcVerdict,
		SenderIdentity,
		PgValue,
		PgError,
		PgRun,
		PgStatement,
		PgReadError,
		MySqlValue,
		MySqlError,
		MySqlRun,
		MySqlStatement,
		MySqlReadError,
		Vector,
		VectorOf,
		MetaValue,
		FilterOp,
		Condition,
		MetadataScope,
		QueryOptions,
		VectorMatch,
		Mutation,
		IndexInfo,
		VectorError,
		SearchHit,
		RetrievalType,
		SearchOptions,
		SearchAnswer,
		SearchError,
		ContainerError,
	}

	---
	When a `Kv.putWith` or `Kv.putBytes` entry expires: `Never`, `After` a
	duration (a part second rounds up), or `At` an instant. Either must be at
	least 60 seconds away. KV has further expiry forms, so a `match` over this
	type needs a wildcard.
	---
	type KvExpiration =
		| Never
		| After(ttl: Duration)
		| At(instant: Instant)

	---
	The options of a `Kv.putWith` or `Kv.putBytes` write: when the entry
	expires, and the metadata stored beside it (at most 1024 bytes once
	serialised as JSON). Leave a field out for `Kv.put`'s behaviour: no expiry,
	no metadata.
	---
	type KvPut = {
		expiration: KvExpiration = KvExpiration.Never,
		metadata: Map[String, String] = Map.empty(),
	}

	---
	The options of a `Kv.getWith` read. `cacheTtl` is how long the read may be
	served from Cloudflare's edge cache, at least 30 seconds; `None` keeps the
	platform's default of 60, and is the default.
	---
	type KvGet = {
		cacheTtl: Option[Duration] = None,
	}

	---
	A value read by `Kv.getWith`, with the metadata written beside it.
	---
	type KvEntry = {
		value: String,
		metadata: Map[String, String],
	}

	---
	One key of a `Kv.listPage`: its name, when it expires (`None` for never),
	and its metadata.
	---
	type KvKey = {
		name: String,
		expiration: Option[Instant],
		metadata: Map[String, String],
	}

	---
	The options of a `Kv.listPage`: the keys under `prefix`, from `cursor` (the
	previous page's; `None` for the first), at most `limit` of them (1 to 1000;
	`None` for 1000).
	---
	type KvList = {
		prefix: Option[String],
		cursor: Option[String],
		limit: Option[Int],
	}

	---
	One page of a `Kv.listPage`: its keys in key order, and the cursor of the
	next page, `None` on the last. A page may be short and still have a
	cursor, so loop until the cursor is `None`, not until a page is short.
	---
	type KvListing = {
		keys: List[KvKey],
		cursor: Option[String],
	}

	---
	A Cloudflare Workers KV namespace: a key/value store with optional per-entry
	expiry and prefix listing.

	`get`, `put`, `putTtl`, `delete` and `list` work on text. The rest
	(experimental) add what the platform has beyond that:
	- `getWith` reads a value with its metadata, optionally edge-cached for
	  `cacheTtl`; `putWith` writes one with an expiry and metadata.
	- `getBytes` and `putBytes` read and write binary values.
	- `listPage` reads one page of keys, with each key's expiry and metadata.

	Text and binary values share the namespace, as on the platform: `getBytes`
	of a text value gives its UTF-8 bytes, and reading a binary value as text
	decodes it as UTF-8, replacing what is not. Keep each key to one kind.

	A key over 512 bytes, metadata over 1024 bytes, an expiry under 60 seconds
	away, a `cacheTtl` under 30 seconds, or a `limit` outside 1 to 1000 faults
	the new operations before the platform is called; a value over 25 MiB
	faults with the platform's error.
	---
	capability Kv {
		fn get(key: String) -> Effect[Option[String]]
		fn put(key: String, value: String) -> Effect[()]
		fn putTtl(key: String, value: String, ttlSeconds: Int) -> Effect[()]
		fn delete(key: String) -> Effect[()]
		fn list(prefix: Option[String]) -> Effect[List[String]]
		fn getWith(key: String, options: KvGet) -> Effect[Option[KvEntry]]
		fn putWith(key: String, value: String, options: KvPut) -> Effect[()]
		fn getBytes(key: String) -> Effect[Option[Bytes]]
		fn putBytes(key: String, value: Bytes, options: KvPut) -> Effect[()]
		fn listPage(options: KvList) -> Effect[KvListing]
	}

	---
	A Service Binding to a Worker that is not part of this Bynk project: an
	untyped HTTP call over Cloudflare's private channel, never the public
	internet. Used only through a named instance that names its Worker,
	`capability Billing = Service @worker("legacy-billing")`, which binds as
	`SERVICE_BILLING`; a bare `given Service` names no Worker and is refused.

	`send` has `Fetch.send`'s shape and rules: the same `Request` (its
	headers checked the same way, refused as `InvalidHeader` before anything
	is sent), the same `Response`, and `Network` when the call itself fails.
	The URL's host is not used for routing (the binding decides where the
	request goes), but the URL must be absolute and the callee sees it. A
	status the Worker returns, 5xx included, is an `Ok` response.

	The callee is not Bynk's: `bynk deploy` neither creates nor checks its
	contract, and warns when no Worker of that name exists in the account
	(Cloudflare itself then rejects the upload). `bynk dev` binds a local
	test double unless `--local-worker` names the Worker, and `bynkc test`
	faults until the call is stubbed. A Bynk callee should be consumed with
	`consumes` instead, which checks its contract.

	`Request`, `Response` and `FetchError` are `bynk`'s types, so a context
	that calls `send` also writes `consumes bynk` to name them.
	---
	capability Service {
		fn send(req: Request) -> Effect[Result[Response, FetchError]]
	}

	---
	An object in an R2 bucket, as `head`, `put`, `putWith` and `list` report
	it: no body. `etag` is R2's opaque version tag (what `EtagMatches` compares
	against), `uploaded` when the object was last written. `contentType` is
	`None` when none was stored; `metadata` is the custom metadata written
	with the object.
	---
	type R2Object = {
		key: String,
		size: Int,
		etag: String,
		uploaded: Instant,
		contentType: Option[String],
		metadata: Map[String, String],
	}

	---
	The precondition of an `R2.putWith` write. `Always` writes
	unconditionally, `Absent` only when the key holds no object (create-only,
	which content-addressed storage needs), and `EtagMatches(etag)` only when
	the current object's etag is `etag` (compare-and-swap). R2 has further
	conditions, so a `match` over this type needs a wildcard.
	---
	type R2Condition =
		| Always
		| Absent
		| EtagMatches(etag: String)

	---
	The options of an `R2.putWith` write: the content type and custom
	metadata to store, and the precondition (`onlyIf`) the write needs. Leave a
	field out for `R2.put`'s behaviour: no content type, no metadata, always
	written.
	---
	type R2Put = {
		contentType: Option[String] = None,
		metadata: Map[String, String] = Map.empty(),
		onlyIf: R2Condition = R2Condition.Always,
	}

	---
	One page of an `R2.list`: the objects it holds, and the cursor of the next
	page, `None` on the last.
	---
	type R2Listing = {
		keys: List[R2Object],
		cursor: Option[String],
	}

	---
	An object read by `R2.getStream`: its metadata, and its body as a stream
	of chunks, read from R2 as they are pulled. The body can be read once
	(`collect`, `map`, or handed to `RawStreamed`); a second read faults. A
	record carrying a stream is not data: it can't be stored, sent or encoded.
	---
	type R2Body = {
		object: R2Object,
		body: Stream[Bytes],
	}

	---
	A multipart upload in progress, as `R2.createUpload` begins it. It is
	plain data, so it can be kept (in an agent, say) or handed to a client
	between the requests that upload its parts. R2 aborts an upload left
	incomplete for 7 days.
	---
	type R2Upload = {
		key: String,
		uploadId: String,
	}

	---
	The options of an `R2.createUpload`: the content type and custom metadata
	of the object the upload completes.
	---
	type R2UploadOptions = {
		contentType: Option[String],
		metadata: Map[String, String],
	}

	---
	One uploaded part of a multipart upload, as `R2.uploadPart` reports it.
	`R2.completeUpload` takes every part, in any order.
	---
	type R2Part = {
		partNumber: Int,
		etag: String,
	}

	---
	The options of a `Queue.sendWith`. `delay` holds the message back before
	it can be delivered: whole seconds (a part second rounds up), at most 12
	hours; `None`, the default, delivers as soon as the queue can.
	---
	type QueueSend = {
		delay: Option[Duration] = None,
	}

	---
	One event written to an `Analytics` dataset. `index` is the sampling key
	(at most 96 bytes; `None` samples the dataset as a whole), `blobs` are
	text dimensions (at most 20, totalling at most 16 KB), and `doubles` are
	numeric values (at most 20, each finite). In the SQL API they are the
	columns `index1`, `blob1`…`blob20` and `double1`…`double20`, in order.
	---
	type DataPoint = {
		index: Option[String],
		blobs: List[String],
		doubles: List[Float],
	}

	---
	A value bound to a `?n` parameter of a `D1` statement, by SQLite storage
	class. `Boolean` binds as `1` or `0`, as SQLite has no boolean.
	---
	type SqlValue =
		| Null
		| Integer(value: Int)
		| Real(value: Float)
		| Text(value: String)
		| Blob(value: Bytes)
		| Boolean(value: Bool)

	---
	One statement of a `D1.batch`: its SQL, a string literal, and its
	positional parameters. It stays where it is built: it is never stored,
	sent or decoded, since one from outside would carry SQL that was never a
	literal.
	---
	type SqlStatement = {
		sql: String,
		params: List[SqlValue],
	}

	---
	What a `D1.run` (or one statement of a `D1.batch`) changed: the rows it
	wrote, and the rowid of the last row it inserted.
	---
	type SqlRun = {
		changes: Int,
		lastRowId: Int,
	}

	---
	Why a `D1` statement failed. `Constraint` is a UNIQUE, CHECK, NOT NULL or
	foreign-key violation, an outcome a handler answers (with a `409`, say);
	`Failed` is anything else, with the database's message. D1 has further
	failure kinds, so a `match` over this type needs a wildcard.
	---
	type SqlError =
		| Constraint(message: String)
		| Failed(message: String)

	---
	Why a typed `D1` read (`select[T]`, `firstAs[T]`) failed: `Sql` is the
	statement's own failure, `Decode` a row that did not fit `T` (a column
	whose stored value disagrees with its field's type).
	---
	type SqlReadError =
		| Sql(error: SqlError)
		| Decode(error: DecodeError)

	---
	One file attached to an outbound `EmailMessage`. `content` is the file's bytes,
	`contentType` its MIME type (`"application/pdf"`) and `filename` the name
	the recipient sees. `inline` sends it for display inside the body (an
	image the `html` refers to as `cid:logo.png`, its content id being its
	filename) rather than as a download.
	---
	type EmailAttachment = {
		filename: String,
		contentType: String,
		content: Bytes,
		inline: Bool = false,
	}

	---
	One outbound email for `Email.send`. Addresses are plain `String`s
	(`"orders@shop.example"` or `"Shop <orders@shop.example>"`); the platform,
	not Bynk, judges their syntax. At least one of `text` and `html` is
	required. `headers` adds custom headers: `From`, `To`, `Cc`, `Bcc`,
	`Subject` and `Reply-To` are set by the fields above and may not be set
	here, and a name or value with a line break is refused, since either would
	let data inject a header.
	---
	type EmailMessage = {
		from: String,
		to: List[String],
		cc: List[String] = [],
		bcc: List[String] = [],
		replyTo: Option[String] = None,
		subject: String,
		text: Option[String] = None,
		html: Option[String] = None,
		attachments: List[EmailAttachment] = [],
		headers: Map[String, String] = Map.empty(),
	}

	---
	Why an `Email.send` was refused by the platform. `SenderNotVerified` is a
	`from` address outside a domain verified for sending; `RecipientNotAllowed`
	a recipient the instance's `@to` or `@allowedRecipients` (or the account)
	does not permit; `RateLimited` and `DailyLimit` the per-second and
	per-day sending limits. All are outcomes a handler can act on (retry
	later, alert); `SendFailed` is any other refusal, with the platform's
	message. Cloudflare has further error codes, so a `match` over this type
	needs a wildcard.
	---
	type EmailError =
		| SenderNotVerified
		| RecipientNotAllowed
		| RateLimited
		| DailyLimit
		| SendFailed(message: String)

	---
	One file attached to an inbound `InboundEmail`: its `filename`, MIME
	`contentType` and `content` bytes. `inline` is true for a part the HTML body
	refers to by content id (an embedded image) rather than a download.
	---
	type InboundAttachment = {
		filename: String,
		contentType: String,
		content: Bytes,
		inline: Bool = false,
	}

	---
	One email delivered to a `from email(...)` service's `on message` handler.
	`from` is the **envelope** sender, a claim: anyone can write any address, so
	trust it only when the `Sender` actor's `dmarc` is `DmarcPass`. `to` is the
	envelope recipient the service was routed by. `headers` holds the message's
	headers by lower-case name. `text`, `html` and `attachments` come from the
	parsed MIME body (`None` or empty when the message has no such part); a test
	builds them directly. `size` is the raw message in bytes. Every field after
	`to` has a default, so a test writes only what it cares about.
	---
	type InboundEmail = {
		from: String,
		to: String,
		subject: String = "",
		messageId: String = "",
		headers: Map[String, String] = Map.empty(),
		text: Option[String] = None,
		html: Option[String] = None,
		attachments: List[InboundAttachment] = [],
		size: Int = 0,
	}

	---
	The content of a `Reply` verdict. Only the content is the handler's: the
	runtime fills in `From` (the receiving address), `To` (the sender),
	`In-Reply-To` and `References`, so a reply can only go to the sender, from
	the address that received the mail, as the platform requires. `subject`
	defaults to the incoming subject prefixed `Re: `.
	---
	type EmailReply = {
		subject: Option[String] = None,
		text: Option[String] = None,
		html: Option[String] = None,
	}

	---
	What a `from email` handler decides about a message, returned as
	`Effect[EmailVerdict]` (the agency rule of ADR 0078, as `QueueResult` is).
	`Accept` handles it and nothing else happens; `Reject(reason)` refuses it
	permanently with an SMTP rejection carrying `reason`; `Forward(to)` passes it
	to one destination, which must be a verified destination address in the
	account; `Reply(message)` answers the sender. One decision per message.
	---
	type EmailVerdict =
		| Accept
		| Reject(reason: String)
		| Forward(to: String)
		| Reply(message: EmailReply)

	---
	Whether the platform authenticated the sender's domain with DMARC, read from
	the `Authentication-Results` header Cloudflare Email Routing prepends: only
	the topmost, and only if it is from `mx.cloudflare.net`, is trusted. `DmarcNone`
	is no verdict (the header is absent, is another server's, or reports none). The variants carry the `Dmarc`
	prefix because a bare `None` would resolve to `Option`'s.
	---
	type DmarcVerdict = enum { DmarcPass, DmarcFail, DmarcNone }

	---
	The identity of the `Sender` actor, the default actor of a `from email`
	handler: the envelope `address` and the platform's `dmarc` verdict on it.
	The Worker's `email()` entry mints it from the envelope and Email Routing's
	`Authentication-Results` header; a handler runs in a suite without a
	minted identity today, so `s.identity` reads as `()` until that lands.
	---
	type SenderIdentity = {
		address: String,
		dmarc: DmarcVerdict,
	}

	---
	A value bound to a `$n` parameter of a `Postgres` statement. `PgInteger`
	binds a whole number and `PgReal` a float; `PgText` binds text, `PgBytea` bytes
	and `PgBoolean` a flag. `PgTimestamp` binds an `Instant` as a `timestamptz`.
	`PgJson` binds JSON text and `PgNumeric` a decimal as text, each as text
	the server types from the column or cast it meets (`$1::jsonb`,
	`$2::numeric`), so neither loses a digit to a float. The variants carry the
	`Pg` prefix because a bare `Null`, `Integer`, `Real`, `Text` or `Boolean`
	would resolve to `SqlValue`'s, and `Json` and `Timestamp` to a built-in.
	---
	type PgValue =
		| PgNull
		| PgInteger(value: Int)
		| PgReal(value: Float)
		| PgText(value: String)
		| PgBytea(value: Bytes)
		| PgBoolean(value: Bool)
		| PgTimestamp(value: Instant)
		| PgJson(value: String)
		| PgNumeric(value: String)

	---
	What a `Postgres.run` changed: the rows the statement inserted, updated or
	deleted (or, for a `SELECT`, returned).
	---
	type PgRun = {
		rowCount: Int,
	}

	---
	Why a `Postgres` statement failed, with the SQLSTATE where Postgres gave
	one. `PgConstraint` is an integrity-constraint violation (class `23`: a
	unique, not-null, check or foreign-key violation), an outcome a handler
	answers (with a `409`, say). `PgSerialization` is a serialization failure
	(`40001`), which a retry may clear. `PgConnection` is a connection that could not
	be made or was lost; its message names the driver's code and never the
	host or the connection string. `PgFailed` is anything else, with its SQLSTATE
	(empty when the driver reported none) and the database's message. Postgres has further failure
	kinds, so a `match` over this type needs a wildcard. The variants carry the
	`Pg` prefix because `Constraint` and `Failed` are `SqlError`'s.
	---
	type PgError =
		| PgConstraint(sqlstate: String, message: String)
		| PgSerialization(message: String)
		| PgConnection(message: String)
		| PgFailed(sqlstate: String, message: String)

	---
	One statement of a `Postgres.transaction`: its SQL, a string literal, and
	its positional parameters (`$1`, `$2`, …). It stays where it is built: it is
	never stored, sent or decoded, since one from outside would carry SQL that
	was never a literal.
	---
	type PgStatement = {
		sql: String,
		params: List[PgValue],
	}

	---
	Why a typed `Postgres` read (`select[T]`, `firstAs[T]`) failed: `PgSql` is
	the statement's own failure, `PgDecode` a row that did not fit `T` (a
	column whose value disagrees with its field's type). The variants carry the
	`Pg` prefix because `Sql` and `Decode` are `SqlReadError`'s.
	---
	type PgReadError =
		| PgSql(error: PgError)
		| PgDecode(error: DecodeError)

	---
	A value bound to a `?` parameter of a `MySql` statement. `MySqlInteger`
	binds a signed whole number and `MySqlReal` a float; `MySqlText` binds text
	and `MySqlBytes` bytes. `MySqlBoolean` binds a flag as `1` or `0`, which is
	what a `TINYINT(1)` column holds.

	`MySqlUnsigned` binds an unsigned integer as its decimal digits, since an
	`Int` is signed and a `BIGINT UNSIGNED` reaches past it; a value that is not
	digits only is refused by the server. `MySqlDecimal` binds a `DECIMAL` as
	text and `MySqlJson` binds JSON text for a `JSON` column, so neither loses a
	digit to a float.

	MySQL has two date and time types that Postgres does not, and Bynk does not
	pretend they are one. `MySqlDateTime` binds the wall-clock text of a
	`DATETIME` (`2026-11-12 09:30:00`), which has no time zone and is not an
	instant. `MySqlTimestamp` binds an `Instant` as UTC text
	(`2026-11-12 09:30:00.000`): right for a `DATETIME` column that holds UTC by
	convention, and for a `TIMESTAMP` column only when the session's time zone is
	UTC, since MySQL converts a `TIMESTAMP` through the session's zone.

	The variants carry the `MySql` prefix so nothing collides with `PgValue`'s or
	`SqlValue`'s.
	---
	type MySqlValue =
		| MySqlNull
		| MySqlInteger(value: Int)
		| MySqlUnsigned(value: String)
		| MySqlReal(value: Float)
		| MySqlText(value: String)
		| MySqlBytes(value: Bytes)
		| MySqlBoolean(value: Bool)
		| MySqlTimestamp(value: Instant)
		| MySqlDateTime(value: String)
		| MySqlJson(value: String)
		| MySqlDecimal(value: String)

	---
	What a `MySql.run` changed: `rowCount` is the rows the statement affected
	(for a `SELECT`, returned), and `insertId` the `AUTO_INCREMENT` id of the
	row it inserted, `0` when it inserted none. MySQL has no `RETURNING`, so
	`insertId` is how a handler learns the key of the row it just wrote. An id
	or a count past 2^53 cannot be an `Int`: `run` answers `Err(MySqlFailed(0, …))`
	naming it, rather than a `0` that would mean "inserted none". Outside a
	transaction the statement has still been applied, so do not retry on it
	blindly; inside one, the failure rolls the transaction back.
	---
	type MySqlRun = {
		rowCount: Int,
		insertId: Int,
	}

	---
	Why a `MySql` statement failed, keyed on MySQL's error number. `MySqlConstraint`
	is an integrity-constraint violation (`1062` duplicate key, `1048` a column
	that cannot be null, `1452` and `1451` a foreign key, `3819` a check), an
	outcome a handler answers (with a `409`, say). `MySqlSerialization` is a
	deadlock (`1213`) or a lock wait timeout (`1205`), which a retry may clear.
	`MySqlConnection` is a connection that could not be made or was lost; its
	message names the driver's code and never the host, the user or the
	password. `MySqlFailed` is anything else, with its error number (`0` when the
	driver reported none) and the database's message. MySQL has further failure
	kinds, so a `match` over this type needs a wildcard. The variants carry the
	`MySql` prefix because `Constraint` and `Failed` are `SqlError`'s.
	---
	type MySqlError =
		| MySqlConstraint(code: Int, message: String)
		| MySqlSerialization(code: Int, message: String)
		| MySqlConnection(message: String)
		| MySqlFailed(code: Int, message: String)

	---
	One statement of a `MySql.transaction`: its SQL, a string literal, and its
	positional parameters (`?`). It stays where it is built: it is never stored,
	sent or decoded, since one from outside would carry SQL that was never a
	literal.
	---
	type MySqlStatement = {
		sql: String,
		params: List[MySqlValue],
	}

	---
	Why a typed `MySql` read (`select[T]`, `firstAs[T]`) failed: `MySqlSql` is
	the statement's own failure, `MySqlDecode` a row that did not fit `T` (a
	column whose value disagrees with its field's type). The variants carry the
	`MySql` prefix because `Sql` and `Decode` are `SqlReadError`'s.
	---
	type MySqlReadError =
		| MySqlSql(error: MySqlError)
		| MySqlDecode(error: DecodeError)

	---
	An R2 bucket: objects stored and read as `Bytes` or streamed, with
	metadata, conditional writes and multipart uploads. Used only through a named instance,
	`capability Archives = R2`, which binds as `R2_ARCHIVES`; a bare
	`given R2` names no bucket and is refused. `@jurisdiction("eu")` (or
	`"fedramp"`) pins the bucket's jurisdiction at creation.

	`get`, `put` and `putWith` buffer the object in the Worker's memory, so
	each should stay well under its 128 MB limit. `get` and `head` give `None`
	for a missing key; `delete` is idempotent. `put` writes unconditionally.
	`putWith` honours its `onlyIf` and gives `None` when the condition failed
	(nothing written). `list` returns one page of up to 1000 objects (fewer
	is possible: the cursor decides whether more remain) in key order,
	optionally under a prefix; pass the previous page's `cursor` for the next.

	Larger objects stream. `getStream` gives the object's metadata and its
	body as a `Stream[Bytes]` (serve it with `RawStreamed`). `putStream` and
	`putStreamWith` write a stream of exactly `size` bytes, which R2 needs to
	know up front: a stream that holds more or fewer faults the write, and
	nothing is stored.

	A multipart upload builds one object from parts uploaded separately, in
	any order and across requests: `createUpload`, an `uploadPart` per part
	(numbered from 1, at most 10,000), then `completeUpload` with every part,
	or `abortUpload`. Every part but the last must be the same size, and R2
	needs at least 5 MiB; a completion R2 refuses faults.

	Bucket names are scoped to the Cloudflare account, so `bynk deploy` names
	each `<worker>-<capability, kebab>`, environment-qualified.
	---
	capability R2 {
		fn get(key: String) -> Effect[Option[Bytes]]
		fn head(key: String) -> Effect[Option[R2Object]]
		fn put(key: String, body: Bytes) -> Effect[R2Object]
		fn putWith(key: String, body: Bytes, options: R2Put) -> Effect[Option[R2Object]]
		fn delete(key: String) -> Effect[()]
		fn list(prefix: Option[String], cursor: Option[String]) -> Effect[R2Listing]
		fn getStream(key: String) -> Effect[Option[R2Body]]
		fn putStream(key: String, body: Stream[Bytes], size: Int) -> Effect[R2Object]
		fn putStreamWith(
			key: String,
			body: Stream[Bytes],
			size: Int,
			options: R2Put
		) -> Effect[Option[R2Object]]
		fn createUpload(key: String, options: R2UploadOptions) -> Effect[R2Upload]
		fn uploadPart(upload: R2Upload, partNumber: Int, body: Bytes) -> Effect[R2Part]
		fn completeUpload(upload: R2Upload, parts: List[R2Part]) -> Effect[R2Object]
		fn abortUpload(upload: R2Upload) -> Effect[()]
	}

	---
	A Workers Rate Limiting binding: a counter of calls per key over a fixed
	window. Used only through a named instance that sets both,
	`capability LoginLimit = RateLimit @limit(100) @period(60.seconds)`, which
	binds as `RATELIMIT_LOGIN_LIMIT`; a bare `given RateLimit` sets neither
	and is refused. The period is `10.seconds` or `60.seconds`, the platform's
	only windows.

	`allow(key)` counts one call for `key` and gives `true` while `key` is
	within the limit, `false` once it is over (refuse the request, typically
	with `TooManyRequests`). Counting is approximate: it is kept per Cloudflare
	location and is eventually consistent, so it suits abuse and cost control,
	not billing or exact quotas (use an agent for those). Each instance counts
	on its own: `bynk deploy` gives it its own `namespace_id`.
	---
	capability RateLimit {
		fn allow(key: String) -> Effect[Bool]
	}

	---
	A Cloudflare Queue to send messages to. Used only through a named instance
	that names the queue, `capability OrderEvents = Queue @name("order-events")`,
	which binds as `QUEUE_ORDER_EVENTS`; a bare `given Queue` names no queue and
	is refused. The name is account-wide: every Worker that names the same
	queue shares it, and a Bynk consumer reads it with
	`service … from queue("order-events")`. `bynk deploy` creates the queue
	when it is missing, environment-qualified as a consumer's is.

	A body is JSON text, normally `Json.encode(value)`, and the consumer
	decodes it with its message type; text that is not JSON faults the send.
	`sendValue(message)` is `send(Json.encode(message))` for any `Codable`
	value: it puts exactly the same message on the queue, encoding at the call
	site (`Queue.sendValue(order)`). `sendBatch` sends its bodies in one call,
	all or none. `sendValueWith(message, options)` and `sendValueBatch(messages)`
	are `sendWith` and `sendBatch` for any `Codable` value, encoding at the call
	site: the same messages, the same delay and the same all-or-none rule (a
	message that cannot be encoded faults before anything is sent). The platform caps a
	message at 128 KB and a batch at 100 messages and 256 KB; over a cap, the
	send faults. Delivery is at least once and messages are stored by the
	platform, so make consumers idempotent and keep secrets out of bodies.
	---
	capability Queue {
		fn send(body: String) -> Effect[()]
		fn sendWith(body: String, options: QueueSend) -> Effect[()]
		fn sendBatch(bodies: List[String]) -> Effect[()]
		fn sendValue[T: Codable](message: T) -> Effect[()]
		fn sendValueWith[T: Codable](message: T, options: QueueSend) -> Effect[()]
		fn sendValueBatch[T: Codable](messages: List[T]) -> Effect[()]
	}

	---
	A Workers Analytics Engine dataset to write events to. Used only through a
	named instance, `capability Signups = Analytics`, which binds as
	`ANALYTICS_SIGNUPS`; a bare `given Analytics` is refused. The dataset's
	name is derived, never written: context `shop.cart`'s `Signups` writes to
	`shop_cart_signups`, and to `shop_cart_signups_staging` under
	`--env staging`. The platform creates it on the first write.

	`write` checks the point against the platform's limits (see `DataPoint`)
	and faults on a breach; a Worker invocation may write at most 250 points.
	Writes are sent after the response, so one never delays it. Reading is
	the account's SQL API, outside Bynk. Data is kept for three months and
	readable with any account analytics token, so keep secrets and personal
	data out of it.
	---
	capability Analytics {
		fn write(point: DataPoint) -> Effect[()]
	}

	---
	Cloudflare's edge cache for this context's Worker (Workers Cache), and its
	purge. Used only through a named instance, `capability Edge = EdgeCache`,
	at most one per context; declaring it is what turns the cache on, so a bare
	`given EdgeCache` is refused.

	An opted-in Worker is served through the cache: a `2xx` from a `GET` with
	`@cache(scope: public)` is stored at Cloudflare's edge and served from
	there, without running the Worker, until its `max-age` runs out or it is
	purged. Every other `GET` or `HEAD` response (a route without `@cache`, or
	one that is not a `2xx`, a `404` included) is sent `Cache-Control:
	no-store`, so nothing else is kept. A `public` response is shared with
	every caller, even one sent to a request carrying `Authorization`, so a
	`@cache(scope: public)` route here must be served by an open actor such as
	`Visitor`.

	`purge(prefixes)` removes every cached response whose path starts with one
	of `prefixes`, everywhere, and gives `true` once Cloudflare has accepted the
	purge, `false` when it refused one (purges are rate-limited at Cloudflare's
	Free-tier limits on every plan), so the caller can retry. Each prefix is a
	path starting with `/`, with no query and no control characters; anything
	else faults. An empty list purges nothing and gives `true`.

	The purge reaches the cache only from the Worker's own `fetch`, so it is
	called from a service handler or what one calls; never from an agent, a
	queue consumer or `on schedule` (whose purge Cloudflare accepts but which
	clears nothing). Under `bynk dev` there is no edge cache: every request runs
	the Worker, and `purge` gives `true` after logging that it did nothing.
	---
	capability EdgeCache {
		fn purge(prefixes: List[String]) -> Effect[Bool]
	}

	---
	A D1 database: SQLite, queried with SQL text and positional parameters
	(`?1`, `?2`, …) bound from `SqlValue`s, never spliced into the text. The
	SQL is a string literal, so data reaches a statement only as a parameter. Used
	only through a named instance, `capability Orders = D1`, which binds as
	`D1_ORDERS`; a bare `given D1` names no database and is refused.
	`bynk deploy` creates the database, named `<worker>-<capability, kebab>`
	and environment-qualified, and records its id.

	Rows come back as JSON text for `Json.decodeSql`: `all` gives every row as
	an array of objects keyed by column name (`Json.decodeSql[List[Row]]`),
	`first` the first row as one object, or `None` when there is none. A blob
	column arrives as base64, so a `Bytes` field decodes it. SQLite has no
	boolean: a flag column arrives as `0` or `1`, which `Json.decodeSql` reads
	at a `Bool` field. An integer past ±2^53 cannot be represented and fails
	the decode.

	`select[T]` and `firstAs[T]` read rows straight into a record `T`: the
	argument is the statement from `FROM` on, a string literal that must not
	itself begin with `SELECT`, and the compiler writes the column list from
	`T`'s field names (each quoted), runs the statement and decodes the rows.
	`select` gives `Result[List[T], SqlReadError]`, `firstAs` `Result[Option[T],
	SqlReadError]`; `T` must be a row, as for `Json.decodeSql`.

	`run` executes a write and reports what it changed. `batch` runs its
	statements in order in one transaction: all apply, or none do and the
	result is the failing statement's error. Every operation gives a
	`SqlError` rather than faulting.
	---
	capability D1 {
		fn all(sql: String, params: List[SqlValue]) -> Effect[Result[String, SqlError]]
		fn first(sql: String, params: List[SqlValue]) -> Effect[Result[Option[String], SqlError]]
		fn run(sql: String, params: List[SqlValue]) -> Effect[Result[SqlRun, SqlError]]
		fn batch(statements: List[SqlStatement]) -> Effect[Result[List[SqlRun], SqlError]]
	}

	---
	The version of this Worker that is running, as `Version.current()`
	reports it. `id` is the version's id, `tag` its tag (`None` when the
	version was uploaded without one), and `deployed` when the version was
	created.
	---
	type WorkerVersion = {
		id: String,
		tag: Option[String],
		deployed: Instant,
	}

	---
	The running Worker's version, from Cloudflare's Version metadata binding.
	It is bound once per Worker, so it is used bare (`given Version`) and has
	no named instances. Only a Worker that uses it declares the binding.
	`current()` gives the same value for every call in a deployment: report it
	from a health route, or write it beside an `Analytics` point, to tell
	which version served a request. Under `bynk dev` the id is local; in a
	test the value is fixed (id `"test"`, no tag, `deployed` at the epoch) and
	`stub Version.current() returns …` replaces it.
	---
	capability Version {
		fn current() -> Effect[WorkerVersion]
	}

	---
	Who said a `ChatMessage`. A `System` message sets how the model behaves, a
	`User` message is what it is asked, and an `Assistant` message is an earlier
	reply of the model, to carry a conversation. Cloudflare adds roles over
	time, so a `match` over this type needs a wildcard.
	---
	type ChatRole = enum { System, User, Assistant }

	---
	One message of a conversation for `Ai.generate`.
	---
	type ChatMessage = {
		role: ChatRole,
		content: String,
	}

	---
	The input of `Ai.generate`: the conversation so far in `messages`, which must
	not be empty, and the sampling settings the platform's chat models share.
	A setting left `None` is the model's own default. `maxTokens` caps the
	length of the reply; `temperature` and `topP` shape how varied it is; `seed`
	makes a run repeatable where the model supports it.
	---
	type GenerateRequest = {
		messages: List[ChatMessage],
		maxTokens: Option[Int] = None,
		temperature: Option[Float] = None,
		topP: Option[Float] = None,
		seed: Option[Int] = None,
	}

	---
	The tokens a generation used: `promptTokens` read and `completionTokens`
	written.
	---
	type TokenUsage = {
		promptTokens: Int,
		completionTokens: Int,
	}

	---
	The reply of `Ai.generate`: the model's `text`, which is untrusted input,
	and `usage` when the platform reported it (`None` when it did not).
	---
	type Generation = {
		text: String,
		usage: Option[TokenUsage],
	}

	---
	Why a Workers AI call did not give a reply. `ModelNotFound` is a model id
	the platform does not know, or has retired; `InvalidInput` is a request the
	platform refused as malformed or too large, with its message; `QuotaExceeded`
	is a usage limit of the account, or a model its plan does not include, so
	back off or change the plan; `Overloaded` is the platform's temporary
	capacity, worth retrying; `BadReply` is a reply that is not the shape the
	operation promises (`generate` and `embed` only, never `run`), with what was
	wrong; `AiFailed` is any other refusal, with the platform's message (the `Ai`
	prefix because `Failed` is `SqlError`'s). Cloudflare adds error codes over
	time, so a `match` over this type needs a wildcard.
	---
	type AiError =
		| ModelNotFound
		| InvalidInput(message: String)
		| QuotaExceeded
		| Overloaded
		| BadReply(message: String)
		| AiFailed(message: String)

	---
	Workers AI, from the Worker's `[ai]` binding: it needs no API token and no
	account id. It is bound once per Worker, so it is used bare (`given Ai`)
	and has no named instances. Only a Worker that uses it declares the
	binding.

	`run(model, input)` runs any model by its id (`"@cf/meta/llama-3.2-1b-instruct"`).
	`input` is the model's JSON input as text, and the reply is the model's JSON
	output as text, so a model Cloudflare ships tomorrow works today: build the
	input with `Json.encode` and read the reply with `Json.decode`. An `input`
	that is not a JSON object, or a `model` that is empty or has characters an
	id never has, is a fault. A model that answers with binary data (an image,
	say) is `AiFailed`: `run` carries JSON replies only.

	`generate(model, request)` is chat-style text generation with the same
	request and reply for every chat model: the text is read from the model's
	`response`, or from `choices[0].message.content` for a model that answers in
	that shape. `embed(model, texts)` gives one vector per text, in order, all of
	one length, for a text-embedding model such as `"@cf/baai/bge-base-en-v1.5"`.
	Both return `BadReply` when the platform answers but not in the promised
	shape (a model that is not of that kind, say). An empty `messages` or `texts`
	is a fault. `embed` does not check how many texts one call may carry: the
	limit is the model's, and a call over it is `InvalidInput`. The embeddings use
	the platform's default pooling, so an index built from them stays consistent.

	`runStream(model, input)` is `run` with the reply streamed: the model's own
	events, one element each, as the JSON text of that event (the shape is the
	model's, so a handler that wants text deltas maps the stream and decodes each
	event). The binding asks the model to stream; the terminal `[DONE]` marker
	is consumed, not yielded. A refusal before the stream starts (an unknown
	model, a usage limit) is the `Err`, so a handler can answer with an ordinary
	response; a failure after the first event faults the stream, as a failing
	producer aborts any stream. A model that does not stream is `AiFailed`. Like
	every `Stream`, it is read once and cannot cross a service boundary: the
	handler that calls `runStream` is the one that serves it, as in
	`Streaming(events)`.

	Workers AI is a remote service on your Cloudflare account, so a call
	may be billed, and a model's reply is untrusted input like any other
	user text. See Cloudflare's Workers AI pricing page for what applies,
	and put a `RateLimit` in front of any handler an anonymous caller can reach.
	Under `bynk dev` a call runs the model on Cloudflare. In a test every
	operation faults until `stub Ai.run(_, _) returns …` replaces it, so a
	test never reaches Workers AI.
	---
	capability Ai {
		fn run(model: String, input: String) -> Effect[Result[String, AiError]]
		fn generate(model: String, request: GenerateRequest) -> Effect[Result[Generation, AiError]]
		fn embed(model: String, texts: List[String]) -> Effect[Result[List[List[Float]], AiError]]
		fn runStream(model: String, input: String) -> Effect[Result[Stream[String], AiError]]
	}

	---
	One secret of a Cloudflare Secrets Store, read as `StripeKey.get()`. A
	Secrets Store is account-scoped: its secrets are shared across Workers,
	rotated centrally and bound one per binding, which is what separates this
	from `bynk.Secrets`, whose per-Worker secrets are portable. Used only
	through a named instance that says which store and which secret,
	`capability StripeKey = StoredSecret @store("payments") @secret("stripe-live")`,
	which binds as `SECRET_STRIPE_KEY`; both annotations are required, and a
	bare `given StoredSecret` is refused.

	`bynk deploy` links the instance and never creates anything: it looks the
	store up by name, records its id in `bynk.deploy.lock`, and fails, naming
	the store and the secret, when either is missing (create the secret with
	`wrangler secrets-store secret create`). The deploy needs
	`CLOUDFLARE_API_TOKEN` and `CLOUDFLARE_ACCOUNT_ID`, the token with
	"Secrets Store: Read". `get` returns the value as a `String`, not an
	`Option`: the binding exists only if the deploy found the secret, so an
	absence at run time is a platform fault, not something a handler can act
	on. The value is not logged by Bynk; do not log it either. Under `bynk dev`
	the secret is read from the local store, and a test faults until
	`stub StripeKey.get() returns …` gives it a value.
	---
	capability StoredSecret {
		fn get() -> Effect[String]
	}

	---
	Outbound email through Cloudflare Email Service. Used only through a named
	instance, `capability Mail = Email @allowedSenders(["orders@shop.example"])`,
	which binds as `EMAIL_MAIL`, a `[[send_email]]` entry. The options are
	all optional deploy-time policy: `@to("ops@shop.example")` pins every
	message to one recipient, `@allowedRecipients([…])` limits the recipients
	and `@allowedSenders([…])` limits the senders. An unknown annotation is
	refused.

	`send` returns the platform's message id, or an `EmailError` for an
	outcome a handler acts on. A call that breaks a documented limit is a
	programming error and faults before it reaches the platform: more than
	50 recipients across `to`, `cc` and `bcc`, more than 32 attachments,
	more than 25 MiB in total (attachments counted as base64, as sent), no
	recipient at all, neither `text` nor
	`html`, a reserved header (see `EmailMessage`) or a line break in a header's
	name or value. Attachments go to the platform as base64 text, which both
	the platform and `wrangler dev` accept; message bodies and attachment
	content are never logged by Bynk.

	`bynk deploy` checks, for each `@allowedSenders` address, that its domain
	has Email Sending enabled on the account, and fails naming the domain
	when it does not; it never configures a domain. It needs
	`CLOUDFLARE_API_TOKEN` and `CLOUDFLARE_ACCOUNT_ID`. Without
	`@allowedSenders`, an unverified `from` surfaces at run time as
	`SenderNotVerified`.

	A handler that sends mail is a spam relay if anyone can call it: put a
	`RateLimit` in front of it. Under `bynk dev`, a message with an
	attachment the local simulator cannot serialise should be tried with
	`--remote`. A test records every sent `EmailMessage` without a stub, so
	`expect Mail.send called with …` works, and a stub can force an
	`EmailError`.
	---
	capability Email {
		fn send(message: EmailMessage) -> Effect[Result[String, EmailError]]
	}

	---
	A Postgres database reached through Cloudflare Hyperdrive, over postgres.js:
	SQL text and positional parameters (`$1`, `$2`, …) bound from `PgValue`s,
	never spliced into the text. The SQL is a string literal, so data reaches
	a statement only as a parameter. Used only through a named instance,
	`capability Main = Postgres`, which binds as `HYPERDRIVE_MAIN`, a
	`[[hyperdrive]]` entry; a bare `given Postgres` names no database and is
	refused. Experimental.

	`bynk deploy` makes the Hyperdrive configuration, from the connection
	string in the environment variable `[deploy.hyperdrive.Main]
	connection_env` names in `bynk.toml`, or adopts one named by `config_id`;
	the generated `wrangler.toml` carries a placeholder `id` it replaces.
	`bynk dev` reads the local connection string from the variable
	`[dev.hyperdrive.Main] connection_env` names. A connection string is never
	written to `bynk.toml` (see "Connect an existing Postgres database" in the
	Book).

	Rows come back as JSON text for `Json.decode`: `all` gives every row as an
	array of objects keyed by column name, `first` the first row as one object,
	or `None` when there is none. `int8` (`bigint`) and `numeric` arrive as
	strings, so nothing past 2^53 is lost; `timestamptz` as ISO-8601 text;
	`bytea` as base64 (a `Bytes` field decodes it); `json` and `jsonb` nested as
	JSON. A `boolean` arrives as `true` or `false`, not `0` or `1`.

	`select[T]` and `firstAs[T]` read rows straight into a record `T`: the
	argument is the statement from `FROM` on, a string literal that must not
	itself begin with `SELECT`, and the compiler writes the column list from
	`T`'s field names (each quoted in Postgres style: double quotes, an
	embedded quote doubled), runs the statement and decodes the rows. `select`
	gives `Result[List[T], PgReadError]`, `firstAs` `Result[Option[T],
	PgReadError]`. A row field is an `Int`, `Float`, `String`, `Bool`, `Bytes`,
	`Decimal` or `Instant` (or a refined or opaque type over one, or an
	`Option` of either). An `Int` reads an `int8` that arrives as text, and an
	`Instant` reads the ISO-8601 text of a `timestamptz`, with any offset.

	`transaction` runs its statements in order on one connection, in one
	transaction: all apply, or none do and the result is the failing
	statement's error. It runs a fixed list; a read that decides a later write
	needs an interactive transaction, which this does not offer.

	`run` executes a write and reports the rows it changed. Every operation
	gives a `PgError` rather than faulting. Each statement uses its own
	connection, opened and closed around it, and Cloudflare allows six
	simultaneous connections per Worker invocation, so a `par` over more than
	six queries waits for its turn.
	---
	capability Postgres {
		fn all(sql: String, params: List[PgValue]) -> Effect[Result[String, PgError]]
		fn first(sql: String, params: List[PgValue]) -> Effect[Result[Option[String], PgError]]
		fn run(sql: String, params: List[PgValue]) -> Effect[Result[PgRun, PgError]]
		fn transaction(statements: List[PgStatement]) -> Effect[Result[List[PgRun], PgError]]
	}

	---
	A MySQL (or MariaDB) database reached through Cloudflare Hyperdrive, over
	mysql2: SQL text and positional parameters (`?`) bound from `MySqlValue`s.
	The SQL is a string literal, so data reaches a statement only as a
	parameter. Used only through a named instance, `capability Legacy = MySql`,
	which binds as `HYPERDRIVE_LEGACY`, a `[[hyperdrive]]` entry; a bare
	`given MySql` names no database and is refused. Experimental.

	`@tls("…")` sets how Hyperdrive secures its connection to the database:
	`"required"` (the default), `"verify-ca"` or `"verify-identity"`. Anything
	else is refused. The Worker's own connection to Hyperdrive is not part of
	it. `bynk deploy` sends the mode with the config it makes; the two `verify`
	modes need a CA certificate the account holds, which `bynk deploy` does not
	upload, so such an instance takes a config that exists (`config_id` in
	`[deploy.hyperdrive.Legacy]`).

	Deploy and `bynk dev` work as for `Postgres`: the connection string is
	named by `[deploy.hyperdrive.Legacy] connection_env` in `bynk.toml` and is a
	secret, a `mysql://user:password@host:3306/database` URL. A statement's
	parameters are substituted by the driver as escaped literals (mysql2's
	`query`) and not sent as a prepared statement, so `LIMIT ?, ?` works and a
	statement survives Hyperdrive's transaction pooling. `??` (mysql2's
	identifier placeholder) is not supported.

	Rows come back as JSON text for `Json.decode`: `all` gives every row as an
	array of objects keyed by column name, `first` the first row as one object,
	or `None` when there is none. A `BIGINT` (signed or unsigned) and a `DECIMAL`
	arrive as strings, so nothing past 2^53 is lost; a `TINYINT(1)` arrives as
	`true` or `false` (any other `TINYINT` as a number); a `BLOB` as base64; a
	`JSON` column nested. `DATETIME`, `TIMESTAMP` and `DATE` arrive as the
	server's text, `2026-11-12 09:30:00`, with no zone on it: a `String` field
	reads it and an `Instant` field refuses it.

	`select[T]` and `firstAs[T]` read rows straight into a record `T`: the
	argument is the statement from `FROM` on, a string literal that must not
	itself begin with `SELECT`, and the compiler writes the column list from
	`T`'s field names (each quoted with backticks, an embedded backtick
	doubled), runs the statement and decodes the rows. `select` gives
	`Result[List[T], MySqlReadError]`, `firstAs` `Result[Option[T],
	MySqlReadError]`.

	`transaction` runs its statements in order on one connection, in one
	transaction: all apply, or none do and the result is the failing
	statement's error. It runs a fixed list; a read that decides a later write
	needs an interactive transaction, which this does not offer. `run`
	executes a write and reports the rows it changed and the id it inserted.
	Every operation gives a `MySqlError` rather than faulting. Each statement
	uses its own connection, and Cloudflare allows six simultaneous connections
	per Worker invocation.
	---
	capability MySql {
		fn all(sql: String, params: List[MySqlValue]) -> Effect[Result[String, MySqlError]]
		fn first(
			sql: String,
			params: List[MySqlValue]
		) -> Effect[Result[Option[String], MySqlError]]
		fn run(sql: String, params: List[MySqlValue]) -> Effect[Result[MySqlRun, MySqlError]]
		fn transaction(
			statements: List[MySqlStatement]
		) -> Effect[Result[List[MySqlRun], MySqlError]]
	}

	---
	One vector of a `Vectorize` index: its `id` (at most 64 bytes), its `values`
	(as many numbers as the index has dimensions), the `namespace` it lives in
	when it has one, and `metadata`, a JSON object as text (`Json.encode` writes
	it, `Json.decode` reads it back). A property can be filtered on only when
	the index declares it in `@indexed`.
	---
	type Vector = {
		id: String,
		values: List[Float],
		metadata: Option[String] = None,
		namespace: Option[String] = None,
	}

	---
	One vector to write with typed metadata: a `Vector` whose `metadata` is a
	value of `M`, which `upsertValue` encodes with `M`'s codec. Reading is not
	typed: `getByIds` and a query's matches give the metadata as text, so a
	vector stored by an older version of `M` can be skipped or repaired.
	Keep the properties a query filters on plain (not `Option`): an `Option` is
	written as a tagged object, as `Json.encode` writes it, so a filter on it
	would never match.
	---
	type VectorOf[M] = {
		id: String,
		values: List[Float],
		metadata: Option[M] = None,
		namespace: Option[String] = None,
	}

	---
	A metadata value a `Condition` compares a property with: text, a number or
	a flag.
	---
	type MetaValue =
		| MetaText(value: String)
		| MetaNumber(value: Float)
		| MetaFlag(value: Bool)

	---
	How a `Condition` compares a property with a value: equal, not equal, less
	than, at most, greater than, at least, one of a list, or none of a list.
	The platform allows a range over text or numbers only, and a lower and an
	upper bound on one property together, not other mixes; it refuses the
	rest as `VectorInvalidInput`.
	---
	type FilterOp =
		| FilterEq(value: MetaValue)
		| FilterNe(value: MetaValue)
		| FilterLt(value: MetaValue)
		| FilterLte(value: MetaValue)
		| FilterGt(value: MetaValue)
		| FilterGte(value: MetaValue)
		| FilterAnyOf(values: List[MetaValue])
		| FilterNoneOf(values: List[MetaValue])

	---
	One test of a `Vectorize` query: the metadata property `field` (a dot nests, as in
	`"author.name"`) against `op`. A query's conditions all have to hold.
	The property has to be declared in the index's `@indexed`, and a vector
	only matches once it was written after that index existed. A text property
	is indexed by its first 64 bytes only.
	---
	type Condition = {
		field: String,
		op: FilterOp,
	}

	---
	How much metadata a `Vectorize` query returns: `Omit` none (the default),
	`Indexed` only the `@indexed` properties, `All` every property. `All` costs
	the platform more work and lowers how many matches one query may return.
	---
	type MetadataScope = enum { Omit, Indexed, All }

	---
	The options of `Vectorize.query`. `topK` is how many matches to return
	(5 unless set; the platform caps it, and caps it lower when `returnValues`
	is set or `returnMetadata` is `All`, and says so as `VectorInvalidInput`).
	`namespace` restricts the query to one namespace. `filter` is a list of
	conditions that must all hold.
	---
	type QueryOptions = {
		topK: Int = 5,
		returnValues: Bool = false,
		returnMetadata: MetadataScope = MetadataScope.Omit,
		namespace: Option[String] = None,
		filter: List[Condition] = [],
	}

	---
	One match of `Vectorize.query`: the vector's `id` and its `score`, whose
	meaning depends on the index's metric (a larger cosine score is nearer; a
	smaller euclidean distance is nearer). `values`, `metadata` (a JSON object
	as text) and `namespace` are present when the query asked for them and the
	vector has them.
	---
	type VectorMatch = {
		id: String,
		score: Float,
		values: Option[List[Float]],
		metadata: Option[String],
		namespace: Option[String],
	}

	---
	The receipt of a write: its `id`. A write is asynchronous. It is queryable
	after the platform has processed it, which takes some seconds, so a handler
	that writes and then queries in the same request will not see its own write.
	---
	type Mutation = {
		id: String,
	}

	---
	An index's configuration, as `Vectorize.describe` reports it: its
	`dimensions` and its `metric`.
	---
	type IndexInfo = {
		dimensions: Int,
		metric: String,
	}

	---
	Why a Vectorize call did not succeed. `DimensionMismatch` is a vector or
	query whose length is not the index's dimensions, with the platform's
	message; `VectorInvalidInput` is a request the platform refused as malformed
	or over a limit (a bad filter, too large a `topK`, too large a batch or too
	much metadata); `VectorRateLimited` is a rate limit, worth retrying later;
	`VectorFailed` is any other refusal, with the platform's message. The
	`Vector` prefix is because `InvalidInput` is `AiError`'s, `RateLimited`
	`EmailError`'s and `Failed` `SqlError`'s. Cloudflare adds error cases over
	time, so a `match` over this type needs a wildcard.
	---
	type VectorError =
		| DimensionMismatch(message: String)
		| VectorInvalidInput(message: String)
		| VectorRateLimited
		| VectorFailed(message: String)

	---
	A Vectorize index: vectors with an id, searched by similarity. Used only
	through a named instance that states the index's fixed shape,
	`capability Docs = Vectorize @dimensions(768) @metric("cosine")`, which
	binds as `VECTORIZE_DOCS`, a `[[vectorize]]` entry; both annotations are
	required, and a bare `given Vectorize` is refused. `@metric` is `"cosine"`,
	`"euclidean"` or `"dot-product"`. Experimental.

	An index's dimensions and metric cannot change once it exists, so they are
	written next to the code that depends on them. `@indexed(["category:string",
	"year:number"])` lists the metadata properties a query may filter on (at
	most 10, each `name:type` with the type `string`, `number` or `boolean`).
	Metadata indexes should exist before the vectors that carry the property.

	`upsert` writes vectors, replacing any with the same id in full; `insert`
	writes only vectors whose id is new. `upsertValue(vectors)` is `upsert` with
	the metadata of each `VectorOf[M]` encoded by `M`'s codec, as
	`Queue.sendValue` encodes a message. `query(vector, options)` returns the
	nearest matches, best first. `getByIds` reads vectors back, `deleteByIds`
	removes them, and `describe` reports the index's dimensions and metric.
	Metadata is JSON text: write it with `Json.encode` and read it with
	`Json.decode`, so a vector stored by an older version of the program can be
	skipped or repaired instead of failing the query. The embeddings of
	`Ai.embed` are the usual `values`; an index must be queried with the same
	model and pooling it was built with.

	A write returns a `Mutation` and is visible to queries only after the
	platform has processed it. Every operation gives a `VectorError` rather
	than faulting, except a call on an index that does not exist, which is a
	platform fault.

	Vectorize is a remote service on your Cloudflare account, so a call may be
	billed; see Cloudflare's Vectorize pricing page for what applies, and put a
	`RateLimit` in front of any handler an anonymous caller can reach.

	In a test each instance is an in-memory index built from its declaration,
	so a test never reaches Cloudflare and a retrieval flow (store, filter,
	rank) runs. It ranks exactly where production ranks approximately, and a
	write is visible at once where production takes some seconds; those are
	its two differences. It enforces the dimensions, namespaces, insert versus
	upsert, all eight filter operators and the platform limits as of
	2026-11-13 (a limit it refuses is a `VectorInvalidInput`). A filter on a
	property that is not in `@indexed` faults, naming the difference, because
	production silently matches nothing for it. `stub Docs.query(_, _) returns …`
	still replaces any operation.
	---
	capability Vectorize {
		fn upsert(vectors: List[Vector]) -> Effect[Result[Mutation, VectorError]]
		fn insert(vectors: List[Vector]) -> Effect[Result[Mutation, VectorError]]
		fn upsertValue[M: Codable](
			vectors: List[VectorOf[M]]
		) -> Effect[Result[Mutation, VectorError]]
		fn query(
			vector: List[Float],
			options: QueryOptions
		) -> Effect[Result[List[VectorMatch], VectorError]]
		fn getByIds(ids: List[String]) -> Effect[Result[List[Vector], VectorError]]
		fn deleteByIds(ids: List[String]) -> Effect[Result[Mutation, VectorError]]
		fn describe() -> Effect[Result[IndexInfo, VectorError]]
	}

	---
	One retrieved chunk of an `AiSearch` instance: the chunk's `id`, its `score`
	(0 to 1, larger is a closer match), its `text`, and where it came from: `key`
	is the source file's path or the page's URL, `timestamp` the source item's
	unix time in milliseconds when the platform reports one (a `timestamp`
	condition in `SearchOptions.filter` compares in the same unit), and `metadata` the item's custom
	metadata as a JSON object in text (`None` when it has none). The text is
	indexed content, so treat it as untrusted input.
	---
	type SearchHit = {
		id: String,
		score: Float,
		text: String,
		key: String,
		timestamp: Option[Int],
		metadata: Option[String],
	}

	---
	How an `AiSearch` query finds chunks: by `Vector` (meaning), by `Keyword`
	(words), or `Hybrid`, both together. The platform's default is `Hybrid`.
	---
	type RetrievalType = enum { Vector, Keyword, Hybrid }

	---
	The options of `AiSearch.search` and `AiSearch.answer` (for `answer` they
	shape its retrieval step). A setting left `None` or `false` leaves the
	platform's own default in place: `maxResults` is how many chunks to return
	(1 to 50, 10 unless set), `matchThreshold` the least score a chunk may have
	(0 to 1, 0.4 unless set), and `retrieval` how chunks are found. `rewriteQuery`
	has the instance rewrite the question for better retrieval, and `rerank`
	has it reorder the chunks with a reranking model; both use the models the
	platform picks. `filter` is a list of conditions on the items' attributes
	(`folder`, `timestamp`, `filename`) and on the instance's custom metadata
	(at most five fields), and every condition must hold. A text value is
	matched on its first 64 bytes only. Out-of-range values are refused as
	`SearchInvalidInput`.
	---
	type SearchOptions = {
		maxResults: Option[Int] = None,
		matchThreshold: Option[Float] = None,
		retrieval: Option[RetrievalType] = None,
		rewriteQuery: Bool = false,
		rerank: Bool = false,
		filter: List[Condition] = [],
	}

	---
	The reply of `AiSearch.answer`: the generated `text`, which is untrusted
	input, the `hits` it was grounded on, and the `usage` of the generation when
	the platform reported it.
	---
	type SearchAnswer = {
		text: String,
		hits: List[SearchHit],
		usage: Option[TokenUsage],
	}

	---
	Why an AI Search call did not give a reply. `SearchInvalidInput` is a
	request the platform refused as malformed or out of range (a bad filter or
	option), with its message; `SearchRateLimited` is a rate limit, worth
	retrying later; `SearchQuotaExceeded` is a usage limit of the account;
	`SearchFailed` is any other refusal, or a reply that is not the shape the
	operation promises, with a message. The `Search` prefix is because
	`InvalidInput` is `AiError`'s, `RateLimited` `EmailError`'s, `QuotaExceeded`
	`AiError`'s and `Failed` `SqlError`'s. Cloudflare adds error cases over time,
	so a `match` over this type needs a wildcard.
	---
	type SearchError =
		| SearchInvalidInput(message: String)
		| SearchRateLimited
		| SearchQuotaExceeded
		| SearchFailed(message: String)

	---
	An AI Search instance: a managed retrieval service that indexes a data source
	(an R2 bucket, a website, files uploaded to it) and answers from it. Used
	only through a named instance that names it,
	`capability Kb = AiSearch @instance("support-docs")`, which binds as
	`AI_SEARCH_KB`, an `[[ai_search]]` entry; the annotation is required, and a
	bare `given AiSearch` is refused. Experimental.

	The instance is not created by Bynk. It is configured by whoever owns it (the
	data source, the models, the chunking, how it is kept in sync), so you create
	it in the Cloudflare dashboard, with `wrangler` or the REST API, and the
	Worker only queries it. The name is used as written in every environment.
	To fill an instance backed by an R2 bucket, write the files with `R2.put`;
	the instance indexes them on its own schedule, so a freshly written file is
	not searchable at once, and a query against an instance that has indexed
	nothing yet is an empty list, not an error.

	`search(query, options)` returns the best-matching chunks, best first, for a
	handler that shows results or builds its own prompt (with `Ai.generate`).
	`answer(messages, options)` retrieves the same way and has the instance's own
	generation model write the reply from the conversation, which must not be
	empty; a `SearchAnswer` carries the text, the chunks it used and the token usage.
	The generation model is the instance's setting and a call cannot override
	it. Every operation gives a `SearchError` rather than faulting, except a call
	on an instance that does not exist, which is a platform fault.

	AI Search is a remote service on your Cloudflare account, so a call may be
	billed; see Cloudflare's AI Search pricing page for what applies, and put a
	`RateLimit` in front of any handler an anonymous caller can reach. Under
	`bynk dev` a call goes to the deployed instance on Cloudflare. In a test every
	operation faults until `stub Kb.search(_, _) returns …` replaces it, so a test
	never reaches AI Search; to test retrieval logic, use `Vectorize`, which
	has an in-memory double.
	---
	capability AiSearch {
		fn search(
			query: String,
			options: SearchOptions
		) -> Effect[Result[List[SearchHit], SearchError]]
		fn answer(
			messages: List[ChatMessage],
			options: SearchOptions
		) -> Effect[Result[SearchAnswer, SearchError]]
	}

	---
	Why a `Container` call did not succeed. `StartFailed` is a container that
	would not start, or whose port never listened, with a message; `Unavailable`
	is the platform declining to start another instance (the account's limits);
	`Timeout` is a start or a call that took too long; `Network` is a failure
	reaching the instance. Cloudflare adds error cases over time, so a `match`
	over this type needs a wildcard.
	---
	type ContainerError =
		| StartFailed(message: String)
		| Unavailable
		| Timeout
		| Network

	---
	A container: a server in a Docker image, run on Cloudflare and reached over
	HTTP on one port. Used only through a named instance,
	`capability Renderer = Container @build("containers/renderer") @port(8080)`,
	which binds as `CONTAINER_RENDERER`, a Durable Object class the compiler
	generates; a bare `given Container` is refused. `@build` is the
	project-relative directory that holds the `Dockerfile`, and `@port` the
	port its server listens on; both are required. Experimental.

	`@sleepAfter(5.minutes)` stops an idle container after that long (more than
	zero, at most 6 hours); left out, the platform stops it shortly after the
	instance goes inactive, with no figure to rely on. `@instanceType` is
	`"lite"` (the default), `"standard-1"`, `"standard-2"`, `"standard-3"` or
	`"standard-4"`. `@forward(["API_KEY"])` names Worker secrets the container's
	process reads from its environment: every process and dependency in the
	image can read them, and Bynk cannot scope them further.

	`send(instance, req)` sends `req` to the container named `instance` and
	returns its response; `receiveBytes` returns the body as `Bytes`, and
	`sendBytes` sends `body` as the request body (`req.body` must be `None`).
	`Request`, `Response` and `BytesResponse` are `bynk`'s, so a context that
	calls them also writes `consumes bynk`. The URL's host is not used for
	routing, but the URL must be absolute, and the container sees it.

	`instance` is the name of one container instance, one process: the same
	name reaches the same instance, and a new name starts a new one. It is a
	runtime value, so a handler can use one per tenant, and it is not a secret:
	names appear in Cloudflare's dashboards and logs. A name that is empty, over
	256 bytes or holds a control character faults the call. The first call to an
	instance starts its container, which takes noticeable time, longer for a
	larger image. A container is not storage: its disk is ephemeral.

	A container has no internet access: Bynk always starts it with outbound
	access off. Images must be built for `linux/amd64` and live in Cloudflare's
	registry. `bynk.cloudflare` puts no ceiling on instances: names are chosen
	by the caller and only the account's limits apply, so choose `@sleepAfter`
	and `@instanceType` with that in mind. A running container costs money; see
	Cloudflare's Containers pricing and limits pages for what applies. A slow
	call from inside an agent handler holds that agent's queue, so call from a
	service and hand the result to the agent.

	Deploy with `wrangler deploy` (Docker running, Wrangler 4.136.0 or later).
	In a test every operation faults until `stub Renderer.send(_, _) returns …`
	replaces it, so a test never starts a container.
	---
	capability Container {
		fn send(instance: String, req: Request) -> Effect[Result[Response, ContainerError]]
		fn receiveBytes(
			instance: String,
			req: Request
		) -> Effect[Result[BytesResponse, ContainerError]]
		fn sendBytes(
			instance: String,
			req: Request,
			body: Bytes
		) -> Effect[Result[BytesResponse, ContainerError]]
	}

	provides Kv = WorkersKv

	provides Service = WorkersService

	provides R2 = WorkersR2

	provides RateLimit = WorkersRateLimit

	provides Queue = WorkersQueue

	provides Analytics = WorkersAnalytics

	provides EdgeCache = WorkersEdgeCache

	provides D1 = WorkersD1

	provides Version = WorkersVersion

	provides Ai = WorkersAi

	provides StoredSecret = WorkersStoredSecret

	provides Email = WorkersEmail

	provides Postgres = WorkersPostgres

	provides MySql = WorkersMySql

	provides Vectorize = WorkersVectorize

	provides Container = WorkersContainer

	provides AiSearch = WorkersAiSearch
}
