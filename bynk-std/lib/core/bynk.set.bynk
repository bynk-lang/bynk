commons bynk.set {
	---
	Deprecated: use `a.union(b)`. Every element of `a`, then every element of
	`b` not already in `a`, in that order.
	---
	fn union[T: Key](a: Set[T], b: Set[T]) -> Set[T] {
		a.union(b)
	}

	---
	Deprecated: use `a.intersect(b)`. The elements of `a` that are also in `b`,
	in `a`'s order.
	---
	fn intersect[T: Key](a: Set[T], b: Set[T]) -> Set[T] {
		a.intersect(b)
	}

	---
	Deprecated: use `a.difference(b)`. The elements of `a` that are not in `b`,
	in `a`'s order.
	---
	fn difference[T: Key](a: Set[T], b: Set[T]) -> Set[T] {
		a.difference(b)
	}

	---
	Deprecated: use `a.isSubsetOf(b)`. Whether every element of `a` is in `b`.
	---
	fn isSubsetOf[T: Key](a: Set[T], b: Set[T]) -> Bool {
		a.isSubsetOf(b)
	}

	---
	Deprecated: use `s.filter(p)`. The elements of `s` for which `p` holds, in
	order. Named apart from `bynk.list`'s `filter`, so a unit can use both
	commons.
	---
	fn filterSet[T: Key](s: Set[T], p: T -> Bool) -> Set[T] {
		s.filter(p)
	}

	---
	Deprecated: use `s.map(f)`. `f` applied to each element of `s`, in order.
	Elements that map to the same value collapse to one, at the first one's
	position; the result type must itself be value-keyable. Named apart from
	`bynk.list`'s `map`, so a unit can use both commons.
	---
	fn mapSet[A: Key, B: Key](s: Set[A], f: A -> B) -> Set[B] {
		s.map(f)
	}
}
