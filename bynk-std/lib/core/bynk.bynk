adapter bynk {
	uses bynk.locale.types
	exports capability { Clock, Random, Logger, Fetch, Secrets, Locale, Idempotency, Events }
	exports opaque { Secret, Authorization }
	exports transparent {
		Uuid,
		CronSchedule,
		Method,
		FetchError,
		Request,
		Response,
		BytesResponse,
		StreamResponse,
		File,
		Cookie,
		SameSite,
		SseEvent,
		CloseInfo,
		ContentRange,
		FetchOptions,
		ParOptions,
		Redirect,
		TimedOut,
		CallOutcome,
		CallFailure,
		Refusal,
		LogLevel,
		Claim,
		EventEnvelope,
	}

	---
	A secret read from the platform's secret store. It cannot leak by accident: it
	has no string form (it cannot be interpolated), is not `Eq` or a `Key`
	(comparing two is variable-time; use `matches`), and is not `Codable`, so it is
	never stored, sent, encoded or returned across a boundary
	(`bynk.types.secret_at_boundary`). `reveal()` is the one explicit way to the
	text, and `matches(candidate)` the constant-time comparison.
	---
	type Secret = opaque String

	---
	The credential of a request's `Authorization` header: `token.bearer()` for
	`Bearer <token>` and `password.basic(user)` for `Basic <user:password>`,
	made from a `Secret`. It carries the secret without ever being text: it has
	no string form, is not `Eq`, a `Key` or `Codable`, and cannot be stored or
	sent (`bynk.types.secret_at_boundary`), and it has no reader of its own,
	because `Fetch` is the only place it is revealed. It is set on a request as
	`authorization: Some(token.bearer())`.
	---
	type Authorization = opaque String

	---
	A UUID in canonical 8-4-4-4-12 lowercase-hex form.
	---
	type Uuid = String where Matches("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")

	---
	A valid Cloudflare cron schedule: five fields (minute hour day-of-month month
	day-of-week) separated by exactly one space, run in UTC. A literal is checked
	at compile time; `CronSchedule.of`, decoding and a boundary check at run time.
	---
	type CronSchedule = String where Cron

	---
	An HTTP request method. A `Head` response's `body` is `""`.
	---
	type Method = enum { Get, Post, Put, Delete, Patch, Head, Options }

	---
	Why an outbound `Fetch.send` failed: a network error, a timeout, a
	request whose headers `Fetch.send` refused to send (`InvalidHeader`), or
	one whose body it refused to send (`InvalidBody`). An
	`InvalidHeader` request never reaches the network: its `headers` named
	Content-Type or Authorization while the matching typed slot was `Some`,
	named a header the platform owns (`host`, `content-length`, and the other
	framing/hop-by-hop headers), named one header twice in different case, or
	held a name or value that is not a legal HTTP header; or a typed slot
	(`contentType`, `authorization`) held a value that is not a legal header
	value — a secret with a stray newline, say. An `InvalidBody` request never
	reaches the network either: a `Get` or `Head` carried a body, which HTTP
	forbids, or `Fetch.sendBytes` was given a `Bytes` body while `req.body`
	was also `Some`. Retrying cannot fix either.
	---
	type FetchError = enum { Network, Timeout, InvalidHeader, InvalidBody }

	---
	An outbound HTTP request, as passed to `Fetch.send`. `contentType` and
	`authorization` are the typed slots for the two common headers; `headers`
	carries any other (`User-Agent`, `Accept`, `If-None-Match`, …), and an empty
	map (`Map.empty()`) sends none. Header names are case-insensitive. A
	`headers` entry for Content-Type or Authorization is accepted only while the
	matching typed slot is `None` — when both are given, `Fetch.send` returns
	`Err(InvalidHeader)` rather than let one silently win. Names the platform
	owns — `host`, `content-length`, `connection`, `keep-alive`, `te`,
	`trailer`, `transfer-encoding`, `upgrade`, `expect` — are refused the same
	way, as is a duplicate name differing only in case.
	---
	type Request = {
		method: Method,
		url: String,
		contentType: Option[String],
		authorization: Option[Authorization],
		headers: Map[String, String],
		body: Option[String],
	}

	---
	What `Fetch.sendWith` does with a redirect: `Follow` it, as `send` does, or
	return the `3xx` itself (`Manual`), `location` header included, so the
	caller decides where to go.
	---
	type Redirect = enum { Follow, Manual }

	---
	The options of a `Fetch.sendWith`. `timeout` bounds the whole exchange,
	response body included, for `sendWith`, `receiveBytes` and `sendBytes`; for
	`receiveStream` and `sendStream` it bounds the response head only, so a
	streamed body may take as long as the platform allows. When it elapses the
	result is `Err(Timeout)`. A
	timeout of zero or less, or over 2,147,483,647 ms (about 24 days, the
	longest a platform timer takes), faults the call, with nothing sent. `None` waits as
	long as the platform does. Each field defaults to what `send` does, so
	`FetchOptions {}` is `send`.
	---
	type FetchOptions = {
		timeout: Option[Duration] = None,
		redirect: Redirect = Redirect.Follow,
	}

	---
	The options of the bounded fan-out methods `parForEachWith`, `parTraverseWith`,
	`parTraverseAllWith` and `parTraverseTryWith`. `limit` is the most steps in
	flight at once: a whole number from 1 to 1000, with no default, so a call
	always states it. A literal or constant outside that range is the error
	`bynk.list.par_limit_range`; a computed one faults the call.
	---
	type ParOptions = {
		limit: Int,
	}

	---
	Why an `e.within(d)` produced no value: the deadline `after` passed first.
	The abandoned effect is **not** cancelled. It is handed to the platform's
	`waitUntil` and may still complete after the handler has returned, so its
	side effects (a write, a commit in another agent) can still happen. Use
	`FetchOptions.timeout` when the work must actually stop.
	---
	type TimedOut = {
		after: Duration,
	}

	---
	What a cross-context service call came to, as `<context>.<service>.outcome(args)`
	yields it. The variants are grouped by whether the callee's handler ran:
	`Handled` it ran and answered with `result`; `Rejected` it was refused before it
	ran, for the `reason`; `Faulted` it ran and faulted (a faulting handler commits
	nothing); `Unreachable` it is not known whether it ran, with the HTTP `status`
	when there was a response. Only `.outcome(…)` and a test `stub` make one.
	---
	type CallOutcome[R] =
		| Handled(result: R)
		| Rejected(reason: Refusal)
		| Faulted
		| Unreachable(status: Option[Int])

	---
	`Handled(r)` becomes `Ok(r)`; any other case becomes `Err` of the matching
	`CallFailure`, so `outcome(…).handled()?` propagates a failed call with `?`
	and `embeds`.
	---
	fn CallOutcome.handled(self) -> Result[R, CallFailure] {
		match self {
			Handled(r) => Ok(r),
			Rejected(reason) => Err(Rejected(reason)),
			Faulted => Err(Faulted),
			Unreachable(status) => Err(Unreachable(status)),
		}
	}

	---
	Why a call did not come to `Handled`: `CallOutcome[R]` without its `Handled`
	case, as `outcome(…).handled()` yields it in the `Err` of a `Result`. An
	ordinary sum, so `embeds` can wrap it into a caller's own error type.
	---
	type CallFailure =
		| Rejected(reason: Refusal)
		| Faulted
		| Unreachable(status: Option[Int])

	---
	Why the callee refused a call before its handler ran, one case per check the
	wire makes: `TooLarge` (413), `NotAuthenticated` (401), `UnsupportedWire`
	(400), `NoSuchService` (404), `NotAdmitted` (403), `StaleContract` (409) and
	`Undecodable` (400, a body that is not the service's arguments).
	---
	type Refusal = enum {
		TooLarge,
		NotAuthenticated,
		UnsupportedWire,
		NoSuchService,
		NotAdmitted,
		StaleContract,
		Undecodable,
	}

	---
	The level of a `Logger.log` record.
	---
	type LogLevel = enum { Debug, Info, Warn, Error }

	---
	An HTTP response: a status code, its headers, and a body. `headers` keys
	are lowercased (`res.headers.get("etag")`); a header the server repeated
	arrives as one value, joined with ", ". That includes `set-cookie`, and
	there the join is lossy: a cookie's `Expires` attribute holds a comma, so
	a joined `set-cookie` cannot be split back into its cookies reliably.
	---
	type Response = {
		status: Int,
		headers: Map[String, String],
		body: String,
	}

	---
	An HTTP response whose body is raw bytes, as `Fetch.receiveBytes` and
	`Fetch.sendBytes` return it: every byte as the server sent it, where
	`Response.body` would have decoded it as UTF-8. `headers` are as
	`Response`'s. `b.decodeUtf8()` reads a body that is really text.
	---
	type BytesResponse = {
		status: Int,
		headers: Map[String, String],
		body: Bytes,
	}

	---
	A file part of a `@multipart` request body: what the browser sent for one
	`<input type=file>`. `filename` is the client's name for the file (`None` for
	a part with no `filename`), `contentType` the type the client claimed
	(`application/octet-stream` when it claimed none), and `bytes` the whole part.
	Both are client-controlled: never use `filename` as a storage key or path, and
	do not trust `contentType`. The size is `bytes.length()`. A `File` is only a
	field of a `@multipart` body record, and is not a JSON boundary type.
	---
	type File = {
		filename: Option[String],
		contentType: String,
		bytes: Bytes,
	}

	---
	The `SameSite` attribute of a `Cookie`: whether a browser sends it on a
	cross-site request. `Lax` (the default) sends it on top-level navigations,
	`Strict` only on same-site requests, and `Unrestricted` (`SameSite=None` on the
	wire) on every request, which a browser accepts only for a `Secure` cookie.
	---
	type SameSite = enum { Strict, Lax, Unrestricted }

	---
	A cookie to set on an HTTP response, attached with `result.withCookie(c)`. The
	defaults are the safe ones: `HttpOnly`, `Secure`, `SameSite=Lax`, `Path=/`, no
	`Domain` (the cookie goes to the exact host), and no `maxAge` or `expires` (a
	session cookie, gone when the browser closes). `maxAge` and `expires` are both
	sent when both are given; browsers prefer `Max-Age`. A cookie name is an RFC
	6265 token and a value is `cookie-octet`s (no whitespace, `"`, `,`, `;` or `\`);
	a name starting `__Host-` needs `secure`, `path: "/"` and no `domain`, and
	`__Secure-` needs `secure`.
	---
	type Cookie = {
		name: String,
		value: String,
		maxAge: Option[Duration] = None,
		expires: Option[Instant] = None,
		domain: Option[String] = None,
		path: String = "/",
		secure: Bool = true,
		httpOnly: Bool = true,
		sameSite: SameSite = Lax,
		partitioned: Bool = false,
	}

	---
	One server-sent event, for a `Streaming(...)` response that needs more than a
	`data:` line. `data` is the payload (a line break in it becomes several `data:`
	lines); `event` names the event type a browser's `EventSource` listens for;
	`id` sets its last event ID, which a reconnecting browser sends back as
	`Last-Event-ID`; `retry` is the reconnection delay the browser should wait, sent
	in whole milliseconds. `event` and `id` cannot hold a line break and `id`
	cannot hold NUL: an element that does faults the stream, in-band. A
	`Stream[String]` is still framed as plain `data:` events, unchanged.
	---
	type SseEvent = {
		data: String,
		event: Option[String] = None,
		id: Option[String] = None,
		retry: Option[Duration] = None,
	}

	---
	Why a WebSocket connection ended, as an `on close` handler receives it as a
	trailing `close: CloseInfo` parameter. `code` and `reason` are the close
	frame's: `1000` is a normal closure, `1001` a client navigating away, and
	`1006` an abnormal disconnection with no close frame (its `reason` is `""` and
	`clean` is `false`). `clean` is whether the close handshake completed. A
	connection ended by a non-disconnection error is `CloseInfo { code: 1011,
	reason: "error", clean: false }`.
	---
	type CloseInfo = {
		code: Int,
		reason: String,
		clean: Bool,
	}

	---
	The part of a representation a `PartialContent(...)` response carries, as the
	`Content-Range` header states it: bytes `start` to `end` inclusive, of `total`
	bytes in all (`None` when the total is not known, written `*`). `start` is at
	least 0 and at most `end`, and `end` is below `total` when there is one: a
	response whose range breaks this faults, so a malformed `Content-Range` is
	never sent.
	---
	type ContentRange = {
		start: Int,
		end: Int,
		total: Option[Int] = None,
	}

	---
	An HTTP response whose body streams as it is read, as `Fetch.receiveStream`
	and `Fetch.sendStream` return it. `headers` are as `Response`'s. `body` is
	single-pass: a second read faults. A network failure partway through the
	body faults the read, since the result is already `Ok`. An unread body
	holds its connection until the request ends.
	---
	type StreamResponse = {
		status: Int,
		headers: Map[String, String],
		body: Stream[Bytes],
	}

	---
	Runtime metadata carried alongside an event payload (Events track, slice
	2; ADR 0293, spine #936), available as an `on event`
	handler's optional second parameter. `eventId` is minted once per
	emission — every subscriber of that emission sees the same value, making
	it the dedup key for the `Idempotency` capability's `dedup`/`remember`
	idiom. `publisherId` is the emitting context's qualified name, not the
	emitting agent's instance identity: `Events.emit` is legal from a plain,
	keyless service handler with no agent to report, so a context-scoped
	identifier is the only one available uniformly at every legal emission
	site (an amendment to design/bynk-design-notes.md §7's "the publisher is
	the emitting agent" framing). `schemaVersion` is the version the
	cross-build schema registry (`bynk.schema.lock`, Events slice 3c) computes
	for the emitting event: unchanged shape keeps its stored version, a purely
	additive shape change (only new defaulted fields) auto-bumps it, and a
	non-additive change fails the build. An explicit `@schema(N)` annotation
	(slice 3b) is checked against that computed value rather than trusted
	outright — a mismatch is a build error, not a silent override.

	`trace` is the id of the trace the emission happened in (32 lowercase hex
	digits, the trace id of the W3C `traceparent` the delivery carries), so a
	handler can tie what it does to the request that caused the event. It is
	`None` when the event was emitted outside a trace, and for an envelope from a
	publisher built before traces existed: the field is additive, defaulted, and
	never changes whether an event is delivered.
	---
	type EventEnvelope = {
		eventId: String,
		publisherId: String,
		emittedAt: Instant,
		schemaVersion: Int,
		trace: Option[String] = None,
	}

	---
	Reads the current wall-clock time, as Unix milliseconds.
	---
	capability Clock {
		fn now() -> Effect[Instant]
	}

	---
	A source of randomness — fresh UUIDs, bounded integers and random bytes.

	`int` draws from a general-purpose generator and is **not** for secrets:
	use `bytes` for tokens, nonces and keys. `bytes(n)` returns `n` bytes from
	the platform's cryptographically secure generator (`crypto.getRandomValues`);
	`n` must be between 1 and 65,536, and anything else fails the effect with an
	error naming the bound.
	---
	capability Random {
		fn uuid() -> Effect[Uuid]
		fn int(lo: Int, hi: Int) -> Effect[Int]
		fn bytes(n: Int) -> Effect[Bytes]
	}

	---
	Logging at four levels. `debug`, `info`, `warn` and `error` write the
	message as it is. `log` writes a structured record, `{ message, level,
	fields }`: on Cloudflare one object (Workers Logs indexes its keys, so
	`fields.orderId` is queryable), under Node one JSON line, in the browser
	the message and then the fields. Fields are nested under `fields`, so none
	can overwrite the record's own keys. Values are text: format a number with
	`toString()` and a structure with `Json.encode`.
	---
	capability Logger {
		fn info(msg: String) -> Effect[()]
		fn error(msg: String) -> Effect[()]
		fn warn(msg: String) -> Effect[()]
		fn debug(msg: String) -> Effect[()]
		fn log(level: LogLevel, msg: String, fields: Map[String, String]) -> Effect[()]
	}

	---
	Performs outbound HTTP requests. `send` follows redirects and waits as long
	as the platform does; `sendWith` takes a timeout and a redirect policy.
	`receiveBytes` sends `req` as `sendWith` does and returns the response body
	as `Bytes`; `sendBytes` sends `body` as the request body (`req.body` must
	be `None`) and returns the response as `Bytes` too. A binary body gets no
	Content-Type of its own: set `req.contentType`. Their bodies are buffered
	whole. `receiveStream` and `sendStream` stream them instead: the result
	arrives with the response head, and the body as it is read. `sendStream`
	sends its stream chunked, with no `content-length`, and returns a redirect
	as it is, whatever `options.redirect` says: a streamed body can't be sent
	twice.
	---
	capability Fetch {
		fn send(req: Request) -> Effect[Result[Response, FetchError]]
		fn sendWith(req: Request, options: FetchOptions) -> Effect[Result[Response, FetchError]]
		fn receiveBytes(
			req: Request,
			options: FetchOptions
		) -> Effect[Result[BytesResponse, FetchError]]
		fn sendBytes(
			req: Request,
			body: Bytes,
			options: FetchOptions
		) -> Effect[Result[BytesResponse, FetchError]]
		fn receiveStream(
			req: Request,
			options: FetchOptions
		) -> Effect[Result[StreamResponse, FetchError]]
		fn sendStream(
			req: Request,
			body: Stream[Bytes],
			options: FetchOptions
		) -> Effect[Result[StreamResponse, FetchError]]
	}

	---
	Reads named secrets from the platform's secret store.
	---
	capability Secrets {
		fn get(name: String) -> Effect[Option[Secret]]
	}

	---
	Reads the current locale for this request/session. Slice 1: always
	returns a fixed reference tag (`"en"`) on every platform.
	---
	capability Locale {
		fn current() -> Effect[LocaleTag]
	}

	---
	The outcome of an `Idempotency.claim`: `Claimed` for the first caller to
	claim a key, `AlreadyClaimed` for every later one while the claim lasts.
	---
	type Claim = enum { Claimed, AlreadyClaimed }

	---
	Mechanical dedup for at-least-once delivery (design notes §12). `dedup`
	checks for a cached outcome under `key`; on a cache miss the caller
	computes its outcome and writes it back with `remember` (`record` is a
	reserved keyword), which the caller must call to actually cache anything
	— a `dedup` miss with no matching `remember` call simply recomputes every
	time. `expiresAfter` sets the retention window a call to `remember`
	establishes. The cached type `T` must be `Codable`: the value is stored as
	its JSON encoding, and a stored value that no longer decodes as `T` (an
	older deploy wrote it as another shape) reads as a miss, not a fault.

	**Provider.** The provider follows the build's platform. On Cloudflare it
	is D1-backed: durable and shared across isolates, in the Worker's implicit
	`<worker>-idempotency` database. On Node and in the browser it is
	in-memory, lost on restart.

	`claim` is the race-free form: the first call for a key returns `Claimed`
	and every later call within `expiresAfter` returns `AlreadyClaimed`, as one
	step, so two concurrent deliveries cannot both be told they are first.
	`dedup` then `remember` is check-then-act, and two concurrent deliveries
	can both miss. In a service handler a claim is released if the handler fails
	(a fault, a returned `Err`, or a 5xx `HttpResult`), so a retry can claim
	again, and is held for the full `expiresAfter` otherwise. Until the handler
	settles it holds for 30 seconds only, so a claim whose instance died
	lapses. `claim` records no outcome and is separate from `dedup`/`remember`.
	---
	capability Idempotency {
		---
		Checks for a cached outcome under `key`, any `Key` type; a miss is `None`.

		The provider follows the build's platform: D1-backed on Cloudflare
		(durable and shared across isolates, in the Worker's `<worker>-idempotency`
		database), in-memory on Node and in the browser (lost on restart).
		---
		fn dedup[T: Codable, K: Key](key: K) -> Effect[Option[T]] @onUndecodable(miss)
		---
		Caches `value` under `key`, any `Key` type, for `expiresAfter`.

		The provider follows the build's platform: D1-backed on Cloudflare
		(durable and shared across isolates, in the Worker's `<worker>-idempotency`
		database), in-memory on Node and in the browser (lost on restart).
		---
		fn remember[T: Codable, K: Key](key: K, value: T, expiresAfter: Duration) -> Effect[()]
		---
		Claims `key`, any `Key` type, for `expiresAfter`: `Claimed` to the first caller, `AlreadyClaimed` after.

		The provider follows the build's platform: D1-backed on Cloudflare
		(durable and shared across isolates, in the Worker's `<worker>-idempotency`
		database), in-memory on Node and in the browser (lost on restart).
		---
		fn claim[K: Key](key: K, expiresAfter: Duration) -> Effect[Claim]
	}

	---
	Emits an event declared by the calling context (Events track, slice 0;
	ADRs 0288, 0289, spine #936). Owner-only: the compiler rejects
	`emit[E]` when `E` is not an event declared in the emitting context, even
	when `E` is otherwise visible via `consumes`. Fire-and-forget: releases at
	handler commit, so an aborted handler emits nothing — a `dedup`/`remember`-
	style write-then-flush the provider itself is responsible for, not a
	distinct control-flow form here. The type argument `[E]` is inferred from
	the argument, as for `Idempotency.remember[T]`: `Events.emit(e)` and
	`Events.emit[E](e)` mean the same.
	---
	capability Events {
		fn emit[E](event: E) -> Effect[()]
	}

	provides Clock = ClockProvider

	provides Random = RandomProvider

	provides Logger = LoggerProvider

	provides Fetch = FetchProvider

	provides Secrets = SecretsProvider

	provides Locale = LocaleProvider

	provides Idempotency = IdempotencyProvider given Clock

	provides Events = EventsProvider
}
