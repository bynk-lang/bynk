commons bynk.list {
	---
	Deprecated: use `xs.reverse()`. Returns the elements of `xs` in reverse order.
	---
	fn reverse[A](xs: List[A]) -> List[A] {
		xs.reverse()
	}

	---
	Deprecated: use `xs.map(f)`. Applies `f` to each element of `xs`, returning the
	results in the same order.
	---
	fn map[A, B](xs: List[A], f: A -> B) -> List[B] {
		xs.map(f)
	}

	---
	Deprecated: use `xs.filter(p)`. Returns the elements of `xs` that satisfy the
	predicate `p`, in order.
	---
	fn filter[A](xs: List[A], p: A -> Bool) -> List[A] {
		xs.filter(p)
	}

	---
	Deprecated: use `xs.find(p)`. Returns the first element of `xs` satisfying `p`,
	or `None` if none does.
	---
	fn find[A](xs: List[A], p: A -> Bool) -> Option[A] {
		xs.find(p)
	}

	---
	Deprecated: use `xs.any(p)`. True if at least one element of `xs` satisfies
	`p`; false for an empty list.
	---
	fn any[A](xs: List[A], p: A -> Bool) -> Bool {
		xs.any(p)
	}

	---
	Deprecated: use `xs.all(p)`. True if every element of `xs` satisfies `p`; true
	for an empty list.
	---
	fn all[A](xs: List[A], p: A -> Bool) -> Bool {
		xs.all(p)
	}

	---
	Deprecated: use `xs.traverse(f)`. Runs the effectful `f` over each element of
	`xs` in order, collecting the results into a single `Effect` that yields the
	list of outputs.
	---
	fn traverse[A, B](xs: List[A], f: A -> Effect[B]) -> Effect[List[B]] {
		xs.traverse(f)
	}

	---
	Deprecated: use `xs.sort()`. Returns the elements of `xs` in ascending order.
	The sort is stable, and the order is the type's own: `Float` puts `NaN` last, a
	type that `derives Ord` orders by declaration order.
	---
	fn sort[T: Ord](xs: List[T]) -> List[T] {
		xs.sort()
	}

	---
	Deprecated: use `xs.min()`. Returns the smallest element of `xs`, or `None`
	for an empty list.
	---
	fn min[T: Ord](xs: List[T]) -> Option[T] {
		xs.min()
	}

	---
	Deprecated: use `xs.max()`. Returns the largest element of `xs`, or `None` for
	an empty list.
	---
	fn max[T: Ord](xs: List[T]) -> Option[T] {
		xs.max()
	}
}
