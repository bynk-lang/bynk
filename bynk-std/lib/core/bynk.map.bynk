commons bynk.map {
	---
	Deprecated: use `m.values()`. Returns the values of `m`, one per key (order
	follows `m.keys()`).
	---
	fn values[K: Key, V](m: Map[K, V]) -> List[V] {
		m.values()
	}

	---
	Deprecated: use `m.contains(key)`. True if `m` has an entry for `key`.
	---
	fn contains[K: Key, V](m: Map[K, V], key: K) -> Bool {
		m.contains(key)
	}

	---
	Deprecated: use `m.getOrElse(key, fallback)`. Returns the value `m` holds for
	`key`, or `fallback` if there is none.
	---
	fn getOr[K: Key, V](m: Map[K, V], key: K, fallback: V) -> V {
		m.getOrElse(key, fallback)
	}
}
