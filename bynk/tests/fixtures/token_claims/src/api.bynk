context api

type LearnerId = String where NonEmpty && MaxLength(64)

// #3821: `bynk token` mints with the `iss` and `aud` an actor declares.
actor Learner { auth = Bearer(secret = "AUTH_SECRET", issuer = "agilearn-web", audience = "agilearn-api"), identity = LearnerId }
actor Internal { auth = Bearer(secret = "AUTH_SECRET", audience = "agilearn-internal"), identity = LearnerId }
actor Plain { auth = Bearer(secret = "PLAIN_SECRET"), identity = LearnerId }
actor Partner { auth = Bearer(secret = "PARTNER_SECRET", issuer = "partner", audience = "partner-api", trustFrom = "PARTNER_TRUST"), identity = LearnerId }

service api from http {
  on GET("/me") () -> Effect[HttpResult[String]] by l: Learner { Ok("me") }
  on GET("/internal") () -> Effect[HttpResult[String]] by i: Internal { Ok("internal") }
  on GET("/plain") () -> Effect[HttpResult[String]] by p: Plain { Ok("plain") }
  on GET("/partner") () -> Effect[HttpResult[String]] by p: Partner { Ok("partner") }
}
