context shop.api

type UserId = String where NonEmpty
actor User { auth = Bearer(secret = "AUTH_SECRET"), identity = UserId }

type Sku = String where NonEmpty && MaxLength(8)
// An `@example` is the value `Val` uses where it cannot generate one (#2686).
type Code = String where Matches("[A-Z]{3}") @example("ABC")
// No example: `Val[Slug]` still needs a pin, so its route is skipped.
type Slug = String where Matches("[a-z-]+")
// An inline field refinement: `Val[Item]` must fabricate a `qty` of 1.
type Item = { sku: Sku, qty: Int where Positive }
// An inline `Matches` on a field takes an example as a type does.
type Tag = { code: String where Matches("[a-z]+") @example("abc") }

// A helper's result is one the walk of a handler's body can't see into, so the
// `409` below is not among `/clash`'s declared statuses (#2685).
fn taken() -> HttpResult[String] {
  Conflict("taken")
}

service api from http {
  // Answers a status it does not declare: a warning, not a failure.
  on GET("/clash") () -> Effect[HttpResult[String]] by v: Visitor {
    Effect.pure(taken())
  }
  on GET("/ping") () -> Effect[HttpResult[String]] by v: Visitor {
    Ok("pong")
  }
  on PUT("/cart/:sku") (sku: Sku, body: Item) -> Effect[HttpResult[Item]] by u: User {
    Created(body)
  }
  // A bare `String` path parameter (#2706): `Val` refuses it, so it gets a literal.
  on GET("/hello/:name") (name: String) -> Effect[HttpResult[String]] by v: Visitor {
    Ok("Hello, \(name)!")
  }
  // A bare `String` body (#2706): a literal, not `Val`.
  on POST("/note") (body: String) -> Effect[HttpResult[String]] by v: Visitor {
    Created(body)
  }
  // A body type with no literal that `Val` refuses (`bynk.val.unsupported_kind`):
  // the `answers` case is skipped with the reason, not a failure of the run.
  on POST("/bulk") (body: List[String]) -> Effect[HttpResult[String]] by v: Visitor {
    Created("ok")
  }
  // A `Matches` type with an example is fabricated from it.
  on GET("/code/:c") (c: Code) -> Effect[HttpResult[String]] by v: Visitor {
    Ok(c)
  }
  // No example and no generator for a `Matches` type: skipped, and named.
  on GET("/slug/:s") (s: Slug) -> Effect[HttpResult[String]] by v: Visitor {
    Ok(s)
  }
  // A body field with an example is fabricated too.
  on POST("/tag") (body: Tag) -> Effect[HttpResult[Tag]] by v: Visitor {
    Created(body)
  }
  // The defect a smoke exists to find.
  on GET("/boom") () -> Effect[HttpResult[String]] by v: Visitor {
    ServerError("boom")
  }
}
