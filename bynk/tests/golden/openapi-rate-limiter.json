      "ClientId": {
        "description": "Who is being limited — a non-empty client/API-key identifier. Each distinct\n`ClientId` keys its own [Limiter] instance (a Cloudflare Durable Object), so\nlimits never bleed across clients.\n\nRe-validated at the boundary: must be non-empty.",
        "minLength": 1,
        "type": "string",
        "x-bynk-refinements": [
          "NonEmpty"
        ]
      },
      "RateView": {
        "description": "The verdict returned to the caller. On the allow path it is the `200` body:\n`allowed` is the decision, [remaining] the budget left in the window, and\n`resetAt` when the window rolls over. When the window is exhausted the handler\nreturns `429 TooManyRequests` instead, with the reset time in the message. See\n[decide] for how the window rolls over; the [`RateView.remaining`] field is\nnever negative.",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "remaining": {
            "type": "integer"
          },
          "resetAt": {
            "type": "integer"
          }
        },
        "required": [
          "allowed",
          "remaining",
          "resetAt"
        ],
        "type": "object"
      }
    }
  },
