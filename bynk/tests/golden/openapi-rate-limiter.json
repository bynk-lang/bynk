              },
              "kind": {
                "const": "StructuralMismatch"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "expected",
              "actual"
            ],
            "type": "object"
          },
          {
            "properties": {
