                  ],
                  "type": "object"
                }
              }
            },
            "description": "RateLimited — the route's `@rateLimit` limiter refused the request before its body was read (a `Retry-After` header says when to try again)",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limiter's window lets the caller try again.",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          }
        },
        "tags": [
          "api"
        ]
      }
    },
    "/signup": {
