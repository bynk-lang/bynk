{
  "components": {
    "schemas": {
      "BynkBoundaryError": {
        "description": "A request the boundary rejected: malformed JSON, a value of the wrong shape, or one that violates a refinement.",
        "oneOf": [
          {
            "properties": {
              "details": {
                "type": "string"
              },
              "kind": {
                "const": "MalformedJson"
              }
            },
            "required": [
              "kind",
              "details"
            ],
            "type": "object"
          },
          {
            "properties": {
              "actual": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "kind": {
                "const": "StructuralMismatch"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path",
              "expected",
              "actual"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "RefinementViolation"
              },
              "path": {
                "type": "string"
              },
              "violation": {
                "$ref": "#/components/schemas/ValidationViolation"
              }
            },
            "required": [
              "kind",
              "path",
              "violation"
            ],
            "type": "object"
          }
        ]
      },
      "BynkProblemDetails": {
        "description": "An error as RFC 9457 problem details. An error variant has `type` `about:blank`; a router rejection has a `https://bynk-lang.org/problems/<kind>` type and its own members (`kind`, `path`, `expected`, `actual`, `violation`).",
        "properties": {
          "actual": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "violation": {
            "properties": {
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "rule": {
                "type": "object"
              }
            },
            "required": [
              "field",
              "message",
              "rule"
            ],
            "type": "object"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ValidationBound": {
        "description": "A numeric argument of a rule, of the refined type's own base. A `Decimal` is its canonical text and a `Duration` its milliseconds.",
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "IntBound"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "FloatBound"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "DecimalBound"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "DurationBound"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          }
        ]
      },
      "ValidationRule": {
        "description": "The predicate a refinement enforces, with its argument. `WellFormed` is a value that is not a valid member of its base type at all.",
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "NonNegative"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "Positive"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "hi": {
                "$ref": "#/components/schemas/ValidationBound"
              },
              "kind": {
                "const": "InRange"
              },
              "lo": {
                "$ref": "#/components/schemas/ValidationBound"
              }
            },
            "required": [
              "kind",
              "lo",
              "hi"
            ],
            "type": "object"
          },
          {
            "properties": {
              "bound": {
                "$ref": "#/components/schemas/ValidationBound"
              },
              "kind": {
                "const": "AtLeast"
              }
            },
            "required": [
              "kind",
              "bound"
            ],
            "type": "object"
          },
          {
            "properties": {
              "bound": {
                "$ref": "#/components/schemas/ValidationBound"
              },
              "kind": {
                "const": "AtMost"
              }
            },
            "required": [
              "kind",
              "bound"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "NonEmpty"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "MinLength"
              },
              "limit": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "limit"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "MaxLength"
              },
              "limit": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "limit"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "Length"
              },
              "limit": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "limit"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "Matches"
              },
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "pattern"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "IsoDate"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "Cron"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "WellFormed"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "ValidationViolation": {
        "description": "The refinement a value broke. The offending value is never echoed.",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rule": {
            "$ref": "#/components/schemas/ValidationRule"
          }
        },
        "required": [
          "field",
          "message",
          "rule"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "limits",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/enrol": {
      "post": {
        "operationId": "problems_post_enrol",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Ok"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/BynkProblemDetails"
                }
              }
            },
            "description": "StructuralMismatch — every param is structurally re-validated on the way in; a malformed or refinement-violating value fails closed with a 400 the handler body never names"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/BynkProblemDetails"
                }
              }
            },
            "description": "PayloadTooLarge — the body is counted as it is read and cut off at the route's cap (1 MiB unless `@limit` or `limits` says otherwise)"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/BynkProblemDetails"
                }
              }
            },
            "description": "RateLimited — the route's `@rateLimit` limiter refused the request before its body was read (a `Retry-After` header says when to try again)",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limiter's window lets the caller try again.",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          }
        },
        "tags": [
          "problems"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "api_get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Ok"
          }
        },
        "tags": [
          "api"
        ]
      }
    },
