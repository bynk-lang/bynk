                  ],
                  "type": "object"
                }
              }
            },
            "description": "PayloadTooLarge — the body is counted as it is read and cut off at the route's cap (1 MiB unless `@limit` or `limits` says otherwise)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "details": {
                      "type": "string"
                    },
