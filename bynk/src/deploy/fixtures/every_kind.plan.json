== default ==
{
  "environment": "default",
  "orphans": {
    "kv": [
      {
        "worker": "gone"
      },
      {
        "worker": "gone",
        "binding": "KV_CACHE"
      },
      {
        "worker": "shop",
        "binding": "KV_OLD"
      }
    ],
    "r2": [
      {
        "worker": "shop",
