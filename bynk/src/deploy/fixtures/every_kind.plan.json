    "workers": [
      "gone-core"
    ],
    "worker_contexts": {
      "gone-core": [
        "gone",
        "gone.admin"
      ]
    },
    "queues": [
      "old-jobs"
    ]
  },
  "order": [
    "shop-cart",
    "shop"
  ],
