// Regression (ADR 0117): a warning-only project build must print
// `Warning:`/`warning[...]:`, exit 0, and — since a successful build now
// carries `ProjectOutput.snapshots` — a real `path:line:col` under
// `--format short`, not just the category with no position.
context warn_unused_given

capability Logger { fn info(message: String) -> Effect[()] }

provides Logger = ConsoleLogger {
  fn info(message: String) -> Effect[()] {
    Effect.pure(())
  }
}

service hello {
  on call() -> Effect[()] given Logger {
    Effect.pure(())
  }
}
