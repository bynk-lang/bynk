context demo.pages

type Greeting = enum { Hello, Missing }

fn parse(s: String) -> Result[Int, String] {
  if s == "1" { Ok(1) } else { Err("not a number: ".concat(s)) }
}

fn greet(n: Int) -> Greeting {
  if n > 0 { Hello } else { Missing }
}

fn feed() -> Option[Stream[Int]] {
  Some(Stream.of([1, 2]))
}

service api from http {
  on GET("/hello") () -> Effect[HttpResult[String]] by Visitor {
    Ok("hi")
  }
}

fn claims() -> Option[TokenClaims] {
  Some(TokenClaims.of(["sub: ada"]))
}

fn long() -> Option[String] {
  Some("")
}
