// #4199: `for all` draws each plain type across its realistic domain, so a claim that holds only
// in the old narrow domain (an Int within 1000, a string of at most eight characters, a float
// below 1001) is found false.
suite demo.m {
  property "ints stay below 1001" {
    for all n: Int {
      expect n < 1001
    }
  }

  property "strings stay within eight characters" {
    for all s: String {
      expect s.length() < 9
    }
  }

  property "floats stay below 1001" {
    for all x: Float {
      expect x < 1001.0
    }
  }

  property "durations stay under a day" {
    for all d: Duration {
      expect d < 1.day
    }
  }

  property "a refined int stays inside its range" {
    for all p: Percent {
      expect p >= 0 && p <= 100
    }
  }

  // Each claim below fails only inside a band no boundary value reaches, so it is found false
  // through the random draw alone.
  property "decimals stay out of the thousands" {
    for all d: Decimal {
      expect d < 1000d || d > 100000000d
    }
  }

  property "byte strings stay short" {
    for all b: Bytes {
      expect b.length() < 5
    }
  }

  property "durations avoid two days to a year" {
    for all d: Duration {
      expect d < 2.days || d > 365.days
    }
  }

  property "instants avoid a band of epoch milliseconds" {
    for all t: Instant {
      expect t.toEpochMillis() < 200000000 || t.toEpochMillis() > 30000000000
    }
  }

  property "floats stay below a trillion" {
    for all x: Float {
      expect x < 1000000000000.0
    }
  }

  property "a length-bounded string stays within its limit" {
    for all t: Tag {
      expect t.chars().length() <= 3
    }
  }
}
