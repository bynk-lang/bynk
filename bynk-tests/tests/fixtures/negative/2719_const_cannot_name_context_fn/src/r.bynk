context r

consumes bynk

fn tick(n: Int) -> Effect[()] {
	let _ <- Effect.pure(n).within(1.seconds)
	Effect.pure(())
}

fn twice(f: (Int) -> Effect[()], n: Int) -> Effect[Int] {
	~> f(n)
	Effect.pure(n)
}

// #2719: a `const` initialiser is a static value, so it cannot name a function at all (a
// context-needing one included); the existing refusal already covers it.
const Ticker: (Int) -> Effect[()] = tick
