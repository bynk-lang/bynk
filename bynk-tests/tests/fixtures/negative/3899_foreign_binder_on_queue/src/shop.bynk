context shop

type Order = { id: String }

actor Legacy { auth = Foreign(secret = "LEGACY_QUEUE_KEY") }

// A binder names the verified sender for the handler to read, which no seam binds on a queue yet.
service fulfil from queue("orders") {
  delivery { deadLetter: None }
  on message(order: Order) -> Effect[QueueResult] by who: Legacy {
    Ack
  }
}
