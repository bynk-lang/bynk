context a

agent Counter {
  key id: String
  store n: Cell[Int] = 0
  on call bump() -> Effect[()] { n.update((x) => x + 1) }
  on call get() -> Effect[Int] { n }
}

type Box[T] = { item: T }

// #1658: an effect stored in an `Option` is started, unawaited.
service s {
  on call() -> Effect[Int] {
    let o = Some(Counter("k").get())
    let v <- Counter("k").get()
    Effect.pure(v)
  }
}
