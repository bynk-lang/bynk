adapter mail {
  binding "./mail.binding.ts"

  exports capability { Mailer }
  exports transparent { DbError, MailError }

  type DbError = | Constraint(message: String) | Failed(message: String)
  type MailError = | RateLimited | Failed(message: String)

  capability Mailer {
    fn send(to: String) -> Effect[Result[String, MailError]]
    fn audit(to: String) -> Effect[Result[String, String]]
  }

  provides Mailer = RealMailer
}
