context shop.orders

consumes bynk.cloudflare { Queue, QueueSend }

capability OrderEvents = Queue @name("order-events")

// #4106: a computed `Duration` is not a `QueueDelay` until `QueueDelay.of` has checked it.
service place {
  on call(id: String, wait: Duration) -> Effect[()] by Caller given OrderEvents {
    OrderEvents.sendWith(Json.encode(id), QueueSend { delay: Some(wait) })
  }
}
