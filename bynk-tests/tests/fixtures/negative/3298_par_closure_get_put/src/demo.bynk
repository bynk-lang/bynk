context demo

// #3298: a `get` then a `put` in a `parTraverse` closure. Every `<-` is an await
// point, so the branches interleave between the read and the write and updates
// are lost. Q4 (`par { }`) already keeps store writes sequential; the closure
// follows the same rule.

agent Tally {
  key id: String
  store counts: Map[String, Int]

  on call bump(n: Int) -> Effect[()] {
    let _ <- counts.put("k", 0)
    let _ <- [1, 2, 3].parTraverse((x: Int) => {
      let o <- counts.get("k")
      counts.put("k", o.getOrElse(0) + 1)
    })
    Effect.pure(())
  }
}
