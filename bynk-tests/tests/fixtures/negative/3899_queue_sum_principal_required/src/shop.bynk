context shop

type Order = { id: String }

actor Legacy { auth = Foreign(secret = "LEGACY_QUEUE_KEY") }
actor Partner { auth = Foreign(secret = "PARTNER_QUEUE_KEY") }

service fulfil from queue("orders") {
  delivery { deadLetter: None }
  on message(order: Order) -> Effect[QueueResult] by who: Legacy | Partner {
    match who {
      Legacy => Ack
      Partner => Ack
    }
  }
}
