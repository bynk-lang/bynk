context demo

consumes bynk { CallOutcome }

// #3933: `.outcome` on an operation the agent does not declare.
agent Counter {
  key id: String
  store n: Cell[Int]

  on call add(by: Int) -> Effect[Int] {
    n
  }
}

service probe {
  on call() -> Effect[Int] by Caller {
    let o <- Counter("a").nope.outcome(1)
    Effect.pure(0)
  }
}
