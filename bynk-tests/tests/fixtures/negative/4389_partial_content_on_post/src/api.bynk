context api

consumes bynk { ContentRange }

service api from http {
    on POST("/blob") (body: String) -> Effect[HttpResult[()]] by v: Visitor {
        PartialContent(
            Stream.of([Bytes.fromUtf8("x")]),
            "text/plain",
            ContentRange { start: 0, end: 0, total: Some(1) }
        )
    }
}
