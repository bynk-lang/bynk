context demo

consumes bynk.cloudflare { Analytics }

type P = {
	d1: Int,
	d2: Int,
	d3: Int,
	d4: Int,
	d5: Int,
	d6: Int,
	d7: Int,
	d8: Int,
	d9: Int,
	d10: Int,
	d11: Int,
	d12: Int,
	d13: Int,
	d14: Int,
	d15: Int,
	d16: Int,
	d17: Int,
	d18: Int,
	d19: Int,
	d20: Int,
	d21: Int,
}

capability Signups = Analytics

service s from http {
	on GET("/x") () -> Effect[HttpResult[Int]] by Visitor given Signups {
		let _ <- Signups.writeValue(P { d1: 1, d2: 1, d3: 1, d4: 1, d5: 1, d6: 1, d7: 1, d8: 1, d9: 1, d10: 1, d11: 1, d12: 1, d13: 1, d14: 1, d15: 1, d16: 1, d17: 1, d18: 1, d19: 1, d20: 1, d21: 1 })
		Ok(1)
	}
}
