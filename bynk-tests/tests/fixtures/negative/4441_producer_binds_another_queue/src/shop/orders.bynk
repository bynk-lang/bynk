context shop.orders

consumes bynk.cloudflare { Queue }

// A producer, but of another queue: nothing here sends to `order-events`.
capability AuditEvents = Queue @name("audit-events")

type Order = { id: String }

service place {
  on call(o: Order) -> Effect[()] by Caller given AuditEvents {
    AuditEvents.sendValue(o)
  }
}
