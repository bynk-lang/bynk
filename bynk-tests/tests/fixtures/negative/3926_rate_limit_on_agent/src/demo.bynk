context demo

consumes bynk.cloudflare { RateLimit }

capability SignupLimit = RateLimit @limit(10) @period(60.seconds)

// An agent's handlers are never routes, so the annotation is refused, not ignored.
agent Counter {
  key id: String
  store n: Cell[Int] = 0

  @rateLimit(SignupLimit, key: clientIp)
  on call bump() -> Effect[()] { n.update((x) => x + 1) }
}
