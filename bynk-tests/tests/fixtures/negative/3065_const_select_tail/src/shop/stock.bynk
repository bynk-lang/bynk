context shop.stock

consumes bynk
consumes bynk.cloudflare { D1, SqlReadError }

capability Stock = D1

type Item = { id: String }

const GoodSql: String = "SELECT 1"

service s {
  on call() -> Effect[Result[List[Item], SqlReadError]] by Caller given Stock {
    Stock.select[Item](GoodSql, [])
  }
}
