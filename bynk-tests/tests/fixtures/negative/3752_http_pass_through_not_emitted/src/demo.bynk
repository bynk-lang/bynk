context demo

consumes bynk { Upstream, InboundRequest, Forwarded, PassThrough, UpstreamError }

// #3752 (slice 3a): a pass-through route checks, but no build emits it yet.
service proxy from http {
  on ANY("/blog/*path") (path: String, request: InboundRequest) -> Effect[PassThrough] by Visitor {
    Respond(NotFound)
  }
}
