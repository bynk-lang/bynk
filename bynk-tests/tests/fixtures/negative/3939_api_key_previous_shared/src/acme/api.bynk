context acme.api

type AccountId = String where NonEmpty

// #3939 (slice 3): another actor's `previous` may not be this actor's pepper.
actor Client { auth = ApiKey(secret = "CLIENT_KEY_PEPPER", prefix = "acme"), identity = AccountId }
actor Robot { auth = ApiKey(secret = "ROBOT_KEY_PEPPER", previous = "CLIENT_KEY_PEPPER", prefix = "rbt"), identity = AccountId }
