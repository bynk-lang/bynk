context svc

consumes bynk.cloudflare {
  InboundEmail,
  EmailVerdict,
}

const Front: String = "front@shop.example"

service front from email(Front) {
  on message(mail: InboundEmail) -> Effect[EmailVerdict] by Sender {
    Accept
  }
}

service other from email("FRONT@shop.example") {
  on message(mail: InboundEmail) -> Effect[EmailVerdict] by Sender {
    Accept
  }
}
