context shop.stock

consumes bynk
consumes bynk.cloudflare { D1, SqlError }

capability Stock = D1

type Item = { id: String }

const GoodSql: String = "SELECT 1"

const Count: Int = 3

service s {
  on call() -> Effect[Result[Option[String], SqlError]] by Caller given Stock {
    Stock.first(Count, [])
  }
}
