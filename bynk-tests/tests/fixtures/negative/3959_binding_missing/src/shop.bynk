---
#3959, track §11 and §14.1 `bynk.given.binding_missing`: a capability parameter is bound
explicitly at every call and never inferred, even when the caller holds one candidate.
---
context shop

consumes bynk { Logger }
consumes bynk.cloudflare { Kv, D1 }
uses lib.cache

capability Sessions = Kv
capability Archive = Kv
capability Orders = D1

fn save(key: String) -> Effect[String] given Sessions, Logger {
	remember(key, "v")
}
