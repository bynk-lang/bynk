suite shop.stock as integration

// #3135: literal D1 statements in an integration case are prepared against the
// target's migrations, `const` SQL included.
const MISSPELT: String = "SELECT id FROM items WHERE stauts = ?1"

case "an integration case reads a column the table lacks" {
	let _ <- Stock.all("SELECT id FROM items WHERE stauts = ?1", [Text("a")])
	let _ <- Stock.all(MISSPELT, [Text("a")])
	let _ <- Stock.run("DELETE FROM items WHERE id = ?1", [Text("a"), Text("b")])
}
