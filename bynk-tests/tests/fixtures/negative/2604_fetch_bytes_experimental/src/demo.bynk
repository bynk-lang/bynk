context demo

consumes bynk { Fetch, Request, FetchOptions, Redirect }

// #2604: `Fetch.receiveBytes` ships experimental, though `Fetch` is stable.
service probe {
  on call(req: Request) -> Effect[Int] given Fetch {
    let _ <- Fetch.receiveBytes(req, FetchOptions { timeout: None, redirect: Follow })
    Effect.pure(0)
  }
}
