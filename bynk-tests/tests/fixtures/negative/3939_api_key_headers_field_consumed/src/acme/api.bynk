context acme.api

consumes bynk.crypto { Crypto }

type AccountId = String where NonEmpty

// #3939 (D3 E, ADR 0899): the key's header is the seam's, so a typed `headers` field that reads it is
// refused: the handler never sees the key.
actor Client { auth = ApiKey(secret = "CLIENT_KEY_PEPPER", prefix = "acme", header = "x-api-key"), identity = AccountId }

type Keyed = { @name("x-api-key") key: String }

service api from http {
	on GET("/me") (headers: Keyed) -> Effect[HttpResult[String]] by c: Client {
		Ok(c.identity)
	}
}
