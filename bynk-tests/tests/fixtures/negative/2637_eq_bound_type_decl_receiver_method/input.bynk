// A bound the type declares holds for every value of it, with no `where`
// clause, even when the instantiation is inferred from a construction (#3958):
// the construction is where the bad type is made, so it is reported there.
commons c

type Box2[T: Eq] = { value: T }

fn Box2.size(self) -> Int { 0 }

fn g(f: (Int) -> Int) -> Int {
  let s = Box2 { value: f }
  s.size()
}
