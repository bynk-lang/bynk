context demo

consumes bynk { Upstream, InboundRequest, Forwarded, PassThrough, UpstreamError }

// #3752 (D11): only a pass-through route receives an `InboundRequest`.
service api from http {
  on GET("/x") (request: InboundRequest) -> Effect[HttpResult[String]] by Visitor {
    Ok(request.method())
  }
}
