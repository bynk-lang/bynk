context demo

// #3515: `Images` is experimental, so using it needs `[unstable] allow`.

consumes bynk.cloudflare { Images, TransformOptions, OutputOptions, ImageFormat }

service s {
	on call(image: Bytes) -> Effect[Int] given Images {
		let r <- Images.transform(image, TransformOptions {}, OutputOptions { format: ImageFormat.Png })
		match r {
			Ok(img) => Effect.pure(img.body.length()),
			Err(_) => Effect.pure(0),
		}
	}
}
