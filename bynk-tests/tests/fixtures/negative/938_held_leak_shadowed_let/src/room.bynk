// Regression: the linearity pass's `let`-introduction path deferred every
// leak check to end-of-block via a single `introduced` list keyed by name.
// Two `let`s reusing the same name in one block collapsed to one state slot,
// so closing only the *second* connection silently hid the first one's leak.
context room
type ServerFrame = { text: String }
capability Gateway { fn accept() -> Effect[Connection[ServerFrame]] }
service Chat from http {
  on GET("/x") () -> Effect[HttpResult[()]] by v: Visitor given Gateway {
    let c <- Gateway.accept()
    let c <- Gateway.accept()
    do c.close()
    NoContent
  }
}
