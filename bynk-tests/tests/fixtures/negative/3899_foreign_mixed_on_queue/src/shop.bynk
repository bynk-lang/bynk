context shop

type Order = { id: String }

actor Legacy { auth = Foreign(secret = "LEGACY_QUEUE_KEY") }

// A `Foreign` actor beside an unsigned one: its messages carry no signature to tell them apart
// from `Producer`'s, so the consumer cannot say which it admitted.
service fulfil from queue("orders") {
  delivery { deadLetter: None }
  on message(order: Order) -> Effect[QueueResult] by who: Legacy | Producer {
    match who {
      Legacy => Ack
      Producer => Ack
    }
  }
}
