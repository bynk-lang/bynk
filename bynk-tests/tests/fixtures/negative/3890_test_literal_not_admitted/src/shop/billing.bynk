context shop.billing

actor Admin = Caller where IsContext(shop.admin)
actor Fulfilment = Caller where IsContext(shop.orders, shop.fulfil)
actor NotLegacy = Caller where !IsContext(shop.legacy)
actor Ledger { auth = Foreign(secret = "LEDGER_CALL_KEY") }

service refunds {
  on call(id: String) -> Effect[Result[String, String]] by c: Admin {
    Ok("\(id) refunded for \(c.identity)")
  }
}

service ship {
  on call(order: String) -> Effect[Result[String, String]] by c: Fulfilment {
    Ok("\(order) shipped for \(c.identity)")
  }
}

service status {
  on call(id: String) -> Effect[Result[String, String]] by NotLegacy {
    Ok(id)
  }
}

service book {
  on call(id: String) -> Effect[Result[String, String]] by who: Fulfilment | Ledger {
    match who {
      Fulfilment(name) => Ok("\(id) for \(name)")
      Ledger => Ok("\(id) for the ledger")
    }
  }
}
