context acme.api

consumes bynk { Clock }

type AccountId = String where NonEmpty

actor Client { auth = ApiKey(secret = "CLIENT_KEY_PEPPER", previous = "CLIENT_KEY_PEPPER_PREV", prefix = "acme"), identity = AccountId }

// #3939 (slice 3, §7): `sweep` tells the keys under the live pepper from the rest, which takes the
// pepper, and the pepper reaches a service handler and not an agent, so an agent cannot sweep.
agent Accounts {
	key id: AccountId

	store swept: Cell[Int] = 0

	on call tidy() -> Effect[Int] given Clock {
		Client.sweep(self.id)
	}
}
