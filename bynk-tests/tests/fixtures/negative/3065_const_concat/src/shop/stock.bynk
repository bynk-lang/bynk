context shop.stock

consumes bynk
consumes bynk.cloudflare { D1 }

capability Stock = D1

type Item = { id: String }

const GoodSql: String = "SELECT 1"

const Joined: String = GoodSql + " WHERE 1"

service s {
  on call() -> Effect[Result[Option[String], SqlError]] given Stock {
    Stock.first(Joined, [])
  }
}
