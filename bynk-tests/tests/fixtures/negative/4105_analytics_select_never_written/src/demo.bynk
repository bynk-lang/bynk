context demo

consumes bynk.cloudflare { Analytics, AnalyticsReadError, AnalyticsSql }

type Signup = { plan: String, seats: Int }
type R = { plan: String }

capability Signups = Analytics

service s from http {
	on GET("/x") () -> Effect[HttpResult[Int]] by Visitor given AnalyticsSql, Signups {
		let _ <- AnalyticsSql.select[R](Signups, "FROM {dataset} WHERE timestamp > NOW() - INTERVAL '1' HOUR", [])
		Ok(1)
	}
}
