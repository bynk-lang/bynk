context a

agent Counter {
  key id: String
  store n: Cell[Int] = 0
  on call bump() -> Effect[()] { n.update((x) => x + 1) }
  on call get() -> Effect[Int] { n }
}

type Box[T] = { item: T }

// #1658: an `Effect` annotation does not make a plain `let` bind it.
service s {
  on call() -> Effect[Int] {
    let e: Effect[()] = Counter("k").bump()
    let v <- Counter("k").get()
    Effect.pure(v)
  }
}
