context demo

consumes bynk
consumes bynk.cloudflare { MySql }

capability Legacy = MySql

type Shape = | Circle(radius: Float) | Dot
type Placed = { id: Int, shape: Shape }

service probe {
  on call() -> Effect[Bool] by Caller given Legacy {
    let d <- Legacy.firstAs[Placed]("FROM orders", [])
    d is Ok(_)
  }
}
