context shop

type Order = { id: String }

actor Legacy { auth = Foreign(secret = "LEGACY_QUEUE_KEY") }

// A signed queue's dead letters are the signed envelope, which the unsigned consumer of its
// dead-letter queue could not decode.
service fulfil from queue("orders") {
  delivery { deadLetter: "orders-dead" }
  on message(order: Order) -> Effect[QueueResult] by Legacy {
    Ack
  }
}

service review from queue("orders-dead") {
  delivery { deadLetter: None }
  on message(order: Order) -> Effect[QueueResult] by Producer {
    Ack
  }
}
