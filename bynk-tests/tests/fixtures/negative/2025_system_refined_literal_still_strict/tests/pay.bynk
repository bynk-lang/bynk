// #2025: admitting a literal to a refined parameter keeps the boundary
// strict otherwise. A literal outside the refinement is refused, and a
// plain `Int` still does not cross as `Cents`. (`src/t/other.bynk` has the
// caller-with-its-own-`Cents` cases.)
suite t.pay as system {
	uses t.values

	case "an out-of-range literal" {
		let r <- t.pay.charge(5000) by Caller("t.other")
		expect r == 5000
	}

	case "a plain Int binding" {
		let n = 250
		let r <- t.pay.charge(n) by Caller("t.other")
		expect r == 250
	}
}
