// #2073 review: `shop.ledger.take` reaches `shop.base`'s types, which this
// context does not consume. The refusal names the declaration (`Base`), not a
// qualified key.
context shop.front

consumes shop.order
consumes shop.ledger

service check {
  on call(o: Order) -> Effect[String] {
    shop.ledger.take(o)
  }
}
