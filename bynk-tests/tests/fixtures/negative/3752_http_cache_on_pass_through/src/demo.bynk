context demo

consumes bynk { Upstream, InboundRequest, Forwarded, PassThrough, UpstreamError }

// #3752 (D9): an upstream's own `Cache-Control` is a forwarded answer's freshness.
service proxy from http {
  @cache(maxAge: 5.minutes)
  on ANY("/blog/*path") (path: String) -> Effect[PassThrough] by Visitor {
    Respond(NotFound)
  }
}
