context shop.orders

consumes bynk.cloudflare { Queue, QueueSend }

capability OrderEvents = Queue @name("order-events")

type Order = { id: String, qty: Int }
type Refund = { id: String }

service place {
  on call(o: Order) -> Effect[()] by Caller given OrderEvents {
    OrderEvents.sendValueWith(Refund { id: o.id }, QueueSend { delay: None })
  }
}
