context demo

consumes bynk { Fetch, Request, FetchOptions, Redirect }

// #2586: `Fetch.sendWith` ships experimental, though `Fetch` is stable.
service probe {
  on call(req: Request) -> Effect[Int] by Caller given Fetch {
    let _ <- Fetch.sendWith(req, FetchOptions { timeout: None, redirect: Follow })
    Effect.pure(0)
  }
}
