context svc

type EmailJob = { to: String }

service outbox from queue("outbound-email") {
  delivery { deadLetter: "outbound-email-dlq" }
  on message(message: EmailJob) -> Effect[QueueResult] by Producer { Ack }
}

service review from queue("outbound-email-dlq") {
  delivery { deadLetter: None }
  on message(message: String) -> Effect[QueueResult] by Producer { Ack }
}
