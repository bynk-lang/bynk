context api

const Png: String = "image/png"

service api from http {
    @raw(contentType: "image/png")
    @limit(maxBody: 1_000_000)
    on POST("/avatars") (body: Bytes) -> Effect[HttpResult[String]] by v: Visitor {
        Ok("x")
    }

    @raw(contentType: Png)
    @limit(maxBody: 1_000_000)
    on POST("/icons") (body: Bytes) -> Effect[HttpResult[String]] by v: Visitor {
        Ok("x")
    }
}
