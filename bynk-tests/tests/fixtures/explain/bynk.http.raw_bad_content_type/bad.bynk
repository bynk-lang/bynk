context api

service api from http {
    @raw(contentType: "png")
    @limit(maxBody: 1_000_000)
    on POST("/avatars") (body: Bytes) -> Effect[HttpResult[String]] by v: Visitor {
        Ok("x")
    }

    @raw(contentType: ["image/png", "*/*"])
    @limit(maxBody: 1_000_000)
    on POST("/photos") (body: Bytes) -> Effect[HttpResult[String]] by v: Visitor {
        Ok("x")
    }
}
