context api

type UserId = opaque String

actor User { auth = Bearer(secret = "AUTH_JWT_SECRET"), identity = UserId }

service api from http {
    @raw(contentType: "image/png")
    @limit(maxBody: 5_000_000)
    on PUT("/avatars") (body: Stream[Bytes]) -> Effect[HttpResult[()]] by who: User {
        NoContent
    }
}
