context demo

consumes bynk.cloudflare { EdgeCache }

capability Edge = EdgeCache

agent Index {
    key name: String

    store hits: Cell[Int]

    on call withdraw(path: String) -> Effect[Bool] {
        Effect.pure(true)
    }
}

service operator from http {
    on POST("/purge/:hex") (hex: String) -> Effect[HttpResult[Bool]] by v: Visitor given Edge {
        let purged <- Edge.purge(["/dl/\(hex)"])
        Ok(purged)
    }
}
