context demo

consumes bynk { Clock }

capability Files {
    fn write(name: String) -> Effect[()]
}

provides Files = MemFiles {
    fn write(name: String) -> Effect[()] {
        Effect.pure(())
    }
}

agent Index {
    key name: String

    store hits: Cell[Int]

    on call withdraw() -> Effect[()] given Files {
        Files.write(self.name)
    }
}

capability Takedown {
    fn take(name: String) -> Effect[()]
}

provides Takedown = Bucket given Clock, Files {
    fn take(name: String) -> Effect[()] { Index(name).withdraw() }
}
