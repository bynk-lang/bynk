context demo

consumes bynk.cloudflare { EdgeCache }

capability Edge = EdgeCache

type MemberId = opaque String

actor Member { auth = Bearer(secret = "AUTH_SECRET"), identity = MemberId }

service api from http {
    @cache(maxAge: 5.minutes, scope: private)
    on GET("/me") () -> Effect[HttpResult[String]] by m: Member {
        Ok("member")
    }
}
