context api

consumes bynk { Cookie }

type Mode = enum { Light, Dark }
type Prefs = { mode: Mode = Light, other: Option[String] }

service api from http {
    on GET("/a") (cookies: Prefs) -> Effect[HttpResult[String]] by v: Visitor {
        Ok("x").withCookie(Cookie { name: "mode", value: "Dark" })
    }
}
