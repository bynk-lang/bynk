context demo

capability Users {
    fn find(id: Int) -> Effect[String]
}

capability Orders {
    fn forUser(id: Int) -> Effect[Int]
}

fn parse(raw: String) -> Result[Int, String] {
    match Int.parse(raw) {
        Some(n) => Ok(n),
        None => Err("not a number"),
    }
}

service dash {
    on call(raw: String) -> Effect[Result[Int, String]] given Users, Orders {
        let key = parse(raw)?
        par {
            let a <- Users.find(1)
            let b <- Orders.forUser(key)
        }
        Effect.pure(Ok(b))
    }
}
