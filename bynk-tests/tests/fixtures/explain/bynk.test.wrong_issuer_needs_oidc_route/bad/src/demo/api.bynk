context demo.api

type UserId = String where NonEmpty

actor User { auth = Bearer(secret = "S"), identity = UserId }

actor Workload { auth = Oidc(issuer = "https://issuer.example.com", audience = "demo", jwks = "https://issuer.example.com/jwks"), identity = UserId }

service api from http {
  on GET("/me") () -> Effect[HttpResult[String]] by u: User {
    Ok(u.identity)
  }

  on GET("/who") () -> Effect[HttpResult[String]] by w: Workload {
    Ok(w.identity)
  }
}
