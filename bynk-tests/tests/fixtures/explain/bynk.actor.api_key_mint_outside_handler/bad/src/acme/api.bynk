context acme.api

consumes bynk { Clock, ApiKeyLabel }

type AccountId = String where NonEmpty

actor Client { auth = ApiKey(secret = "CLIENT_KEY_PEPPER"), identity = AccountId }

agent Accounts {
	key id: AccountId
	store opened: Cell[Int] = 0
	on call open(label: ApiKeyLabel) -> Effect[()] given Clock {
		let _ <- Client.mint(self.id, label)
	}
}
