context demo

type WorkloadId = String where NonEmpty

type UserId = String where NonEmpty

actor User { auth = Bearer(secret = "JWT_KEY"), identity = UserId }

actor Workload { auth = Oidc(issuer = "https://i.test", audience = "a", jwks = "https://i.test/jwks", trustFrom = "JWT_KEY"), identity = WorkloadId }

service api from http {
  on GET("/x") () -> Effect[HttpResult[()]] by w: Workload {
    NoContent
  }
}
