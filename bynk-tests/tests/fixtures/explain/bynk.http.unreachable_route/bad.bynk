context api

service api from http {
    on GET("/a/b") () -> Effect[HttpResult[String]] by v: Visitor {
        Ok("b")
    }

    on GET("/a/:x") (x: String) -> Effect[HttpResult[String]] by v: Visitor {
        Ok(x)
    }

    on GET("/a/:y") (y: String) -> Effect[HttpResult[String]] by v: Visitor {
        Ok(y)
    }
}
