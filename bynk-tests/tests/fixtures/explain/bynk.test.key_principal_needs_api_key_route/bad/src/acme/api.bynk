context acme.api

consumes bynk.crypto { Crypto }
consumes bynk.cloudflare { RateLimit }

type AccountId = String where NonEmpty

type UserId = String where NonEmpty

actor User { auth = Bearer(secret = "AUTH_SECRET"), identity = UserId }
actor Client { auth = ApiKey(secret = "CLIENT_KEY_PEPPER", prefix = "acme"), identity = AccountId }

service api from http {
	on GET("/me") () -> Effect[HttpResult[String]] by u: User {
		Ok(u.identity)
	}
}

capability PerIp = RateLimit @limit(100) @period(60.seconds)

service keys from http {
	@rateLimit(PerIp, key: clientIp)
	on GET("/key") () -> Effect[HttpResult[String]] by c: Client {
		Ok(c.identity)
	}
}
