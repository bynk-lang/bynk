context shop

type CartV1 = { owner: String, total: Int }

agent Cart {
    key id: String
    store ownerName: Cell[String]
    store totalCents: Cell[Int]

    on call cents() -> Effect[Int] {
        totalCents
    }

    migrate from 1 (old: CartV1) {
        ownerName := old.owner
        totalCents := old.total * 100
    }
}
