// #3985: a suite-level stub of a consumed service names the suite's constants, as its argument pattern and as its value.
suite shop.orders {
  consumes shop.pay { Receipt, PaymentError }

  stub shop.stock.reserve(_) returns Ok(())
  stub Pay.authorise(Limit) returns Err(Declined)
  stub Pay.authorise(_) returns Ok(Receipt { id: Prefix })

  const Limit: Int = 5
  const Prefix: String = "r-"

  case "a suite constant is a stub argument and a stub value" {
    let r <- placeOrder.call("widget", 100)
    expect r is Ok("r-")
    let d <- placeOrder.call("widget", 5)
    expect d is Err("declined")
  }
}
