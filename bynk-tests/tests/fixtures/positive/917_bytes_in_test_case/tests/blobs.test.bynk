// #914: a `Bytes` value built inside a test-case body. The test module's
// runtime import list is emitted as a fixed set by `tests_emit.rs`, so the
// base64 decode and the content-equality helper this lowers to must still
// reach that import line.
suite blobs {
  case "decodes base64" {
    match Bytes.fromBase64("aGk=") {
      Some(b) => expect size(b) == 2
      None => expect false
    }
  }

  case "compares by content" {
    expect Bytes.fromUtf8("hi") == Bytes.fromUtf8("hi")
  }
}
