commons errortypes {
  // #1319: the ts_any residual for the four runtime-owned error types
  // (ValidationError/DecodeError/HttpResult/QueueResult) as ordinary record
  // fields, crossing the Json boundary so the real (de)serialise codec
  // actually reaches the `WireRef::Unchecked` residual sites.
  type WithErrors = {
    validation: ValidationError,
    jsonErr: DecodeError,
    httpResult: HttpResult[Int],
    queueResult: QueueResult,
  }

  fn save(w: WithErrors) -> String {
    Json.encode(w)
  }

  fn load(s: String) -> Result[WithErrors, DecodeError] {
    Json.decode[WithErrors](s)
  }
}
