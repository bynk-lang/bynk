---
#2660: a recursive `derives Ord` type. Its comparator names itself, so it is built
with a fixed point rather than inlined without end.
---
commons demo.expr

uses bynk.list

type Expr =
  | Num(n: Int)
  | Neg(inner: Expr)
  | Add(left: Expr, right: Expr)
  derives Ord

type Chain = { head: Int, rest: Option[Chain] } derives Ord

fn ordered(xs: List[Expr]) -> List[Expr] { sort(xs) }

fn chains(xs: List[Chain]) -> Option[Chain] { max(xs) }
