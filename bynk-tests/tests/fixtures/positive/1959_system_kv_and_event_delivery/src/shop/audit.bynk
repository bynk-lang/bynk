context shop.audit

consumes shop.order
consumes shop.ledger

service OnPlaced from Events(Placed) {
  on event(e: Placed) -> Effect[()] {
    shop.ledger.note("placed:\(e.id)")
  }
}

service OnTallied from Events(Tallied) {
  on event(e: Tallied) -> Effect[()] {
    shop.ledger.note("tallied:\(e.id)")
  }
}
