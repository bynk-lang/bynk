context who

uses shared.ids

type Days = Int where InRange(1, 90)
type Window = { days: Days = 7 }

actor User { auth = Bearer(secret = "USER_SECRET"), identity = UserId }

service api from http {
	on GET("/me") (query: Window) -> Effect[HttpResult[String]] by u: User {
		Ok("\(u.identity) \(query.days)")
	}
}
