suite demo.xs

case "filterMap keeps the Some results, in order" {
	expect bigs([1, 3, 2, 5]) == [30, 50]
}

case "filterMap on an empty list, and when every result is None" {
	let none: List[Int] = []
	expect bigs(none) == none
	expect bigs([1, 2]) == none
}

case "zipWith pairs elements and stops at the shorter list" {
	expect totals([2, 3, 4], [10, 100]) == [20, 300]
	expect totals([2], [10, 100, 1000]) == [20]
	let none: List[Int] = []
	expect totals(none, [1]) == none
}

case "takeWhile and skipWhile split at the first failing element" {
	expect head([1, 2, 3, 1]) == [1, 2]
	expect tail([1, 2, 3, 1]) == [3, 1]
}

case "takeWhile and skipWhile on empty, all-true and all-false" {
	let none: List[Int] = []
	expect head(none) == none
	expect tail(none) == none
	expect head([1, 2]) == [1, 2]
	expect tail([1, 2]) == none
	expect head([5, 6]) == none
	expect tail([5, 6]) == [5, 6]
}

case "count with a predicate, and count without" {
	expect evens([1, 2, 3, 4, 6]) == 3
	expect all([1, 2, 3]) == 3
	let none: List[Int] = []
	expect evens(none) == 0
}

case "filterMap with an inline lambda that changes the element type" {
	expect ports(["80", "x", "443", ""]) == [80, 443]
	expect pick(["a", "b", "c"], [2, 9, 0, -1]) == ["c", "a"]
}
