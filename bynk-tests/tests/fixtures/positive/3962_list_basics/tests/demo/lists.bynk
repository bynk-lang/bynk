suite demo.lists

case "reverse, last, lastOrElse and isEmpty" {
	expect [1, 2, 3].reverse() == [3, 2, 1]
	expect [1, 2, 3].last() == Some(3)
	expect [1, 2, 3].last().getOrElse(0) == 3
	let none: List[Int] = []
	expect none.last() is None
	expect none.lastOrElse(0) == 0
	expect [1, 2, 3].lastOrElse(0) == 3
	expect none.isEmpty()
	expect !([1].isEmpty())
	expect none.reverse() == none
}

case "find returns the first match" {
	expect [1, 2, 3, 4].find((n) => n > 1) == Some(2)
	expect [1, 2, 3].find((n) => n > 5) is None
}

case "contains compares by value, on a record too" {
	expect [1, 2, 3].contains(2)
	expect ![1, 2, 3].contains(9)
	expect points().contains(Point { x: 3, y: 4 })
	expect !points().contains(Point { x: 3, y: 5 })
	expect has(["a", "b"], "b")
}

case "sort, min and max use the element order" {
	expect [3, 1, 2].sort() == [1, 2, 3]
	expect ordered(ranks()) == [A, A, B, C]
	expect ranks().min() == Some(A)
	expect ranks().max() == Some(C)
	expect [3, 1, 2].min() == Some(1)
	expect ["b", "a"].max() == Some("b")
	let none: List[Int] = []
	expect none.min() is None
	expect newest([1.5, 0.5]) == Some(1.5)
	expect [3, 1, 2].min((n) => 0 - n) == Some(-3)
}

case "traverse keeps the results in order" {
	let out <- enrich([1, 2, 3])
	expect out == [10, 20, 30]
}
