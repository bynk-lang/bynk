context ops.mail

consumes bynk.cloudflare { QueueDelivery }

type Job = { id: String }

// #3880: the handler may take its delivery metadata beside the message, in either order.
service plain from queue("plain-jobs") {
  on message(job: Job) -> Effect[QueueResult] {
    Ack
  }
}

// It backs off by attempt: it gives up retrying at the third.
service backoff from queue("backoff-jobs") {
  on message(job: Job, delivery: QueueDelivery) -> Effect[QueueResult] {
    if delivery.attempts > 2 {
      Ack
    } else {
      Retry("attempt \(delivery.attempts)")
    }
  }
}

// It reads how long the message waited, delivery first.
service flipped from queue("flipped-jobs") {
  on message(delivery: QueueDelivery, job: Job) -> Effect[QueueResult] {
    if delivery.sentAt == Instant.fromEpochMillis(5000) {
      Ack
    } else {
      Retry("sent at \(delivery.sentAt.toEpochMillis())")
    }
  }
}
