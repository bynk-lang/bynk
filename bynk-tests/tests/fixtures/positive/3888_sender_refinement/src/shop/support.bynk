context shop.support

consumes bynk.cloudflare {
  InboundEmail,
  EmailVerdict,
}

actor Authenticated = Sender where Dmarc(DmarcPass)
actor NotFailed = Sender where !Dmarc(DmarcFail)

service orders from email("orders@shop.example") {
  on message(mail: InboundEmail) -> Effect[EmailVerdict] by s: Authenticated {
    Accept
  }
}

service support from email("support@shop.example") by NotFailed {
  on message(mail: InboundEmail) -> Effect[EmailVerdict] {
    Accept
  }
}
