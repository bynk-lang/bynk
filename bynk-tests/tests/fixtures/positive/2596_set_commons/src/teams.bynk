context teams

// #2596: the set combinators as `Set` methods.

fn a() -> Set[String] {
	Set.of(["ada", "bo", "cy"])
}

fn b() -> Set[String] {
	Set.of(["cy", "dee", "ada"])
}

fn joined() -> List[String] {
	a().union(b()).toList()
}

fn shared() -> List[String] {
	a().intersect(b()).toList()
}

fn onlyA() -> List[String] {
	a().difference(b()).toList()
}

fn lengths() -> List[Int] {
	a().map((s) => s.length()).toList()
}

fn short() -> List[String] {
	a().filter((s) => s.length() < 3).toList()
}

fn within() -> Bool {
	Set.of(["ada"]).isSubsetOf(a()) && !b().isSubsetOf(a())
}
