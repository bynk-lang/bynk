---
#2660: a generic `derives Ord` type is `Ord` at an instantiation whose arguments
are, and its comparator is built per instantiation: `Entry[Int, String]` and
`Entry[String, Int]` order by different field types.
---
commons demo.pairs


type Entry[K, V] = { key: K, value: V } derives Ord

type Maybe[T] =
  | Missing
  | Present(item: T)
  derives Ord

fn entriesByInt(xs: List[Entry[Int, String]]) -> List[Entry[Int, String]] { xs.sort() }

fn entriesByString(xs: List[Entry[String, Int]]) -> List[Entry[String, Int]] { xs.sort() }

fn firstEntry[K: Ord, V: Ord](xs: List[Entry[K, V]]) -> Option[Entry[K, V]] { xs.min() }

fn maybes(xs: List[Maybe[Int]]) -> List[Maybe[Int]] { xs.sort() }

fn nested(xs: List[Entry[Maybe[Int], List[Int]]]) -> Option[Entry[Maybe[Int], List[Int]]] { xs.max() }
