suite auth.api {
	case "a handler's result carries its cookies" {
		let r <- api.POST("/login", Login { user: "ada" })
		expect r is Created("ok")
		expect r.cookies().map((c) => c.name) == ["__Host-sid"]
	}

	case "no cookies by default" {
		let r <- api.POST("/prefs")
		expect r.cookies().length() == 2
	}
}

suite auth.api as system {
	case "the router sends the cookie with the safe defaults" {
		let r <- api.POST("/login", Login { user: "ada" })
		expect r is Created("ok")
		match r.cookies().first() {
			Some(c) => {
				expect c.name == "__Host-sid"
				expect c.value == "abc"
				expect c.httpOnly
				expect c.secure
				expect c.path == "/"
				expect c.maxAge == Some(30.minutes)
			}
			None => {
				expect false
			}
		}
	}

	case "a redirect carries a cookie too" {
		let r <- api.GET("/go")
		expect r is SeeOther(_)
		expect r.cookies().length() == 1
	}

	case "several cookies, in order" {
		let r <- api.POST("/prefs")
		expect r.cookies().map((c) => c.name) == ["theme", "lang"]
		match r.cookies().first() {
			Some(c) => {
				expect c.httpOnly
				expect c.path == "/app"
			}
			None => {
				expect false
			}
		}
	}

	case "a cleared cookie is sent empty and expired" {
		let r <- api.POST("/logout")
		match r.cookies().first() {
			Some(c) => {
				expect c.name == "__Host-sid"
				expect c.value == ""
				expect c.maxAge == Some(0.seconds)
			}
			None => {
				expect false
			}
		}
	}

	case "a cookie value that is not a cookie-octet faults the request" {
		let r <- api.POST("/bad", Login { user: "a b" })
		expect r is ServerError(_)
	}
}
