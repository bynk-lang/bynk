context shop.orders

// #1820: a multi-file context. This file declares the agent; `place.bynk`, a
// sibling, constructs it, which lowers to this file's `__makeBook`. The
// sibling import named the types and functions it used but not the factory
// (TS2304).
type OrderId = String where NonEmpty

agent Book {
  key id: OrderId

  store count: Cell[Int]

  on call add(n: Int) -> Effect[Int] {
    let _ <- count.update((c) => c + n)
    Effect.pure(count)
  }
}
