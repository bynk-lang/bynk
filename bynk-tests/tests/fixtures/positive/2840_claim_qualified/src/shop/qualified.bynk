context shop.qualified

// `claim` through the qualified name declares the implicit claims database too.

consumes bynk

service api from http {
	on GET("/claim/:id") (id: String) -> Effect[HttpResult[String]] by Visitor given bynk.Idempotency {
		let _ <- bynk.Idempotency.claim(id, 1.hours)
		Ok("claimed")
	}

	on GET("/seen/:id") (id: String) -> Effect[HttpResult[String]] by Visitor given bynk.Idempotency {
		let seen <- bynk.Idempotency.dedup[String](id)
		match seen {
			Some(v) => Ok(v),
			None => {
				let _ <- bynk.Idempotency.remember[String](id, "first", 1.hours)
				Ok("fresh")
			},
		}
	}
}
