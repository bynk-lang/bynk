context shop.signups

// #3513 B: `AnalyticsSql` reads Analytics Engine datasets over the account's SQL API. It is a
// singleton binding (`CF_ANALYTICS_SQL`, an `[analytics]` stanza) with no resource of its own to
// create. Parameters bind positionally as `$1`, and a reply is a result set or a typed error.

consumes bynk
consumes bynk.cloudflare { Analytics, AnalyticsSql, AnalyticsSqlError, AnalyticsSqlResult, SqlValue }

capability Signups = Analytics

const WEEKLY: String = "SELECT count() AS n, (SELECT count() FROM {dataset}) AS total FROM {dataset} WHERE timestamp > NOW() - INTERVAL '7' DAY"

service report from http {
	on GET("/weekly") () -> Effect[HttpResult[Int]] by Visitor given AnalyticsSql, Signups {
		let res <- AnalyticsSql.query(Signups, WEEKLY, [])
		match res {
			Ok(r) => Ok(r.rows),
			Err(_) => ServerError("the query failed"),
		}
	}

	on GET("/signups/:country") (country: String) -> Effect[HttpResult[Int]] by Visitor given AnalyticsSql, Signups {
		// #4104: the SQL is a literal; `{dataset}` is this environment's table for `Signups`:
		// `events.analyticsEngine.shop_signups_signups`, or the `_staging` one under `--env staging`.
		let res <- AnalyticsSql.query(Signups,
			"SELECT count() AS n FROM {dataset} WHERE blob1 = $1 AND timestamp > NOW() - INTERVAL '1' DAY",
			[Text(country)])
		match res {
			Ok(r) => Ok(r.rows),
			Err(SqlRetryable(_)) => ServerError("try again shortly"),
			Err(SqlRejected(_)) => ServerError("the query was refused"),
			Err(_) => ServerError("the query failed"),
		}
	}
}
