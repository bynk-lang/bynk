suite demo.desk

uses demo.kit_b

stub Meter.read() returns helper()

// the commons' `amount` must not hide the call's `amount` argument in the match test
stub Meter.scale(helper()) returns amount()

case "suite b stub value" {
  let n <- local.call(0)
  expect n == 20
}

case "suite b stub matched on an argument pattern" {
  let n <- scaled.call(20)
  expect n == 9
}
