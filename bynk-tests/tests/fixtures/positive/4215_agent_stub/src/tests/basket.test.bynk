suite shop.basket {
	// Suite-scoped: every call to `add` is busy, whatever the key.
	stub Basket.add(_) unreachable

	case "a stubbed operation is Unreachable, whatever the key" {
		let a <- place.call("a", 2)
		let b <- place.call("b", 3)
		expect a is Err("busy")
		expect b is Err("busy")
	}

	case "a case's own stub wins over the suite's" {
		stub Basket.add(_) faulted
		let r <- place.call("a", 2)
		expect r is Err("faulted")
	}

	case "an argument pattern stubs only the calls it matches" {
		stub Basket.add(7) faulted
		let hit <- place.call("a", 7)
		let miss <- place.call("a", 2)
		expect hit is Err("faulted")
		expect miss is Err("busy")
	}

	case "an operation that is not stubbed is the real one" {
		let n <- total.call("a")
		expect n == 0
	}

	case "a plain call to a stubbed operation faults" {
		expect placePlain.call("a", 2) faults
	}
}
