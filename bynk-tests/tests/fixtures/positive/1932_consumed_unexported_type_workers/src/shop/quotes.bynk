context shop.quotes

// #1932: `Box` and `Amount` are not exported. A value of them still crosses
// structurally (spec §6.5); the consumer generates its own codecs for them,
// under renamed names so they cannot collide with its own (#1846).

type Amount = { cents: Int }

type Box = { a: Amount }

service quote {
  on call() -> Effect[Box] {
    Effect.pure(Box { a: Amount { cents: 1 } })
  }
}

service echo {
  on call(b: Box) -> Effect[Int] {
    Effect.pure(b.a.cents)
  }
}
