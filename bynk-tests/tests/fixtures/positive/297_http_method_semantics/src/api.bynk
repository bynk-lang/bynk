context api

consumes bynk { SseEvent }

// v0.139 (ADR 0162): method correctness for a `from http` service. The route
// table below declares GET+POST on `/notes`, GET on `/notes/:id`, and a
// streamed GET on `/ticks`; the router synthesises `405 + Allow`, a plain
// `OPTIONS`, and `HEAD` from these declarations alone. Drives the
// `http_method_behaviour` end-to-end test.
service routes from http {
  on GET("/notes") () -> Effect[HttpResult[String]] by v: Visitor {
    Ok("all notes")
  }

  on POST("/notes") (body: String) -> Effect[HttpResult[String]] by v: Visitor {
    Created(body)
  }

  on GET("/notes/:id") (id: String) -> Effect[HttpResult[String]] by v: Visitor {
    Ok(id)
  }

  on GET("/ticks") () -> Effect[HttpResult[()]] by v: Visitor {
    Streaming(Stream.of(["tick-1", "tick-2"]).take(2))
  }

  // #3918: structured events — `event`, `id` and `retry` before `data`, a multi-line
  // `data` split into one `data:` line each, and a bare event with only `data`.
  on GET("/events") () -> Effect[HttpResult[()]] by v: Visitor {
    Streaming(Stream.of([
      SseEvent { data: "hello", event: Some("greeting"), id: Some("7"), retry: Some(1500.milliseconds) },
      SseEvent { data: "a\r\nb\nc" },
    ]))
  }

  // #3918: an `event` name with a line break cannot be framed; the body errors in-band.
  on GET("/bad-event") () -> Effect[HttpResult[()]] by v: Visitor {
    Streaming(Stream.of([SseEvent { data: "x", event: Some("a\nb") }]))
  }

  on GET("/logo") () -> Effect[HttpResult[()]] by v: Visitor {
    Raw(Bytes.fromUtf8("<svg/>"), "image/svg+xml")
  }

  // K-streams (#2623): a raw body streamed chunk by chunk.
  on GET("/chunks") () -> Effect[HttpResult[()]] by v: Visitor {
    RawStreamed(
      Stream.of([Bytes.fromUtf8("one,"), Bytes.fromUtf8(""), Bytes.fromUtf8("two,"), Bytes.fromUtf8("three")]),
      "text/csv"
    )
  }
}
