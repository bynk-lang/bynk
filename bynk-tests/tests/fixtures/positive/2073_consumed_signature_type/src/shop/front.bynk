// #2073: a caller of `shop.ledger` that consumes `shop.order` too, so it
// can pass `shop.order`'s types across `shop.ledger`'s boundary.
context shop.front

consumes shop.order
consumes shop.ledger

service check {
  on call(id: String) -> Effect[Bool] {
    shop.ledger.isDomestic(Order { id: id, region: Region.Domestic })
  }
}
