context shop.account

consumes bynk { Events }

exports transparent { AccountClosed }

event AccountClosed = {
	id: String,
}

type Order = {
	id: String,
	status: String,
}

agent Account {
	key id: String

	store email: Cell[String] = "none"
	store orders: Map[String, Order] @indexed(by: status)

	on call open(mail: String) -> Effect[()] {
		email := mail
		let _ <- orders.put("o1", Order { id: "o1", status: "open" })
		let _ <- orders.put("o2", Order { id: "o2", status: "open" })
		Effect.pure(())
	}

	// Close the account: tell the world, then delete every trace of this key.
	on call close() -> Effect[()] given Events {
		do Events.emit[AccountClosed](AccountClosed { id: self.id })
		self.erase()
	}

	// Erase on one path only: a handler that faults erases nothing.
	on call closeOrFault(refuse: Bool) -> Effect[()] {
		do self.erase()
		if refuse {
			unreachable("refused after erase")
		} else {
			Effect.pure(())
		}
	}

	// Writes made before the erase are discarded with the rest.
	on call writeThenErase() -> Effect[()] {
		email := "changed"
		do self.erase()
		Effect.pure(())
	}

	on call readEmail() -> Effect[String] {
		email
	}

	on call openOrders() -> Effect[Int] {
		orders.filter((o) => o.status == "open").count()
	}

	on call orderCount() -> Effect[Int] {
		orders.size()
	}
}
