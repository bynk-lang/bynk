// v0.86 (ADR 0112): the `Duration` primitive — literals, arithmetic, scalar
// scaling, comparison, the sanctioned clock-math mix, and the conversions.

fn total() -> Duration {
  5.minutes + 30.seconds
}

fn scaled() -> Duration {
  2.minutes * 3
}

fn longer() -> Bool {
  1.hour > 30.minutes
}

fn deadline(now: Instant) -> Instant {
  now + 5.minutes
}

fn millis() -> Int {
  1.minute.toMillis()
}

fn ofInt(n: Int) -> Duration {
  Duration.millis(n)
}

fn everyUnit() -> Duration {
  100.milliseconds + 1.second + 1.minute + 1.hour + 1.day
}
