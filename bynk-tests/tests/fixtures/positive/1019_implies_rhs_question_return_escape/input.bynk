commons probe

// #1044 review: `implies`'s general-path arm negates the condition *and*
// puts rhs in the else branch — the third `hoist_if_as_statement` call site
// with no fixture coverage before this one.
fn risky() -> Result[Int, String] {
  Ok(1)
}

fn check(x: Bool) -> Result[Bool, String] {
  Ok(x implies risky()? > 0)
}
