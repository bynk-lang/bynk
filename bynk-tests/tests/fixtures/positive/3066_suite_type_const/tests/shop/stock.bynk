suite shop.stock

type Counted = { n: Int }

type Kind = | Fruit | Veg

const Prefix: String = "fruit-"
const Greeting: String = Prefix

fn first_id() -> String {
	Prefix
}

case "a suite type reads back through select" {
	let _ <- Stock.run("CREATE TABLE items (id TEXT)", [])
	let _ <- Stock.run("INSERT INTO items (id) VALUES ('a')", [])
	let rows <- Stock.select[Counted]("FROM (SELECT count(*) AS n FROM items)", [])
	expect rows == Ok([Counted { n: 1 }])
}

case "a suite type and constants are plain values" {
	let c = Counted { n: 3 }
	expect c.n == 3
	expect Greeting == "fruit-"
	expect first_id() == Prefix
	expect Fruit != Veg
	expect Json.decode[Counted](Json.encode(c)) == Ok(c)
}

property "a suite type works in a property" {
	for all n: Int {
		expect Counted { n: n }.n == n
	}
}
