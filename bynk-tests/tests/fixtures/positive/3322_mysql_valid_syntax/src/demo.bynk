context demo

// Hyperdrive H5 (#3322): MySQL-specific syntax, with a `schema.sql`, that the
// statement check must accept: backtick identifiers, `ON DUPLICATE KEY UPDATE`,
// `LIMIT ?, ?`, `INSERT IGNORE`, and a `?` inside a string literal, a quoted
// name and a comment, none of which is a parameter.

consumes bynk
consumes bynk.cloudflare { MySql, MySqlError, MySqlRun, MySqlStatement, MySqlValue }

capability Legacy = MySql

service probe {
  on call(name: String) -> Effect[Result[String, MySqlError]] given Legacy {
    let a <- Legacy.all("select `id`, `name` from `orders` where `name` like ? order by `id` limit ?, ?", [MySqlText(name), MySqlInteger(0), MySqlInteger(10)])
    let b <- Legacy.all("insert into orders (name, qty) values (?, ?) on duplicate key update qty = qty + values(qty)", [MySqlText(name), MySqlInteger(1)])
    let c <- Legacy.all("insert ignore into orders (name) values (?)", [MySqlText(name)])
    let d <- Legacy.first("select 'is this a parameter?' as q, `what?` from t where id = ? -- and ?", [MySqlNull])
    Legacy.all("update orders set qty = qty - 1 where name = ? /* ? */ limit 1", [MySqlText(name)])
  }
}

service batch {
  on call(name: String) -> Effect[Result[List[MySqlRun], MySqlError]] given Legacy {
    Legacy.transaction([
      MySqlStatement { sql: "insert ignore into orders (name) values (?)", params: [MySqlText(name)] },
      MySqlStatement { sql: "delete from orders where qty < ?", params: [MySqlInteger(0)] },
    ])
  }
}
