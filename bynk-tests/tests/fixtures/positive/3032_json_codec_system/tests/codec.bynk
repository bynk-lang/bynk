suite api as system {
  uses shape.model
  // #3032: `Json.encode`/`Json.decode` in a system suite generate their own codecs.
  case "a commons record round-trips, tagged" {
    let p = Pull { id: 7, draft: Some(true), closed_at: None, head: Head { ref: "b", repo: None }, labels: ["x", "y"] }
    expect Json.decode[Pull](Json.encode(p)) == Ok(p)
    expect Json.encode(Some(1)) == "{\"kind\":\"Some\",\"value\":1}"
  }

  case "a commons record round-trips, plain" {
    let p = Pull { id: 7, draft: Some(true), closed_at: None, head: Head { ref: "b", repo: Some("r") }, labels: ["x"] }
    expect Json.encodePlain(p) == "{\"id\":7,\"draft\":true,\"closed_at\":null,\"head\":{\"ref\":\"b\",\"repo\":\"r\"},\"labels\":[\"x\"]}"
    expect Json.decode[Pull](Json.encodePlain(p)) == Ok(p)
  }
}
