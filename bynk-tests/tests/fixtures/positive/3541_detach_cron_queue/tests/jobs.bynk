// #3541: a detached `Err` in a cron or queue handler is reported on the case that
// ran it, as one in an HTTP or service handler is, and does not fail the case.
suite cr.jobs as system {
	case "a detached Err in a cron handler is reported" {
		let r <- sweeper.schedule("*/5 * * * *", Instant.fromEpochMillis(960000))
		expect r is Ok(_)
	}

	case "a detached fault in a cron handler is reported" {
		let r <- sweeper.schedule("0 * * * *", Instant.fromEpochMillis(0))
		expect r is Ok(_)
	}

	case "a detached Err in a queue consumer is reported" {
		let r <- deliveries.message(Delivery { id: "d1" })
		expect r is Ack
	}
}
