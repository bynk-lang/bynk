context boundary.consumer

consumes boundary.provider as Provider

type Reply = String where MaxLength(8)
type Handle = opaque String where MaxLength(8)

service ask {
  on call(n: Int) -> Effect[Result[Reply, Int]] {
    let r <- Provider.reply(n)
    Effect.pure(r)
  }
}

service askAll {
  on call(n: Int) -> Effect[List[Reply]] {
    let rs <- Provider.replies(n)
    Effect.pure(rs)
  }
}

service askMixed {
  on call(n: Int) -> Effect[Int] {
    let r <- Provider.mixed(n)
    match r {
      Ok(_) => Effect.pure(0)
      Err(_) => Effect.pure(1)
    }
  }
}

service askHandle {
  on call(n: Int) -> Effect[Result[Handle, Int]] {
    let h <- Provider.handle(n)
    Effect.pure(h)
  }
}
