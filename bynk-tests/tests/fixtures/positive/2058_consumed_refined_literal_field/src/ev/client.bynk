context ev.client

consumes ev.store
consumes ev.kinds

// #2058: the caller never names `Code`, so a literal admitted to it is cast
// to `ev_store.Code`, under the namespace the module already imports.
service bound {
  on call() -> Effect[Int] {
    let i = Item { code: 1, name: "a" }
    ev.store.put(i)
  }
}

// `ev.kinds` has no service, so only the type cast names its namespace.
service tagged {
  on call() -> Effect[Int] {
    let t = Tag { kind: 3, label: "x" }
    t.kind
  }
}

service direct {
  on call() -> Effect[Int] {
    ev.store.put(Item { code: 2, name: "b" })
  }
}
