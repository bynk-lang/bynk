// #2058: run over the wire.
suite ev.client as system {
  case "a record bound before the call" {
    let r <- ev.client.bound()
    expect r == 1
  }

  case "a record of a consumed context with no service" {
    let r <- ev.client.tagged()
    expect r == 3
  }

  case "a record built in the call" {
    let r <- ev.client.direct()
    expect r == 2
  }
}
