---
#2684: the `Set` methods run erased over record elements; collisions that
a naive encoding would conflate stay distinct.
---
commons demo.gen

type P = { x: Int, y: Int }

type Tagged = | Num(n: Int) | Str(s: String)

fn merge(a: Set[P], b: Set[P]) -> Set[P] { a.union(b) }

fn common(a: Set[P], b: Set[P]) -> Set[P] { a.intersect(b) }
