suite reg.tokens

// K4: a unit-tier test runs real cryptography through the Node binding, so
// known answers hold, and `stub`/`expect` still work on `Crypto`.

case "a token is hashed with SHA-256" {
  let h <- hashing.call("abc")
  expect h == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
}

case "equal digests match and different ones do not" {
  let same <- matching.call("secret", "secret")
  let different <- matching.call("secret", "Secret")
  expect same == true
  expect different == false
}

case "an HMAC matches RFC 4231 test case 2" {
  let m <- mac.call("Jefe", "what do ya want for nothing?")
  expect m == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
}

case "a webhook MAC verifies, and a wrong one does not" {
  let good <- webhook.call("Jefe", "what do ya want for nothing?", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  let bad <- webhook.call("Jefe", "tampered", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  let junk <- webhook.call("Jefe", "x", "not hex")
  expect good == true
  expect bad == false
  expect junk == false
}

case "random bytes are deterministic under test" {
  let n <- token.call()
  expect n == 64
}

case "an Ed25519 signature matches RFC 8032 test 1" {
  let sig <- signing.call("302e020100300506032b6570042204209d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "")
  expect sig == "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
}

case "that signature verifies, and fails for other data" {
  let sig <- signing.call("302e020100300506032b6570042204209d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "")
  let ok <- verifying.call("302a300506032b6570032100d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "", sig)
  let other <- verifying.call("302a300506032b6570032100d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "other", sig)
  expect ok == true
  expect other == false
}

case "a bad key is an error value, not a fault" {
  let sig <- signing.call("00", "x")
  expect sig == "error"
}

case "a stubbed digest is observed" {
  stub Crypto.digest(_, _) returns Bytes.fromUtf8("stubbed")
  let h <- hashing.call("abc")
  expect h == "73747562626564"
  expect Crypto.digest called once
}
