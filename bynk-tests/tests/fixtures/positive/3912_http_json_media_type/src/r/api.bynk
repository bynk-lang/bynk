context r.api

type Note = { text: String }

service api from http {
	// A JSON body route: a form or multipart post is the router's `415`.
	on POST("/notes") (body: Note) -> Effect[HttpResult[String]] by v: Visitor {
		Ok(body.text)
	}

	// A raw route that takes either of two image types.
	@raw(contentType: ["image/png", "image/jpeg"])
	@limit(maxBody: 1_000)
	on POST("/avatars") (body: Bytes) -> Effect[HttpResult[Int]] by v: Visitor {
		Ok(body.length())
	}
}
