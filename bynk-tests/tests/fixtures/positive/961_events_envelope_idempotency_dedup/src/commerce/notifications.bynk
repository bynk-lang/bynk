context commerce.notifications

consumes commerce.order
consumes bynk { Idempotency, Logger }

service OnPayment from Events(PaymentConfirmed) {
  on event(e: PaymentConfirmed, env: EventEnvelope) -> Effect[()] given Idempotency, Logger {
    let seen <- Idempotency.dedup[Bool](env.eventId)
    match seen {
      Some(_) => (),
      None => {
        let _ <- Logger.info(e.orderId)
        let _ <- Idempotency.remember[Bool](env.eventId, true, 7.days)
      }
    }
  }
}
