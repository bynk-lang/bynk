// #2062: a case names a consumed context's nullary variant bare, as the
// target's own handlers may (`shop.ledger` writes `Domestic` for
// `shop.order`'s `Region.Domestic`). Each lowers to `Region.Domestic`.
suite shop.ledger {
  case "a bare consumed variant in a record literal" {
    let o = Order { id: "o1", region: Domestic }
    let d <- isDomestic.call(o)
    expect d
  }

  case "a bare consumed variant in a comparison" as integration {
    let o <- domestic.call("o2")
    expect o.region == Domestic
  }

  case "a bare consumed variant as a value and a pattern" {
    let r = International
    let label = match r {
      Domestic => "home",
      International => "abroad",
    }
    expect label == "abroad"
  }
}
