context shop.api

// #3926: a limit counted per signed-in user, on a `sessions = true` SignedCookie actor. The cookie
// seam's own checks run before the limiter is asked, all of them: the cross-site refusal of a
// state-changing request, the cookie's signature and lifetime, and the session-live check. A caller
// who fails any of them gets that refusal and never touches the limiter.

consumes bynk { Clock }
consumes bynk.cloudflare { RateLimit }

type UserId = String where NonEmpty && MaxLength(64)

actor Member { auth = SignedCookie(secret = "SESSION_KEY", previous = "SESSION_KEY_PREV", ttl = 12.hours, sessions = true), identity = UserId }

capability RenameLimit = RateLimit @limit(2) @period(60.seconds)

service api from http {
  cors { origins: ["https://app.example.com"], credentials: true }

  @rateLimit(RenameLimit, key: identity)
  on POST("/rename") (body: String) -> Effect[HttpResult[()]] by u: Member {
    NoContent
  }

  // The same limiter on a route that also takes the request's headers, so a case can send a
  // cross-site request: the limiter counts across both routes, by caller.
  @rateLimit(RenameLimit, key: identity)
  on POST("/rename-from") (headers: RequestHeaders, body: String) -> Effect[HttpResult[()]] by u: Member {
    NoContent
  }

  on POST("/logout") () -> Effect[HttpResult[()]] by u: Member {
    let c <- Member.expire()
    NoContent.withCookie(c)
  }
}
