context shop.ask

// #3480: an `AiSearch` instance names the account's instance. It binds as
// `AI_SEARCH_<NAME>`, an `[[ai_search]]` entry naming the instance as
// written, and only a Worker that reaches one declares it.

consumes bynk
consumes bynk.cloudflare { Kv, AiSearch, ChatMessage, ChatRole, SearchOptions, SearchHit, SearchError, RetrievalType, Condition, FilterOp, MetaValue, SearchAnswer }

capability Kb = AiSearch @instance("support-docs")

service api from http {
	on POST("/search") (body: String) -> Effect[HttpResult[String]] by Visitor given Kb {
		let hits <- Kb.search(body, SearchOptions {
			maxResults: Some(5),
			retrieval: Some(RetrievalType.Hybrid),
			rerank: true,
			filter: [Condition { field: "folder", op: FilterEq(MetaText("docs/")) }],
		})
		match hits {
			Ok(found) => Ok(Json.encode(found)),
			Err(SearchInvalidInput(message)) => ServerError(message),
			Err(_) => ServerError("search unavailable"),
		}
	}

	on POST("/ask") (body: String) -> Effect[HttpResult[String]] by Visitor given Kb {
		let reply <- Kb.answer([ChatMessage { role: ChatRole.User, content: body }], SearchOptions {})
		match reply {
			Ok(a) => Ok(a.text),
			Err(SearchRateLimited) => ServerError("busy"),
			Err(_) => ServerError("search unavailable"),
		}
	}
}
