---
#2805: a store `Query`'s `sortByDescending` is stable and the exact reverse of
`sortBy`'s order (so `NaN` is first), and
composes lazily with `take`/`skip`.
---
context demo.desc

type Priority = enum { Low, Medium, High } derives Ord

type Job = { name: String, priority: Priority, due: Int, score: Float, div: Float }

agent Board {
  key id: String
  store jobs: Map[String, Job]

  on call add(name: String, priority: Priority, due: Int, score: Float, div: Float) -> Effect[()] {
    let _ <- jobs.put(name, Job { name: name, priority: priority, due: due, score: score, div: div })
    ()
  }
  on call byPriority() -> Effect[List[String]] {
    jobs.sortByDescending((j) => j.priority).map((j) => j.name).collect()
  }
  on call byDue() -> Effect[List[String]] {
    jobs.sortByDescending((j) => j.due).map((j) => j.name).collect()
  }
  on call byDueAscending() -> Effect[List[String]] {
    jobs.sortBy((j) => j.due).map((j) => j.name).collect()
  }
  on call byScore() -> Effect[List[String]] {
    jobs.sortByDescending((j) => j.score / j.div).map((j) => j.name).collect()
  }
  on call topTwo() -> Effect[List[String]] {
    jobs.sortByDescending((j) => j.due).take(2).map((j) => j.name).collect()
  }
}
