---
#2684: the decoded `Map` and `Set` are keyed by value, so they compare and look up
like the originals; a duplicate set member on the wire is a decode error.
---
suite demo.wire

case "a record-keyed map round-trips" {
  let l = sample()
  match Json.decode[Ledger](Json.encode(l)) {
    Ok(back) => expect back == l
    Err(_) => expect false
  }
}

case "a decoded map looks up by value" {
  match Json.decode[Ledger](Json.encode(sample())) {
    Ok(back) => expect back.totals.get(OrderId { n: 7, region: "eu" }) == Some(3)
    Err(_) => expect false
  }
}

case "a decoded set is keyed by value" {
  match Json.decode[Ledger](Json.encode(sample())) {
    Ok(back) => expect back.seen.contains(Shipped)
    Err(_) => expect false
  }
}

case "a repeated set member is rejected" {
  match Json.decode[Set[Status]](Json.encode([Open, Open])) {
    Ok(_) => expect false
    Err(_) => expect true
  }
}

case "a distinct set decodes" {
  match Json.decode[Set[Status]](Json.encode([Open, Shipped])) {
    Ok(s) => expect s.length() == 2
    Err(_) => expect false
  }
}

case "a repeated map key is rejected, not last-entry-wins (#2707)" {
  expect Json.decode[Map[String, Int]]("[[\"a\",1],[\"a\",2]]") is Err(_)
  expect Json.decode[Map[Int, Int]]("[[1,1],[1,2]]") is Err(_)
}

case "a repeated composite map key is rejected by value (#2707)" {
  expect Json.decode[Map[OrderId, Int]]("[[{\"region\":\"eu\",\"n\":7},1],[{\"n\":7,\"region\":\"eu\"},2]]") is Err(_)
}

case "a repeated Decimal map key is rejected on its canonical value (#2707)" {
  expect Json.decode[Map[Decimal, Int]]("[[\"1.20\",1],[\"1.2\",2]]") is Err(_)
  match Json.decode[Map[Decimal, Int]]("[[\"1.20\",1],[\"1.3\",2]]") {
    Ok(m) => expect m.length() == 2
    Err(_) => expect false
  }
}

case "distinct map keys still decode (#2707)" {
  match Json.decode[Map[String, Int]]("[[\"a\",1],[\"b\",2]]") {
    Ok(m) => expect m.length() == 2
    Err(_) => expect false
  }
}
