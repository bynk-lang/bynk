commons app.z

// #4352: a declaration reached by several spellings is one declaration: `Status` from the
// selection, `Y.Status` through the alias and `lib.y.Status` by the full name are one type,
// so a value of one is a value of the others and a match reads its variants.
uses lib.y { Status, describe }
uses lib.y as Y

fn viaAlias(s: Status) -> Y.Status { s }

fn viaFullName(s: Y.Status) -> lib.y.Status { s }

fn back(s: lib.y.Status) -> Status { s }

fn same(a: Status, b: Y.Status, c: lib.y.Status) -> Bool { a == b && b == c }

fn read(s: lib.y.Status) -> Int {
  match s {
    On => 1,
    Off => 0,
  }
}

fn named(s: Y.Status) -> String { "\(describe(s))\(Y.describe(s))\(lib.y.describe(s))" }

fn limit() -> Int { Y.Limit + lib.y.Limit }
