context shop.search

// #3479: a test never reaches an index. Every operation faults until it is
// stubbed, and a stubbed reply (or error) is what the handler sees.

consumes bynk
consumes bynk.cloudflare { Vectorize, Vector, VectorError, VectorMatch, QueryOptions, Mutation }

capability Docs = Vectorize @dimensions(3) @metric("cosine")

service api from http {
	on PUT("/doc") (body: String) -> Effect[HttpResult[String]] by Visitor given Docs {
		let written <- Docs.upsert([Vector { id: body, values: [0.1, 0.2, 0.3] }])
		match written {
			Ok(mutation) => Ok(mutation.id),
			Err(DimensionMismatch(message)) => ServerError(message),
			Err(_) => ServerError("index unavailable"),
		}
	}

	on GET("/search") () -> Effect[HttpResult[String]] by Visitor given Docs {
		let hits <- Docs.query([0.1, 0.2, 0.3], QueryOptions { topK: 3 })
		match hits {
			Ok(found) => Ok(Json.encode(found)),
			Err(_) => ServerError("search unavailable"),
		}
	}
}
