suite shop.search

// #3479: an unstubbed operation faults, a stubbed `Ok` is what the handler
// sees, and a typed error is matched.

case "an unstubbed upsert faults" {
	expect api.PUT("/doc", "d1") by Visitor faults
}

case "a stubbed upsert returns its mutation id" {
	stub Docs.upsert(_) returns Ok(Mutation { id: "m1" })
	let r <- api.PUT("/doc", "d1") by Visitor
	expect r is Ok("m1")
	expect Docs.upsert called once
}

case "a dimension mismatch is matched" {
	stub Docs.upsert(_) returns Err(DimensionMismatch("expected 3 dimensions"))
	let r <- api.PUT("/doc", "d1") by Visitor
	expect r is ServerError("expected 3 dimensions")
}

case "a stubbed query is returned" {
	stub Docs.query(_, _) returns Ok([])
	let r <- api.GET("/search") by Visitor
	expect r is Ok("[]")
}
