// #2840: at `system`, the Worker runs the real Cloudflare provider against the
// participant's own database, which starts with the compiler's claims migration.
suite shop.hooks as system {
  case "a claim is taken in the participant's database, once" {
    let first <- api.POST("/hooks/:id", "wire-1") by Visitor
    expect first is Ok("processed")
    let again <- api.POST("/hooks/:id", "wire-1") by Visitor
    expect again is Ok("duplicate")
  }

  case "a failed handler releases its claim over the wire" {
    let first <- api.POST("/flaky/:id", "down") by Visitor
    expect first is ServerError(_)
    let retry <- api.POST("/flaky/:id", "down") by Visitor
    expect retry is ServerError(_)
  }

  case "a remembered value is stored in the participant's database and read back" {
    let first <- skew.POST("/receipt/:id", "wire-r") by Visitor
    expect first is Ok("stored")
    let again <- skew.POST("/receipt/:id", "wire-r") by Visitor
    expect again is Ok("hit wire-r:42")
  }

  case "a stored value that does not decode reads as a miss over the wire" {
    let text <- skew.POST("/skew/:id/:mode", "wire-s", "text") by Visitor
    expect text is Ok("stored")
    let asInt <- skew.POST("/skew/:id/:mode", "wire-s", "int") by Visitor
    expect asInt is Ok("stored")
    let intAgain <- skew.POST("/skew/:id/:mode", "wire-s", "int") by Visitor
    expect intAgain is Ok("hit 7")
  }
}
