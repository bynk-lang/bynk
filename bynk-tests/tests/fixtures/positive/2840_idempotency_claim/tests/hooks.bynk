suite shop.hooks {
  case "the first delivery is processed and a repeat is a duplicate" {
    let first <- api.POST("/hooks/:id", "d1") by Visitor
    expect first is Ok("processed")
    let again <- api.POST("/hooks/:id", "d1") by Visitor
    expect again is Ok("duplicate")
  }

  case "another key is its own claim" {
    let a <- api.POST("/hooks/:id", "d1") by Visitor
    expect a is Ok("processed")
    let b <- api.POST("/hooks/:id", "d2") by Visitor
    expect b is Ok("processed")
  }

  case "a claim lapses after its window" {
    let first <- api.POST("/hooks/:id", "d1") by Visitor
    expect first is Ok("processed")
    advance Clock by 61.minutes
    let later <- api.POST("/hooks/:id", "d1") by Visitor
    expect later is Ok("processed")
  }

  case "a claim is released when the handler returns a 5xx" {
    let first <- api.POST("/flaky/:id", "down") by Visitor
    expect first is ServerError(_)
    let retry <- api.POST("/flaky/:id", "down") by Visitor
    expect retry is ServerError(_)
  }

  case "a claim is kept when the handler completes with a 4xx" {
    let first <- api.POST("/flaky/:id", "invalid") by Visitor
    expect first is BadRequest(_)
    let retry <- api.POST("/flaky/:id", "invalid") by Visitor
    expect retry is Ok("duplicate")
  }

  case "a completed claim stays claimed" {
    let first <- api.POST("/flaky/:id", "fine") by Visitor
    expect first is Ok("processed")
    let again <- api.POST("/flaky/:id", "fine") by Visitor
    expect again is Ok("duplicate")
  }

  // The lease is only for an unsettled claim: a settled one holds for its full window.
  case "a completed claim outlasts the lease" {
    let first <- api.POST("/flaky/:id", "fine") by Visitor
    expect first is Ok("processed")
    advance Clock by 10.minutes
    let again <- api.POST("/flaky/:id", "fine") by Visitor
    expect again is Ok("duplicate")
  }

  // The double honours `remember`'s window on the harness clock.
  case "a remembered value lapses after its window" {
    let first <- replay.POST("/replay/:id", "r1") by Visitor
    expect first is Ok("fresh")
    let hit <- replay.POST("/replay/:id", "r1") by Visitor
    expect hit is Ok("computed")
    advance Clock by 61.minutes
    let after <- replay.POST("/replay/:id", "r1") by Visitor
    expect after is Ok("fresh")
  }

  case "a claim is released when a handler returns Err" {
    let first <- ledger.call("bad")
    expect first is Err("rejected")
    let retry <- ledger.call("bad")
    expect retry is Err("rejected")
  }

  case "a handler that returns Ok keeps its claim" {
    let first <- ledger.call("good")
    expect first is Ok("done")
    let again <- ledger.call("good")
    expect again is Ok("duplicate")
  }

  case "a value round-trips through the generic helper" {
    let first <- skew.POST("/receipt/:id", "r1") by Visitor
    expect first is Ok("stored")
    let again <- skew.POST("/receipt/:id", "r1") by Visitor
    expect again is Ok("hit r1:42")
    let other <- skew.POST("/receipt/:id", "r2") by Visitor
    expect other is Ok("stored")
  }

  case "a stored value that does not decode as the type asked for is a miss" {
    let text <- skew.POST("/skew/:id/:mode", "s1", "text") by Visitor
    expect text is Ok("stored")
    let again <- skew.POST("/skew/:id/:mode", "s1", "text") by Visitor
    expect again is Ok("hit text")
    // Read as an Int, the stored text does not decode: a miss, which then stores the Int.
    let asInt <- skew.POST("/skew/:id/:mode", "s1", "int") by Visitor
    expect asInt is Ok("stored")
    let intAgain <- skew.POST("/skew/:id/:mode", "s1", "int") by Visitor
    expect intAgain is Ok("hit 7")
  }
}
