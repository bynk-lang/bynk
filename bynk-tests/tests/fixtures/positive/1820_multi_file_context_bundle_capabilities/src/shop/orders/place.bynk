context shop.orders

uses shop.values

// #1820: `place` names no capability, but the agent it calls is `given`
// `Stamp`, so its deps carry it.
service place {
  on call(m: Money) -> Effect[Int] {
    Book("o1").add(m)
  }
}

service length {
  on call(n: Note) -> Effect[Int] { n.text.length() }
}
