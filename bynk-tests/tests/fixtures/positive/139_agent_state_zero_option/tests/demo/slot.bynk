---
State-init probe: a never-seen Option field reads None (so resolve fails Empty).
---
suite demo.slot

case "a fresh Slot key resolves to Empty" {
	match Label.of("fresh") {
		Err(_) => expect false
		Ok(id) => {
			let outcome <- resolve.call(id)
			match outcome {
				Ok(_)  => expect false
				Err(slotError) => match slotError {
					Empty => expect true
				}
			}
		}
	}
}

case "a written Slot key reads back after a reload" {
	match Label.of("written") {
		Err(_) => expect false
		Ok(id) => {
			do Slot(id).assign(42)
			let outcome <- resolve.call(id)
			match outcome {
				Ok(v) => expect v == 42
				Err(_) => expect false
			}
		}
	}
}
