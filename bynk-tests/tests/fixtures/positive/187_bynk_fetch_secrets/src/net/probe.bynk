context net.probe

consumes bynk { Fetch, Secrets, Method, Request }

service probe {
  on call(url: String) -> Effect[Int] by Caller given Fetch, Secrets {
    let auth <- Secrets.get("PROBE_TOKEN")
    let req = Request {
      method: Get,
      url: url,
      contentType: None,
      authorization: auth.map((t) => t.bearer()),
      headers: Map.empty(),
      body: None,
    }
    let res <- Fetch.send(req)
    match res {
      Ok(r) => r.status,
      Err(_) => 0,
    }
  }
}
