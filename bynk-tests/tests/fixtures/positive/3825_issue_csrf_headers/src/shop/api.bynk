context shop.api

consumes bynk { Cookie, Clock }

type UserId = String where NonEmpty && MaxLength(64)

type Login = { user: String }

actor Member { auth = SignedCookie(secret = "SESSION_KEY", ttl = 12.hours), identity = UserId }

// #3825: the headers a sign-in carries decide whether it runs. `bynk-tests/tests/system/login_csrf_seam.rs`
// drives the compiled Worker with each combination, including the ones the `system` tier cannot send: no
// `Sec-Fetch-Site` at all, and an `Origin` alone.
service api from http {
	cors { origins: ["https://app.example.com"], credentials: true }

	@limit(maxBody: 256)
	on POST("/login") (body: Login) -> Effect[HttpResult[String]] by v: Visitor given Clock {
		let Ok(id) = UserId.of(body.user) else {
			BadRequest("bad user")
		}
		let c <- Member.issue(id)
		Created("welcome").withCookie(c)
	}
}
