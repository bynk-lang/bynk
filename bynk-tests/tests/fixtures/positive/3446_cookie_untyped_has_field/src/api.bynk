context api

consumes bynk { Cookie }

type Theme = enum { Light, Dark }
type Prefs = { theme: Theme = Light }

service api from http {
  // A cookie in no record is fine; one a record reads is better written from it.
  on GET("/a") (cookies: Prefs) -> Effect[HttpResult[String]] by v: Visitor {
    Ok("x").withCookie(Cookie { name: "theme", value: "Dark" })
  }

  // Deleting is an empty value, which no decoder reads: a warning to use `expire()`, not an error.
  on POST("/reset") () -> Effect[HttpResult[()]] by v: Visitor {
    NoContent.clearCookie(Cookie { name: "theme", value: "" })
  }
}
