// #3887: a `system` case posts the message to the Worker's real `email()` entry and reads back
// everything the handler's verdict did: a combination is a `Route`, a single action the shorthand.
suite shop.support as system {
  case "a reply and two forwards, with the tag on the forwards" {
    let r <- support.message(InboundEmail { from: "a@b.example", to: "support@shop.example", subject: "billing" })
    match r {
      Route(a) => {
        expect a.forward == ["billing@shop.example", "audit@shop.example"]
        expect a.reply.isSome()
        let expected: Map[String, String] = Map.empty().insert("x-ticket", "T-1234")
        expect a.tag == expected
      }
      _ => expect false
    }
  }

  case "destinations that differ only in case are forwarded once" {
    let r <- support.message(InboundEmail { from: "a@b.example", to: "support@shop.example", subject: "duplicates" })
    expect r is Forward("audit@shop.example")
  }

  case "a route with nothing to do is accepted" {
    let r <- support.message(InboundEmail { from: "a@b.example", to: "support@shop.example", subject: "nothing" })
    expect r is Accept
  }

  case "a plain forward is still a forward" {
    let r <- support.message(InboundEmail { from: "a@b.example", to: "support@shop.example", subject: "other" })
    expect r is Forward("billing@shop.example")
  }

  case "a service with a fallback still reads its Route, tags and all" {
    let r <- escalate.message(InboundEmail { from: "a@b.example", to: "escalate@shop.example", subject: "route" })
    match r {
      Route(a) => {
        expect a.forward == ["billing@shop.example", "audit@shop.example"]
        let expected: Map[String, String] = Map.empty().insert("x-ticket", "T-9")
        expect a.tag == expected
      }
      _ => expect false
    }
  }

  case "a fault in a service with a fallback is the fallback's forward, with no tag" {
    let r <- escalate.message(InboundEmail { from: "a@b.example", to: "escalate@shop.example", subject: "boom" })
    expect r is Forward("ops@ops.example")
  }
}
