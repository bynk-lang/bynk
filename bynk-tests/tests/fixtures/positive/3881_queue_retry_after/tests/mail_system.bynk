suite ops.mail as system {

consumes bynk.cloudflare { QueueDelivery }
  case "a backoff doubles with each attempt (system)" {
    let first <- backoff.message(Job { id: "a" })
    expect first == RetryAfter("dependency down", 10.seconds)
    let second <- backoff.message(Job { id: "a" }, QueueDelivery { attempts: 2, sentAt: Instant.fromEpochMillis(0) })
    expect second == RetryAfter("dependency down", 20.seconds)
    let third <- backoff.message(Job { id: "a" }, QueueDelivery { attempts: 3, sentAt: Instant.fromEpochMillis(0) })
    expect third == RetryAfter("dependency down", 40.seconds)
  }

  case "a computed delay is clamped and truncated (system)" {
    let long <- clamped.message(Job { id: "b" })
    expect long == RetryAfter("too long", 24.hours)
    let short <- clamped.message(Job { id: "b" }, QueueDelivery { attempts: 2, sentAt: Instant.fromEpochMillis(0) })
    expect short == RetryAfter("too short", 1.second)
    let part <- clamped.message(Job { id: "b" }, QueueDelivery { attempts: 3, sentAt: Instant.fromEpochMillis(0) })
    expect part == RetryAfter("part second", 1.second)
  }

  case "a plain retry carries no delay of its own (system)" {
    let r <- plain.message(Job { id: "c" })
    expect r == Retry("again")
  }

  case "the delay is readable from the verdict (system)" {
    let r <- backoff.message(Job { id: "d" }, QueueDelivery { attempts: 4, sentAt: Instant.fromEpochMillis(0) })
    match r {
      RetryAfter(_, d) => expect d == 80.seconds
      Retry(_) => expect false
      Ack => expect false
      Undecodable => expect false
    }
  }
}
