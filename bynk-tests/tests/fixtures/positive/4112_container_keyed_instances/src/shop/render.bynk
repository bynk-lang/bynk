context shop.render

// #4112: `@instances(by: TenantId)` makes `send`, `receiveBytes` and `sendBytes` take a `TenantId`
// where they would take a `String`. The key's construction is where the set of names is decided,
// so a keyed instance on a route served by an authenticated actor does not warn. A key limits what
// a name looks like, not how many there are, so on a route anyone can call it would (see
// `4584_container_keyed_open_route`).

consumes bynk
consumes bynk.cloudflare { Container, ContainerError }

type TenantId = String where Matches(r"[a-z0-9-]{3,32}")

actor Member { auth = Bearer(secret = "AUTH_SECRET"), identity = TenantId }

capability Renderer = Container @build("containers/renderer") @port(8080) @instances(by: TenantId)

service api from http {
	on GET("/render/:tenant") (
		tenant: TenantId
	) -> Effect[HttpResult[String]] by m: Member given Renderer {
		let req = Request {
			method: Get,
			url: "http://renderer/render",
		}
		let res <- Renderer.send(tenant, req)
		match res {
			Ok(r) => Ok(r.body),
			Err(Unavailable) => ServiceUnavailable("no capacity"),
			Err(_) => ServerError("render failed"),
		}
	}

	on GET("/thumb/:tenant") (
		tenant: TenantId
	) -> Effect[HttpResult[String]] by m: Member given Renderer {
		let req = Request {
			method: Get,
			url: "http://renderer/thumb",
		}
		let res <- Renderer.receiveBytes(tenant, req)
		match res {
			Ok(r) => Ok(r.body.decodeUtf8().getOrElse("")),
			Err(_) => ServerError("thumbnail failed"),
		}
	}
}
