context cs.store

uses cs.values
exports transparent { Batch, Holder }

// #2035: a caller's view of these is typed `cs_store.Batch`, whose commons
// fields carry this context's brand.
type Batch = { lines: List[Line], first: Option[Line], byKey: Map[String, Line], page: Page[Line], pair: Pair }

type Holder = { batch: Batch, extra: List[Line] }

service put {
  on call(b: Batch) -> Effect[Int] { b.lines.length() }
}

service hold {
  on call(h: Holder) -> Effect[Int] { h.extra.length() }
}

service many {
  on call(ls: List[Line], first: Option[Line], byKey: Map[String, Line]) -> Effect[Int] { ls.length() }
}
