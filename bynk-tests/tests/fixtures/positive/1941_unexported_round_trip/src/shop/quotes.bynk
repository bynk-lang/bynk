context shop.quotes

// #1941: `Box` and `Amount` are not exported. A consumer holds a `Box` it
// received from `quote` and passes it back to `take`: the value compares
// against its own declaration, which the consumer cannot name.

type Amount = { cents: Int }

type Box = { a: Amount }

service quote {
  on call() -> Effect[Box] {
    Effect.pure(Box { a: Amount { cents: 1 } })
  }
}

service take {
  on call(b: Box) -> Effect[Int] {
    Effect.pure(b.a.cents)
  }
}
