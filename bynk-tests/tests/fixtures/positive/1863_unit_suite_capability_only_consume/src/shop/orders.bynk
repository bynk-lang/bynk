context shop.orders

consumes shop.fees as Fees

consumes bynk as B

consumes shop.rates as Rates

// #1863: a unit suite against a context consuming `shop.fees` only for its
// capability. Its test deps called `shop.fees`'s nonexistent `__makeSurface`
// (TS2339) and never built `Fees`'s provider (TS2345).

// A local provider `given` the consumed capability: built with its deps.
capability Stamp {
  fn next() -> Effect[Int]
}

provides Stamp = FeeStamp given Fees.Fees {
  fn next() -> Effect[Int] {
    let f <- Fees.Fees.fee()
    Effect.pure(f + 1)
  }
}

service charge {
  on call() -> Effect[Int] given Fees.Fees {
    Fees.Fees.fee()
  }
}

service stamp {
  on call() -> Effect[Int] given Stamp {
    Stamp.next()
  }
}

// An agent `given` a consumed capability no service is.
agent Till {
  key id: String

  store total: Cell[Int] = 0

  on call add() -> Effect[Int] given Fees.Tax {
    let t <- Fees.Tax.tax()
    let _ <- total.update((n) => n + t)
    Effect.pure(total)
  }
}

service till {
  on call() -> Effect[Int] {
    Till("t").add()
  }
}

// #1864 review: a first-party capability named with a prefix, not
// flattened (`consumes bynk { Clock }`), gets its test double too.
service clock {
  on call() -> Effect[Int] given B.Clock {
    let _ <- B.Clock.now()
    Effect.pure(1)
  }
}

// #1864 review: `Rates` is given here directly as well as to `Fees`'s
// provider, so both are locals of the test deps, `Rates` declared first.
service rate {
  on call() -> Effect[Int] given Rates.Rates {
    Rates.Rates.rate()
  }
}
