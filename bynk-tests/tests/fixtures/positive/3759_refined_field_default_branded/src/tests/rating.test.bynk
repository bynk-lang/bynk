suite demo.rating {
  // #3759: the omitted refined default is a `Rating`, not a bare number.

  case "the default rating is used" {
    expect plain().rating == 5
  }

  case "the default flows where a Rating is expected" {
    expect stars(ratingOf(plain())) == 5
  }

  case "nested refined defaults are branded too" {
    expect plain().scores.length() == 2
  }
}
