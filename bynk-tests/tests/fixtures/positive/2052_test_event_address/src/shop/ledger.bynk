// #2052: subscribers a case delivers events to with `svc.event(e)`.
context shop.ledger

consumes shop.order
consumes bynk { Idempotency, Claim }

agent Books {
  key id: String
  store count: Cell[Int] = 0
  store publisher: Cell[String] = ""

  on call bump() -> Effect[()] {
    let _ <- count.update((n) => n + 1)
  }

  on call note(p: String) -> Effect[()] {
    publisher := p
  }

  on call total() -> Effect[Int] {
    count
  }

  on call publisherSeen() -> Effect[String] {
    publisher
  }
}

// The events guide's idempotency idiom: claim the envelope's `eventId`.
service OnPlaced from Events(Placed) {
  on event(e: Placed, env: EventEnvelope) -> Effect[()] given Idempotency {
    let Claim.Claimed <- Idempotency.claim(env.eventId, 7.days) else { () }
    let _ <- Books("publisher").note(env.publisherId)
    Books("all").bump()
  }
}

// A pattern filter, on a handler that declares no envelope.
service OnDomestic from Events(Placed { region: Region.Domestic, .. }) {
  on event(e: Placed) -> Effect[()] {
    Books("domestic").bump()
  }
}

// `via schema(N)` guards, on handlers that declare no envelope.
service OnV1 from Events(Placed) via schema(1) {
  on event(e: Placed) -> Effect[()] {
    Books("v1").bump()
  }
}

service OnV2 from Events(Placed) via schema(2) {
  on event(e: Placed) -> Effect[()] {
    Books("v2").bump()
  }
}
