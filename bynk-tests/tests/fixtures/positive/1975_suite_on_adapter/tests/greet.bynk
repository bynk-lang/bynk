suite greet

// #1975: a suite on an adapter tests its binding, so the binding runs at
// every tier; its `given` takes the tier's doubles, and a `stub` on one.
case "the binding reads its secret" {
	stub Secrets.get(_) returns Some("hi")
	let s <- Greeter.hello("ann")
	expect s == "hi, ann at 0"
}

case "the binding falls back without one" {
	let s <- Greeter.hello("ann")
	expect s == "hello, ann at 0"
}

// A `stub` on the adapter's own capability overlays the real binding.
case "a stub on the adapter's capability answers instead" {
	stub Greeter.hello(_) returns "stubbed"
	let s <- Greeter.hello("ann")
	expect s == "stubbed"
}
