context shop.account

agent Account {
	key id: String

	store closed: Cell[Bool]
	store note: Cell[String]

	// A `:=` after `do self.erase()` in the same block has nothing to write to.
	on call close() -> Effect[()] {
		do self.erase()
		closed := true
		Effect.pure(())
	}

	// The same in a branch of an `if`.
	on call closeIf(flag: Bool) -> Effect[()] {
		if flag {
			do self.erase()
			note := "gone"
			Effect.pure(())
		} else {
			note := "kept"
			Effect.pure(())
		}
	}

	// Erasing and writing in different branches is fine, and so is a write before the erase.
	on call replace(text: String) -> Effect[()] {
		note := text
		self.erase()
	}
}
