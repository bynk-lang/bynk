context api

type LearnerId = String where NonEmpty && MaxLength(64)

// #3821: two `Bearer` actors on one secret, told apart by the `aud` their tokens carry. A token minted
// for one is refused (401) at a route of the other; `issuer` is checked too where it is declared.
actor Learner {
  auth = Bearer(secret = "AUTH_SECRET", issuer = "agilearn-web", audience = "agilearn-api"),
  identity = LearnerId
}

actor Internal {
  auth = Bearer(secret = "AUTH_SECRET", audience = "agilearn-internal"),
  identity = LearnerId
}

// A third actor on its own secret and from the environment: `trustFrom` replaces what it declares.
actor Partner {
  auth = Bearer(secret = "PARTNER_SECRET", issuer = "partner", audience = "partner-api", trustFrom = "PARTNER_TRUST"),
  identity = LearnerId
}

// `trustFrom` and no literal claim: what the variable supplies is all that is checked, and with the
// variable unset nothing would be, so the seam refuses every request (fail closed).
actor Open {
  auth = Bearer(secret = "OPEN_SECRET", trustFrom = "OPEN_TRUST"),
  identity = LearnerId
}

// A refinement follows its base: the same `iss`/`aud` check, then the claim (403).
actor Admin = Learner where hasClaim("admin")

service api from http {
  on GET("/me") () -> Effect[HttpResult[String]] by user: Learner {
    Ok(user.identity)
  }

  on GET("/internal") () -> Effect[HttpResult[String]] by user: Internal {
    Ok(user.identity)
  }

  on GET("/partner") () -> Effect[HttpResult[String]] by user: Partner {
    Ok(user.identity)
  }

  on GET("/open") () -> Effect[HttpResult[String]] by user: Open {
    Ok(user.identity)
  }

  on GET("/admin") () -> Effect[HttpResult[String]] by user: Admin {
    Ok(user.identity)
  }

  // An actor sum with a `Bearer` member: the member checks the same claims, and a token it refuses falls
  // through to `Visitor`.
  on GET("/either") () -> Effect[HttpResult[String]] by who: Learner | Visitor {
    match who {
      Learner(l) => Ok(l)
      Visitor => Ok("anyone")
    }
  }
}
