context commerce.order

consumes bynk { Events }
exports transparent { PaymentConfirmed, Region }

type Region = enum { Domestic, International }

event PaymentConfirmed = {
  orderId: String,
  region: Region = Region.Domestic,
}

service markPaid {
  on call(orderId: String) -> Effect[()] given Events {
    Events.emit[PaymentConfirmed](PaymentConfirmed { orderId: orderId, region: Region.International })
  }
}

// #2607 (Decision C): an event literal may leave a defaulted field out; it is
// filled with the default's in-memory value, not a qualified reference.
service markPaidDomestic {
  on call(orderId: String) -> Effect[()] given Events {
    Events.emit[PaymentConfirmed](PaymentConfirmed { orderId: orderId })
  }
}
