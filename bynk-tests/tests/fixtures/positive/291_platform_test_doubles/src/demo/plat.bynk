context demo.plat

consumes bynk { Clock, Random, Secrets, Locale, Logger, Fetch, Idempotency }
consumes bynk.cloudflare { Kv }
uses bynk.locale.types

service clock {
  on call() -> Effect[Int] given Clock {
    let t <- Clock.now()
    t.toEpochMillis()
  }
}

service draws {
  on call() -> Effect[List[Int]] given Random {
    let a <- Random.int(0, 1000)
    let b <- Random.int(0, 1000)
    [a, b]
  }
}

service ids {
  on call() -> Effect[List[String]] given Random {
    let a <- Random.uuid()
    let b <- Random.uuid()
    [a, b]
  }
}

service secret {
  on call(name: String) -> Effect[Option[String]] given Secrets {
    Secrets.get(name)
  }
}

service locale {
  on call() -> Effect[String] given Locale {
    let l <- Locale.current()
    l
  }
}

service greet {
  on call(who: String) -> Effect[()] given Logger {
    Logger.info("hello \(who)")
  }
}

service once {
  on call(key: String) -> Effect[Bool] given Idempotency {
    let seen <- Idempotency.dedup[Bool](key)
    match seen {
      Some(_) => Effect.pure(false)
      None => {
        let _ <- Idempotency.remember[Bool](key, true, 1.hours)
        Effect.pure(true)
      }
    }
  }
}

service store {
  on call(k: String, v: String) -> Effect[Option[String]] given Kv {
    let _ <- Kv.put(k, v)
    Kv.get(k)
  }
}

service lookup {
  on call(k: String) -> Effect[Option[String]] given Kv {
    Kv.get(k)
  }
}

service relay {
  on call(url: String) -> Effect[Int] given Fetch {
    let res <- Fetch.send(Request {
      method:        Get,
      url:           url,
      contentType:   None,
      authorization: None,
      headers:       Map.empty().insert("user-agent", "bynk-demo/1.0"),
      body:          None,
    })
    match res {
      Ok(r) => Effect.pure(r.status)
      Err(_) => Effect.pure(-1)
    }
  }
}
