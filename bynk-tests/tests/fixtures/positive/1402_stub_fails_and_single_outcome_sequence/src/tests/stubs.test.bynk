suite demo.stubs {
  // Review of #1402 (Arc C, slice 33): pins emit_stub_rhs's own two untested
  // branches directly — a bare `fails` clause (StubRhs::Fails) and a
  // `returns each` sequence whose last outcome is `fails`
  // (SeqOutcome::Fails) — plus a single-outcome `returns each` (no
  // cursor-bump `if`, since n == 1).
  stub Vault.open() fails

  case "a direct fails clause" {
    let r <- box.call()
    expect true
  }

  case "returns each ending in fails" {
    stub Vault.peek() returns each [1, fails]
    let r <- box.call()
    expect true
  }

  case "a single-outcome returns each" {
    stub Vault.peek() returns each [42]
    let r <- box.call()
    expect true
  }
}
