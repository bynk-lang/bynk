context acme.api

consumes bynk { Clock, ApiKeyId, ApiKeyInfo, ApiKeyLabel, ApiKeySecret }
consumes bynk.cloudflare { RateLimit }

type AccountId = String where NonEmpty && MaxLength(64)

type NewKey = { label: ApiKeyLabel }

// #3939: an API key actor. Keys look like `acme_<id>_<secret><checksum>` and are read from
// `Authorization: Bearer <key>`. A key lasts 90 days (slice 3), and `CLIENT_KEY_PEPPER_PREV`, when
// set, holds the pepper being rotated out.
actor Client { auth = ApiKey(secret = "CLIENT_KEY_PEPPER", previous = "CLIENT_KEY_PEPPER_PREV", prefix = "acme", ttl = 90.days), identity = AccountId }

capability PerIp = RateLimit @limit(1000) @period(60.seconds)

capability PerClient = RateLimit @limit(2) @period(60.seconds)

service api from http {
	cors { origins: ["https://console.example.com"] }

	// The seam verifies the key before the body runs; the binder carries the identity.
	@rateLimit(PerIp, key: clientIp)
	on GET("/me") () -> Effect[HttpResult[String]] by c: Client {
		Ok(c.identity)
	}

	// #3939 (slice 2, track §12): `key: identity` counts a verified key holder, after the seam; a key
	// that fails verification never reaches this limiter, so this route still warns
	// `bynk.actor.api_key_unlimited`: nothing bounds the unverified requests a guessing attacker sends.
	@rateLimit(PerClient, key: identity)
	on GET("/usage") () -> Effect[HttpResult[String]] by c: Client {
		Ok("usage for \(c.identity)")
	}

	// The handler's `headers` view hides the key's header (ADR 0899).
	@rateLimit(PerIp, key: clientIp)
	on GET("/auth-header") (headers: RequestHeaders) -> Effect[HttpResult[String]] by c: Client {
		Ok(headers.get("authorization").getOrElse("none"))
	}

	// The binder is optional: verify the key, capture nothing.
	@rateLimit(PerIp, key: clientIp)
	on DELETE("/session") () -> Effect[HttpResult[()]] by Client {
		NoContent
	}

	// `mint` answers the key once.
	@rateLimit(PerIp, key: clientIp)
	on POST("/accounts/:id/keys") (id: AccountId, body: NewKey) -> Effect[HttpResult[ApiKeySecret]] by Visitor given Clock {
		let r <- Client.mint(id, body.label)
		match r {
			Ok(key) => Created(key),
			Err(_) => Conflict("too many keys"),
		}
	}

	// #3939 (slice 2): `list` answers the identity's keys, never a secret or a digest.
	@rateLimit(PerIp, key: clientIp)
	on GET("/accounts/:id/keys") (id: AccountId) -> Effect[HttpResult[List[ApiKeyInfo]]] by Visitor given Clock {
		let keys <- Client.list(id)
		Ok(keys)
	}

	// `revoke` answers `false` for a key that is not the identity's, or is already gone.
	@rateLimit(PerIp, key: clientIp)
	on DELETE("/accounts/:id/keys/:key") (id: AccountId, key: ApiKeyId) -> Effect[HttpResult[()]] by Visitor {
		let gone <- Client.revoke(id, key)
		if gone { NoContent } else { NotFound }
	}

	// #3939 (slice 3, §7): `sweep` removes the identity's expired keys and keys under neither pepper,
	// and answers how many remain under `previous`: the keys dropping it now would end.
	@rateLimit(PerIp, key: clientIp)
	on POST("/accounts/:id/sweep") (id: AccountId) -> Effect[HttpResult[Int]] by Visitor given Clock {
		let n <- Client.sweep(id)
		Ok(n)
	}

	// `revokeAll` is legal in an agent's handler too, as an account-closure workflow needs.
	@rateLimit(PerIp, key: clientIp)
	on POST("/accounts/:id/close") (id: AccountId) -> Effect[HttpResult[Int]] by Visitor {
		let n <- Accounts(id).close()
		Ok(n)
	}
}

agent Accounts {
	key id: AccountId

	store closed: Cell[Bool] = false

	on call close() -> Effect[Int] {
		closed := true
		Client.revokeAll(self.id)
	}
}
