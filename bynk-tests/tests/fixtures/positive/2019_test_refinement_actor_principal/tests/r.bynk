suite r

// #2019: a refinement actor inherits its base's identity, so a case acts as it
// with that identity. Below `system` the claim is given, not verified.
case "an admin is answered" {
	let r <- api.GET("/admin") by Admin("root")
	expect r == Ok("root")
}

case "an operator is answered" {
	let r <- api.GET("/ops") by Operator("ada")
	expect r == Ok("ada")
}

case "a binder-less refinement route is answered" {
	let r <- api.GET("/gate") by Admin("root")
	expect r == Ok("admitted")
}

case "an admin is answered at the integration tier" as integration {
	let r <- api.GET("/admin") by Admin("root")
	expect r == Ok("root")
}
