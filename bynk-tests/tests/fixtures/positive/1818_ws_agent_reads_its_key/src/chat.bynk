context chat

type RoomId = opaque String
type UserId = opaque String
type ServerFrame = { text: String }
type ClientFrame = { text: String }

actor Participant { auth = Bearer(secret = "AUTH_SECRET"), identity = UserId }

// #1818: the hosting agent reads its own key (`self.id`) on all three
// WebSocket paths. An upgrade, a waking message and a close reach the Durable
// Object without its `/_bynk/agent/` dispatch, so each must set the key itself:
// the edge forwards it with the upgrade, and the socket attachment carries it to
// the message and close handlers.
service ChatGateway from websocket(in: ClientFrame, out: ServerFrame) {
  on open (roomId: RoomId) -> Effect[()] by user: Participant {
    let _ <- connection.send(ServerFrame { text: "welcome" })
    let _ <- Room(roomId).join(user.identity, connection)
    ()
  }

  // Slice 3b-iii/4: an inbound frame is posted to the room, which broadcasts it to
  // every connection (the sender included — the §20 fan-out); on close, the stored
  // connection is disposed via the agent. On the bundle target these are callable
  // surface methods a `TestConnection` test drives.
  on message (roomId: RoomId, frame: ClientFrame) -> Effect[()] by user: Participant {
    let _ <- Room(roomId).post(user.identity, frame.text)
    ()
  }

  on close (roomId: RoomId) -> Effect[()] by user: Participant {
    let _ <- Room(roomId).leave(user.identity)
    ()
  }
}

agent Room {
  key id: RoomId
  store members: Set[UserId]
  store conns: Map[UserId, Connection[ServerFrame]]
  store opened: Cell[Option[RoomId]]
  store posted: Cell[Option[RoomId]]
  store left: Cell[Option[RoomId]]

  on call join(u: UserId, conn: Connection[ServerFrame]) -> Effect[()] {
    let _ <- members.add(u)
    let _ <- conns.put(u, conn)
    opened := Some(self.id)
    ()
  }

  on call leave(u: UserId) -> Effect[()] {
    let _ <- members.remove(u)
    let _ <- conns.remove(u)
    left := Some(self.id)
    ()
  }

  // Slice 4 (the closure): broadcast a message to every connection in the room.
  // `conns.parTraverse` borrows each held connection and `send`s concurrently —
  // the held-aware iteration borrow surface, the track's final piece.
  on call post(sender: UserId, text: String) -> Effect[()] {
    let _ <- conns.parTraverse((c: Connection[ServerFrame]) => c.send(ServerFrame { text: text }))
    posted := Some(self.id)
    ()
  }
}
