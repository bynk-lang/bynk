context demo.orders

consumes demo.slots { Slot as Item }
consumes idempotency { Idempotency }

service slot {
  on call() -> Effect[Int] by Caller given Idempotency {
    let found <- Idempotency.dedup[Item]("slot-key")
    match found {
      Some(s) => s.id
      None => 0
    }
  }
}

service reserve {
  on call() -> Effect[Int] by Caller given Idempotency {
    let count <- Idempotency.dedup[Int]("order-key-1")
    let label <- Idempotency.dedup[String]("order-key-2")
    match count {
      Some(n) => match label {
        Some(_) => n
        None => n + 100
      }
      None => 0
    }
  }
}
