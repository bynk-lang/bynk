suite demo.orders {
  consumes idempotency { Idempotency }
  stub Idempotency.dedup[Int](_) returns Some(7)
  stub Idempotency.dedup[String](_) returns None

  case "each type argument has its own stub" {
    let result <- reserve.call()
    expect result == 107
  }

  case "observations count calls per type argument" {
    let result <- reserve.call()
    expect Idempotency.dedup[Int] called once
    expect Idempotency.dedup[String] called once
    expect Idempotency.dedup called 2 times
  }

  case "a type argument that was not called is never called" {
    let result <- reserve.call()
    expect Idempotency.dedup[Bool] never called
  }
}
