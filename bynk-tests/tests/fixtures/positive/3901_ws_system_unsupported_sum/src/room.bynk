context room

type UserId = String where NonEmpty
type RoomKey = String where Matches("^[a-z]+$")
type Frame = { text: String }

actor Member { auth = Bearer(secret = "ROOM_SECRET"), identity = UserId }

// #3901: an actor sum is not one a `system` case presents yet: it fails the case at `open` with a message saying
// so, never an upgrade the Worker answers for the wrong member.
service mixed from websocket(in: Frame, out: Frame) {
  on open(room: RoomKey) -> Effect[()] by who: Member | Visitor {
    let _ <- connection.send(Frame { text: "hello" })
    let _ <- Rooms(room).keep(connection)
  }

  on close(room: RoomKey) -> Effect[()] by who: Member | Visitor {
    let _ <- Rooms(room).drop()
  }
}

agent Rooms {
  key id: RoomKey
  store held: Map[String, Connection[Frame]]

  on call keep(conn: Connection[Frame]) -> Effect[()] {
    let _ <- held.put("c", conn)
    ()
  }

  on call drop() -> Effect[()] {
    let _ <- held.remove("c")
    ()
  }
}
