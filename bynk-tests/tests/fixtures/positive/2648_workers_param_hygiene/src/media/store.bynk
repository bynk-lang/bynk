context media.store

// #2648: a user parameter named like a local the Worker wrapper declares or
// reads (`body`, `result`, `args`, `request`, `surface`, `handlers`, ...) must
// not redeclare or shadow it. The `call` dispatch decodes each parameter into a
// binding of its own name and then encodes the result into `body`; the http and
// scheduled dispatches bind `request`, `surface` and `result`.

// A non-empty deps shape, so a parameter that shadowed `deps` would fail `tsc`.
capability Clock {
	fn now() -> Effect[Int]
}

provides Clock = FixedClock {
	fn now() -> Effect[Int] {
		42
	}
}

type UserId = String where NonEmpty

actor User { auth = Bearer(secret = "AUTH_JWT_SECRET"), identity = UserId }

// One parameter: the single-argument dispatch path.
service one {
	on call(body: String) -> Effect[Int] given Clock {
		let t <- Clock.now()
		t + body.length()
	}
}

// Several parameters: the keyed-object dispatch path.
service many {
	on call(key: String, body: String, result: String, args: String, argsObj: String, surface: String, request: String, env: String, ctx: String, handlers: String, deps: String) -> Effect[Int] {
		body.length() + result.length() + args.length() + argsObj.length() + surface.length() + request.length() + env.length() + ctx.length() + handlers.length() + deps.length() + key.length()
	}
}

service api from http {
	on GET("/by/:request/:result/:surface") (request: String, result: String, surface: String) -> Effect[HttpResult[Int]] by Visitor {
		Ok(request.length() + result.length() + surface.length())
	}

	on GET("/at/:url/:path") (url: String, path: String) -> Effect[HttpResult[Int]] by Visitor {
		Ok(url.length() + path.length())
	}

	// A Bearer route and a multi-actor sum route: their wrappers declare
	// `request` and read `deps`/`handlers` after the path params are bound.
	on GET("/bearer/:request/:result") (request: String, result: String) -> Effect[HttpResult[Int]] by u: User {
		Ok(request.length() + result.length())
	}

	on GET("/sum/:request/:result") (request: String, result: String) -> Effect[HttpResult[Int]] by who: User | Visitor {
		Ok(request.length() + result.length())
	}

	on POST("/echo") (body: String) -> Effect[HttpResult[Int]] by Visitor {
		Ok(body.length())
	}
}

service ticker from cron {
	on schedule("*/5 * * * *") (deps: Int) -> Effect[Result[(), String]] {
		Ok(())
	}
}

service ticker2 from cron {
	on schedule("0 * * * *") (result: Int) -> Effect[Result[(), String]] {
		Ok(())
	}
}

service jobs from queue("jobs") {
	on message(result: String) -> Effect[QueueResult] {
		Ack
	}
}
