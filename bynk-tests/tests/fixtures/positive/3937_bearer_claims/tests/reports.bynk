suite shop.reports {
	case "the handler reads a string claim and the presence of another" {
		let r <- api.GET("/who") by User("ada", TokenClaims.of(["tenant: acme", "beta: yes"]))
		expect r == Ok("ada acme true")
	}

	case "no claims given reads as none" {
		let r <- api.GET("/who") by User("ada")
		expect r == Ok("ada default false")
	}

	case "a refinement's binder reads the claims" {
		let r <- api.GET("/admin") by Admin("root", TokenClaims.of(["tenant: acme"]))
		expect r == Ok("root acme")
	}
}

suite shop.reports as integration {
	case "in process, claims reach the handler" {
		let r <- api.GET("/who") by User("ada", TokenClaims.of(["tenant: acme"]))
		expect r == Ok("ada acme false")
	}
}

suite shop.reports as system {
	case "the signed token carries the claims" {
		let r <- api.GET("/who") by User("ada", TokenClaims.of(["tenant: acme", "beta: yes"]))
		expect r == Ok("ada acme true")
	}

	case "a refinement's token carries its witness claim and the principal's" {
		let r <- api.GET("/admin") by Admin("root", TokenClaims.of(["tenant: acme"]))
		expect r == Ok("root acme")
	}

	case "a token without the claim reads as none" {
		let r <- api.GET("/who") by User("ada")
		expect r == Ok("ada default false")
	}
}
