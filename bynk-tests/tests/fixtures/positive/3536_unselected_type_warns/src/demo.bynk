context demo

// #3536: `TimedOut` and the variants of `Claim` are not listed, so naming them
// still resolves but is a `bynk.consumes.type_not_selected` warning; `bynk check
// --fix` adds `TimedOut` and `Claim` to the braces.

consumes bynk { Logger }
consumes bynk.cloudflare { D1 }

type Outcome = | Done(n: Int) | Unavailable

// The expected type picks the sum: this is the user's own `Unavailable`, and the
// one below is `ContainerError`'s, which the braces do not list.
fn mine() -> Outcome {
    Unavailable
}

fn theirs() -> ContainerError {
    Unavailable
}

fn at(t: TimedOut) -> Bool {
    true
}

fn won(r: Claim) -> Bool {
    match r {
        Claimed => true
        AlreadyClaimed => false
    }
}
