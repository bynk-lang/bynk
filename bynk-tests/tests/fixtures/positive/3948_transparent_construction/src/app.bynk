context app

consumes shapes

// A refined type with `.of`, a sum by its variants and a record by its
// fields, all owned by `shapes` and exported transparent.
fn port(n: Int) -> Result[Port, ValidationError] {
  Port.of(n)
}

fn round(r: Int) -> Shape {
  Circle(r)
}

fn dot() -> Shape {
  Dot
}

fn spot() -> Point {
  Point { x: 1, y: 2 }
}
