context shapes

exports transparent { Port, Shape, Point }

// #3948: everything here is exported transparent, so a consumer builds it.
type Port = Int where InRange(1, 65535)

type Shape = | Dot | Circle(radius: Int)

type Point = {
  x: Int,
  y: Int,
}

service origin {
  on call() -> Effect[Point] by Caller {
    Effect.pure(Point { x: 0, y: 0 })
  }
}
