suite shop.ledger {
	case "a call to a jurisdiction-pinned agent is served, and its state accumulates" {
		let a <- Learner("l1").add(2)
		let b <- Learner("l1").add(3)
		expect a == 2
		expect b == 5
	}

	case "pinned instances are independent by key" {
		let a <- Learner("x").add(1)
		let b <- Learner("y").add(7)
		expect a == 1
		expect b == 7
	}

	case "an agent with both annotations is served" {
		let t <- Audit("a1").add(4)
		expect t == 4
	}

	case "an unannotated agent is served" {
		let t <- Plain("p1").add(1)
		expect t == 1
	}
}

suite shop.ledger as system {
	case "a route reaches a pinned agent over the restricted namespace and its state persists" {
		let first <- api.POST("/learner/:id", "z") by Visitor
		expect first is Ok(1)
		let second <- api.POST("/learner/:id", "z") by Visitor
		expect second is Ok(2)
	}
}
