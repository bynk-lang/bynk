suite depot.stock

type Counted = {
	n: Int,
}

case "a suite-local row type reads through firstAs" {
	let orders <- Main.firstAs[Counted]("FROM (SELECT count(*) AS n FROM orders) AS c", [])
	expect orders == Ok(Some(Counted { n: 0 }))
}

case "a suite-local row type reads through select" {
	let rows <- Main.select[Counted]("FROM (SELECT count(*) AS n FROM orders) AS c", [])
	expect rows == Ok([Counted { n: 0 }])
}

case "a context-level row type reads through firstAs" {
	let a <- add.call()
	expect a == Ok(PgRun { rowCount: 1 })
	let found <- Main.firstAs[Order]("FROM orders WHERE id = $1", [PgInteger(1)])
	match found {
		Ok(Some(o)) => {
			expect o.qty == 1
		}
		_ => expect false
	}
}

case "a context-level row type reads through select" {
	let a <- add.call()
	expect a == Ok(PgRun { rowCount: 1 })
	let found <- Main.select[Order]("FROM orders", [])
	match found {
		Ok(rows) => expect rows.length() == 1
		_ => expect false
	}
}
