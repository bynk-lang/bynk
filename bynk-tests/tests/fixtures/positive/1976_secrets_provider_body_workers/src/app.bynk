context app

consumes bynk { Secrets }
consumes tone { Tone }

// #1976: a literal `Secrets.get` inside a provider body is a read of this
// Worker's, exactly as one in a handler body is. The composition root builds
// `SecretMode` (a local provider) and `PlainTone` (a bodied provider in the
// consumed context `tone`, one `given` away, built in this Worker), so
// `APP_MODE` and `TONE` belong in the manifest's `read` beside the handler's
// own `API_KEY`. So does `AGENT_KEY`: an agent is hosted in this Worker, so
// its handlers' reads are this Worker's too. Every name is a literal, so the
// list is still a census: `read_complete: true`.

capability Mode {
	fn current() -> Effect[String]
}

provides Mode = SecretMode given Secrets {
	fn current() -> Effect[String] {
		let m <- Secrets.get("APP_MODE")
		match m {
			Some(v) => v,
			None => "default",
		}
	}
}

service mode {
	on call() -> Effect[String] given Mode {
		let m <- Mode.current()
		m
	}
}

service key {
	on call() -> Effect[Bool] given Secrets {
		let k <- Secrets.get("API_KEY")
		k is Some(_)
	}
}

service voice {
	on call() -> Effect[String] given Tone {
		let t <- Tone.current()
		t
	}
}

type GateId = opaque String

agent Gate {
	key id: GateId

	store opened: Cell[Int]

	on call open() -> Effect[Bool] given Secrets {
		let k <- Secrets.get("AGENT_KEY")
		k is Some(_)
	}
}
