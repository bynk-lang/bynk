// #2026: a `system` case runs each context as the Worker it deploys as, so
// a `stub` there has no seam to override. Refused, suite- and case-scoped,
// rather than accepted and dropped.
suite r as system {
	stub Secrets.get(_) returns None

	case "a stubbed secret over the wire" {
		stub Secrets.get("MODE") returns Some("fake")
		let m <- r.mode() by Caller("other")
		expect m == "fake"
	}
}
