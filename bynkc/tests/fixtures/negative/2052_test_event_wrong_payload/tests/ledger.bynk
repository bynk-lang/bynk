// #2052: `svc.event` types the payload against the subscribed event and
// the envelope against `EventEnvelope`, and takes one or two arguments.
suite shop.ledger {
  case "a payload that is not the event" {
    let _ <- OnPlaced.event("o1")
  }

  case "an envelope that is not an envelope" {
    let _ <- OnPlaced.event(Placed { id: "o1" }, "evt-1")
  }

  case "no payload" {
    let _ <- OnPlaced.event()
  }
}
