// I4 (#1970): a foreign caller signs under `BYNK_CALL_TO_<CONTEXT>`, named
// from the context's name. `shop.a__b` (a doubled `_`) names no key, so
// the context cannot admit one; the compiler says so rather than panicking
// when it writes the client.
context shop.a__b

actor Legacy { auth = Foreign(secret = "LEGACY_CALL_KEY") }

service ping {
  on call(n: Int) -> Effect[Int] by Legacy {
    n
  }
}
