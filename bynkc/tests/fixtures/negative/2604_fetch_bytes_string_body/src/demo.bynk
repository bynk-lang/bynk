context demo

consumes bynk { Fetch }

// #2604: `sendBytes` takes its body as `Bytes`; a `String` is refused.
service probe {
  on call(req: Request) -> Effect[Int] given Fetch {
    let _ <- Fetch.sendBytes(req, "not bytes", FetchOptions { timeout: None, redirect: Follow })
    Effect.pure(0)
  }
}
