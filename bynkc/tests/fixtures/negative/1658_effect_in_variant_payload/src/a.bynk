context a

agent Counter {
  key id: String
  store n: Cell[Int] = 0
  on call get() -> Effect[Int] { n }
}

type ApiResult[T] =
  | Loaded(v: T)
  | Failed

// #1658: an effect stored in a sum variant's payload is started, unawaited.
service s {
  on call() -> Effect[Int] {
    let r = Loaded(Counter("k").get())
    let v <- Counter("k").get()
    Effect.pure(v)
  }
}
