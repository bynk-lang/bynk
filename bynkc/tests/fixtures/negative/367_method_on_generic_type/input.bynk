commons bad

type Box[T] = { value: T }

// #2766: a static on a generic type is allowed, but one whose signature never
// mentions the type's parameter leaves `T` undeterminable at every call, so it
// is rejected with `bynk.generics.method_on_generic_type`.
fn Box.empty() -> Box[Int] {
  Box { value: 0 }
}
