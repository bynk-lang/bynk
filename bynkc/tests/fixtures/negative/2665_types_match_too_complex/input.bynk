commons demo

type Big = { f0: Bool, f1: Bool, f2: Bool, f3: Bool, f4: Bool, f5: Bool, f6: Bool, f7: Bool, f8: Bool, f9: Bool, f10: Bool, f11: Bool, f12: Bool, f13: Bool, f14: Bool, f15: Bool, f16: Bool, f17: Bool, f18: Bool, f19: Bool }

fn f(b: Big) -> Int {
  match b {
    Big { f0: true, .. } => 0
    Big { f1: true, .. } => 1
    Big { f2: true, .. } => 2
    Big { f3: true, .. } => 3
    Big { f4: true, .. } => 4
    Big { f5: true, .. } => 5
    Big { f6: true, .. } => 6
    Big { f7: true, .. } => 7
    Big { f8: true, .. } => 8
    Big { f9: true, .. } => 9
    Big { f10: true, .. } => 10
    Big { f11: true, .. } => 11
    Big { f12: true, .. } => 12
    Big { f13: true, .. } => 13
    Big { f14: true, .. } => 14
    Big { f15: true, .. } => 15
    Big { f16: true, .. } => 16
    Big { f17: true, .. } => 17
    Big { f18: true, .. } => 18
    Big { f19: true, .. } => 19
  }
}
