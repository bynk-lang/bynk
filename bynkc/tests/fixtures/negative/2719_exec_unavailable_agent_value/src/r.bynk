context r

consumes bynk

fn tick(n: Int) -> Effect[()] {
	let _ <- Effect.pure(n).within(1.seconds)
	Effect.pure(())
}

fn twice(f: (Int) -> Effect[()], n: Int) -> Effect[Int] {
	~> f(n)
	Effect.pure(n)
}

// #2719 DECISION D: naming a function that needs the context as a value, in an
// agent handler, is refused as a call is.
agent Counter {
	key id: String
	store n: Cell[Int] = 0

	on call run() -> Effect[()] {
		let _ <- [1, 2].parTraverse(tick)
		()
	}
}
