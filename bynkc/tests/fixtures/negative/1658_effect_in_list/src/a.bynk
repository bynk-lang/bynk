context a

agent Counter {
  key id: String
  store n: Cell[Int] = 0
  on call bump() -> Effect[()] { n.update((x) => x + 1) }
  on call get() -> Effect[Int] { n }
}

type Box[T] = { item: T }

// #1658: a list of effects starts each one, unawaited.
service s {
  on call() -> Effect[Int] {
    let xs = [Counter("k").get(), Counter("k").get()]
    let v <- Counter("k").get()
    Effect.pure(v)
  }
}
