context compat.board

// #1883, slice 2: the platform answers `/favicon.ico` before the Worker runs,
// for every method, so a handler at exactly that path is unreachable.
asset favicon = "assets/favicon.ico" at "/favicon.ico"

service web from http {
  on GET("/favicon.ico") () -> Effect[HttpResult[String]] by Visitor {
    Ok("never reached")
  }
}
