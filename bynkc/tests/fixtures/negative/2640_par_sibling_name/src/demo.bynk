context demo

// #2640: the bindings run together, so none can read a sibling's result.
capability Users {
  fn get(id: Int) -> Effect[String]
}

capability Orders {
  fn forUser(id: Int) -> Effect[Int]
  fn touch(id: Int) -> Effect[()]
}

service dash {
  on call(id: Int) -> Effect[Int] given Users, Orders {
    par {
      let user <- Users.get(id)
      let n <- Orders.forUser(user.length())
    }
    Effect.pure(0)
  }
}
