// #1822: on Workers, a required capability needs a provider in its context.
context shop.mail

capability Mailer {
	fn send(to: String) -> Effect[()]
}

service notify {
	on call(to: String) -> Effect[()] given Mailer {
		Mailer.send(to)
	}
}

// A second requirement of `Mailer` is not a second error.
service remind {
	on call(to: String) -> Effect[()] given Mailer {
		Mailer.send(to)
	}
}

capability Clock {
	fn now() -> Effect[Int]
}

agent Outbox {
	key id: String

	store sent: Cell[Int]

	on call stamp() -> Effect[Int] given Clock {
		Clock.now()
	}
}

capability Store {
	fn put(v: String) -> Effect[()]
}

capability Courier {
	fn ship(v: String) -> Effect[()]
}

provides Courier = Fast given Store {
	fn ship(v: String) -> Effect[()] {
		Store.put(v)
	}
}
