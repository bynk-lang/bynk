context demo

consumes bynk { Fetch }

// #2627: a `StreamResponse` carries a stream, so it can't be a handler's
// result: serve its body with `RawStreamed` instead.
service probe {
  on call(req: Request) -> Effect[Result[StreamResponse, FetchError]] given Fetch {
    Fetch.receiveStream(req, FetchOptions { timeout: None, redirect: Follow })
  }
}
