context demo

// #1662: two providers for one capability.
capability Clock {
  fn now() -> Effect[Int]
}

provides Clock = FixedClock {
  fn now() -> Effect[Int] {
    Effect.pure(0)
  }
}

provides Clock = OtherClock {
  fn now() -> Effect[Int] {
    Effect.pure(1)
  }
}

service probe {
  on call() -> Effect[Int] {
    Effect.pure(1)
  }
}
