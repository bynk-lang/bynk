// #2073 review: `shop.order.place` and `shop.ledger.take` reach `shop.base`'s `Base`, which this
// context does not consume.
context shop.front

consumes shop.order
consumes shop.ledger

service check {
  on call(id: String) -> Effect[Int] {
    let o <- shop.order.place(id)
    shop.ledger.take(o)
  }
}
