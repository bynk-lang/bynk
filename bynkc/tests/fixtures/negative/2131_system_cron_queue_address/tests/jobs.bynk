suite cr.jobs as system {
	case "the sweeper runs, then the count is read over the wire" {
		let r <- sweeper.schedule("*/5 * * * *", 960000)
		expect r is Ok(_)
		let c <- api.GET("/count") by Visitor
		expect c is Ok(1)
	}

	case "a delivery lands, then the count is read over the wire" {
		let r <- deliveries.message(Delivery { id: "c" })
		expect r is Ack
		let c <- api.GET("/count") by Visitor
		expect c is Ok(1)
	}

	case "the count is read over the wire" {
		let c <- api.GET("/count") by Visitor
		expect c is Ok(0)
	}
}
