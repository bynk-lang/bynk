context demo

consumes bynk.cloudflare { D1 }

capability Orders = D1

// #2628: a `SqlStatement` from outside would carry SQL that was never a
// literal, so it never crosses a boundary or is stored.
type Job = { statement: SqlStatement }

service exec {
  on call(s: SqlStatement) -> Effect[Result[List[SqlRun], SqlError]] given Orders {
    Orders.batch([s])
  }
}
