context r

capability Logger {
	fn error(message: String) -> Effect[()]
}

capability Orders {
	fn count(sku: String) -> Effect[Int]
}

provides Logger = NullLogger {
	fn error(message: String) -> Effect[()] {}
}

provides Orders = FixedOrders {
	fn count(sku: String) -> Effect[Int] {
		3
	}
}

fn warn(what: String) -> Effect[()] given Logger {
	Logger.error(what)
}

service api {
	on call(sku: String) -> Effect[()] {
		warn(sku)
	}
}
