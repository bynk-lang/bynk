// #2087 review: a different declaration with the same name and an
// incompatible shape is still refused at the boundary. Only one declaration
// on both sides is matched without walking its fields.
context shop.front

consumes shop.ledger

type Ticket = { n: Int }

service check {
  on call() -> Effect[String] {
    shop.ledger.take(Ticket { n: 1 })
  }
}
