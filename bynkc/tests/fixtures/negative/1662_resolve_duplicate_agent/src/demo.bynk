context demo

// #1662: an agent declared twice.
agent Counter {
  key id: String
  store n: Cell[Int]

  on call get() -> Effect[Int] {
    n
  }
}

agent Counter {
  key id: String
  store n: Cell[Int]

  on call get() -> Effect[Int] {
    n
  }
}

service probe {
  on call() -> Effect[Int] {
    Effect.pure(1)
  }
}
