context demo

// #1662: a capability declared twice.
capability Clock {
  fn now() -> Effect[Int]
}

capability Clock {
  fn now() -> Effect[Int]
}

provides Clock = FixedClock {
  fn now() -> Effect[Int] {
    Effect.pure(0)
  }
}

service probe {
  on call() -> Effect[Int] {
    Effect.pure(1)
  }
}
