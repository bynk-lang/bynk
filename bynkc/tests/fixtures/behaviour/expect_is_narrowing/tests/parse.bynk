suite parse

// #2836: driven by bynkc/tests/expect_is_narrowing_behaviour.rs. An `is` test
// lowers to a `.tag ===` condition that tsc would use to narrow the value; the
// exhaustive `match` that follows must still type-check under tsc.

case "match after expect is" {
	let r = parse(3)
	expect r is Ok(_)
	let out = match r {
		Ok(v) => v
		Err(_) => 0
	}
	expect out == 3
}

case "match after a parenthesised expect is" {
	let r = parse(3)
	expect (r is Ok(_))
	let out = match r {
		Ok(v) => v
		Err(_) => 0
	}
	expect out == 3
}

case "match after expect is with a conjunct" {
	let r = parse(3)
	expect r is Ok(_) && r != Err("x")
	let out = match r {
		Ok(v) => v
		Err(_) => 0
	}
	expect out == 3
}

case "match after a negated expect is" {
	let r = parse(3)
	expect !(r is Err(_))
	let out = match r {
		Ok(v) => v
		Err(_) => 0
	}
	expect out == 3
}

case "production fns" {
	expect orZero(4) == 4
	expect orZero(0) == 0
	expect describe(1) == "ok"
	expect describe(0) == "not positive"
}
