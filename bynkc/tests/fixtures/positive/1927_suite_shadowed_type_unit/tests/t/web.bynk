// #1927: on the Bundle target, so the unit test module is golden and
// type-checked. `Status` is the service; the hidden type is not bound.
suite t.web {
  case "the service answers" {
    let r <- Status.GET("/")
    expect r is Ok(_)
  }
  case "a value of the hidden type flows" {
    expect isDone(current())
    expect all().filter((s) => isDone(s)).length() == 1
    expect countDone() == 1
  }
}
