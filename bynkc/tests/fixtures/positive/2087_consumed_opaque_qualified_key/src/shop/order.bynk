// #2087: `Code` is `shop.order`'s own unexported opaque type; `shop.ledger`
// declares an opaque `Code` of its own.
context shop.order

exports transparent { Order }

type Code = opaque String

type Order = { id: String, code: Code }

service place {
  on call(id: String) -> Effect[Order] {
    Order { id: id, code: Code.unsafe("c-\(id)") }
  }
}
