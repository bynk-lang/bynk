suite shop.storefront as system {
	// #2252: the parameter's `Sku` comes from `shop.catalogue`, imported
	// type-only, so the entry's `handlers.Sku.of` was undefined and every
	// request faulted with a 500. It is now validated by this context's own
	// `__deserialise_Sku`.
	case "a route parameter of a consumed refined type is validated" {
		let r <- api.GET("/items/:sku", "abc") by Visitor
		expect r is Ok("listed")
	}

	// The codec's error is the rejection body itself, so the router still
	// refuses a bad segment as a refinement violation at `path.sku`.
	case "a segment that breaks the consumed refinement is refused" {
		let r <- api.GET("/items/:sku", Wire("NOT-A-SKU")) by Visitor
		match r {
			Rejected(RefinementViolation(d)) => expect d.contains("path.sku")
			_ => expect false
		}
	}
}
