context store.uploads

// A webhook sender that signs the raw octets it sends.
actor Sender { auth = Signature(secret = "SENDER_SECRET", header = "X-Sig", timestamp = "X-Ts", tolerance = 300) }

service uploads from http {
	// The service-wide cap, for the routes with no `@limit` of their own.
	limits { maxBody: 64 }

	// A raw body: the handler gets the octets as sent, under the declared type.
	// The reply is the base64 of what it received, so the test can compare a
	// binary payload (not valid UTF-8) byte for byte.
	@raw(contentType: "application/vnd.bynk.tree-v1")
	on PUT("/api/:org/:package") (org: String, package: String, body: Bytes) -> Effect[HttpResult[String]] by v: Visitor {
		Ok("\(org)/\(package) \(body.toBase64())")
	}

	// Any content type, under a tighter cap of its own.
	@raw(contentType: "*/*")
	@limit(maxBody: 8)
	on POST("/blob") (body: Bytes) -> Effect[HttpResult[String]] by v: Visitor {
		Ok(body.toBase64())
	}

	// A raw body signed as received: the HMAC covers the octets.
	@raw(contentType: "application/octet-stream")
	on POST("/signed") (body: Bytes) -> Effect[HttpResult[String]] by Sender {
		Ok(body.toBase64())
	}

	// Without `@raw`, a `Bytes` body keeps its base64-in-JSON wire form.
	on POST("/json") (body: Bytes) -> Effect[HttpResult[String]] by v: Visitor {
		Ok(body.toBase64())
	}
}
