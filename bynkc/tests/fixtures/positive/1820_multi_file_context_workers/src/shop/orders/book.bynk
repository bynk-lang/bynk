context shop.orders

consumes shop.fees as Fees

// #1820: an agent storing, and called with, a sibling file's type. It is
// `given` a provider a sibling file declares and another context's. Its
// Durable Object rebuilds both, from one directory deeper than `handlers.ts`.
agent Book {
  key id: String

  store last: Cell[Option[Line]]

  store count: Cell[Int] = 0

  on call add(line: Line) -> Effect[Int] given Stamp, Fees.Fees {
    let f <- Fees.Fees.fee()
    let s <- Stamp.next()
    last := Some(line)
    let _ <- count.update((c) => c + line.qty)
    Effect.pure(count + s + f)
  }
}
