context shop.orders

consumes shop.payment as Payment

uses shop.values

// #1820: a service whose wire types, agents and provider are all declared in
// sibling files, and which crosses into another context.
service place {
  on call(line: Line) -> Effect[Int] {
    let ok <- Payment.authorise(line.qty)
    let n <- Book(line.sku).add(line)
    let h <- Tally("all").hit()
    if ok { n + h } else { 0 }
  }
}

service length {
  on call(n: Note) -> Effect[Int] { n.text.length() }
}
