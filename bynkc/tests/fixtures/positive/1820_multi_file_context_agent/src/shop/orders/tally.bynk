context shop.orders

// #1844 review: a second agent-declaring file, so the per-file generated
// helpers (`__resetAgents`) appear in two modules.
agent Tally {
  key id: String

  store hits: Cell[Int]

  on call hit() -> Effect[Int] {
    let _ <- hits.update((h) => h + 1)
    Effect.pure(hits)
  }
}
