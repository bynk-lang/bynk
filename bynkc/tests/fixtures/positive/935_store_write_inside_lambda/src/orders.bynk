context orders

// Regression for the emitter's `block_writes_state` probe missing a `Lambda`
// arm: a store mutation reached only through a lambda passed to `forEach`
// must still trigger the end-of-handler `commitState` flush.
type Order = { id: String, total: Int }

agent Orders {
  key shopId: String
  store orders: Map[String, Order]

  on call bulkAdd(items: List[Order]) -> Effect[()] {
    items.forEach((o: Order) => orders.put(o.id, o))
  }
}
