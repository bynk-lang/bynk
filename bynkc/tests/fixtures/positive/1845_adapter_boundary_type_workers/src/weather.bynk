// #1845: a Worker whose `on call` returns a consumed adapter's exported
// types calls the adapter's codecs, so it must import them.
adapter weather {
  binding "./weather.binding.ts"

  exports capability  { Weather }
  exports transparent { Report, WeatherError }

  type Report = {
    tempC: Int,
    summary: String,
  }

  type WeatherError = enum {
    NotFound,
    Upstream,
  }

  capability Weather {
    fn current(city: String) -> Effect[Result[Report, WeatherError]]
  }

  provides Weather = FixedWeather
}
