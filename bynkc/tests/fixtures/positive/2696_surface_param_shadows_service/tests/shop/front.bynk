suite shop.front as system {
	case "a parameter named like its service survives the surface" {
		let s <- shop.front.front("hi")
		expect s == "hi"
	}

	case "a parameter named deps survives the surface" {
		let n <- shop.front.count(4)
		expect n == 5
	}

	case "a caller-binding handler's parameter named like its service survives" {
		let s <- shop.front.note("yo")
		expect s == "yo"
	}
}
