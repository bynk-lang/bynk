// #1856: `bynk` is consumed only for `Clock`, provided in-process. A system
// suite stands up only contexts as Workers, so it imports no `bynk` Worker.
context shop.one

consumes bynk { Clock }

service now {
  on call() -> Effect[Int] given Clock {
    let _ <- Clock.now()
    Effect.pure(1)
  }
}

service api from http {
  on GET("/") () -> Effect[HttpResult[String]] by v: Visitor { Ok("up") }
}
