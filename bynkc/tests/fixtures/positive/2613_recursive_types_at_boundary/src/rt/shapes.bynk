// #2613: non-generic recursive types are ordinary boundary-legal types. A
// recursive sum, and a record that recurses through a `List`, cross a context
// boundary, sit in agent storage, round-trip through JSON and ride in an
// event payload, each through a recursive codec.
commons rt.shapes

type Tree =
  | Leaf
  | Node(left: Tree, value: Int, right: Tree)

type Dir = { name: String, children: List[Dir] }
