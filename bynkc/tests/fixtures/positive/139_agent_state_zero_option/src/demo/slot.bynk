---
A fresh `Slot` key must read `value == None`: Option state zero-initialises.
---
context demo.slot

exports transparent { SlotError }

type Label = String where Matches("[a-z0-9]{1,16}")

type SlotError = enum {
	Empty,
}

agent Slot {
	key id: Label

	store value: Cell[Option[Int]]

	// #1649: a write the suite then reloads. Before #1649, the stored `Option`
	// faulted on the next load.
	on call assign(v: Int) -> Effect[()] {
		value := Some(v)
	}

	on call resolve() -> Effect[Result[Int, SlotError]] {
		match value {
			Some(v) => Ok(v)
			None    => Err(Empty)
		}
	}
}

service resolve {
	on call(id: Label) -> Effect[Result[Int, SlotError]] {
		let slot = Slot(id)
		let outcome <- slot.resolve()
		outcome
	}
}
