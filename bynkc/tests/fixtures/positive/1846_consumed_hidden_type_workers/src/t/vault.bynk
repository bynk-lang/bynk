// #1846: `Ticket` is exported, but the `Code` its fields reach is not. A
// Worker that consumes `t.vault` decodes a `Ticket`, so it generates `Code`'s
// codecs itself, under a name that can't meet its own `Code`'s. So too for
// the unexported generics `Envelope` and `Choice`, renamed where they are
// applied (`Envelope[Code]`) as well as where they are declared.
context t.vault

uses t.money
exports transparent { Ticket }

type Code = Int where NonNegative

type Envelope[T] = { item: T }

type Choice[T] = | Has(v: T)
| Nope

type Ticket = {
	label: String,
	code: Code,
	spare: Option[Code],
	env: Envelope[Code],
	pick: Choice[Code],
	fee: Money,
}

service fetch {
	on call() -> Effect[Ticket] {
		Effect.pure(Ticket {
			label: "vault",
			code: 7,
			spare: None,
			env: Envelope { item: 1 },
			pick: Nope,
			fee: Money { amount: 3, currency: "EUR" },
		})
	}
}
