// #1846: `t.desk` declares its own `Code` and puts it, and `Option[Code]`,
// on its own boundary, so both its codecs and `t.vault`'s `Code` codecs are
// in one `handlers.ts`.
context t.desk

consumes t.vault as Vault

type Code = String where NonEmpty

service probe {
  on call(c: Code) -> Effect[Option[Code]] {
    let t <- Vault.fetch()
    Effect.pure(if t.label == "vault" { Some(c) } else { None })
  }
}
