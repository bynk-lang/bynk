context boundary.consumer

consumes boundary.provider as Provider

uses lib.money

type Reply = String where MaxLength(8)
type Envelope = { reply: Reply }

service askPrice {
  on call(n: Int) -> Effect[Result[Cents, Int]] {
    let r <- Provider.price(n)
    Effect.pure(r)
  }
}

service askWrapped {
  on call(n: Int) -> Effect[Result[Envelope, Int]] {
    let r <- Provider.wrapped(n)
    Effect.pure(r)
  }
}
