context boundary.consumer

consumes boundary.provider as Provider

uses lib.money

type Reply = String where MaxLength(8)
type Envelope = { reply: Reply }
type Outcome = | Done(reply: Reply) | Failed(code: Int)
type Tagged = { token: Token, n: Int }

service askPrice {
  on call(n: Int) -> Effect[Result[Cents, Int]] {
    let r <- Provider.price(n)
    Effect.pure(r)
  }
}

service askWrapped {
  on call(n: Int) -> Effect[Result[Envelope, Int]] {
    let r <- Provider.wrapped(n)
    Effect.pure(r)
  }
}

service askOutcome {
  on call(n: Int) -> Effect[Result[Outcome, Int]] {
    let r <- Provider.outcome(n)
    Effect.pure(r)
  }
}

service askTagged {
  on call(n: Int) -> Effect[Result[Tagged, Int]] {
    let r <- Provider.tagged(n)
    Effect.pure(r)
  }
}
