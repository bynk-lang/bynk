suite r.api as system {
	case "a handled request is untouched" {
		let r <- api.PUT("/items/:id", "1", Item { name: "a" }) by Visitor
		expect r is Ok("1 a")
	}

	case "an oversized body is rendered by on rejected" {
		let r <- api.PUT("/items/:id", "1", Wire("{\"name\": \"this body is a good deal longer than sixty-four bytes\"}")) by Visitor
		expect r is Handled(PayloadTooLarge("too_large"))
	}

	case "malformed JSON is rendered by on rejected" {
		let r <- api.PUT("/items/:id", "1", Wire("{")) by Visitor
		expect r is Handled(BadRequest("bad_request"))
	}

	case "a mismatched status falls back to the router's default" {
		let r <- api.PUT("/items/:id", "1", Wire("{\"name\": \"\"}")) by Visitor
		expect r is Rejected(RefinementViolation(_))
	}

	case "a 405 keeps its Allow header" {
		let r <- api.DELETE("/items/:id")
		expect r is Rejected(MethodNotAllowed)
	}
}
