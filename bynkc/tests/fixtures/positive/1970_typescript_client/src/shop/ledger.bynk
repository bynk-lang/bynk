context shop.ledger

uses shop.money

// I4 (#1970): a context with a foreign caller gets a typed TypeScript client,
// `bynk-client.ts`, covering the services that caller may call. Its boundary
// reaches a commons record with refined fields, an opaque type, a sum with a
// payload, a generic record, `Option`, `List` and `Bytes`.
actor Billing { auth = Foreign(secret = "BILLING_CALL_KEY", worker = "billing-svc") }

type EntryId = opaque String where Matches("E-[0-9]+")

type Entry = {
  id: EntryId,
  amount: Money,
  memo: Option[String],
  tags: List[String],
  receipt: Bytes,
}

type LedgerError =
  | NotFound
  | Rejected(reason: String)

// Named like the client's own `Client` type: the client renames it `Client_`.
type Client = { name: String }

type Page[T] = { items: List[T], next: Option[Int] }

service post {
  on call(client: Client, amount: Money, memo: Option[String]) -> Effect[Result[EntryId, LedgerError]] by Billing {
    if amount.cents > 1000000 {
      Err(Rejected("over the limit for \(client.name)"))
    } else {
      Ok(EntryId.unsafe("E-1"))
    }
  }
}

service lookup {
  on call(id: EntryId) -> Effect[Result[Entry, LedgerError]] by Billing {
    Err(NotFound)
  }
}

service recent {
  on call() -> Effect[Page[Entry]] by Billing {
    let page: Page[Entry] = Page { items: [], next: None }
    page
  }
}

// The default `Caller`: a foreign caller may not call it, so the client
// leaves it out.
service audit {
  on call(n: Int) -> Effect[Int] {
    n
  }
}
