context reg.api

// A webhook sender that signs what it sends, and a bearer-token user: a route
// may take either.
actor Sender { auth = Signature(secret = "SENDER_SECRET", header = "X-Sig") }

type UserId = String where NonEmpty

actor User { auth = Bearer(secret = "AUTH_JWT_SECRET"), identity = UserId }

// A service that implements an existing API's contract: it reads the request's
// headers itself, and answers errors in the contract's own body shape.
service api from http {
	// The caller's bearer token, read without an actor seam.
	on GET("/whoami") (headers: RequestHeaders) -> Effect[HttpResult[String]] by v: Visitor {
		match headers.bearer() {
			Some(token) => Ok("token \(token)")
			None => RawError(Unauthorized, problem("unauthorized", "a bearer token is required"), "application/json")
		}
	}

	// `headers` sits anywhere among the params: here after a path param and the body.
	on PUT("/packages/:name") (name: String, body: String, headers: RequestHeaders) -> Effect[HttpResult[String]] by v: Visitor {
		match headers.get("x-request-id") {
			Some(id) => Ok("\(name) \(body) \(id) \(headers.clientIp().getOrElse("-"))")
			None => HttpResult.RawError(ErrorStatus.Conflict, problem("conflict", "\(name) needs a request id"), "application/json")
		}
	}

	// Under a sum of actors the wrapper owns the boundary; `headers` still
	// arrives in its declared place, after the path parameter and the body.
	on POST("/notes/:id") (id: String, body: String, headers: RequestHeaders) -> Effect[HttpResult[String]] by who: Sender | User {
		let trace = headers.get("x-trace").getOrElse("-")
		match who {
			Sender => Ok("sender \(id) \(body) \(trace)")
			User(u) => Ok("\(u) \(id) \(body) \(trace)")
		}
	}

	// A plain-text error body on a message-bearing status.
	on DELETE("/packages/:name") (name: String) -> Effect[HttpResult[()]] by v: Visitor {
		RawError(ServiceUnavailable, Bytes.fromUtf8("\(name): try later"), "text/plain")
	}
}

// The contract's refusal body, `{"error": code, "message": text}`.
fn problem(code: String, message: String) -> Bytes {
	Bytes.fromUtf8("{\"error\":\"\(code)\",\"message\":\"\(message)\"}")
}
