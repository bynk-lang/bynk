---
#1654: `is` bindings flow left to right through `&&` and `implies`, and into the
else-branch of a negated test (type-system §2.3.6). One rule decides where, and
the resolver, the checker and the emitter all read it (`bynk_check::narrowing`).
---
commons demo.narrow

type Q = Int where Positive

type Booking =
  | Held(guest: String, room: Int)
  | Released

fn dbl(q: Q) -> Int {
  q * 2
}

// Both operands narrow, and the then-branch reads the right operand's binding.
fn both(n: Int, m: Int) -> Int {
  if n is Q && m is Q { dbl(n) + dbl(m) } else { 0 }
}

// The right operand of `&&` sees the left operand's binding.
fn positive(o: Option[Int]) -> Bool {
  o is Some(v) && v > 0
}

// The spec's own example shape: a variant's payload used in the right operand.
fn bigRoom(b: Booking) -> Bool {
  (b is Held(g, r)) && r > 100 && g != ""
}

// `implies`: the consequent is reached only when the antecedent holds.
fn nonNegativeIfSome(o: Option[Int]) -> Bool {
  o is Some(v) implies v >= 0
}

// The else-branch of a negated test sees the binding.
fn orZero(o: Option[Int]) -> Int {
  if !(o is Some(v)) { 0 } else { v }
}

// Negating a disjunction: both tests matched in the else-branch.
fn sumOrZero(a: Option[Int], b: Option[Int]) -> Int {
  if !(a is Some(x)) || !(b is Some(y)) { 0 } else { x + y }
}

// A non-negated `||` proves nothing in either branch, so it binds nothing and
// lowers as a plain ternary (review of #1695).
fn either(a: Option[Int], b: Option[Int]) -> Int {
  if a is Some(_) || b is Some(_) { 1 } else { 0 }
}

// The same condition with a hoisting branch (`?`), which lowers through the
// hoisted-`if` statement form.
fn eitherOr(a: Option[Int], b: Option[Int], r: Result[Int, String]) -> Result[Int, String] {
  let n = if a is Some(_) || b is Some(_) { r? } else { 0 }
  Ok(n)
}
