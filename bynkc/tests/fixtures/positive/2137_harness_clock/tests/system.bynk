-- #2137: at `system`, every participant's `Clock` reads the harness clock,
-- which starts at the epoch and moves only with `advance`.
suite ck.holds as system {
	case "a hold expires sixteen minutes on, over the wire" {
		let r <- api.POST("/holds/:id", "h1") by Visitor
		expect r is Ok(true)
		advance Clock by 16.minutes
		let e <- api.GET("/holds/:id", "h1") by Visitor
		expect e is Ok(true)
	}

	case "fourteen minutes is not enough, over the wire" {
		let r <- api.POST("/holds/:id", "h1") by Visitor
		expect r is Ok(true)
		advance Clock by 14.minutes
		let e <- api.GET("/holds/:id", "h1") by Visitor
		expect e is Ok(false)
	}

	case "the clock starts at the epoch, over the wire" {
		let r <- api.POST("/holds/:id", "h1") by Visitor
		expect r is Ok(true)
		let e <- api.GET("/holds/:id", "h1") by Visitor
		expect e is Ok(false)
	}
}
