-- #2137: the same body, promoted to `integration`.
suite ck.holds as integration {
	case "a hold expires sixteen minutes on, in process" {
		let r <- api.POST("/holds/:id", "h1") by Visitor
		expect r is Ok(true)
		advance Clock by 16.minutes
		let e <- api.GET("/holds/:id", "h1") by Visitor
		expect e is Ok(true)
	}

	case "fourteen minutes is not enough, in process" {
		let r <- api.POST("/holds/:id", "h1") by Visitor
		expect r is Ok(true)
		advance Clock by 14.minutes
		let e <- api.GET("/holds/:id", "h1") by Visitor
		expect e is Ok(false)
	}
}
