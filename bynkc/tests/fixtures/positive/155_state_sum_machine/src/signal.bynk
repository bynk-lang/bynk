context signal

type Light = enum { Red, Green }

agent Signal {
  key id: String

  store colour: Cell[Light] = Red

  on call peek() -> Effect[Result[(), String]] {
    Ok(())
  }

  // #1649: a write the suite then reloads. Before #1649, the stored enum
  // faulted on the next load.
  on call turnGreen() -> Effect[()] {
    colour := Green
  }

  on call isGreen() -> Effect[Bool] {
    colour == Green
  }
}
