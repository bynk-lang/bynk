context demo.orders

consumes audit

type Order = { id: String, total: Int }

// A qualified cross-context call takes its type arguments explicitly; the
// `Codable` argument is encoded at the call site all the same. A
// caller-declared type as the argument of a qualified generic call is rejected
// today as a cross-context structural mismatch, so the arguments here are base types.
service place {
  on call(order: Order) -> Effect[()] given audit.Audit {
    let _ <- audit.Audit.append[Int]("order", order.total)
    let _ <- audit.Audit.appendAll[String]([order.id])
    audit.Audit.note("done")
  }
}
