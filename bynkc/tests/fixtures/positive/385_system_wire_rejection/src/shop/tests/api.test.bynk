suite shop.api as system {
  case "a typed create returns Created over the real wire" {
    let item <- api.POST("/cart", Item { sku: "widget" }) by User("alice")
    expect item is Created(_)
  }
  case "an empty sku is rejected at the boundary before the handler" {
    let r <- api.POST("/cart", Wire("{\"sku\": \"\"}")) by User("alice")
    expect r is Rejected(RefinementViolation(_))
  }
  case "malformed json is rejected at the boundary" {
    let r <- api.POST("/cart", Wire("{not json")) by User("alice")
    expect r is Rejected(MalformedJson(_))
  }
  case "valid raw input passes the boundary to the handler" {
    let r <- api.POST("/cart", Wire("{\"sku\": \"raw-ok\"}")) by User("alice")
    expect r is Handled(_)
  }
  case "no credential is rejected at the seam" {
    let r <- api.POST("/cart", Item { sku: "widget" }) by Nobody
    expect r is Rejected(Unauthorized)
  }
  case "no credential combined with a raw body is rejected at the seam" {
    let r <- api.POST("/cart", Wire("{\"sku\": \"widget\"}")) by Nobody
    expect r is Rejected(Unauthorized)
  }
  case "no credential combined with a raw path and a typed body is rejected at the seam" {
    let r <- api.PUT("/cart/:sku", Wire("widget"), Item { sku: "widget" }) by Nobody
    expect r is Rejected(Unauthorized)
  }
  case "the wrong method is a 405 fall-through" {
    let r <- api.DELETE("/cart")
    expect r is Rejected(MethodNotAllowed)
  }
  case "a handler-returned 400 is Handled, not a boundary rejection" {
    let r <- api.POST("/reject", Wire("{\"sku\": \"ok\"}")) by User("alice")
    expect r is Handled(_)
  }
  case "a raw path segment with a typed body passes both through the boundary" {
    let r <- api.PUT("/cart/:sku", Wire("widget"), Item { sku: "widget" }) by User("alice")
    expect r is Handled(_)
  }
  // #1660: this case sent `Wire("")`, which can never reach `Sku.of`. The
  // router drops empty path segments, so `PUT /cart/` matches no route and
  // falls through to a 404. Once behavioural fixtures ran the suite, it was
  // shown to have never passed. `Sku` gained `MaxLength(8)`, so a segment that
  // routes can still fail the refinement.
  case "a raw path segment failing refinement is rejected even with a typed body" {
    let r <- api.PUT("/cart/:sku", Wire("far-too-long-sku"), Item { sku: "widget" }) by User("alice")
    expect r is Rejected(RefinementViolation(_))
  }
  // #1660 review: pins the routing decision the case above records. An empty
  // raw path segment does not route: `PUT /cart/` matches no `/cart/:sku`, so the
  // request falls through to a 404 (which the system harness reads as `Handled`)
  // instead of reaching `Sku.of`. If the router ever starts matching empty
  // segments, this case fails and the decision gets revisited.
  case "an empty raw path segment does not route and falls through" {
    let r <- api.PUT("/cart/:sku", Wire(""), Item { sku: "widget" }) by User("alice")
    expect r is Handled(_)
  }
  case "a typed path segment with a raw body passes both through the boundary" {
    let r <- api.PUT("/cart/:sku", "widget", Wire("{\"sku\": \"widget\"}")) by User("alice")
    expect r is Handled(_)
  }
  // #1934: the outcome is typed `HttpOutcome[Item]`, so a rejection's detail
  // and the handler's result inside `Handled` bind with their types.
  case "a refinement rejection carries the router's detail" {
    let r <- api.POST("/cart", Wire("{\"sku\": \"\"}")) by User("alice")
    match r {
      Rejected(RefinementViolation(d)) => expect d.contains("sku")
      _ => expect false
    }
  }
  case "a malformed body's rejection carries the parser's detail" {
    let r <- api.POST("/cart", Wire("{not json")) by User("alice")
    match r {
      Rejected(MalformedJson(d)) => expect d.length() > 0
      _ => expect false
    }
  }
  case "a handled raw body carries the handler's typed result" {
    let r <- api.POST("/cart", Wire("{\"sku\": \"raw-ok\"}")) by User("alice")
    match r {
      Handled(Created(item)) => expect item.sku == "raw-ok"
      _ => expect false
    }
  }
}
