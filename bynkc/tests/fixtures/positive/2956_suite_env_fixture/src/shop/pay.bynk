context shop.pay

consumes bynk { Secrets }

type UserId = String where NonEmpty

actor User { auth = Bearer(secret = "AUTH_JWT_SECRET"), identity = UserId }

service api from http {
	on GET("/processor") () -> Effect[HttpResult[String]] by Visitor given Secrets {
		let p <- Secrets.get("PAYMENTS_PROCESSOR")
		match p {
			Some(v) => Ok(v),
			None => Ok("none"),
		}
	}

	on GET("/me") () -> Effect[HttpResult[String]] by u: User {
		Ok(u.identity)
	}
}
