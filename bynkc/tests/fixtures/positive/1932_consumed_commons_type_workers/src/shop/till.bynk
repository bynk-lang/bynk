context shop.till

consumes shop.quotes

// #1932: no `uses lib.money` here, yet the codecs for its types are imported
// from the commons for the calls below.

service total {
  on call() -> Effect[Int] {
    let b <- shop.quotes.quote()
    let a <- shop.quotes.price()
    let paid <- shop.quotes.pay(a)
    Effect.pure(b.a.cents + paid)
  }
}
