context cs.client

uses cs.values
consumes cs.store

// #2035: this context builds its own commons values, empty constructors
// included, straight into `cs.store`'s arguments. Each must fit the callee's
// parameter type, whose `Line` carries `cs.store`'s brand.
service go {
  on call() -> Effect[Int] {
    let line = Line { qty: 2, note: "n" }
    let a <- cs.store.put(Batch { lines: [], first: None, byKey: Map.empty(), page: Page { items: [] }, pair: Pair { left: line, right: None } })
    let b <- cs.store.put(Batch { lines: List.empty(), first: Some(line), byKey: Map.empty().insert("k", line), page: Page { items: [line] }, pair: Pair { left: line, right: Some(line) } })
    let c <- cs.store.hold(Holder { batch: Batch { lines: [line], first: None, byKey: Map.empty(), page: Page { items: List.empty() }, pair: Pair { left: line, right: None } }, extra: [] })
    let byKey: Map[String, Line] = Map.empty()
    let d <- cs.store.many([line], Some(line), byKey)
    a + b + c + d
  }
}

// Values typed with this context's `Line` (a handler parameter, an annotated
// binding) cross into a consumed record the same way.
service viaParam {
  on call(l: Line, ls: List[Line]) -> Effect[Int] {
    let byKey: Map[String, Line] = Map.empty()
    cs.store.put(Batch { lines: ls, first: Some(l), byKey: byKey, page: Page { items: ls }, pair: Pair { left: l, right: None } })
  }
}
