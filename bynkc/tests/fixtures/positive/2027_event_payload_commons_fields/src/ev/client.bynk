context ev.client

uses ev.values
consumes ev.store

// #2027: this context's own boundary instantiates `List[Line]` and the rest
// too, so `ev.store`'s `Batch` codec shares this context's instantiation
// codecs, which must accept either context's `Line`.
service take {
  on call(ls: List[Line], first: Option[Line], byKey: Map[String, Line], qtys: List[Qty], page: Page[Line]) -> Effect[Int] {
    ls.length()
  }
}

service go {
  on call() -> Effect[Int] {
    let line = Line { qty: 2, tag: someTag() }
    let b <- ev.store.batch(Batch { lines: [line], first: Some(line), qtys: [], page: Page { items: [line] } })
    b.lines.length()
  }
}
