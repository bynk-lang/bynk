// #1829: `Note` is reached only through `Item`, which the context's agent
// stores, and `Tag` only through `Label`, which the context `Json.encode`s.
// The context never reads `item.note` or `label.tag`, so only a codec it
// emits names either type, and the context module must still import it.
commons app.model

type Name = String where NonEmpty

type Note = String where MaxLength(20)

type Item = { name: Name, note: Note }

type Tag = String where MaxLength(8)

type Label = { text: String, tag: Tag }
