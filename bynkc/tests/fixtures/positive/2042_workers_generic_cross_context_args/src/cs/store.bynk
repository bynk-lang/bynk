context cs.store

uses cs.values

// #2042: generic parameters over a commons type. Each is typed with this
// context's `Line`, which carries this context's brand.
service many {
  on call(ls: List[Line], first: Option[Line], byKey: Map[String, Line]) -> Effect[Int] { ls.length() }
}

service nested {
  on call(groups: Map[String, List[Line]], maybe: List[Option[Line]], page: Page[Line], pages: Option[Page[Line]]) -> Effect[Int] { maybe.length() }
}

// A commons generic record as the whole parameter.
service paged {
  on call(p: Page[Line]) -> Effect[Int] { p.items.length() }
}

service counts {
  on call(ns: List[Int]) -> Effect[Int] { ns.length() }
}
