context boundary.consumer

consumes boundary.provider as Provider

type Reply = String where MaxLength(8)

service ask {
  on call(n: Int) -> Effect[Result[Reply, Int]] {
    let r <- Provider.reply(n)
    Effect.pure(r)
  }
}

service askAll {
  on call(n: Int) -> Effect[List[Reply]] {
    let rs <- Provider.replies(n)
    Effect.pure(rs)
  }
}
