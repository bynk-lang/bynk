context room

uses shared

// #1800: a `:=` inside a match-arm guard runs like any other write, so the
// handler must commit it. `body_writes_state` skipped guards, so `bump` got
// no commit wrapper and the write was lost.
agent Counter {
  key id: String
  store hits: Cell[Int] = 0

  on call bump(n: Int) -> Effect[()] {
    match Some(n) {
      Some(x) if if x > 0 {
        hits := x
        true
      } else {
        false
      } => Effect.pure(())
      _ => Effect.pure(())
    }
  }

  // A guard that writes and then yields `false`: its arm is not taken, but the
  // write ran, so it is committed too. The guard also calls `positive`, a
  // cross-file function used nowhere else in this context.
  on call note(n: Int) -> Effect[()] {
    match Some(n) {
      Some(x) if if positive(x) {
        hits := x
        false
      } else {
        false
      } => Effect.pure(())
      _ => Effect.pure(())
    }
  }

  on call read() -> Effect[Int] {
    Effect.pure(hits)
  }
}

service bump {
  on call(id: String, n: Int) -> Effect[()] {
    Counter(id).bump(n)
  }
}

service note {
  on call(id: String, n: Int) -> Effect[()] {
    Counter(id).note(n)
  }
}

service read {
  on call(id: String) -> Effect[Int] {
    Counter(id).read()
  }
}
