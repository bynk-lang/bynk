context demo

// Regression (#1196/R6.5): a handler parameter that shadows a `store`
// field's own name, calling a method with a mutating-verb *name* the field's
// kind would recognise (`Map.put`), must not be classified as a store write
// when the resolved `Callee` says otherwise. `items` here is a `Box`
// parameter shadowing `store items: Map[String, Int]`; `items.put(x)`
// dispatches to `Box.put`, a plain method, never `Callee::Store`. The
// handler must emit as a plain (non-implicit-commit) body.
type Box = { n: Int }

fn Box.put(self, x: Int) -> Effect[()] {
  Effect.pure(())
}

agent Widget {
  key id: String
  store items: Map[String, Int]

  on call shadowedName(items: Box, x: Int) -> Effect[()] {
    let _ <- items.put(x)
    Effect.pure(())
  }
}
