suite app

// #1979: a `svc.call(…)` outcome takes the handler's declared type, so an
// `Ok`/`Err` operand of `==` is typed from it, not from the case's own
// `Result[(), ValidationError]`, and compares structurally.
case "a result compares to an Ok" {
	let r <- id.call("a")
	expect r == Ok("a")
}

case "an Ok on the left" {
	let r <- id.call("a")
	expect Ok("a") == r
}

case "a result compares to an Err" {
	let r <- id.call("")
	expect r == Err("empty")
	expect r != Ok("")
}

case "a different Ok is not equal" {
	let r <- id.call("a")
	expect r == Ok("b")
}
