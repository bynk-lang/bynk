{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "rootDir": ".",
    // "DOM" added for #855: `wire-render.unit.test.ts` imports
    // `src/webview/wire-render.ts`, which (like the browser-context modules
    // below) mixes DOM-touching code with the pure functions the test
    // actually exercises — the whole file still has to type-check. There is
    // no DOM *at runtime* here (no jsdom in this project); a test that
    // called `document.*` directly would compile but crash on `node
    // out/test/runTest.js`. See wire-render.ts's own module doc.
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "mocha"]
  },
  // `src/semanticValues.ts`, `src/inlineDoc.ts`, `src/refreshScheduler.ts`
  // (#2093), `src/projectModel.ts` (#2097) and `src/lmRender.ts` (#2463) are dependency-free (no
  // `vscode` import), so the unit tests can compile against them directly.
  // `rootDir: "."` keeps `test/` output at `out/test/**` (runTest.js path
  // unchanged) and puts those src files at `out/src/`. Do not broaden this to all
  // of `src` — the rest imports `vscode`.
  "include": [
    "test/**/*.ts",
    "src/semanticValues.ts",
    "src/inlineDoc.ts",
    "src/manifestSchema.ts",
    "src/cliCore.ts",
    "src/devEvents.ts",
    "src/devLogs.ts",
    "src/deployPlan.ts",
    "src/dependenciesCore.ts",
    "src/migrationsCore.ts",
    "src/doctorReport.ts",
    "src/approveReport.ts",
    "src/coverageModel.ts",
    "src/testPlan.ts",
    "src/testStream.ts",
    "src/testTargets.ts",
    "src/testSeeds.ts",
    "src/refreshScheduler.ts",
    "src/projectModel.ts",
    "src/lmRender.ts",
    "src/chatCore.ts",
    "src/web/positions.ts",
    "src/web/convert.ts",
    "src/web/project.ts",
    "src/web/wasmCall.ts"
  ],
  // A fixture project's adapter binding module is data for the web suite, not
  // test code (it imports the emitted runtime, which isn't here).
  "exclude": ["test/fixtures/**"]
}
