{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "rootDir": ".",
    // "DOM" added for #855: `wire-render.unit.test.ts` imports
    // `src/webview/wire-render.ts`, which (like the browser-context modules
    // below) mixes DOM-touching code with the pure functions the test
    // actually exercises — the whole file still has to type-check. There is
    // no DOM *at runtime* here (no jsdom in this project); a test that
    // called `document.*` directly would compile but crash on `node
    // out/test/runTest.js`. See wire-render.ts's own module doc.
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "mocha"]
  },
  // `src/semanticValues.ts`, `src/inlineDoc.ts` and `src/refreshScheduler.ts`
  // (#2093) are dependency-free (no
  // `vscode` import), so the unit tests can compile against them directly.
  // `rootDir: "."` keeps `test/` output at `out/test/**` (runTest.js path
  // unchanged) and puts those src files at `out/src/`. Do not broaden this to all
  // of `src` — the rest imports `vscode`.
  "include": [
    "test/**/*.ts",
    "src/semanticValues.ts",
    "src/inlineDoc.ts",
    "src/manifestSchema.ts",
    "src/cliCore.ts",
    "src/devEvents.ts",
    "src/refreshScheduler.ts"
  ]
}
