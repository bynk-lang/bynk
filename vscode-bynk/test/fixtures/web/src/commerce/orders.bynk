context commerce.orders

consumes commerce.payment

service placeOrder {
  on call(total: Int) -> Effect[Result[Int, Int]] {
    let _ <- commerce.payment.authorise(total)
    Ok(total)
  }
}

-- A deliberate type error, so the web smoke test can wait for this file's
-- analysis to land before it checks which diagnostics were reported.
service broken {
  on call() -> Effect[Int] {
    "not an int"
  }
}
