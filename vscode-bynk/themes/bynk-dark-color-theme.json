{
  "$schema": "vscode://schemas/color-theme",
  "name": "Bynk Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#9fb0a8",
    "descriptionForeground": "#9fb0a8",
    "errorForeground": "#ff8a78",
    "focusBorder": "#3cc4a6",
    "widget.shadow": "#00000080",
    "selection.background": "#2a4a42",
    "icon.foreground": "#9fb0a8",
    "textLink.foreground": "#3cc4a6",
    "textLink.activeForeground": "#3cc4a6",
    "textCodeBlock.background": "#1d2825",
    "progressBar.background": "#f2b134",
    "editor.background": "#151e1b",
    "editor.foreground": "#e8efe9",
    "editorLineNumber.foreground": "#7d9288",
    "editorLineNumber.activeForeground": "#e8efe9",
    "editorCursor.foreground": "#f2b134",
    "editor.selectionBackground": "#2a4a42",
    "editor.inactiveSelectionBackground": "#223a34",
    "editor.selectionHighlightBackground": "#2a4a4280",
    "editor.wordHighlightBackground": "#2a4a4280",
    "editor.wordHighlightStrongBackground": "#2a4a42",
    "editor.lineHighlightBackground": "#1d2825",
    "editor.lineHighlightBorder": "#1d2825",
    "editor.findMatchBackground": "#f2b13466",
    "editor.findMatchHighlightBackground": "#f2b13433",
    "editorBracketMatch.background": "#2a4a42",
    "editorBracketMatch.border": "#5f7a70",
    "editorIndentGuide.background1": "#2b3a35",
    "editorIndentGuide.activeBackground1": "#5f7a70",
    "editorWhitespace.foreground": "#2b3a35",
    "editorRuler.foreground": "#2b3a35",
    "editorError.foreground": "#ff8a78",
    "editorWarning.foreground": "#f2b134",
    "editorInfo.foreground": "#6fd3e8",
    "editorHint.foreground": "#3cc4a6",
    "editorGutter.addedBackground": "#a5dc86",
    "editorGutter.modifiedBackground": "#f2b134",
    "editorGutter.deletedBackground": "#ff8a78",
    "editorWidget.background": "#1d2825",
    "editorWidget.border": "#5f7a70",
    "editorWidget.foreground": "#e8efe9",
    "editorSuggestWidget.background": "#1d2825",
    "editorSuggestWidget.border": "#5f7a70",
    "editorSuggestWidget.selectedBackground": "#2a4a42",
    "editorSuggestWidget.highlightForeground": "#f2b134",
    "editorHoverWidget.background": "#1d2825",
    "editorHoverWidget.border": "#5f7a70",
    "peekView.border": "#5f7a70",
    "peekViewEditor.background": "#151e1b",
    "peekViewResult.background": "#1d2825",
    "peekViewTitle.background": "#1d2825",
    "peekViewResult.selectionBackground": "#2a4a42",
    "diffEditor.insertedTextBackground": "#a5dc8626",
    "diffEditor.removedTextBackground": "#ff8a7826",
    "sideBar.background": "#0e1513",
    "sideBar.foreground": "#c6d3cc",
    "sideBar.border": "#2b3a35",
    "sideBarTitle.foreground": "#e8efe9",
    "sideBarSectionHeader.background": "#151e1b",
    "sideBarSectionHeader.foreground": "#e8efe9",
    "activityBar.background": "#0e1513",
    "activityBar.foreground": "#e8efe9",
    "activityBar.inactiveForeground": "#7d9288",
    "activityBar.border": "#2b3a35",
    "activityBar.activeBorder": "#f2b134",
    "activityBarBadge.background": "#f2b134",
    "activityBarBadge.foreground": "#1a1405",
    "titleBar.activeBackground": "#0e1513",
    "titleBar.activeForeground": "#c6d3cc",
    "titleBar.inactiveBackground": "#0e1513",
    "titleBar.inactiveForeground": "#7d9288",
    "titleBar.border": "#2b3a35",
    "statusBar.background": "#1d2825",
    "statusBar.foreground": "#c6d3cc",
    "statusBar.border": "#2b3a35",
    "statusBar.noFolderBackground": "#1d2825",
    "statusBar.debuggingBackground": "#f2b134",
    "statusBar.debuggingForeground": "#1a1405",
    "statusBarItem.remoteBackground": "#f2b134",
    "statusBarItem.remoteForeground": "#1a1405",
    "statusBarItem.hoverBackground": "#2a4a42",
    "tab.activeBackground": "#151e1b",
    "tab.inactiveBackground": "#0e1513",
    "tab.activeForeground": "#e8efe9",
    "tab.inactiveForeground": "#9fb0a8",
    "tab.border": "#2b3a35",
    "tab.activeBorderTop": "#f2b134",
    "tab.hoverBackground": "#1d2825",
    "editorGroup.border": "#2b3a35",
    "editorGroupHeader.tabsBackground": "#0e1513",
    "editorGroupHeader.tabsBorder": "#2b3a35",
    "breadcrumb.foreground": "#9fb0a8",
    "breadcrumb.focusForeground": "#e8efe9",
    "breadcrumb.activeSelectionForeground": "#e8efe9",
    "panel.background": "#151e1b",
    "panel.border": "#2b3a35",
    "panelTitle.activeForeground": "#e8efe9",
    "panelTitle.inactiveForeground": "#9fb0a8",
    "panelTitle.activeBorder": "#f2b134",
    "list.activeSelectionBackground": "#2a4a42",
    "list.activeSelectionForeground": "#e8efe9",
    "list.inactiveSelectionBackground": "#223a34",
    "list.hoverBackground": "#1d2825",
    "list.focusBackground": "#2a4a42",
    "list.highlightForeground": "#f2b134",
    "input.background": "#0e1513",
    "input.foreground": "#e8efe9",
    "input.border": "#5f7a70",
    "input.placeholderForeground": "#8a9c94",
    "inputOption.activeBorder": "#3cc4a6",
    "inputValidation.errorBorder": "#ff8a78",
    "inputValidation.warningBorder": "#f2b134",
    "dropdown.background": "#1d2825",
    "dropdown.foreground": "#e8efe9",
    "dropdown.border": "#5f7a70",
    "button.background": "#f2b134",
    "button.foreground": "#1a1405",
    "button.hoverBackground": "#ffc14d",
    "button.secondaryBackground": "#1d2825",
    "button.secondaryForeground": "#e8efe9",
    "badge.background": "#f2b134",
    "badge.foreground": "#1a1405",
    "scrollbarSlider.background": "#5f7a7055",
    "scrollbarSlider.hoverBackground": "#5f7a7099",
    "scrollbarSlider.activeBackground": "#5f7a7099",
    "minimap.findMatchHighlight": "#f2b134",
    "minimap.selectionHighlight": "#2a4a42",
    "menu.background": "#1d2825",
    "menu.foreground": "#e8efe9",
    "menu.selectionBackground": "#2a4a42",
    "menu.selectionForeground": "#e8efe9",
    "menu.separatorBackground": "#2b3a35",
    "notifications.background": "#1d2825",
    "notifications.foreground": "#e8efe9",
    "notifications.border": "#5f7a70",
    "gitDecoration.modifiedResourceForeground": "#f2b134",
    "gitDecoration.addedResourceForeground": "#a5dc86",
    "gitDecoration.untrackedResourceForeground": "#3cc4a6",
    "gitDecoration.deletedResourceForeground": "#ff8a78",
    "gitDecoration.ignoredResourceForeground": "#7d9288",
    "gitDecoration.conflictingResourceForeground": "#ff8a78",
    "terminal.background": "#151e1b",
    "terminal.foreground": "#e8efe9",
    "terminalCursor.foreground": "#f2b134",
    "terminal.selectionBackground": "#2a4a42",
    "terminal.ansiBlack": "#0e1513",
    "terminal.ansiRed": "#ff8a78",
    "terminal.ansiGreen": "#a5dc86",
    "terminal.ansiYellow": "#f2b134",
    "terminal.ansiBlue": "#9bc8f0",
    "terminal.ansiMagenta": "#c4a7e7",
    "terminal.ansiCyan": "#6fd3e8",
    "terminal.ansiWhite": "#c6d3cc",
    "terminal.ansiBrightBlack": "#5f7a70",
    "terminal.ansiBrightRed": "#ffa89a",
    "terminal.ansiBrightGreen": "#bde8a3",
    "terminal.ansiBrightYellow": "#ffc14d",
    "terminal.ansiBrightBlue": "#b9d9f6",
    "terminal.ansiBrightMagenta": "#d6c1ee",
    "terminal.ansiBrightCyan": "#93e0f0",
    "terminal.ansiBrightWhite": "#e8efe9",
    "bynk.docHeadingForeground": "#f2b134"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.double-slash.bynk",
        "punctuation.definition.comment.bynk"
      ],
      "settings": {
        "foreground": "#8a9c94",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation.bynk",
        "comment.line.documentation.bynk"
      ],
      "settings": {
        "foreground": "#93b5a7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Declaration keywords (context, service, type, fn, …)",
      "scope": [
        "keyword.declaration.bynk"
      ],
      "settings": {
        "foreground": "#f2b134"
      }
    },
    {
      "name": "Control keywords (if, match, let, …)",
      "scope": [
        "keyword.control.bynk"
      ],
      "settings": {
        "foreground": "#f2b134"
      }
    },
    {
      "name": "Modifier keywords",
      "scope": [
        "keyword.modifier.bynk"
      ],
      "settings": {
        "foreground": "#f2b134",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTTP methods",
      "scope": [
        "keyword.other.http-method.bynk"
      ],
      "settings": {
        "foreground": "#f2b134",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators (<-, ->, =>, ::, …)",
      "scope": [
        "keyword.operator.bynk"
      ],
      "settings": {
        "foreground": "#9fb0a8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator.bynk",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9fb0a8"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type.bynk",
        "support.type.builtin.bynk",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#6fd3e8"
      }
    },
    {
      "name": "Interfaces and capabilities",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#3cc4a6"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function.builtin.bynk",
        "support.function.builtin.mock.bynk",
        "support.function"
      ],
      "settings": {
        "foreground": "#9bc8f0"
      }
    },
    {
      "name": "Refinement predicates",
      "scope": [
        "support.function.predicate.bynk"
      ],
      "settings": {
        "foreground": "#9bc8f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "entity.name.function.decorator.bynk",
        "punctuation.definition.annotation.bynk"
      ],
      "settings": {
        "foreground": "#c4a7e7"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.double.bynk"
      ],
      "settings": {
        "foreground": "#a5dc86"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape.bynk"
      ],
      "settings": {
        "foreground": "#ffb08a"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.section.interpolation.begin.bynk",
        "punctuation.section.interpolation.end.bynk"
      ],
      "settings": {
        "foreground": "#f2b134"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric.bynk",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffb08a"
      }
    },
    {
      "name": "Language constants (true, false, None, Ok, …)",
      "scope": [
        "constant.language.bynk",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffb08a"
      }
    },
    {
      "name": "self",
      "scope": [
        "variable.language.self.bynk"
      ],
      "settings": {
        "foreground": "#f2b134",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other.bynk",
        "variable"
      ],
      "settings": {
        "foreground": "#e8efe9"
      }
    },
    {
      "name": "Markdown headings in doc comments",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#f2b134",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis in doc comments",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic in doc comments",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code in doc comments",
      "scope": [
        "markup.raw",
        "markup.inline.raw",
        "markup.raw.block.markdown",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#a5dc86"
      }
    },
    {
      "name": "Markdown links in doc comments",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#3cc4a6"
      }
    },
    {
      "name": "Markdown list and quote marks",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown",
        "punctuation.definition.markdown"
      ],
      "settings": {
        "foreground": "#9fb0a8"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#6fd3e8",
    "type.declaration": {
      "foreground": "#6fd3e8",
      "bold": true
    },
    "type.refined": {
      "foreground": "#6fd3e8",
      "italic": true
    },
    "type.opaque": {
      "foreground": "#6fd3e8",
      "underline": true
    },
    "capability": "#3cc4a6",
    "capability.declaration": {
      "foreground": "#3cc4a6",
      "bold": true
    },
    "service": {
      "foreground": "#6fd3e8",
      "bold": true
    },
    "agent": {
      "foreground": "#6fd3e8",
      "bold": true
    },
    "actor": "#6fd3e8",
    "messages": "#6fd3e8",
    "provider": "#9bc8f0",
    "function": "#9bc8f0",
    "method": "#9bc8f0",
    "function.declaration": {
      "foreground": "#9bc8f0",
      "bold": true
    },
    "property": "#d5e3dc",
    "variable": "#e8efe9",
    "decorator": "#c4a7e7",
    "asset": "#ffb08a",
    "embed": "#ffb08a",
    "comment.documentation": {
      "foreground": "#93b5a7",
      "italic": true
    },
    "*.platformNative": {
      "italic": true
    }
  }
}
