{
  "$schema": "vscode://schemas/color-theme",
  "name": "Bynk Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#55625c",
    "descriptionForeground": "#55625c",
    "errorForeground": "#b3261e",
    "focusBorder": "#0b6b5c",
    "widget.shadow": "#1b242129",
    "selection.background": "#d6e8df",
    "icon.foreground": "#55625c",
    "textLink.foreground": "#0b6b5c",
    "textLink.activeForeground": "#0b6b5c",
    "textCodeBlock.background": "#ffffff",
    "progressBar.background": "#f2b134",
    "editor.background": "#fffdf8",
    "editor.foreground": "#1b2421",
    "editorLineNumber.foreground": "#616e68",
    "editorLineNumber.activeForeground": "#1b2421",
    "editorCursor.foreground": "#7a4f00",
    "editor.selectionBackground": "#d6e8df",
    "editor.inactiveSelectionBackground": "#e6efe9",
    "editor.selectionHighlightBackground": "#c4ddd2aa",
    "editor.wordHighlightBackground": "#c4ddd2aa",
    "editor.wordHighlightStrongBackground": "#d6e8df",
    "editor.lineHighlightBackground": "#ffffff",
    "editor.lineHighlightBorder": "#ffffff",
    "editor.findMatchBackground": "#f2b13499",
    "editor.findMatchHighlightBackground": "#f2b13455",
    "editorBracketMatch.background": "#d6e8df",
    "editorBracketMatch.border": "#7d8a83",
    "editorIndentGuide.background1": "#d9d3c5",
    "editorIndentGuide.activeBackground1": "#7d8a83",
    "editorWhitespace.foreground": "#d9d3c5",
    "editorRuler.foreground": "#d9d3c5",
    "editorError.foreground": "#b3261e",
    "editorWarning.foreground": "#7a4f00",
    "editorInfo.foreground": "#0a5f78",
    "editorHint.foreground": "#0b6b5c",
    "editorGutter.addedBackground": "#2f6b17",
    "editorGutter.modifiedBackground": "#7a4f00",
    "editorGutter.deletedBackground": "#b3261e",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#7d8a83",
    "editorWidget.foreground": "#1b2421",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#7d8a83",
    "editorSuggestWidget.selectedBackground": "#d6e8df",
    "editorSuggestWidget.highlightForeground": "#7a4f00",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#7d8a83",
    "peekView.border": "#7d8a83",
    "peekViewEditor.background": "#fffdf8",
    "peekViewResult.background": "#ffffff",
    "peekViewTitle.background": "#ffffff",
    "peekViewResult.selectionBackground": "#d6e8df",
    "diffEditor.insertedTextBackground": "#2f6b1720",
    "diffEditor.removedTextBackground": "#b3261e20",
    "sideBar.background": "#f6f3ec",
    "sideBar.foreground": "#33403b",
    "sideBar.border": "#d9d3c5",
    "sideBarTitle.foreground": "#1b2421",
    "sideBarSectionHeader.background": "#fffdf8",
    "sideBarSectionHeader.foreground": "#1b2421",
    "activityBar.background": "#f6f3ec",
    "activityBar.foreground": "#1b2421",
    "activityBar.inactiveForeground": "#616e68",
    "activityBar.border": "#d9d3c5",
    "activityBar.activeBorder": "#7a4f00",
    "activityBarBadge.background": "#f2b134",
    "activityBarBadge.foreground": "#1a1405",
    "titleBar.activeBackground": "#f6f3ec",
    "titleBar.activeForeground": "#33403b",
    "titleBar.inactiveBackground": "#f6f3ec",
    "titleBar.inactiveForeground": "#616e68",
    "titleBar.border": "#d9d3c5",
    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#33403b",
    "statusBar.border": "#d9d3c5",
    "statusBar.noFolderBackground": "#ffffff",
    "statusBar.debuggingBackground": "#f2b134",
    "statusBar.debuggingForeground": "#1a1405",
    "statusBarItem.remoteBackground": "#f2b134",
    "statusBarItem.remoteForeground": "#1a1405",
    "statusBarItem.hoverBackground": "#d6e8df",
    "tab.activeBackground": "#fffdf8",
    "tab.inactiveBackground": "#f6f3ec",
    "tab.activeForeground": "#1b2421",
    "tab.inactiveForeground": "#55625c",
    "tab.border": "#d9d3c5",
    "tab.activeBorderTop": "#7a4f00",
    "tab.hoverBackground": "#ffffff",
    "editorGroup.border": "#d9d3c5",
    "editorGroupHeader.tabsBackground": "#f6f3ec",
    "editorGroupHeader.tabsBorder": "#d9d3c5",
    "breadcrumb.foreground": "#55625c",
    "breadcrumb.focusForeground": "#1b2421",
    "breadcrumb.activeSelectionForeground": "#1b2421",
    "panel.background": "#fffdf8",
    "panel.border": "#d9d3c5",
    "panelTitle.activeForeground": "#1b2421",
    "panelTitle.inactiveForeground": "#55625c",
    "panelTitle.activeBorder": "#7a4f00",
    "list.activeSelectionBackground": "#d6e8df",
    "list.activeSelectionForeground": "#1b2421",
    "list.inactiveSelectionBackground": "#e6efe9",
    "list.hoverBackground": "#ffffff",
    "list.focusBackground": "#d6e8df",
    "list.highlightForeground": "#7a4f00",
    "input.background": "#f6f3ec",
    "input.foreground": "#1b2421",
    "input.border": "#7d8a83",
    "input.placeholderForeground": "#5f6b65",
    "inputOption.activeBorder": "#0b6b5c",
    "inputValidation.errorBorder": "#b3261e",
    "inputValidation.warningBorder": "#7a4f00",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#1b2421",
    "dropdown.border": "#7d8a83",
    "button.background": "#f2b134",
    "button.foreground": "#1a1405",
    "button.hoverBackground": "#e5a623",
    "button.secondaryBackground": "#ffffff",
    "button.secondaryForeground": "#1b2421",
    "badge.background": "#f2b134",
    "badge.foreground": "#1a1405",
    "scrollbarSlider.background": "#7d8a8344",
    "scrollbarSlider.hoverBackground": "#7d8a8388",
    "scrollbarSlider.activeBackground": "#7d8a8388",
    "minimap.findMatchHighlight": "#f2b134",
    "minimap.selectionHighlight": "#d6e8df",
    "menu.background": "#ffffff",
    "menu.foreground": "#1b2421",
    "menu.selectionBackground": "#d6e8df",
    "menu.selectionForeground": "#1b2421",
    "menu.separatorBackground": "#d9d3c5",
    "notifications.background": "#ffffff",
    "notifications.foreground": "#1b2421",
    "notifications.border": "#7d8a83",
    "gitDecoration.modifiedResourceForeground": "#7a4f00",
    "gitDecoration.addedResourceForeground": "#2f6b17",
    "gitDecoration.untrackedResourceForeground": "#0b6b5c",
    "gitDecoration.deletedResourceForeground": "#b3261e",
    "gitDecoration.ignoredResourceForeground": "#616e68",
    "gitDecoration.conflictingResourceForeground": "#b3261e",
    "terminal.background": "#fffdf8",
    "terminal.foreground": "#1b2421",
    "terminalCursor.foreground": "#7a4f00",
    "terminal.selectionBackground": "#d6e8df",
    "terminal.ansiBlack": "#1b2421",
    "terminal.ansiRed": "#b3261e",
    "terminal.ansiGreen": "#2f6b17",
    "terminal.ansiYellow": "#7a4f00",
    "terminal.ansiBlue": "#1f5f9e",
    "terminal.ansiMagenta": "#6b4aa0",
    "terminal.ansiCyan": "#0a5f78",
    "terminal.ansiWhite": "#d9d3c5",
    "terminal.ansiBrightBlack": "#55625c",
    "terminal.ansiBrightRed": "#c9342a",
    "terminal.ansiBrightGreen": "#3b7f1f",
    "terminal.ansiBrightYellow": "#946000",
    "terminal.ansiBrightBlue": "#2a72b8",
    "terminal.ansiBrightMagenta": "#7e5bb8",
    "terminal.ansiBrightCyan": "#0d7592",
    "terminal.ansiBrightWhite": "#fffdf8",
    "bynk.docHeadingForeground": "#7a4f00"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.double-slash.bynk",
        "punctuation.definition.comment.bynk"
      ],
      "settings": {
        "foreground": "#5f6b65",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation.bynk",
        "comment.line.documentation.bynk"
      ],
      "settings": {
        "foreground": "#4f6b5e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Declaration keywords (context, service, type, fn, …)",
      "scope": [
        "keyword.declaration.bynk"
      ],
      "settings": {
        "foreground": "#7a4f00"
      }
    },
    {
      "name": "Control keywords (if, match, let, …)",
      "scope": [
        "keyword.control.bynk"
      ],
      "settings": {
        "foreground": "#7a4f00"
      }
    },
    {
      "name": "Modifier keywords",
      "scope": [
        "keyword.modifier.bynk"
      ],
      "settings": {
        "foreground": "#7a4f00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTTP methods",
      "scope": [
        "keyword.other.http-method.bynk"
      ],
      "settings": {
        "foreground": "#7a4f00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators (<-, ->, =>, ::, …)",
      "scope": [
        "keyword.operator.bynk"
      ],
      "settings": {
        "foreground": "#55625c"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator.bynk",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#55625c"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type.bynk",
        "support.type.builtin.bynk",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#0a5f78"
      }
    },
    {
      "name": "Interfaces and capabilities",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#0b6b5c"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function.builtin.bynk",
        "support.function.builtin.mock.bynk",
        "support.function"
      ],
      "settings": {
        "foreground": "#1f5f9e"
      }
    },
    {
      "name": "Refinement predicates",
      "scope": [
        "support.function.predicate.bynk"
      ],
      "settings": {
        "foreground": "#1f5f9e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "entity.name.function.decorator.bynk",
        "punctuation.definition.annotation.bynk"
      ],
      "settings": {
        "foreground": "#6b4aa0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.double.bynk"
      ],
      "settings": {
        "foreground": "#2f6b17"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape.bynk"
      ],
      "settings": {
        "foreground": "#a3410f"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.section.interpolation.begin.bynk",
        "punctuation.section.interpolation.end.bynk"
      ],
      "settings": {
        "foreground": "#7a4f00"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric.bynk",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#a3410f"
      }
    },
    {
      "name": "Language constants (true, false, None, Ok, …)",
      "scope": [
        "constant.language.bynk",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#a3410f"
      }
    },
    {
      "name": "self",
      "scope": [
        "variable.language.self.bynk"
      ],
      "settings": {
        "foreground": "#7a4f00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other.bynk",
        "variable"
      ],
      "settings": {
        "foreground": "#1b2421"
      }
    },
    {
      "name": "Markdown headings in doc comments",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#7a4f00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis in doc comments",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic in doc comments",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code in doc comments",
      "scope": [
        "markup.raw",
        "markup.inline.raw",
        "markup.raw.block.markdown",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#2f6b17"
      }
    },
    {
      "name": "Markdown links in doc comments",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0b6b5c"
      }
    },
    {
      "name": "Markdown list and quote marks",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown",
        "punctuation.definition.markdown"
      ],
      "settings": {
        "foreground": "#55625c"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#0a5f78",
    "type.declaration": {
      "foreground": "#0a5f78",
      "bold": true
    },
    "type.refined": {
      "foreground": "#0a5f78",
      "italic": true
    },
    "type.opaque": {
      "foreground": "#0a5f78",
      "underline": true
    },
    "capability": "#0b6b5c",
    "capability.declaration": {
      "foreground": "#0b6b5c",
      "bold": true
    },
    "service": {
      "foreground": "#0a5f78",
      "bold": true
    },
    "agent": {
      "foreground": "#0a5f78",
      "bold": true
    },
    "actor": "#0a5f78",
    "messages": "#0a5f78",
    "provider": "#1f5f9e",
    "function": "#1f5f9e",
    "method": "#1f5f9e",
    "function.declaration": {
      "foreground": "#1f5f9e",
      "bold": true
    },
    "property": "#3a4a44",
    "variable": "#1b2421",
    "decorator": "#6b4aa0",
    "asset": "#a3410f",
    "embed": "#a3410f",
    "comment.documentation": {
      "foreground": "#4f6b5e",
      "italic": true
    },
    "*.platformNative": {
      "italic": true
    }
  }
}
