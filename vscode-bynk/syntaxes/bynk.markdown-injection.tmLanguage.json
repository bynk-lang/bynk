{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bynk fenced code blocks in Markdown",
  "comment": "Injected into text.html.markdown (#2099). Highlights ```bynk and ~~~bynk fences with source.bynk. The patterns follow VS Code's own markdown-basics fenced_code_block_<lang> rules, so fence length, indentation and info-string attributes behave as they do for the built-in languages.",
  "scopeName": "markdown.bynk.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "fileTypes": [],
  "patterns": [
    {
      "include": "#fenced_code_block_bynk"
    }
  ],
  "repository": {
    "fenced_code_block_bynk": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(bynk)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.bynk",
          "patterns": [
            {
              "include": "source.bynk"
            }
          ]
        }
      ]
    }
  }
}
