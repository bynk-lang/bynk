{
  "name": "bynk-vscode",
  "displayName": "Bynk",
  "description": "Language support for Bynk (.bynk) source files.",
  "version": "0.352.2",
  "publisher": "bynk",
  "license": "MIT OR Apache-2.0",
  "icon": "assets/bynk-icon.png",
  "repository": {
    "url": "https://github.com/bynk-lang/bynk"
  },
  "//bynkServerVersion": "The bynkc-lsp release this extension build provisions (see src/server.ts): the last shipped release, not the workspace version. release.yml's server-pin job moves it when a release is published (#1673).",
  "bynkServerVersion": "v0.330.4",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:bynk",
    "workspaceContains:bynk.toml",
    "onWebviewPanel:bynkSequenceDiagram",
    "onWebviewPanel:bynkDocumentation",
    "onWebviewPanel:bynkArchitectureMap",
    "onWebviewPanel:bynkWireContract"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bynk",
        "aliases": [
          "Bynk",
          "bynk"
        ],
        "extensions": [
          ".bynk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bynk",
        "scopeName": "source.bynk",
        "path": "./syntaxes/bynk.tmLanguage.json"
      },
      {
        "scopeName": "markdown.bynk.codeblock",
        "path": "./syntaxes/bynk.markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bynk": "bynk"
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "capability",
        "superType": "interface",
        "description": "A Bynk capability (an effectful interface)."
      },
      {
        "id": "service",
        "superType": "type",
        "description": "A Bynk service (a set of request/response handlers)."
      },
      {
        "id": "agent",
        "superType": "class",
        "description": "A Bynk agent (a stateful set of handlers)."
      },
      {
        "id": "provider",
        "superType": "function",
        "description": "A Bynk capability provider."
      },
      {
        "id": "actor",
        "superType": "type",
        "description": "A Bynk actor (a boundary contract consumed by a handler's `by` clause)."
      },
      {
        "id": "messages",
        "superType": "struct",
        "description": "A Bynk message bundle (`messages <tag> { ... }`)."
      },
      {
        "id": "asset",
        "superType": "variable",
        "description": "A Bynk asset (a static file the platform serves, `asset name = \"path\"`)."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "refined",
        "description": "A refined type — a base type narrowed by a predicate."
      },
      {
        "id": "opaque",
        "description": "An opaque type — nominal identity with a hidden representation."
      },
      {
        "id": "platformNative",
        "description": "Declared by a platform adapter (e.g. bynk.cloudflare's Kv)."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "bynk",
        "scopes": {
          "capability": [
            "entity.name.type.interface"
          ],
          "service": [
            "entity.name.type"
          ],
          "agent": [
            "entity.name.type.class"
          ],
          "provider": [
            "entity.name.function"
          ],
          "actor": [
            "entity.name.type"
          ],
          "messages": [
            "entity.name.type.struct"
          ],
          "asset": [
            "variable.other.constant"
          ],
          "type.refined": [
            "support.type"
          ],
          "type.opaque": [
            "support.type"
          ],
          "capability.platformNative": [
            "support.type"
          ],
          "service.platformNative": [
            "support.type"
          ],
          "agent.platformNative": [
            "support.type"
          ],
          "provider.platformNative": [
            "support.type"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "bynk.restartServer",
        "title": "Restart Language Server",
        "category": "Bynk"
      },
      {
        "command": "bynk.downloadServer",
        "title": "Download Language Server",
        "category": "Bynk"
      },
      {
        "command": "bynk.showServerOutput",
        "title": "Show Language Server Output",
        "category": "Bynk"
      },
      {
        "command": "bynk.openProjectConfig",
        "title": "Open Project Config (bynk.toml)",
        "category": "Bynk"
      },
      {
        "command": "bynk.newProject",
        "title": "New Project",
        "category": "Bynk"
      },
      {
        "command": "bynk.newContext",
        "title": "New Context",
        "category": "Bynk"
      },
      {
        "command": "bynk.runTests",
        "title": "Run Tests",
        "category": "Bynk"
      },
      {
        "command": "bynk.debugTests",
        "title": "Debug Tests",
        "category": "Bynk"
      },
      {
        "command": "bynk.showSequenceDiagram",
        "title": "Show Sequence Diagram",
        "category": "Bynk",
        "icon": "$(symbol-event)"
      },
      {
        "command": "bynk.showDocumentation",
        "title": "Show Documentation",
        "category": "Bynk",
        "icon": "$(book)"
      },
      {
        "command": "bynk.showArchitectureMap",
        "title": "Show Architecture Map",
        "category": "Bynk",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bynk.showWireContract",
        "title": "Show Wire Contract",
        "category": "Bynk",
        "icon": "$(plug)"
      },
      {
        "command": "bynk.explainDiagnostic",
        "title": "Explain Diagnostic Code…",
        "category": "Bynk"
      },
      {
        "command": "bynk.project.refresh",
        "title": "Refresh",
        "category": "Bynk",
        "icon": "$(refresh)"
      },
      {
        "command": "bynk.project.showArchitectureMap",
        "title": "Show Architecture Map",
        "category": "Bynk",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bynk.project.showDocumentation",
        "title": "Show Documentation",
        "category": "Bynk",
        "icon": "$(book)"
      },
      {
        "command": "bynk.project.sequenceDiagram",
        "title": "Show Sequence Diagram",
        "category": "Bynk",
        "icon": "$(symbol-event)"
      },
      {
        "command": "bynk.project.wireContract",
        "title": "Show Wire Contract",
        "category": "Bynk",
        "icon": "$(plug)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bynk.newContext",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.openProjectConfig",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.runTests",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.debugTests",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.restartServer",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.downloadServer",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.showServerOutput",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.showSequenceDiagram",
          "when": "editorLangId == bynk"
        },
        {
          "command": "bynk.showDocumentation",
          "when": "editorLangId == bynk"
        },
        {
          "command": "bynk.showArchitectureMap",
          "when": "editorLangId == bynk"
        },
        {
          "command": "bynk.showWireContract",
          "when": "editorLangId == bynk"
        },
        {
          "command": "bynk.explainDiagnostic",
          "when": "editorLangId == bynk || bynk.hasProject"
        },
        {
          "command": "bynk.project.refresh",
          "when": "false"
        },
        {
          "command": "bynk.project.showArchitectureMap",
          "when": "false"
        },
        {
          "command": "bynk.project.showDocumentation",
          "when": "false"
        },
        {
          "command": "bynk.project.sequenceDiagram",
          "when": "false"
        },
        {
          "command": "bynk.project.wireContract",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "bynk.runTests",
          "when": "editorLangId == bynk",
          "group": "bynk@1"
        },
        {
          "command": "bynk.debugTests",
          "when": "editorLangId == bynk",
          "group": "bynk@2"
        }
      ],
      "editor/context": [
        {
          "command": "bynk.runTests",
          "when": "editorLangId == bynk",
          "group": "bynk@1"
        },
        {
          "command": "bynk.debugTests",
          "when": "editorLangId == bynk",
          "group": "bynk@2"
        }
      ],
      "explorer/context": [
        {
          "command": "bynk.newContext",
          "when": "explorerResourceIsFolder && bynk.hasProject",
          "group": "bynk@1"
        },
        {
          "command": "bynk.openProjectConfig",
          "when": "explorerResourceIsFolder && bynk.hasProject",
          "group": "bynk@2"
        }
      ],
      "editor/title": [
        {
          "command": "bynk.showSequenceDiagram",
          "when": "editorLangId == bynk",
          "group": "navigation@91"
        },
        {
          "command": "bynk.showDocumentation",
          "when": "editorLangId == bynk",
          "group": "navigation@92"
        },
        {
          "command": "bynk.showArchitectureMap",
          "when": "editorLangId == bynk",
          "group": "navigation@93"
        },
        {
          "command": "bynk.showWireContract",
          "when": "editorLangId == bynk",
          "group": "navigation@94"
        }
      ],
      "view/title": [
        {
          "command": "bynk.project.refresh",
          "when": "view == bynk.project",
          "group": "navigation@1"
        },
        {
          "command": "bynk.project.showArchitectureMap",
          "when": "view == bynk.project",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bynk.project.showDocumentation",
          "when": "view == bynk.project && viewItem == bynkUnit",
          "group": "inline"
        },
        {
          "command": "bynk.project.showDocumentation",
          "when": "view == bynk.project && viewItem == bynkUnit",
          "group": "bynk@1"
        },
        {
          "command": "bynk.project.showArchitectureMap",
          "when": "view == bynk.project && viewItem == bynkProject",
          "group": "inline"
        },
        {
          "command": "bynk.project.sequenceDiagram",
          "when": "view == bynk.project && viewItem == bynkHandler",
          "group": "inline@1"
        },
        {
          "command": "bynk.project.wireContract",
          "when": "view == bynk.project && viewItem == bynkHandler",
          "group": "inline@2"
        },
        {
          "command": "bynk.project.sequenceDiagram",
          "when": "view == bynk.project && viewItem == bynkHandler",
          "group": "bynk@1"
        },
        {
          "command": "bynk.project.wireContract",
          "when": "view == bynk.project && viewItem == bynkHandler",
          "group": "bynk@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bynk",
          "title": "Bynk",
          "icon": "assets/bynk-activity.svg"
        }
      ]
    },
    "views": {
      "bynk": [
        {
          "id": "bynk.project",
          "name": "Project",
          "when": "bynk.hasProject",
          "contextualTitle": "Bynk"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bynk.project",
        "contents": "No Bynk units found in this workspace yet.\n[New Context](command:bynk.newContext)"
      }
    ],
    "keybindings": [
      {
        "command": "bynk.runTests",
        "key": "ctrl+; t",
        "mac": "cmd+; t",
        "when": "editorLangId == bynk"
      },
      {
        "command": "bynk.debugTests",
        "key": "ctrl+; d",
        "mac": "cmd+; d",
        "when": "editorLangId == bynk"
      }
    ],
    "snippets": [
      {
        "language": "bynk",
        "path": "./snippets/bynk.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "bynkc"
      }
    ],
    "breakpoints": [
      {
        "language": "bynk"
      }
    ],
    "debuggers": [
      {
        "type": "bynk",
        "label": "Bynk",
        "languages": [
          "bynk"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "test",
                  "dev"
                ],
                "enumDescriptions": [
                  "Debug the project's tests (`bynk test --inspect`).",
                  "Debug the dev server worker (`bynk dev --inspect`)."
                ],
                "description": "What to debug: the tests, or the running dev server.",
                "default": "test"
              },
              "context": {
                "type": "string",
                "description": "For `mode: dev` in a multi-context project — which context's worker to serve and attach to (dotted `a.b` or worker-dir `a-b`)."
              },
              "port": {
                "type": "number",
                "description": "For `mode: dev` — the V8 inspector port (`wrangler dev --inspector-port`).",
                "default": 9229
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "bynk",
            "request": "launch",
            "name": "Bynk: Debug tests",
            "mode": "test"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Bynk: Debug tests",
            "description": "Debug the project's tests, pausing at breakpoints set in `.bynk` sources.",
            "body": {
              "type": "bynk",
              "request": "launch",
              "name": "Bynk: Debug tests",
              "mode": "test"
            }
          },
          {
            "label": "Bynk: Debug dev server",
            "description": "Serve the worker under the V8 inspector and attach, pausing at `.bynk` breakpoints.",
            "body": {
              "type": "bynk",
              "request": "launch",
              "name": "Bynk: Debug dev server",
              "mode": "dev"
            }
          }
        ]
      }
    ],
    "problemMatchers": [
      {
        "name": "bynkc",
        "owner": "bynk",
        "source": "bynkc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning)\\[([^\\]]+)\\]: (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Bynk",
      "properties": {
        "bynk.executablePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a bynkc-lsp executable to use. When empty, the extension resolves the server automatically: `bynkc-lsp` on PATH, then a previously-downloaded copy, then it downloads the matching release."
        },
        "bynk.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP protocol communication (visible in the Bynk LSP output channel)."
        },
        "bynk.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show Bynk inlay hints. When off, the Bynk server's hints are hidden; this takes effect on the next edit or scroll. For an instant on/off use the built-in `editor.inlayHints.enabled`."
        },
        "bynk.inlayHints.types": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred-type hints (on `let` bindings and lambda parameters). Requires `bynk.inlayHints.enable`."
        },
        "bynk.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter-name hints at call arguments. Requires `bynk.inlayHints.enable`."
        },
        "bynk.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Pin an exact `bynkc` compiler for the `bynkc: check` build task, the Test Explorer, and test debugging — passed through as `BYNK_BYNKC` to the `bynk` driver, which now runs these. When empty, `bynk` resolves `bynkc` itself (PATH, then a sibling of `bynk`)."
        },
        "bynk.bynkPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `bynk` driver used by the `bynkc: check` build task, the Test Explorer, and the debug session (`bynk check`/`bynk test`/`bynk dev`). When empty, `bynk` is taken from PATH."
        },
        "bynk.debug.semanticValues": {
          "type": "boolean",
          "default": true,
          "description": "Render Bynk values in the debugger in Bynk's vocabulary (e.g. `Ok(42)` instead of `{tag: \"Ok\", value: 42}`) when debugging tests. Turn off to see the raw emitted shape. (Test-debug only — the dev-server/workerd path always shows the raw shape.)"
        },
        "bynk.testCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a `Run Test | Debug Test` CodeLens above each test case in a `.bynk` file. `Run Test` runs just that case (`bynk test --case <name>`); `Debug Test` runs just that case under the inspector, so a breakpoint pauses. The native gutter run/debug icons appear regardless; turn this off to use only those."
        },
        "bynk.inlineDocRendering.enable": {
          "type": "boolean",
          "default": true,
          "description": "Render doc comments (`--- … ---`) in place with light Markdown affordances — heading colour, **bold**, *italic* — while reading the source. Markers stay visible (style-in-place, no font-size change); clickable `[Name]` links come from document links. Turn off to see doc comments as plain comment text."
        },
        "bynk.views.refresh": {
          "type": "string",
          "enum": [
            "onSave",
            "onType",
            "manual"
          ],
          "enumDescriptions": [
            "Refresh an open model view when a `.bynk` file or `bynk.toml` is saved.",
            "Refresh as you type, about 500 ms after the last edit, once the language server has analysed it.",
            "Refresh only when you click Refresh in the view or run its command again."
          ],
          "default": "onSave",
          "description": "When the open model views (sequence diagram, documentation, architecture map, wire contract) and the Bynk project sidebar re-request their model from the language server. A view refreshes only while it is visible; a hidden one catches up when shown."
        },
        "bynk.viewsCodeLens": {
          "type": "boolean",
          "default": false,
          "description": "Show a `Wire contract` CodeLens above each service and agent handler, beside the language server's `Show Sequence` lens. The editor title-bar buttons open the same views without it."
        }
      }
    },
    "colors": [
      {
        "id": "bynk.docHeadingForeground",
        "description": "Foreground colour of Markdown heading lines rendered in place inside `--- … ---` doc comments (bynk.inlineDocRendering.enable).",
        "defaults": {
          "light": "#0000c0",
          "dark": "#569cd6",
          "highContrast": "#9cdcfe",
          "highContrastLight": "#0000c0"
        }
      }
    ],
    "configurationDefaults": {
      "[bynk]": {
        "editor.defaultFormatter": "bynk.bynk-vscode"
      }
    },
    "walkthroughs": [
      {
        "id": "bynk.gettingStarted",
        "title": "Get Started with Bynk",
        "description": "Set up a project and write your first Bynk context.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to Bynk",
            "description": "What this extension gives you, and how to begin.",
            "media": {
              "markdown": "walkthroughs/welcome.md"
            }
          },
          {
            "id": "project",
            "title": "Create a project",
            "description": "Scaffold a `bynk.toml` and a starter context.\n[New Project](command:bynk.newProject)",
            "media": {
              "markdown": "walkthroughs/project.md"
            },
            "completionEvents": [
              "onCommand:bynk.newProject"
            ]
          },
          {
            "id": "author",
            "title": "Write your first context",
            "description": "Use snippets and the live language features.",
            "media": {
              "markdown": "walkthroughs/author.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify && esbuild src/webview/main.ts --bundle --outfile=out/webview.js --format=iife --platform=browser --target=es2022 --minify && esbuild src/webview/docview.ts --bundle --outfile=out/docview.js --format=iife --platform=browser --target=es2022 --minify && esbuild src/webview/architecture.ts --bundle --outfile=out/architecture.js --format=iife --platform=browser --target=es2022 --minify && esbuild src/webview/wireContract.ts --bundle --outfile=out/wireContract.js --format=iife --platform=browser --target=es2022 --minify && esbuild src/webview/explainview.ts --bundle --outfile=out/explainview.js --format=iife --platform=browser --target=es2022 --minify",
    "check": "tsc -p . --noEmit",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch",
    "package": "npm run build && npx @vscode/vsce package",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile-tests && npm run build",
    "test": "node out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "brace-expansion": "^5.0.8"
  }
}
