commons demo

fn line() -> String {
	"HTTP/1.1 200 OK\r\n"
}

fn nbsp() -> String {
	"a\u{00A0}b"
}

fn digits() -> String {
	r"\d+\.\d+"
}

fn quoted() -> String {
	r#"say "hi""#
}

fn query(name: String) -> String {
	"""
	SELECT id
	  FROM t WHERE n = \(name)
	"""
}

fn pattern() -> String {
	r"""
	^\d+$
	"""
}

fn check(s: String) -> Bool {
	s.matchesRegex(r"\w+")
}

type Sku = String where Matches(r"\d+") && MaxLength(9)

fn family() -> String {
	"👨‍👩‍👧 a‏b"
}

fn interp(n: String) -> String {
	"\u{41}\(n)"
}

messages "en" @reference {
	"short" => "Hi"
	"long" => """
	Dear {name},
	  thanks.
	"""
}
